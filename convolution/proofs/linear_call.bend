        {%Equal.sym(Nat,U32.to_nat(U32.from_nat(total)),total,round) : {Nat.is_le(_,U32.to_nat(Machine.capacity(limits))) == True{} : Bool} room : {Nat.is_le(U32.to_nat(U32.from_nat(total)),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}}) :
      {U32.is_le(U32.from_nat(total),Machine.capacity(Default.limits())) == True{} : Bool}})}

def factors_found(found: Maybe<&2,F.Factors>) -> Bool:
  match found:
    case None{}: False{}
    case Some{value}: True{}

def factors_extended(+extent: U32,rest: List<&2,U32>,+found: F.Factors,+exact: {F.factors(rest) == Some{found} : Maybe<&2,F.Factors>}) ->
  {F.factors(extent <> rest) == F.factors_extended(extent,Some{found}) : Maybe<&2,F.Factors>}:
  match rest:
    case []: Empty.absurd({F.factors([extent]) == F.factors_extended(extent,Some{found}) : Maybe<&2,F.Factors>},
      WordEncoding.false_true(Equal.cong(Maybe<&2,F.Factors>,Bool,value => factors_found(value),None{},Some{found},exact)))
    case +next <> tail:
      match tail:
        case []: Empty.absurd({F.factors([extent,next]) == F.factors_extended(extent,Some{found}) : Maybe<&2,F.Factors>},
          WordEncoding.false_true(Equal.cong(Maybe<&2,F.Factors>,Bool,value => factors_found(value),None{},Some{found},exact)))
        case +second <> +more:
          match more:
            case []: Equal.cong(Maybe<&2,F.Factors>,Maybe<&2,F.Factors>,value => F.factors_extended(extent,value),F.factors([next,second]),Some{found},exact)
            case +third <> +others:
              Equal.cong(Maybe<&2,F.Factors>,Maybe<&2,F.Factors>,value => F.factors_extended(extent,value),F.factors(next <> second <> third <> others),Some{found},exact)

# The leading axes, rows and inputs of x.
def factors_appended(leading: List<&2,U32>,+rows: U32,+inner: U32) -> {F.factors(List.append(&2,U32,leading,[rows,inner])) == Some{F.Factors{leading,rows,inner}} : Maybe<&2,F.Factors>}:
  match leading:
    case []: {==}
    case +extent <> +tail:
      factors_extended(extent,List.append(&2,U32,tail,[rows,inner]),F.Factors{tail,rows,inner},factors_appended(tail,rows,inner))

