# ---- The products as a convolution ----

def axis_word(+all: U32,+positive: {Nat.is_lt(0n,U32.to_nat(all)) == True{} : Bool}) -> {U32.from_nat(KernelShape.axis_size(U32.to_nat(all),U32.to_nat(1),U32.to_nat(1),U32.to_nat(0))) == all : U32}:
  Equal.trans(U32,U32.from_nat(KernelShape.axis_size(U32.to_nat(all),1n,1n,0n)),U32.from_nat(U32.to_nat(all)),all,
    Equal.cong(Nat,U32,size => U32.from_nat(size),KernelShape.axis_size(U32.to_nat(all),1n,1n,0n),U32.to_nat(all),Products.unit_axis(U32.to_nat(all),positive)),
    Arithmetic.native_roundtrip(all))

# The products of rows are the cells of the run of the convolution of a
# one-cell window over one image of the rows.
def products_run(+all: U32,+inner: U32,+outputs: U32,+positive: {Nat.is_lt(0n,U32.to_nat(all)) == True{} : Bool},-pieces: Pieces.Pieces(~Tile.Tile8),-weight_cells: Storage.Buffer<Tile.Tile8>,-bias_cells: Storage.Buffer<Tile.Tile8>,+workers: U32) ->
  {Tiled.cells_of(TensorConvolution.run(~Activations.identity_value,Activations.identity(),TensorConvolution.Geometry{1,True{},KernelShape.Dimensions{U32.to_nat(inner),U32.to_nat(outputs),U32.to_nat(all),U32.to_nat(1),U32.to_nat(1),U32.to_nat(1),U32.to_nat(0)}},pieces,weight_cells,bias_cells,workers)) == TensorConvolution.products(1,all,inner,outputs,pieces,weight_cells,bias_cells,workers) : Tensors.Tensor<Tile.Tile8>}:
  {==}

# ---- The output of the products ----

# The cells of a column of rows and of the rows of the result.

def column_cells(+count: U32,+all: U32,+groups: U32) -> {ShapeLaws.elements([count,all,1,groups]) == Nat.mul(Nat.mul(U32.to_nat(count),U32.to_nat(all)),U32.to_nat(groups)) : Nat}:
  %Equal.sym(Nat,Nat.mul(U32.to_nat(groups),1n),U32.to_nat(groups),Order.times_one(U32.to_nat(groups))) :
    {Nat.mul(U32.to_nat(count),Nat.mul(U32.to_nat(all),Nat.add(_,0n))) == Nat.mul(Nat.mul(U32.to_nat(count),U32.to_nat(all)),U32.to_nat(groups)) : Nat}
  %Equal.sym(Nat,Nat.add(U32.to_nat(groups),0n),U32.to_nat(groups),Addition.zero_right(U32.to_nat(groups))) :
    {Nat.mul(U32.to_nat(count),Nat.mul(U32.to_nat(all),_)) == Nat.mul(Nat.mul(U32.to_nat(count),U32.to_nat(all)),U32.to_nat(groups)) : Nat}
  Equal.sym(Nat,Nat.mul(Nat.mul(U32.to_nat(count),U32.to_nat(all)),U32.to_nat(groups)),Nat.mul(U32.to_nat(count),Nat.mul(U32.to_nat(all),U32.to_nat(groups))),
    RowMajor.assoc(U32.to_nat(count),U32.to_nat(all),U32.to_nat(groups)))


def row_cells(+all: U32,+groups: U32) -> {ShapeLaws.elements([1,all,groups]) == Nat.mul(U32.to_nat(all),U32.to_nat(groups)) : Nat}:
  %Equal.sym(Nat,Nat.mul(U32.to_nat(groups),1n),U32.to_nat(groups),Order.times_one(U32.to_nat(groups))) :
    {Nat.add(Nat.mul(U32.to_nat(all),_),0n) == Nat.mul(U32.to_nat(all),U32.to_nat(groups)) : Nat}
  Addition.zero_right(Nat.mul(U32.to_nat(all),U32.to_nat(groups)))
def images_row_cells(+count: U32,+all: U32,+groups: U32) -> {ShapeLaws.elements([count,all,groups]) == Nat.mul(Nat.mul(U32.to_nat(count),U32.to_nat(all)),U32.to_nat(groups)) : Nat}:
  %Equal.sym(Nat,Nat.mul(U32.to_nat(groups),1n),U32.to_nat(groups),Order.times_one(U32.to_nat(groups))) :
    {Nat.mul(U32.to_nat(count),Nat.mul(U32.to_nat(all),_)) == Nat.mul(Nat.mul(U32.to_nat(count),U32.to_nat(all)),U32.to_nat(groups)) : Nat}
  Equal.sym(Nat,Nat.mul(Nat.mul(U32.to_nat(count),U32.to_nat(all)),U32.to_nat(groups)),Nat.mul(U32.to_nat(count),Nat.mul(U32.to_nat(all),U32.to_nat(groups))),
    RowMajor.assoc(U32.to_nat(count),U32.to_nat(all),U32.to_nat(groups)))



def cell_bound(+count: U32,+all: U32,+outputs: U32) -> {Swapped.cell_count(count,outputs,all) == Nat.mul(Nat.mul(U32.to_nat(count),U32.to_nat(all)),U32.to_nat(Tiled.groups(outputs))) : Nat}:
  {==}


# The values of the output of the window and of the result.

def output_rows(+count: U32,+all: U32,+outputs: U32) -> {ShapeLaws.elements([count,outputs,all,1]) == ShapeLaws.elements([count,all,outputs]) : Nat}:
  Equal.cong(Nat,Nat,value => Nat.mul(U32.to_nat(count),value),Nat.mul(U32.to_nat(outputs),Nat.mul(U32.to_nat(all),Nat.mul(1n,1n))),Nat.mul(U32.to_nat(all),Nat.mul(U32.to_nat(outputs),1n)),
    RowMajor.swap_factors(U32.to_nat(outputs),U32.to_nat(all),1n))


# The values of usable cells of a contract are counted.
def usable_counted(~Logical: Data,~original: Logical -> U32 -> F32,+logical: Logical,+values: List<&2,U32>,-pieces: Pieces.Pieces(~Tile.Tile8),+shape: List<&2,U32>,
  +fill: Tile.Tile8,+workers: U32,+axis: Nat,+lanes: U32,+position: Grid.Position,
  +contract: TiledPublic.Contract(~Logical,~original,logical,values,Tiled.Tiled{Tensors.Tensor{pieces,shape,fill,Tensors.Usable{},workers},axis,lanes,position})) ->
  Global.Counted<values>:
  KernelGemm.Both{global,TiledPublic.Laid{inside,shaped,restored,+counted,pinned}} = contract
  counted

# Usable cells of a Shaped tensor marked usable.
def status_kept(~Element: Data,~Logical: Data,~original: Logical -> U32 -> Element,+logical: Logical,+shape: List<&2,U32>,-tensor: Tensors.Tensor<Element>,
  +shaped: Global.Shaped(~Element,~Logical,~original,logical,shape,tensor)) ->
  Global.Shaped(~Element,~Logical,~original,logical,shape,Tensors.with_status(~Element,Tensors.Usable{},tensor)):
  KernelGemm.Both{Global.Usable{+model,+fill,+workers,+equation},+contract} = shaped
  %equation : Global.Shaped(~Element,~Logical,~original,logical,shape,Tensors.with_status(~Element,Tensors.Usable{},_))
  KernelGemm.Both{Global.Usable{model,fill,workers,{==}},
    {%Equal.sym(Tensors.Tensor<Element>,Tensors.Tensor{PiecesModel.pack(~Element,model),shape,fill,Tensors.Usable{},workers},tensor,equation) : Global.Contract(~Element,~Logical,~original,logical,_)
      contract : Global.Contract(~Element,~Logical,~original,logical,Tensors.Tensor{PiecesModel.pack(~Element,model),shape,fill,Tensors.Usable{},workers})}}

