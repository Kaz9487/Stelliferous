# ---- F.linear ----

# A factor of a product of words with a positive value is positive.
def factor_cases(+value: Nat,+left: U32,+right: U32,+exact: {U32.to_nat(right) == value : Nat},
  +positive: {Nat.is_lt(0n,U32.to_nat((left * right : U32))) == True{} : Bool}) -> {Nat.is_lt(0n,value) == True{} : Bool}:
  match value:
    case 0n:
      Empty.absurd({Nat.is_lt(0n,0n) == True{} : Bool},WordEncoding.false_true({
        %RowMajor.multiply_zero_right(U32.to_nat(left)) : {Nat.is_lt(0n,U32.to_nat(U32.from_nat(_))) == True{} : Bool}
        %exact : {Nat.is_lt(0n,U32.to_nat(U32.from_nat(Nat.mul(U32.to_nat(left),_)))) == True{} : Bool}
        %WordMultiplication.native_multiply(left,right) : {Nat.is_lt(0n,U32.to_nat(_)) == True{} : Bool}
        positive : {False{} == True{} : Bool}}))
    case 1n+ +rest: {==}

# The count of the leading axes of a counted shape whose trailing axes hold values.
def leading_word(+limits: Machine.Limits,+default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},+leading: List<&2,U32>,+tail: List<&2,U32>,+counted: Global.Counted<List.append(&2,U32,leading,tail)>,
  +tail_positive: {Nat.is_lt(0n,ShapeLaws.elements(tail)) == True{} : Bool}) -> {U32.to_nat(Tensors.count_or_zero(leading)) == ShapeLaws.elements(leading) : Nat}:
  +values = List.append(&2,U32,leading,tail)
  +count = Global.count(values,counted)
  +whole = Global.whole_counted(values,count,Global.accepted(values,counted))
  +covers = RowMajor.product_covers(ShapeLaws.elements(leading),ShapeLaws.elements(tail),tail_positive)
  +below = {%whole : {Nat.is_le(ShapeLaws.elements(leading),_) == True{} : Bool}
    %Equal.sym(Nat,ShapeLaws.elements(values),Nat.mul(ShapeLaws.elements(leading),ShapeLaws.elements(tail)),ShapeLaws.elements_appended(leading,tail)) : {Nat.is_le(ShapeLaws.elements(leading),_) == True{} : Bool}
    covers : {Nat.is_le(ShapeLaws.elements(leading),U32.to_nat(count)) == True{} : Bool}}
  +room = Order.transitive(ShapeLaws.elements(leading),U32.to_nat(count),U32.to_nat(Machine.capacity(limits)),below,
    Bounds.as_nat_le(count,Machine.capacity(limits),
      {%Equal.sym(U32,Machine.capacity(limits),Machine.capacity(Default.limits()),default_capacity) : {U32.is_le(count,_) == True{} : Bool}
        Relabel.count_bounded(ShapeLaws.elements(values),count,Global.evidence(values,counted)) : {U32.is_le(count,Machine.capacity(limits)) == True{} : Bool}}))
  +exact = Bounds.roundtrip(ShapeLaws.elements(leading),Machine.capacity(limits),Limits.capacity_fits(limits),room)
  +within = {%default_capacity : {U32.is_le(U32.from_nat(ShapeLaws.elements(leading)),_) == True{} : Bool}
    Held.u32_le(U32.from_nat(ShapeLaws.elements(leading)),Machine.capacity(limits),
      {%Equal.sym(Nat,U32.to_nat(U32.from_nat(ShapeLaws.elements(leading))),ShapeLaws.elements(leading),exact) : {Nat.is_le(_,U32.to_nat(Machine.capacity(limits))) == True{} : Bool} room : {Nat.is_le(U32.to_nat(U32.from_nat(ShapeLaws.elements(leading))),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}}) :
    {U32.is_le(U32.from_nat(ShapeLaws.elements(leading)),Machine.capacity(Default.limits())) == True{} : Bool}}
  %Equal.sym(U32,Tensors.count_or_zero(leading),U32.from_nat(ShapeLaws.elements(leading)),
      Global.whole_width(leading,U32.from_nat(ShapeLaws.elements(leading)),CountCompletion.count_of(leading,U32.from_nat(ShapeLaws.elements(leading)),Equal.sym(Nat,U32.to_nat(U32.from_nat(ShapeLaws.elements(leading))),ShapeLaws.elements(leading),exact),within))) :
    {U32.to_nat(_) == ShapeLaws.elements(leading) : Nat}
  exact

# A shape of a number of values within the capacity is counted.
def counted_by(+limits: Machine.Limits,+default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},+shape: List<&2,U32>,+total: Nat,+exact: {ShapeLaws.elements(shape) == total : Nat},+room: {Nat.is_le(total,U32.to_nat(Machine.capacity(limits))) == True{} : Bool}) -> Global.Counted<shape>:
  +round = Bounds.roundtrip(total,Machine.capacity(limits),Limits.capacity_fits(limits),room)
  Global.Counted{U32.from_nat(total),CountCompletion.count_of(shape,U32.from_nat(total),
    Equal.trans(Nat,ShapeLaws.elements(shape),total,U32.to_nat(U32.from_nat(total)),exact,Equal.sym(Nat,U32.to_nat(U32.from_nat(total)),total,round)),
    {%default_capacity : {U32.is_le(U32.from_nat(total),_) == True{} : Bool}
