# The convolution of the invariant of a task is the record of its problem.
def convolution_same(~Logical: Data,~original: Logical -> U32 -> F32,+holder: WindowProblem<Logical,original>,+convolution: WindowPipeline.Convolution,+bound: U32,+start: U32,+end: U32,+position: U32,
  +work: Call.PackedModel,+holds: Holds(~Logical,~original,holder,convolution,bound,start,end,position,work)) -> {convolution == record_of(~Logical,~original,holder) : WindowPipeline.Convolution}:
  PackedWorkHolds{+ready,+within,+output_depth,+output_depth_ok,+output_need,+outputs_span,+end_room,+end_inside,+output_balanced,+sized,+written} = holds
  ReadyOperands{+shared,+tile_depth,+tile_depth_ok,+tiles_balanced,+tile_need,+pair_depth,+pair_depth_ok,+pairs_balanced,+pair_need} = ready
  SharedOperands{+convolution_exact,+weights_exact,+bias_exact} = shared
  convolution_exact

# The workspace and output trees equal to balanced ones are balanced.
def kept_balances(+tile_depth: Nat,+output_depth: Nat,+tiles: Tree.Tree<Tile.Tile8>,+output: Tree.Tree<Tile.Tile8>,+workspace: Tree.Tree<Tile.Tile8>,+result: Tree.Tree<Tile.Tile8>,
  +tiles_exact: {tiles == workspace : Tree.Tree<Tile.Tile8>},+output_exact: {output == result : Tree.Tree<Tile.Tile8>},+balances: Blocked.Balances<tile_depth,output_depth,workspace,result>) ->
  Blocked.Balances<tile_depth,output_depth,tiles,output>:
  Blocked.Balances{+tiles_balanced,+output_balanced} = balances
  Blocked.Balances{{%Equal.sym(Tree.Tree<Tile.Tile8>,tiles,workspace,tiles_exact) : Shape.Balanced(Tile.Tile8,tile_depth,_) tiles_balanced : Shape.Balanced(Tile.Tile8,tile_depth,tiles)},
    {%Equal.sym(Tree.Tree<Tile.Tile8>,output,result,output_exact) : Shape.Balanced(Tile.Tile8,output_depth,_) output_balanced : Shape.Balanced(Tile.Tile8,output_depth,output)}}

# The invariant of a work from its facts.
def moved(~Logical: Data,~original: Logical -> U32 -> F32,+holder: WindowProblem<Logical,original>,+convolution: WindowPipeline.Convolution,+bound: U32,+start: U32,+end: U32,+position: U32,+work: Call.PackedModel,
  +convolution_exact: {convolution == record_of(~Logical,~original,holder) : WindowPipeline.Convolution},
  +weights_exact: {Buffer.tree(~Tile.Tile8,Call.packed_weights(work)) == weight_cells_of(~Logical,~original,holder) : Tree.Tree<Tile.Tile8>},
  +bias_exact: {Buffer.tree(~Tile.Tile8,Call.packed_bias(work)) == bias_cells_of(~Logical,~original,holder) : Tree.Tree<Tile.Tile8>},
  +within: {Nat.is_le(U32.to_nat((end - start : U32)),U32.to_nat(bound)) == True{} : Bool},
  +tile_depth: Nat,+tile_depth_ok: {Nat.is_le(tile_depth,30n) == True{} : Bool},
  +tile_need: {Nat.is_le(U32.to_nat(Pipeline.workspace_tiles(8192,WindowPipeline.inner_of(convolution),WindowPipeline.call_positions(convolution,bound))),U32.to_nat(U32.shln(1,tile_depth))) == True{} : Bool},
  +pair_depth: Nat,+pair_depth_ok: {Nat.is_le(pair_depth,30n) == True{} : Bool},+pairs_balanced: Shape.Balanced(Tile.Tile16,pair_depth,Buffer.tree(~Tile.Tile16,Call.packed_planes(work))),
  +pair_need: {Nat.is_le(U32.to_nat(WindowPipeline.plane_size(convolution,bound)),U32.to_nat(U32.shln(1,pair_depth))) == True{} : Bool},
  +output_depth: Nat,+output_depth_ok: {Nat.is_le(output_depth,30n) == True{} : Bool},
  +output_need: {Nat.is_le(Nat.mul(Nat.sub(U32.to_nat(end),U32.to_nat(start)),blocks_of(~Logical,~original,holder)),U32.to_nat(U32.shln(1,output_depth))) == True{} : Bool},
  +outputs_span: {Nat.is_le(Nat.mul(outputs_of(~Logical,~original,holder),Nat.sub(U32.to_nat(end),U32.to_nat(start))),capacity_of(~Logical,~original,holder)) == True{} : Bool},
  +end_room: {Nat.is_le(U32.to_nat(end),capacity_of(~Logical,~original,holder)) == True{} : Bool},
  +end_inside: {Nat.is_le(U32.to_nat(end),Nat.mul(images_of(~Logical,~original,holder),Skeleton.plane_nat(convolution))) == True{} : Bool},
  +sized: {Buffer.length(~Tile.Tile8,Call.packed_output(work)) == Nat.mul(Nat.sub(U32.to_nat(end),U32.to_nat(start)),groups_of(~Logical,~original,holder)) : Nat},
  +written: Members.All(Nat,{cell => Written(~Logical,~original,holder,start,Buffer.tree(~Tile.Tile8,Call.packed_output(work)),cell) : Nat -> Data},
    Ranges.range(Nat.mul(Nat.sub(U32.to_nat(position),U32.to_nat(start)),groups_of(~Logical,~original,holder)),0n)),
  +balances: Blocked.Balances<tile_depth,output_depth,Buffer.tree(~Tile.Tile8,Call.packed_tiles(work)),Buffer.tree(~Tile.Tile8,Call.packed_output(work))>) ->
  Holds(~Logical,~original,holder,convolution,bound,start,end,position,work):
  Blocked.Balances{+tiles_balanced,+output_balanced} = balances
  PackedWorkHolds{ReadyOperands{SharedOperands{convolution_exact,weights_exact,bias_exact},tile_depth,tile_depth_ok,tiles_balanced,tile_need,pair_depth,pair_depth_ok,
      pairs_balanced,pair_need},within,output_depth,output_depth_ok,output_need,outputs_span,end_room,end_inside,output_balanced,sized,written}

