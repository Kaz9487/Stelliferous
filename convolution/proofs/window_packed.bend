# ---- The problem a task holds ----

# A convolution of images of the same shape over input cells, with the output
# cells it fills and the facts its kernel relies on.
type WindowProblem<-Logical: Data,-original: Logical -> U32 -> F32> is Data:
  WindowProblem{limits: Machine.Limits,logical: Logical,activation: Activations.Activation,channels: Nat,outputs: Nat,height: Nat,width: Nat,kernel: Nat,stride: Nat,padding: Nat,weight_list: List<&2,F32>,bias_list: List<&2,F32>,groups_out: U32,images: Nat,input_outer: U32,input_after: U32,input_lanes: U32,input_groups: U32,outer_word: U32,after_word: U32,lanes_word: U32,groups_word: U32,upper: U32,upper_ok: {U32.is_le(upper,2147483648) == True{} : Bool},upper_bound: {U32.is_le(upper,1073741824) == True{} : Bool},area_positive: {Nat.is_lt(0n,Nat.mul(channels,Nat.mul(height,width))) == True{} : Bool},area_room: {Nat.is_le(Nat.mul(channels,Nat.mul(height,width)),U32.to_nat(upper)) == True{} : Bool},weight_evidence: StorageLaws.SequenceEvidence<F32,ConvSpec.length(weight_list),weight_list>,bias_evidence: StorageLaws.SequenceEvidence<F32,ConvSpec.length(bias_list),bias_list>,parameters: Inputs.Parameters(ImageProblems.problem(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,0n)),valid: {ConvSpec.valid(ImageProblems.problem(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,0n)) == True{} : Bool},supported: {NativeConv.supports_packed_with_limits(limits,ImageProblems.problem(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,0n)) == True{} : Bool},word_positive: {Nat.is_lt(0n,U32.to_nat(U32.max(WindowPipeline.plane_of(Calls.record(ImageProblems.problem(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,0n),groups_out,activation)),1))) == True{} : Bool},plane_positive: {Nat.is_lt(0n,ImageProblems.plane(height,width,kernel,stride,padding)) == True{} : Bool},plane_exact: {U32.to_nat(U32.max(WindowPipeline.plane_of(Calls.record(ImageProblems.problem(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,0n),groups_out,activation)),1)) == ImageProblems.plane(height,width,kernel,stride,padding) : Nat},plane_room: {Nat.is_le(U32.to_nat(U32.max(WindowPipeline.plane_of(Calls.record(ImageProblems.problem(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,0n),groups_out,activation)),1)),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},outputs_room: {Nat.is_le(outputs,U32.to_nat(Machine.capacity(limits))) == True{} : Bool},groups_exact_out: {U32.to_nat(U32.max(groups_out,1)) == Calls.cell_groups(outputs) : Nat},after_exact: {U32.to_nat(after_word) == ImageProblems.plane(height,width,kernel,stride,padding) : Nat},lanes_exact: {U32.to_nat(lanes_word) == outputs : Nat},elements_room: {Nat.is_le(Nat.mul(Nat.mul(images,Representation.lane_count(TiledCells.Cells{outer_word,after_word,lanes_word,groups_word,Grid.Innermost{}})),Representation.after_count(TiledCells.Cells{outer_word,after_word,lanes_word,groups_word,Grid.Innermost{}})),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},groups_exact: {U32.to_nat(groups_word) == Calls.cell_groups(outputs) : Nat},positive: {Nat.is_lt(0n,Calls.cell_groups(outputs)) == True{} : Bool},input_after_exact: {U32.to_nat(input_after) == Nat.mul(height,width) : Nat},input_lanes_exact: {U32.to_nat(input_lanes) == channels : Nat},input_groups_exact: {U32.to_nat(input_groups) == Cells.group_count(ImageProblems.problem(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,0n)) : Nat},groups_room: {Nat.is_le(Calls.cell_groups(outputs),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},images_count_room: {Nat.is_le(Nat.mul(images,Cells.count(ImageProblems.problem(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,0n),Guards.height(ImageProblems.problem(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,0n)))),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},imag