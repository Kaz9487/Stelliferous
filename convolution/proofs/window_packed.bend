# The output a piece finishes with: its output cells, activated and padded,
# and the kept operands.
def finish_output(~custom: F32 -> F32,convolution: WindowPipeline.Convolution,positions: U32,work: Call.PackedModel) -> Buffer.Model<Tile.Tile8>:
  WindowPipeline.Convolution{h,w,k,s,p,oh,ow,channels,inner,gi,go,activation} = convolution
  Call.PackedModel{weights,bias,planes,tiles,output} = work
  Buffer.remodel(~Tile.Tile8,Pipeline.finished(~custom,activation,channels,positions,Buffer.pack(~Tile.Tile8,output)))

def finish_kept(convolution: WindowPipeline.Convolution,positions: U32,work: Call.PackedModel) -> KeptOperands:
  Call.PackedModel{weights,bias,planes,tiles,output} = work
  KeptOperands{weights,bias,planes,tiles}

