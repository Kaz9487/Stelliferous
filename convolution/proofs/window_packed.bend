  +work: Call.PackedModel,+holds: Holds(~Logical,~original,holder,convolution,bound,(first / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32),((first + count) / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32),((first + count) / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32),work),+fits: Runs.Fits<U32.to_nat(U32.max(WindowPipeline.output_groups_of(convolution),1)),U32.to_nat(first),Nat.add(U32.to_nat(first),U32.to_nat(count)),cells_of(~Logical,~original,holder,convolution)>) ->
  Held.Both<Finished(~custom,~Logical,~original,holder,convolution,first,count,Buffer.content(~Tile.Tile8,finish_output(~custom,convolution,(((first + count) / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32) - (first / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32) : U32),work))),KeptOk(~Logical,~original,holder,convolution,bound,finish_kept(convolution,(((first + count) / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32) - (first / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32) : U32),work))>:
  +same = convolution_same(~Logical,~original,holder,convolution,bound,(first / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32),((first + count) / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32),((first + count) / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32),work,holds)
  {%Equal.sym(WindowPipeline.Convolution,convolution,record_of(~Logical,~original,holder),same) : Held.Both<Finished(~custom,~Logical,~original,holder,_,first,count,Buffer.content(~Tile.Tile8,finish_output(~custom,_,(((first + count) / U32.max(WindowPipeline.output_groups_of(_),1) : U32) - (first / U32.max(WindowPipeline.output_groups_of(_),1) : U32) : U32),work))),KeptOk(~Logical,~original,holder,_,bound,finish_kept(_,(((first + count) / U32.max(WindowPipeline.output_groups_of(_),1) : U32) - (first / U32.max(WindowPipeline.output_groups_of(_),1) : U32) : U32),work))>
    ended_on(~custom,~Logical,~original,holder,bound,first,count,work,{%same : Holds(~Logical,~original,holder,_,bound,(first / U32.max(WindowPipeline.output_groups_of(_),1) : U32),((first + count) / U32.max(WindowPipeline.output_groups_of(_),1) : U32),((first + count) / U32.max(WindowPipeline.output_groups_of(_),1) : U32),work) holds : Holds(~Logical,~original,holder,record_of(~Logical,~original,holder),bound,(first / U32.max(WindowPipeline.output_groups_of(record_of(~Logical,~original,holder)),1) : U32),((first + count) / U32.max(WindowPipeline.output_groups_of(record_of(~Logical,~original,holder)),1) : U32),((first + count) / U32.max(WindowPipeline.output_groups_of(record_of(~Logical,~original,holder)),1) : U32),work)},{%same : Runs.Fits<U32.to_nat(U32.max(WindowPipeline.output_groups_of(_),1)),U32.to_nat(first),Nat.add(U32.to_nat(first),U32.to_nat(count)),cells_of(~Logical,~original,holder,_)> fits : Runs.Fits<U32.to_nat(U32.max(WindowPipeline.output_groups_of(record_of(~Logical,~original,holder)),1)),U32.to_nat(first),Nat.add(U32.to_nat(first),U32.to_nat(count)),cells_of(~Logical,~original,holder,record_of(~Logical,~original,holder))>}) : Held.Both<Finished(~custom,~Logical,~original,holder,convolution,first,count,Buffer.content(~Tile.Tile8,finish_output(~custom,convolution,(((first + count) / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32) - (first / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32) : U32),work))),KeptOk(~Logical,~original,holder,convolution,bound,finish_kept(convolution,(((first + count) / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32) - (first / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32) : U32),work))>}

# ---- Kept operands between tasks ----

# A fresh workspace is balanced.
def fresh_balanced(~Element: Data,+value: Element,+size: U32) ->
  Shape.Balanced(Element,Tensors.depth_for(size),Buffer.tree(~Element,Buffer.remodel(~Element,Tensors.buffer(~Element,value,size)))):
  %Equal.sym(Tree.Tree<Element>,Buffer.tree(~Element,Buffer.remodel(~Element,Tensors.buffer(~Element,value,size))),
      Tree.fresh(Element,Tensors.depth_for(size),value),AllocationLaws.buffer_tree(~Element,value,size)) :
    Shape.Balanced(Element,Tensors.depth_for(size),_)
  Shape.fresh(Element,Tensors.depth_for(size),value)

# A task prepares its own workspaces, of room for its calls of at most
# positions positions.
def prepared_kept(+convolution: WindowPipeline.Convolution,+positions: U32,kept: KeptOperands) -> KeptOperands:
  KeptOperands{weights,bias,planes,tiles} = kept
  KeptOperands{weights,bias,Buffer.remodel(~Tile.Tile16,Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),WindowPipeline.plane_size(convolution,positions))),Buffer.remodel(~Tile.Tile8,Tensors.buffer(~Tile.Tile8,Tile.filled(0.0),WindowPipeline.workspace_size(convolution,positions)))}

def prepare_model(convolution: WindowPipeline.Convolution,positions: U32,kept: KeptOperands) -> KeptOperands:
  prepared_kept(convolution,positions,kept)

def prepare_same(+convolution: WindowPipeline.Convolution,+positions: U32,+kept: KeptOperands) ->
  {WindowPipeline.packed_prepare(convolution,positions,represent_kept(kept)) == represent_kept(prepare_model(convolution,positions,kept)) : WindowPipeline.PackedKept}:
  KeptOperands{+weights,+bias,+planes,+tiles} = kept
  %Equal.sym(Storage.Buffer<Tile.Tile16>,Buffer.pack(~Tile.Tile16,Buffer.remodel(~Tile.Tile16,Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),WindowPipeline.plane_size(convolution,positions)))),Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),WindowPipeline.plane_size(convolution,positions)),Buffer.remodeled(~Tile.Tile16,Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),WindowPipeline.plane_size(convolution,positions)))) :
    {WindowPipeline.packed_prepare(convolution,positions,WindowPipeline.PackedKept{Buffer.pack(~Tile.Tile8,weights),Buffer.pack(~Tile.Tile8,bias),Buffer.pack(~Tile.Tile16,planes),Buffer.pack(~Tile.Tile8,tiles)}) == WindowPipeline.PackedKept{Buffer.pack(~Tile.Tile8,weights),Buffer.pack(~Tile.Tile8,bias),_,Buffer.pack(~Tile.Tile8,Buffer.remodel(~Tile.Tile8,Tensors.buffer(~Tile.Tile8,Tile.filled(0.0),WindowPipeline.workspace_size(convolution,positions))))} :
      WindowPipeline.PackedKept}
  %Equal.sym(Storage.Buffer<Tile.Tile8>,Buffer.pack(~Tile.Tile8,Buffer.remodel(~Tile.Tile8,Tensors.buffer(~Tile.Tile8,Tile.filled(0.0),WindowPipeline.workspace_size(convolution,positions)))),Tensors.buffer(~Tile.Tile8,Tile.filled(0.0),WindowPipeline.workspace_size(convolution,positions)),Buffer.remodeled(~Tile.Tile8,Tensors.buffer(~Tile.Tile8,Tile.filled(0.0),WindowPipeline.workspace_size(convolution,positions)))) :
    {WindowPipeline.packed_prepare(convolution,positions,WindowPipeline.PackedKept{Buffer.pack(~Tile.Tile8,weights),Buffer.pack(~Tile.Tile8,bias),Buffer.pack(~Tile.Tile16,planes),Buffer.pack(~Tile.Tile8,tiles)}) == WindowPipeline.PackedKept{Buffer.pack(~Tile.Tile8,weights),Buffer.pack(~Tile.Tile8,bias),Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),WindowPipeline.plane_size(convolution,positions)),_} : WindowPipeline.PackedKept}
  {==}

# The convolution of shared operands is the record of the problem.
def shared_convolution(~Logical: Data,~original: Logical -> U32 -> F32,+holder: WindowProblem<Logical,original>,+convolution: WindowPipeline.Convolution,+kept: KeptOperands,
  +shared: KeptShared(~Logical,~original,holder,convolution,kept)) -> {convolution == record_of(~Logical,~original,holder) : WindowPipeline.Convolution}:
  SharedOperands{+convolution_exact,+weights_exact,+bias_exact} = shared
  convolution_exact

# Shared operands with prepared workspaces are ready for the pieces of at
# most positions positions.
def prepared_on(~Logical: Data,~original: Logical -> U32 -> F32,+holder: WindowProblem<Logical,original>,+positions: U32,+kept: KeptOperands,
  +shared: KeptShared(~Logical,~original,holder,record_of(~Logical,~original,holder),kept)) ->
  KeptOk(~Logical,~original,holder,record_of(~Logical,~original,holder),positions,prepare_model(record_of(~Logical,~original,holder),positions,kept)):
  WindowProblem{+limits,+logical,+activation,+channels,+outputs,+height,+width,+kernel,+stride,+padding,+weight_list,+bias_list,+groups_out,+images,+input_outer,+input_after,+input_lanes,+input_groups,+outer_word,+after_word,+lanes_word,+groups_word,+upper,+upper_ok,+upper_bound,+area_positive,+area_room,+weight_evidence,+bias_evidence,+parameters,+valid,+supported,+word_positive,+plane_positive,+plane_exact,+plane_room,+outputs_room,+groups_exact_out,+after_exact,+lanes_exact,+elements_room,+groups_exact,+positive,+input_after_exact,+input_lanes_exact,+input_groups_exact,+groups_room,+images_count_room,+images_outputs_room,+cells_room} = holder
  KeptOperands{+weights,+bias,+planes,+tiles} = kept
  SharedOperands{+convolution_exact,+weights_exact,+bias_exact} = shared
  +tiles_sized = Ready.workspace_sized(limits,ImageProblems.problem(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,0n),valid,supported,WindowPipeline.call_positions(Calls.record(ImageProblems.problem(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,0n),groups_out,activation),positions))
  +pairs_sized = Ready.plane_sized(limits,ImageProblems.problem(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,0n),valid,supported,0,0,WindowPipeline.call_positions(Calls.record(ImageProblems.problem(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,0n),groups_out,activation),positions),
    call_grid(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,limits,valid,supported,groups_out,activation,positions))
  ReadyOperands{SharedOperands{convolution_exact,weights_exact,bias_exact},Tensors.depth_for(WindowPipeline.workspace_size(record_of(~Logical,~original,holder),positions)),Depth.allocation_depth(WindowPipeline.workspace_size(record_of(~Logical,~original,holder),positions),tiles_sized),
    fresh_balanced(~Tile.Tile8,Tile.filled(0.0),WindowPipeline.workspace_size(record_of(~Logical,~original,holder),positions)),Depth.allocation_room(WindowPipeline.workspace_size(record_of(~Logical,~original,holder),positions),tiles_sized),Tensors.depth_for(WindowPipeline.plane_size(record_of(~Logical,~original,holder),positions)),
    Depth.allocation_depth(WindowPipeline.plane_size(record_of(~Logical,~original,holder),positions),pairs_sized),fresh_balanced(~Tile.Tile16,Tile.filled_pair(0.0),WindowPipeline.plane_size(record_of(~Logical,~original,holder),positions)),Depth.allocation_room(WindowPipeline.plane_size(record_of(~Logical,~original,holder),positions),pairs_sized)}

def prepared(~Logical: Data,~original: Logical -> U32 -> F32,+holder: WindowProblem<Logical,original>,+convolution: WindowPipeline.Convolution,+positions: U32,+kept: KeptOperands,
  +shared: KeptShared(~Logical,~original,holder,convolution,kept)) ->
  KeptOk(~Logical,~original,holder,convolution,positions,prepare_model(convolution,positions,kept)):
  +same = shared_convolution(~Logical,~original,holder,convolution,kept,shared)
  {%Equal.sym(WindowPipeline.Convolution,convolution,record_of(~Logical,~original,holder),same) : KeptOk(~Logical,~original,holder,_,positions,prepare_model(_,positions,kept))
    prepared_on(~Logical,~original,holder,positions,kept,{%same : KeptShared(~Logical,~original,holder,_,kept) shared : KeptShared(~Logical,~original,holder,record_of(~Logical,~original,holder),kept)}) :
    KeptOk(~Logical,~original,holder,convolution,positions,prepare_model(convolution,positions,kept))}

# Sharing gives the left task copies of the weights and bias with the
# workspaces, and the right task copies with empty workspaces.
def split_observed(-weights: Buffer.Model<Tile.Tile8>,-bias: Buffer.Model<Tile.Tile8>,planes: Buffer.Model<Tile.Tile16>,tiles: Buffer.Model<Tile.Tile8>,
  weights_seen: CloneLaws.Observation<Tile.Tile8,Clone.clone(~Tile.Tile8,Buffer.pack(~Tile.Tile8,weights))>,bias_seen: CloneLaws.Observation<Tile.Tile8,Clone.clone(~Tile.Tile8,Buffer.pack(~Tile.Tile8,bias))>) -> PartitionLaws.Split<KeptOperands>:
  CloneLaws.Observation{left_weights,right_weights,weights_equation} = weights_seen
  CloneLaws.Observation{left_bias,right_bias,bias_equation} = bias_seen
  PartitionLaws.Split{KeptOperands{left_weights,left_bias,planes,tiles},
    KeptOperands{right_weights,right_bias,Buffer.remodel(~Tile.Tile16,Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),0)),Buffer.remodel(~Tile.Tile8,Tensors.buffer(~Tile.Tile8,Tile.filled(0.0),0))}}

def split_kept(kept: KeptOperands) -> PartitionLaws.Split<KeptOperands>:
  KeptOperands{weights,bias,planes,tiles} = kept
  split_observed(weights,bias,planes,tiles,CloneLaws.observe_pair(~Tile.Tile8,Clone.clone(~Tile.Tile8,Buffer.pack(~Tile.Tile8,weights))),CloneLaws.observe_pair(~Tile.Tile8,Clone.clone(~Tile.Tile8,Buffer.pack(~Tile.Tile8,bias))))

def shared_observed(+weights: Buffer.Model<Tile.Tile8>,+bias: Buffer.Model<Tile.Tile8>,+planes: Buffer.Model<Tile.Tile16>,+tiles: Buffer.Model<Tile.Tile8>,
  +weights_seen: CloneLaws.Observation<Tile.Tile8,Clone.clone(~Tile.Tile8,Buffer.pack(~Tile.Tile8,weights))>,+bias_seen: CloneLaws.Observation<Tile.Tile8,Clone.clone(~Tile.Tile8,Buffer.pack(~Tile.Tile8,bias))>) ->
  {WindowPipeline.packed_shared(Clone.clone(~Tile.Tile8,Buffer.pack(~Tile.Tile8,weights)),Clone.clone(~Tile.Tile8,Buffer.pack(~Tile.Tile8,bias)),Buffer.pack(~Tile.Tile16,planes),Buffer.pack(~Tile.Tile8,tiles)) ==
    (represent_kept(PartitionLaws.first(~KeptOperands,split_observed(weights,bias,planes,tiles,weights_seen,bias_seen))),
      represent_kept(PartitionLaws.second(~KeptOperands,split_observed(weights,bias,planes,tiles,weights_seen,bias_seen)))) : WindowPipeline.PackedKept & WindowPipeline.PackedKept}:
  CloneLaws.Observation{+left_weights,+right_weights,+weights_equation} = weights_seen
  CloneLaws.Observation{+left_bias,+right_bias,+bias_equation} = bias_seen
  %weights_equation : {WindowPipeline.packed_shared(_,Clone.clone(~Tile.Tile8,Buffer.pack(~Tile.Tile8,bias)),Buffer.pack(~Tile.Tile16,planes),Buffer.pack(~Tile.Tile8,tiles)) == ({WindowPipeline.PackedKept{Buffer.pack(~Tile.Tile8,left_weights),Buffer.pack(~Tile.Tile8,left_bias),Buffer.pack(~Tile.Tile16,planes),Buffer.pack(~Tile.Tile8,tiles)} : WindowPipeline.PackedKept},{WindowPipeline.PackedKept{Buffer.pack(~Tile.Tile8,right_weights),Buffer.pack(~Tile.Tile8,right_bias),Buffer.pack(~Tile.Tile16,Buffer.remodel(~Tile.Tile16,Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),0))),Buffer.pack(~Tile.Tile8,Buffer.remodel(~Tile.Tile8,Tensors.buffer(~Tile.Tile8,Tile.filled(0.0),0)))} : WindowPipeline.PackedKept}) : WindowPipeline.PackedKept & WindowPipeline.PackedKept}
  %bias_equation : {WindowPipeline.packed_shared((Buffer.pack(~Tile.Tile8,left_weights),Buffer.pack(~Tile.Tile8,right_weights)),_,Buffer.pack(~Tile.Tile16,planes),Buffer.pack(~Tile.Tile8,tiles)) == ({WindowPipeline.PackedKept{Buffer.pack(~Tile.Tile8,left_weights),Buffer.pack(~Tile.Tile8,left_bias),Buffer.pack(~Tile.Tile16,planes),Buffer.pack(~Tile.Tile8,tiles)} : WindowPipeline.PackedKept},{WindowPipeline.PackedKept{Buffer.pack(~Tile.Tile8,right_weights),Buffer.pack(~Tile.Tile8,right_bias),Buffer.pack(~Tile.Tile16,Buffer.remodel(~Tile.Tile16,Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),0))),Buffer.pack(~Tile.Tile8,Buffer.remodel(~Tile.Tile8,Tensors.buffer(~Tile.Tile8,Tile.filled(0.0),0)))} : WindowPipeline.PackedKept}) : WindowPipeline.PackedKept & WindowPipeline.PackedKept}
  %Equal.sym(Storage.Buffer<Tile.Tile16>,Buffer.pack(~Tile.Tile16,Buffer.remodel(~Tile.Tile16,Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),0))),Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),0),Buffer.remodeled(~Tile.Tile16,Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),0))) :
    {WindowPipeline.packed_shared((Buffer.pack(~Tile.Tile8,left_weights),Buffer.pack(~Tile.Tile8,right_weights)),(Buffer.pack(~Tile.Tile8,left_bias),Buffer.pack(~Tile.Tile8,right_bias)),Buffer.pack(~Tile.Tile16,planes),Buffer.pack(~Tile.Tile8,tiles)) == ({WindowPipeline.PackedKept{Buffer.pack(~Tile.Tile8,left_weights),Buffer.pack(~Tile.Tile8,left_bias),Buffer.pack(~Tile.Tile16,planes),Buffer.pack(~Tile.Tile8,tiles)} : WindowPipeline.PackedKept},WindowPipeline.PackedKept{Buffer.pack(~Tile.Tile8,right_weights),Buffer.pack(~Tile.Tile8,right_bias),_,Buffer.pack(~Tile.Tile8,Buffer.remodel(~Tile.Tile8,Tensors.buffer(~Tile.Tile8,Tile.filled(0.0),0)))}) : WindowPipeline.PackedKept & WindowPipeline.PackedKept}
  %Equal.sym(Storage.Buffer<Tile.Tile8>,Buffer.pack(~Tile.Tile8,Buffer.remodel(~Tile.Tile8,Tensors.buffer(~Tile.Tile8,Tile.filled(0.0),0))),Tensors.buffer(~Tile.Tile8,Tile.filled(0.0),0),Buffer.remodeled(~Tile.Tile8,Tensors.buffer(~Tile.Tile8,Tile.filled(0.0),0))) :
    {WindowPipeline.packed_shared((Buffer.pack(~Tile.Tile8,left_weights),Buffer.pack(~Tile.Tile8,right_weights)),(Buffer.pack(~Tile.Tile8,left_bias),Buffer.pack(~Tile.Tile8,right_bias)),Buffer.pack(~Tile.Tile16,planes),Buffer.pack(~Tile.Tile8,tiles)) == ({WindowPipeline.PackedKept{Buffer.pack(~Tile.Tile8,left_weights),Buffer.pack(~Tile.Tile8,left_bias),Buffer.pack(~Tile.Tile16,planes),Buffer.pack(~Tile.Tile8,tiles)} : WindowPipeline.PackedKept},WindowPipeline.PackedKept{Buffer.pack(~Tile.Tile8,right_weights),Buffer.pack(~Tile.Tile8,right_bias),Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),0),_}) : WindowPipeline.PackedKept & WindowPipeline.PackedKept}
  {==}

def share_same(+kept: KeptOperands) ->
  {WindowPipeline.packed_share(represent_kept(kept)) ==
    (represent_kept(PartitionLaws.first(~KeptOperands,split_kept(kept))),represent_kept(PartitionLaws.second(~KeptOperands,split_kept(kept)))) : WindowPipeline.PackedKept & WindowPipeline.PackedKept}:
  KeptOperands{+weights,+bias,+planes,+tiles} = kept
  shared_observed(weights,bias,planes,tiles,CloneLaws.observe_pair(~Tile.Tile8,Clone.clone(~Tile.Tile8,Buffer.pack(~Tile.Tile8,weights))),CloneLaws.observe_pair(~Tile.Tile8,Clone.clone(~Tile.Tile8,Buffer.pack(~Tile.Tile8,bias))))

# Each copy holds the cells of the weights and bias.
def split_shared_observed(~Logical: Data,~original: Logical -> U32 -> F32,+holder: WindowProblem<Logical,original>,+convolution: WindowPipeline.Convolution,+weights: Buffer.Model<Tile.Tile8>,+bias: Buffer.Model<Tile.Tile8>,
  +planes: Buffer.Model<Tile.Tile16>,+tiles: Buffer.Model<Tile.Tile8>,+shared: KeptShared(~Logical,~original,holder,convolution,KeptOperands{weights,bias,planes,tiles}),+weights_seen: CloneLaws.Observation<Tile.Tile8,Clone.clone(~Tile.Tile8,Buffer.pack(~Tile.Tile8,weights))>,+bias_seen: CloneLaws.Observation<Tile.Tile8,Clone.clone(~Tile.Tile8,Buffer.pack(~Tile.Tile8,bias))>) ->
  Held.Both<KeptShared(~Logical,~original,holder,convolution,PartitionLaws.first(~KeptOperands,split_observed(weights,bias,planes,tiles,weights_seen,bias_seen))),KeptShared(~Logical,~original,holder,convolution,PartitionLaws.second(~KeptOperands,split_observed(weights,bias,planes,tiles,weights_seen,bias_seen)))>:
  SharedOperands{+convolution_exact,+weights_exact,+bias_exact} = shared
  CloneLaws.Observation{+left_weights,+right_weights,+weights_equation} = weights_seen
  CloneLaws.Observation{+left_bias,+right_bias,+bias_equation} = bias_seen
  Held.Both{SharedOperands{convolution_exact,CloneLaws.copied_tree(~Tile.Tile8,weights,left_weights,CloneLaws.left_contents(~Tile.Tile8,weights,left_weights,right_weights,weights_equation),weight_cells_of(~Logical,~original,holder),weights_exact),CloneLaws.copied_tree(~Tile.Tile8,bias,left_bias,CloneLaws.left_contents(~Tile.Tile8,bias,left_bias,right_bias,bias_equation),bias_cells_of(~Logical,~original,holder),bias_exact)},SharedOperands{convolution_exact,CloneLaws.copied_tree(~Tile.Tile8,weights,right_weights,CloneLaws.right_contents(~Tile.Tile8,weights,left_weights,right_weights,weights_equation),weight_cells_of(~Logical,~original,holder),weights_exact),CloneLaws.copied_tree(~Tile.Tile8,bias,right_bias,CloneLaws.right_contents(~Tile.Tile8,bias,left_bias,right_bias,bias_equation),bias_cells_of(~Logical,~original,holder),bias_exact)}}

def split_shared(~Logical: Data,~original: Logical -> U32 -> F32,+holder: WindowProblem<Logical,original>,+convolution: WindowPipeline.Convolution,+kept: KeptOperands,+shared: KeptShared(~Logical,~original,holder,convolution,kept)) ->
  Held.Both<KeptShared(~Logical,~original,holder,convolution,PartitionLaws.first(~KeptOperands,split_kept(kept))),
    KeptShared(~Logical,~original,holder,convolution,PartitionLaws.second(~KeptOperands,split_kept(kept)))>:
  KeptOperands{+weights,+bias,+planes,+tiles} = kept
  split_shared_observed(~Logical,~original,holder,convolution,weights,bias,planes,tiles,shared,CloneLaws.observe_pair(~Tile.Tile8,Clone.clone(~Tile.Tile8,Buffer.pack(~Tile.Tile8,weights))),CloneLaws.observe_pair(~Tile.Tile8,Clone.clone(~Tile.Tile8,Buffer.pack(~Tile.Tile8,bias))))

# ---- The packed tasks ----

