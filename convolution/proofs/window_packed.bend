def Written(~Logical: Data,~original: Logical -> U32 -> F32,+holder: WindowProblem<Logical,original>,+start: U32,+tree: Tree.Tree<Tile.Tile8>,+cell: Nat) -> Data:
  WindowProblem{+limits,+logical,+activation,+channels,+outputs,+height,+width,+kernel,+stride,+padding,+weight_list,+bias_list,+groups_out,+images,+input_outer,+input_after,+input_lanes,+input_groups,+outer_word,+after_word,+lanes_word,+groups_word,+upper,+upper_ok,+upper_bound,+area_positive,+area_room,+weight_evidence,+bias_evidence,+parameters,+valid,+supported,+word_positive,+plane_positive,+plane_exact,+plane_room,+outputs_room,+groups_exact_out,+after_exact,+lanes_exact,+elements_room,+groups_exact,+positive,+input_after_exact,+input_lanes_exact,+input_groups_exact,+groups_room,+images_count_room,+images_outputs_room,+cells_room} = holder
  Calls.WrittenCell(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,tree,cell)

# ---- The kept operands and the work of a task ----

# The weights and bias a task reads and its plane and packing workspaces.
type KeptOperands is Data:
  KeptOperands{weights: Buffer.Model<Tile.Tile8>,bias: Buffer.Model<Tile.Tile8>,planes: Buffer.Model<Tile.Tile16>,tiles: Buffer.Model<Tile.Tile8>}

def kept_weights(model: KeptOperands) -> Buffer.Model<Tile.Tile8>:
  KeptOperands{weights,bias,planes,tiles} = model
  weights

def kept_bias(model: KeptOperands) -> Buffer.Model<Tile.Tile8>:
  KeptOperands{weights,bias,planes,tiles} = model
  bias

def kept_planes(model: KeptOperands) -> Buffer.Model<Tile.Tile16>:
  KeptOperands{weights,bias,planes,tiles} = model
  planes

def kept_tiles(model: KeptOperands) -> Buffer.Model<Tile.Tile8>:
  KeptOperands{weights,bias,planes,tiles} = model
  tiles

def represent_kept(model: KeptOperands) -> WindowPipeline.PackedKept:
  KeptOperands{weights,bias,planes,tiles} = model
  WindowPipeline.PackedKept{Buffer.pack(~Tile.Tile8,weights),Buffer.pack(~Tile.Tile8,bias),Buffer.pack(~Tile.Tile16,planes),Buffer.pack(~Tile.Tile8,tiles)}

# The operands a task shares: the convolution of its problem, the weights and
# the bias.
type SharedOperands<-Logical: Data,-original: Logical -> U32 -> F32,-holder: WindowProblem<Logical,original>,-convolution: WindowPipeline.Convolution,-kept: KeptOperands> is Data:
  SharedOperands{convolution_exact: {convolution == record_of(~Logical,~original,holder) : WindowPipeline.Convolution},
    weights_exact: {Buffer.tree(~Tile.Tile8,kept_weights(kept)) == weight_cells_of(~Logical,~original,holder) : Tree.Tree<Tile.Tile8>},
    bias_exact: {Buffer.tree(~Tile.Tile8,kept_bias(kept)) == bias_cells_of(~Logical,~original,holder) : Tree.Tree<Tile.Tile8>}}

# The operands a piece starts with: those it shares, and workspaces of room
# for every call of at most bound positions.
type ReadyOperands<-Logical: Data,-original: Logical -> U32 -> F32,-holder: WindowProblem<Logical,original>,-convolution: WindowPipeline.Convolution,-bound: U32,
  -kept: KeptOperands> is Data:
  ReadyOperands{shared: SharedOperands<Logical,original,holder,convolution,kept>,tile_depth: Nat,tile_depth_ok: {Nat.is_le(tile_depth,30n) == True{} : Bool},
    tiles_balanced: Shape.Balanced(Tile.Tile8,tile_depth,Buffer.tree(~Tile.Tile8,kept_tiles(kept))),
    tile_need: {Nat.is_le(U32.to_nat(Pipeline.workspace_tiles(8192,WindowPipeline.inner_of(convolution),WindowPipeline.call_positions(convolution,bound))),
      U32.to_nat(U32.shln(1,tile_depth))) == True{} : Bool},
    pair_depth: Nat,pair_depth_ok: {Nat.is_le(pair_depth,30n) == True{} : Bool},
    pairs_balanced: Shape.Balanced(Tile.Tile16,pair_depth,Buffer.tree(~Tile.Tile16,kept_planes(kept))),
    pair_need: {Nat.is_le(U32.to_nat(WindowPipeline.plane_size(convolution,bound)),U32.to_nat(U32.shln(1,pair_depth))) == True{} : Bool}}

# The work of a task between calls: the operands it reads, the output cells
# of the positions from start before position, room up to end, at most bound
# positions.
type PackedWorkHolds<-Logical: Data,-original: Logical -> U32 -> F32,-holder: WindowProblem<Logical,original>,-convolution: WindowPipeline.Convolution,-bound: U32,-start: U32,-end: U32,-position: U32,-work: Call.PackedModel> is Data:
  PackedWorkHolds{ready: ReadyOperands<Logical,original,holder,convolution,bound,KeptOperands{Call.packed_weights(work),Call.packed_bias(work),Call.packed_planes(work),
      Call.packed_tiles(work)}>,within: {Nat.is_le(U32.to_nat((end - start : U32)),U32.to_nat(bound)) == True{} : Bool},
    output_depth: Nat,output_depth_ok: {Nat.is_le(output_depth,30n) == True{} : Bool},
    output_need: {Nat.is_le(Nat.mul(Nat.sub(U32.to_nat(end),U32.to_nat(start)),blocks_of(~Logical,~original,holder)),U32.to_nat(U32.shln(1,output_depth))) == True{} : Bool},
    outputs_span: {Nat.is_le(Nat.mul(outputs_of(~Logical,~original,holder),Nat.sub(U32.to_nat(end),U32.to_nat(start))),capacity_of(~Logical,~original,holder)) == True{} : Bool},
    end_room: {Nat.is_le(U32.to_nat(end),capacity_of(~Logical,~original,holder)) == True{} : Bool},
    end_inside: {Nat.is_le(U32.to_nat(end),Nat.mul(images_of(~Logical,~original,holder),Skeleton.plane_nat(convolution))) == True{} : Bool},
    output_balanced: Shape.Balanced(Tile.Tile8,output_depth,Buffer.tree(~Tile.Tile8,Call.packed_output(work))),
