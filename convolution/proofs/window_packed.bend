# The input tensor of a problem: the pieces of a task hold its cells.
def input_of(~Logical: Data,~original: Logical -> U32 -> F32,holder: WindowProblem<Logical,original>) -> Representation.Lifted<Logical>:
  WindowProblem{+limits,+logical,+activation,+channels,+outputs,+height,+width,+kernel,+stride,+padding,+weight_list,+bias_list,+groups_out,+images,+input_outer,+input_after,+input_lanes,+input_groups,+outer_word,+after_word,+lanes_word,+groups_word,+upper,+upper_ok,+upper_bound,+area_positive,+area_room,+weight_evidence,+bias_evidence,+parameters,+valid,+supported,+word_positive,+plane_positive,+plane_exact,+plane_room,+outputs_room,+groups_exact_out,+after_exact,+lanes_exact,+elements_room,+groups_exact,+positive,+input_after_exact,+input_lanes_exact,+input_groups_exact,+groups_room,+images_count_room,+images_outputs_room,+cells_room} = holder
  Representation.Lifted{logical,TiledCells.Cells{input_outer,input_after,input_lanes,input_groups,Grid.Innermost{}}}

# The record of the convolution the problem runs.
def record_of(~Logical: Data,~original: Logical -> U32 -> F32,+holder: WindowProblem<Logical,original>) -> WindowPipeline.Convolution:
  WindowProblem{+limits,+logical,+activation,+channels,+outputs,+height,+width,+kernel,+stride,+padding,+weight_list,+bias_list,+groups_out,+images,+input_outer,+input_after,+input_lanes,+input_groups,+outer_word,+after_word,+lanes_word,+groups_word,+upper,+upper_ok,+upper_bound,+area_positive,+area_room,+weight_evidence,+bias_evidence,+parameters,+valid,+supported,+word_positive,+plane_positive,+plane_exact,+plane_room,+outputs_room,+groups_exact_out,+after_exact,+lanes_exact,+elements_room,+groups_exact,+positive,+input_after_exact,+input_lanes_exact,+input_groups_exact,+groups_room,+images_count_room,+images_outputs_room,+cells_room} = holder
  Calls.record(ImageProblems.problem(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,0n),groups_out,activation)

# The output values and output cells of a problem.
def logical_of(~Logical: Data,~original: Logical -> U32 -> F32,holder: WindowProblem<Logical,original>,convolution: WindowPipeline.Convolution) -> Representation.Lifted<ImageProblems.Context<Logical>>:
  WindowProblem{+limits,+logical,+activation,+channels,+outputs,+height,+width,+kernel,+stride,+padding,+weight_list,+bias_list,+groups_out,+images,+input_outer,+input_after,+input_lanes,+input_groups,+outer_word,+after_word,+lanes_word,+groups_word,+upper,+upper_ok,+upper_bound,+area_positive,+area_room,+weight_evidence,+bias_evidence,+parameters,+valid,+supported,+word_positive,+plane_positive,+plane_exact,+plane_room,+outputs_room,+groups_exact_out,+after_exact,+lanes_exact,+elements_room,+groups_exact,+positive,+input_after_exact,+input_lanes_exact,+input_groups_exact,+groups_room,+images_count_room,+images_outputs_room,+cells_room} = holder
  Representation.Lifted{ImageProblems.Context{logical,activation,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list},TiledCells.Cells{outer_word,after_word,lanes_word,groups_word,Grid.Innermost{}}}

def cells_of(~Logical: Data,~original: Logical -> U32 -> F32,holder: WindowProblem<Logical,original>,convolution: WindowPipeline.Convolution) -> Nat:
  WindowProblem{+limits,+logical,+activation,+channels,+outputs,+height,+width,+kernel,+stride,+padding,+weight_list,+bias_list,+groups_out,+images,+input_outer,+input_after,+input_lanes,+input_groups,+outer_word,+after_word,+lanes_word,+groups_word,+upper,+upper_ok,+upper_bound,+area_positive,+area_room,+weight_evidence,+bias_evidence,+parameters,+valid,+supported,+word_positive,+plane_positive,+plane_exact,+plane_room,+outputs_room,+groups_exact_out,+after_exact,+lanes_exact,+elements_room,+groups_exact,+positive,+input_after_exact,+input_lanes_exact,+input_groups_exact,+groups_room,+images_count_room,+images_outputs_room,+cells_room} = holder
  Nat.mul(Nat.mul(images,ImageProblems.plane(height,width,kernel,stride,padding)),Calls.cell_groups(outputs))

# The cells of the weights and bias every image reads, the output cells of a
# position and the cell a task writes.
def weight_cells_of(~Logical: Data,~original: Logical -> U32 -> F32,+holder: WindowProblem<Logical,original>) -> Tree.Tree<Tile.Tile8>:
  WindowProblem{+limits,+logical,+activation,+channels,+outputs,+height,+width,+kernel,+stride,+padding,+weight_list,+bias_list,+groups_out,+images,+input_outer,+input_after,+input_lanes,+input_groups,+outer_word,+after_word,+lanes_word,+groups_word,+upper,+upper_ok,+upper_bound,+area_positive,+area_room,+weight_evidence,+bias_evidence,+parameters,+valid,+supported,+word_positive,+plane_positive,+plane_exact,+plane_room,+outputs_room,+groups_exact_out,+after_exact,+lanes_exact,+elements_room,+groups_exact,+positive,+input_after_exact,+input_lanes_exact,+input_groups_exact,+groups_room,+images_count_room,+images_outputs_room,+cells_room} = holder
  Calls.weight_tree(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,0n,upper,upper_ok,upper_bound,area_positive,area_room,weight_evidence,bias_evidence,parameters)

def bias_cells_of(~Logical: Data,~original: Logical -> U32 -> F32,+holder: WindowProblem<Logical,original>) -> Tree.Tree<Tile.Tile8>:
  WindowProblem{+limits,+logical,+activation,+channels,+outputs,+height,+width,+kernel,+stride,+padding,+weight_list,+bias_list,+groups_out,+images,+input_outer,+input_after,+input_lanes,+input_groups,+outer_word,+after_word,+lanes_word,+groups_word,+upper,+upper_ok,+upper_bound,+area_positive,+area_room,+weight_evidence,+bias_evidence,+parameters,+valid,+supported,+word_positive,+plane_positive,+plane_exact,+plane_room,+outputs_room,+groups_exact_out,+after_exact,+lanes_exact,+elements_room,+groups_exact,+positive,+input_after_exact,+input_lanes_exact,+input_groups_exact,+groups_room,+images_count_room,+images_outputs_room,+cells_room} = holder
  Inputs.bias_cells(ImageProblems.problem(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,0n),Calls.image_contract(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,0n,upper,upper_ok,upper_bound,area_positive,area_room,weight_evidence,bias_evidence,parameters))

def outputs_of(~Logical: Data,~original: Logical -> U32 -> F32,+holder: WindowProblem<Logical,original>) -> Nat:
  WindowProblem{+limits,+logical,+activation,+channels,+outputs,+height,+width,+kernel,+stride,+padding,+weight_list,+bias_list,+groups_out,+images,+input_outer,+input_after,+input_lanes,+input_groups,+outer_word,+after_word,+lanes_word,+groups_word,+upper,+upper_ok,+upper_bound,+area_positive,+area_room,+weight_evidence,+bias_evidence,+parameters,+valid,+supported,+word_positive,+plane_positive,+plane_exact,+plane_room,+outputs_room,+groups_exact_out,+after_exact,+lanes_exact,+elements_room,+groups_exact,+positive,+input_after_exact,+input_lanes_exact,+input_groups_exact,+groups_room,+images_count_room,+images_outputs_room,+cells_room} = holder
