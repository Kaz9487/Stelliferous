# ---- A piece begins and ends ----

# The work a piece begins with: the kept operands and a fresh output.
def begin_model(convolution: WindowPipeline.Convolution,positions: U32,count: U32,kept: KeptOperands) -> Call.PackedModel:
  KeptOperands{weights,bias,planes,tiles} = kept
  Call.PackedModel{weights,bias,planes,tiles,Buffer.remodel(~Tile.Tile8,Tensors.buffer(~Tile.Tile8,Tile.filled(0.0),count))}

def begin_same(+convolution: WindowPipeline.Convolution,+first: U32,+count: U32,+kept: KeptOperands) ->
  {WindowPipeline.packed_begin(convolution,(((first + count) / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32) - (first / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32) : U32),count,represent_kept(kept)) == Call.represent(begin_model(convolution,(((first + count) / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32) - (first / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32) : U32),count,kept)) : WindowPipeline.PackedWork}:
  KeptOperands{+weights,+bias,+planes,+tiles} = kept
  Equal.cong(Storage.Buffer<Tile.Tile8>,WindowPipeline.PackedWork,
    buffer => WindowPipeline.PackedWork{Buffer.pack(~Tile.Tile8,weights),Buffer.pack(~Tile.Tile8,bias),Buffer.pack(~Tile.Tile16,planes),Buffer.pack(~Tile.Tile8,tiles),buffer},
    Tensors.buffer(~Tile.Tile8,Tile.filled(0.0),count),Buffer.pack(~Tile.Tile8,Buffer.remodel(~Tile.Tile8,Tensors.buffer(~Tile.Tile8,Tile.filled(0.0),count))),
    Equal.sym(Storage.Buffer<Tile.Tile8>,Buffer.pack(~Tile.Tile8,Buffer.remodel(~Tile.Tile8,Tensors.buffer(~Tile.Tile8,Tile.filled(0.0),count))),Tensors.buffer(~Tile.Tile8,Tile.filled(0.0),count),Buffer.remodeled(~Tile.Tile8,Tensors.buffer(~Tile.Tile8,Tile.filled(0.0),count))))

# The convolution of kept operands is the record of the problem.
def kept_convolution(~Logical: Data,~original: Logical -> U32 -> F32,+holder: WindowProblem<Logical,original>,+convolution: WindowPipeline.Convolution,+bound: U32,+kept: KeptOperands,
  +ok: KeptOk(~Logical,~original,holder,convolution,bound,kept)) -> {convolution == record_of(~Logical,~original,holder) : WindowPipeline.Convolution}:
  ReadyOperands{+shared,+tile_depth,+tile_depth_ok,+tiles_balanced,+tile_need,+pair_depth,+pair_depth_ok,+pairs_balanced,+pair_need} = ok
  SharedOperands{+convolution_exact,+weights_exact,+bias_exact} = shared
  convolution_exact

