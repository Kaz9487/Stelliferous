# What the reach of every task of a layout gives its pieces: the facts of
# their calls over the input cells up to the end of the reach.
def TasksReady(+limits: Machine.Limits,+convolution: WindowPipeline.Convolution,+grid: Grid.Grid,tasks: Pieces.Ranges) -> Data:
