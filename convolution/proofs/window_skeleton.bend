# ---- The calls of a task ----

# The calls from output position position to end: one image a call, from the
# position's place in its plane up to the plane's end or to end.
def local_word(+plane: U32,+position: U32) -> U32:
  (position % plane : U32)

def count_word(+plane: U32,+position: U32,+end: U32) -> U32:
  U32.min((plane - local_word(plane,position) : U32),(end - position : U32))

type Advance<-plane: U32,-position: U32,-end: U32,-start: U32> is Data:
  Advance{local_exact: {U32.to_nat(local_word(plane,position)) == Nat.mod(U32.to_nat(position),U32.to_nat(plane)) : Nat},
    image_exact: {U32.to_nat((position / plane : U32)) == Nat.div(U32.to_nat(position),U32.to_nat(plane)) : Nat},
    positive: {Nat.is_lt(0n,U32.to_nat(count_word(plane,position,end))) == True{} : Bool},
    grid: {Nat.is_le(Nat.add(U32.to_nat(local_word(plane,position)),U32.to_nat(count_word(plane,position,end))),U32.to_nat(plane)) == True{} : Bool},
    offset_exact: {U32.to_nat((position - start : U32)) == Nat.sub(U32.to_nat(position),U32.to_nat(start)) : Nat},
    next_exact: {U32.to_nat((position + count_word(plane,position,end) : U32)) == Nat.add(U32.to_nat(position),U32.to_nat(count_word(plane,position,end))) : Nat},
    next_le: {Nat.is_le(Nat.add(U32.to_nat(position),U32.to_nat(count_word(plane,position,end))),U32.to_nat(end)) == True{} : Bool}}

def advance(+limits: Machine.Limits,+plane: U32,+position: U32,+end: U32,+start: U32,+plane_positive: {Nat.is_lt(0n,U32.to_nat(plane)) == True{} : Bool},
  +plane_room: {Nat.is_le(U32.to_nat(plane),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},+end_room: {Nat.is_le(U32.to_nat(end),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},
  +after: {Nat.is_le(U32.to_nat(start),U32.to_nat(position)) == True{} : Bool},+before: {Nat.is_lt(U32.to_nat(position),U32.to_nat(end)) == True{} : Bool}) -> Advance<plane,position,end,start>:
  +cap = Machine.capacity(limits)
  +fits = Limits.capacity_fits(limits)
  +half = Machine.half_word(limits)
  +divisor = Limits.double_bound(limits,U32.to_nat(plane),plane_room)
  +local = local_word(plane,position)
  +count = count_word(plane,position,end)
  +at = U32.to_nat(position)
  +size = U32.to_nat(plane)
  +last = U32.to_nat(end)
  +rest = Nat.mod(at,size)
  +gap = Nat.sub(size,rest)
  +left = Nat.sub(last,at)
  +local_exact = U32Division.modulo(position,plane,half,Limits.half_word_fits(limits),divisor,plane_positive)
  +image_exact = U32Division.divide(position,plane,half,Limits.half_word_fits(limits),divisor,plane_positive)
  +small = DivisionOrder.remainder_small(at,size,plane_positive)
  +ordered = Bounds.strict_le(at,last,before)
  +position_room = Order.transitive(at,last,U32.to_nat(cap),ordered,end_room)
  +gap_exact = Arithmetic.difference_exact(cap,fits,plane,local,size,rest,{==},local_exact,Bounds.strict_le(rest,size,small),plane_room)
  +left_exact = Arithmetic.difference_exact(cap,fits,end,position,last,at,{==},{==},ordered,end_room)
  +count_exact = {%gap_exact : {U32.to_nat(count) == Nat.min(_,left) : Nat}
    %left_exact : {U32.to_nat(count) == Nat.min(U32.to_nat((plane - local : U32)),_) : Nat}
    Extrema.minimum((plane - local : U32),(end - position : U32)) : {U32.to_nat(count) == Nat.min(gap,left) : Nat}}
  +count_value = Equal.sym(Nat,U32.to_nat(count),Nat.min(gap,left),count_exact)
  +positive = {%count_value : {Nat.is_lt(0n,_) == True{} : Bool}
    NatExtrema.minimum_strict_lower(gap,left,0n,Order.positive_difference(size,rest,small),Order.positive_difference(last,at,before)) :
    {Nat.is_lt(0n,U32.to_nat(count)) == True{} : Bool}}
  +grid = {%Equal.sym(Nat,U32.to_nat(local),rest,local_exact) : {Nat.is_le(Nat.add(_,U32.to_nat(count)),size) == True{} : Bool}
    %count_value : {Nat.is_le(Nat.add(rest,_),size) == True{} : Bool}
    %Order.restore_shift(rest,size,Bounds.strict_le(rest,size,small)) : {Nat.is_le(Nat.add(rest,Nat.min(gap,left)),_) == True{} : Bool}
