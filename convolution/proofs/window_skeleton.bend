# A call lends the band of its rows from the pieces with the spare, runs the
# kernel on it and gives it back: the task holds pieces of the same cells, a
# spare with room, and the work moved past the call's positions.
# A cell of the band of a call holds the cell of the reader it was lent from.
def band_read(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,+holder: Holder,+holding: Held.Holding<Tile.Tile8>,+low: Nat,+high: Nat,+capacity: U32,
  +capacity_ok: {U32.is_le(capacity,2147483648) == True{} : Bool},+bounded: {Nat.is_le(high,U32.to_nat(capacity)) == True{} : Bool},
  +tiled: Held.Tiled(~Tile.Tile8,holding,low,high),+values: Held.HoldingValues(~Tile.Tile8,~Holder,~value,holder,holding),+first: U32,+cells: U32,
  +spare: Held.SpareModel<Tile.Tile8>,+spare_room: Held.SpareRoom(~Tile.Tile8,spare),+placed: BandSource.Placed<low,high,first,cells>,
  +allocatable: {U32.is_le(cells,1073741824) == True{} : Bool},+index: Nat,+less: {Nat.is_lt(index,U32.to_nat(cells)) == True{} : Bool}) ->
  BandRead(~Holder,~value,holder,Buffer.remodel(~Tile.Tile8,Held.band_buffer(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),first,cells,Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare)))),Held.band_offset(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),first,cells,Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare))),first,index):
  %Equal.sym(Tree.Tree<Tile.Tile8>,Buffer.tree(~Tile.Tile8,Buffer.remodel(~Tile.Tile8,Held.band_buffer(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),first,cells,Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare))))),Buffer.content_tree(~Tile.Tile8,Buffer.contents(~Tile.Tile8,Held.band_buffer(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),first,cells,Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare))))),
      band_tree(holding,first,cells,spare)) :
    {Tree.read(Tile.Tile8,_,U32.from_nat(Nat.add(U32.to_nat(Held.band_offset(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),first,cells,Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare)))),index))) == value(holder,U32.from_nat(Nat.add(U32.to_nat(first),index))) : Tile.Tile8}
