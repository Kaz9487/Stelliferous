# ---- The windowed output ----

# What the kernel's finished output gives: the values of the output pieces.
def Finishes(~Holder: Data,~Finished: @+holder: Holder -> @+convolution: WindowPipeline.Convolution -> @+first: U32 -> @+rows: U32 -> @+buffer: Buffer.Content<Tile.Tile8> -> Data,~Logical: Data,~original: Logical -> U32 -> Tile.Tile8,~logical_of: Holder -> WindowPipeline.Convolution -> Logical) -> Type:
  @+holder: Holder -> @+convolution: WindowPipeline.Convolution -> @+first: U32 -> @+rows: U32 -> @+buffer: Buffer.Content<Tile.Tile8> ->
    Finished(holder,convolution,first,rows,buffer) -> Placed.PieceHolds(~Tile.Tile8,~Logical,~original,logical_of(holder,convolution),first,rows,buffer)

def finished_content(~Holder: Data,~Finished: @+holder: Holder -> @+convolution: WindowPipeline.Convolution -> @+first: U32 -> @+rows: U32 -> @+buffer: Buffer.Content<Tile.Tile8> -> Data,~Logical: Data,~original: Logical -> U32 -> Tile.Tile8,~logical_of: Holder -> WindowPipeline.Convolution -> Logical,~finished: Finishes(~Holder,~Finished,~Logical,~original,~logical_of),+holder: Holder,+convolution: WindowPipeline.Convolution,content: PiecesModel.Content<Tile.Tile8>,
  +facts: PiecesModel.ContentAll(~Tile.Tile8,~Finished(holder,convolution),content)) ->
  PiecesModel.ContentAll(~Tile.Tile8,~Placed.PieceHolds(~Tile.Tile8,~Logical,~original,logical_of(holder,convolution)),content):
  match content:
    case PiecesModel.PieceContent{+buffer,+first,+rows}:
      finished(holder,convolution,first,rows,buffer,facts)
    case PiecesModel.Joined{+left,+right}:
      Gemm.Both{+left_facts,+right_facts} = facts
      Gemm.Both{finished_content(~Holder,~Finished,~Logical,~original,~logical_of,~finished,holder,convolution,left,left_facts),finished_content(~Holder,~Finished,~Logical,~original,~logical_of,~finished,holder,convolution,right,right_facts)}

# The output pieces of one task, as the clipped cells of its pieces, are its
# parts in order up to its end.
