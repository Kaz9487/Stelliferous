        {Pieces.Walking{Pieces.NoLefts{},(Held.pack(~Tile.Tile8,holding),WindowPipeline.Parameters{_,Held.pack_spare(~Tile.Tile8,spare)})} == Pieces.Walking{Pieces.NoLefts{},(Held.pack(~Tile.Tile8,holding),WindowPipeline.Parameters{represent_kept(prepare_model(convolution,WindowPipeline.task_positions(convolution,first,count),kept)),Held.pack_spare(~Tile.Tile8,spare)})} : Pieces.Walking<Storage.Buffer<Tile.Tile8>,WindowPipeline.Operands(~Kept)>}
