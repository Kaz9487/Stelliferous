# ---- What a kernel gives the skeleton ----

# A kernel run on a band model and a work model gives back the models after
# it.
def ComputeSame(~Work: Type,~WorkModel: Data,~represent: WorkModel -> Work,
  ~compute: @+convolution: WindowPipeline.Convolution -> @+call: WindowPipeline.Call -> Storage.Buffer<Tile.Tile8> -> Work -> Storage.Buffer<Tile.Tile8> & Work,
  ~band_after: WindowPipeline.Convolution -> WindowPipeline.Call -> Buffer.Model<Tile.Tile8> -> WorkModel -> Buffer.Model<Tile.Tile8>,
  ~work_after: WindowPipeline.Convolution -> WindowPipeline.Call -> Buffer.Model<Tile.Tile8> -> WorkModel -> WorkModel) -> Type:
  @+convolution: WindowPipeline.Convolution -> @+call: WindowPipeline.Call -> @+band: Buffer.Model<Tile.Tile8> -> @+work: WorkModel ->
    {compute(convolution,call,Buffer.pack(~Tile.Tile8,band),represent(work)) ==
      (Buffer.pack(~Tile.Tile8,band_after(convolution,call,band,work)),represent(work_after(convolution,call,band,work))) : Storage.Buffer<Tile.Tile8> & Work}

# A kernel gives the band back with the cells it was lent with.
def BandKept(~WorkModel: Data,~band_after: WindowPipeline.Convolution -> WindowPipeline.Call -> Buffer.Model<Tile.Tile8> -> WorkModel -> Buffer.Model<Tile.Tile8>) -> Type:
  @+convolution: WindowPipeline.Convolution -> @+call: WindowPipeline.Call -> @+band: Buffer.Model<Tile.Tile8> -> @+work: WorkModel ->
    {Buffer.content(~Tile.Tile8,band_after(convolution,call,band,work)) == Buffer.content(~Tile.Tile8,band) : Buffer.Content<Tile.Tile8>}

# The output positions of a plane a call computes: image image, from first on,
# count of them, the offset-th position of the task, which starts at start.
type CallAt<-plane: Nat,-start: U32,-end: U32,-position: U32,-image: U32,-first: U32,-count: U32,-offset: U32> is Data:
  CallAt{image_exact: {U32.to_nat(position) == Nat.add(Nat.mul(U32.to_nat(image),plane),U32.to_nat(first)) : Nat},
    offset_exact: {U32.to_nat(offset) == Nat.sub(U32.to_nat(position),U32.to_nat(start)) : Nat},
    after: {Nat.is_le(U32.to_nat(start),U32.to_nat(position)) == True{} : Bool},
    inside: {Nat.is_le(Nat.add(U32.to_nat(first),U32.to_nat(count)),plane) == True{} : Bool},
    positive: {Nat.is_lt(0n,U32.to_nat(count)) == True{} : Bool},
    before: {Nat.is_le(Nat.add(U32.to_nat(position),U32.to_nat(count)),U32.to_nat(end)) == True{} : Bool}}

def plane_nat(+convolution: WindowPipeline.Convolution) -> Nat:
  U32.to_nat(U32.max(WindowPipeline.plane_of(convolution),1))

# The input cells of the band of a call: the first and their count.
def band_row(band: KernelWindow.Band) -> U32:
  KernelWindow.Band{row_first,rows} = band
  row_first

def band_rows(band: KernelWindow.Band) -> U32:
  KernelWindow.Band{row_first,rows} = band
  rows

def call_first(+convolution: WindowPipeline.Convolution,+image: U32,+first: U32,+count: U32) -> U32:
  WindowPipeline.Convolution{+h,+w,k,s,p,oh,ow,channels,inner,+gi,go,activation} = convolution
  ((image * h + band_row(WindowPipeline.band_of(convolution,first,count))) * w * gi : U32)

def call_cells(+convolution: WindowPipeline.Convolution,+first: U32,+count: U32) -> U32:
  WindowPipeline.Convolution{h,+w,k,s,p,oh,ow,channels,inner,+gi,go,activation} = convolution
  (band_rows(WindowPipeline.band_of(convolution,first,count)) * w * gi : U32)

# Cell index of a band model from base on holds cell first + index of a
# reader.
def BandRead(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,+holder: Holder,+band: Buffer.Model<Tile.Tile8>,+base: U32,+first: U32,+index: Nat) -> Data:
  {Tree.read(Tile.Tile8,Buffer.tree(~Tile.Tile8,band),U32.from_nat(Nat.add(U32.to_nat(base),index))) == value(holder,U32.from_nat(Nat.add(U32.to_nat(first),index))) : Tile.Tile8}

# Every cell of a band of cells cells holds its cell of the reader.
def BandHolds(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,+holder: Holder,+band: Buffer.Model<Tile.Tile8>,+base: U32,+first: U32,+cells: U32) -> Data:
  Members.All(Nat,{index => BandRead(~Holder,~value,holder,band,base,first,index) : Nat -> Data},Ranges.range(U32.to_nat(cells),0n))

# The invariant of a kernel moves past the positions of a call that reads
# the rows of its band.
def Step(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,~WorkModel: Data,
  ~work_after: WindowPipeline.Convolution -> WindowPipeline.Call -> Buffer.Model<Tile.Tile8> -> WorkModel -> WorkModel,~Holds: Holder -> WindowPipeline.Convolution -> U32 -> U32 -> U32 -> U32 -> WorkModel -> Data) -> Type:
  @+holder: Holder -> @+convolution: WindowPipeline.Convolution -> @+bound: U32 -> @+image: U32 -> @+first: U32 -> @+count: U32 -> @+offset: U32 -> @+base: U32 -> @+band: Buffer.Model<Tile.Tile8> -> @+work: WorkModel -> @+start: U32 -> @+end: U32 -> @+position: U32 ->
    @+at: CallAt<plane_nat(convolution),start,end,position,image,first,count,offset> ->
    @+reads: BandHolds(~Holder,~value,holder,band,base,call_first(convolution,image,first,count),call_cells(convolution,first,count)) ->
    @+holds: Holds(holder,convolution,bound,start,end,position,work) ->
    Holds(holder,convolution,bound,start,end,(position + count : U32),work_after(convolution,WindowPipeline.Call{WindowPipeline.band_of(convolution,first,count),image,first,offset,count,base},band,work))

# ---- A task between calls ----

# The pieces a task holds cover low to high with the reader's cells, the
# spare has room and the work holds the kernel's invariant from start to
# position.
type Calls<-Holder: Data,-value: Holder -> U32 -> Tile.Tile8,-holder: Holder,-low: Nat,-high: Nat,-layout: Held.Spans,-Work: Type,-WorkModel: Data,
  -represent: WorkModel -> Work,-Holds: Holder -> WindowPipeline.Convolution -> U32 -> U32 -> U32 -> U32 -> WorkModel -> Data,-convolution: WindowPipeline.Convolution,-bound: U32,-start: U32,-end: U32,-position: U32,-state: WindowPipeline.Calling<Work>> is Data:
  Calls{holding: Held.Holding<Tile.Tile8>,tiled: Held.Tiled(~Tile.Tile8,holding,low,high),values: Held.HoldingValues(~Tile.Tile8,~Holder,~value,holder,holding),
    ordered: {Held.spans(~Tile.Tile8,Held.order(~Tile.Tile8,holding)) == layout : Held.Spans},
    spare: Held.SpareModel<Tile.Tile8>,spare_room: Held.SpareRoom(~Tile.Tile8,spare),work: WorkModel,holds: Holds(holder,convolution,bound,start,end,position,work),
    packed: {state == WindowPipeline.Calling{Held.pack(~Tile.Tile8,holding),Held.pack_spare(~Tile.Tile8,spare),represent(work)} : WindowPipeline.Calling<Work>}}

# ---- One call ----

def banded_eta(~Work: Type,~compute: @+convolution: WindowPipeline.Convolution -> @+call: WindowPipeline.Call -> Storage.Buffer<Tile.Tile8> -> Work -> Storage.Buffer<Tile.Tile8> & Work,
  +convolution: WindowPipeline.Convolution,+band: KernelWindow.Band,+image: U32,+first: U32,+offset: U32,+count: U32,banded: Move.Band<Tile.Tile8>,work: Work) ->
  {WindowPipeline.call_banded(~Work,~compute,convolution,band,image,first,offset,count,banded,work) ==
    WindowPipeline.called(~Work,Held.band_loan(~Tile.Tile8,banded),
      compute(convolution,WindowPipeline.Call{band,image,first,offset,count,Held.band_offset(~Tile.Tile8,banded)},Held.band_buffer(~Tile.Tile8,banded),work)) :
    WindowPipeline.Calling<Work>}:
  Move.Band{lent,input,base} = banded
  {==}

def calling_split(~Work: Type,returned: Move.Holding<Tile.Tile8> & Move.Spare<Tile.Tile8>,work: Work) ->
  {WindowPipeline.called_back(~Work,returned,work) ==
    WindowPipeline.Calling{Pair.fst(Move.Holding<Tile.Tile8>,Move.Spare<Tile.Tile8>,returned),Pair.snd(Move.Holding<Tile.Tile8>,Move.Spare<Tile.Tile8>,returned),work} :
    WindowPipeline.Calling<Work>}:
  (window,spare) = returned
  {==}

# The tree of the model of a band is the tree of its contents.
def band_tree(+holding: Held.Holding<Tile.Tile8>,+first: U32,+count: U32,+spare: Held.SpareModel<Tile.Tile8>) ->
  {Buffer.tree(~Tile.Tile8,Buffer.remodel(~Tile.Tile8,Held.band_buffer(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),first,count,Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare))))) == Buffer.content_tree(~Tile.Tile8,Buffer.contents(~Tile.Tile8,Held.band_buffer(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),first,count,Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare))))) : Tree.Tree<Tile.Tile8>}:
  +model = Buffer.remodel(~Tile.Tile8,Held.band_buffer(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),first,count,Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare))))
  Equal.trans(Tree.Tree<Tile.Tile8>,Buffer.tree(~Tile.Tile8,model),Buffer.content_tree(~Tile.Tile8,Buffer.content(~Tile.Tile8,model)),
    Buffer.content_tree(~Tile.Tile8,Buffer.contents(~Tile.Tile8,Held.band_buffer(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),first,count,Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare))))),
    Equal.sym(Tree.Tree<Tile.Tile8>,Buffer.content_tree(~Tile.Tile8,Buffer.content(~Tile.Tile8,model)),Buffer.tree(~Tile.Tile8,model),Buffer.content_tree_of(~Tile.Tile8,model)),
    Equal.cong(Buffer.Content<Tile.Tile8>,Tree.Tree<Tile.Tile8>,content => Buffer.content_tree(~Tile.Tile8,content),Buffer.content(~Tile.Tile8,model),
      Buffer.contents(~Tile.Tile8,Held.band_buffer(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),first,count,Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare)))),Buffer.remodel_content(~Tile.Tile8,Held.band_buffer(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),first,count,Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare))))))



# A call that gave the band back: the pieces it went back into, the spare
# and the work after the kernel.
def call_landed(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,~Work: Type,~WorkModel: Data,~represent: WorkModel -> Work,~compute: @+convolution: WindowPipeline.Convolution -> @+call: WindowPipeline.Call -> Storage.Buffer<Tile.Tile8> -> Work -> Storage.Buffer<Tile.Tile8> & Work,~band_after: WindowPipeline.Convolution -> WindowPipeline.Call -> Buffer.Model<Tile.Tile8> -> WorkModel -> Buffer.Model<Tile.Tile8>,~work_after: WindowPipeline.Convolution -> WindowPipeline.Call -> Buffer.Model<Tile.Tile8> -> WorkModel -> WorkModel,~Holds: Holder -> WindowPipeline.Convolution -> U32 -> U32 -> U32 -> U32 -> WorkModel -> Data,~cells_of: Holder -> WindowPipeline.Convolution -> Nat,
  ~compute_same: ComputeSame(~Work,~WorkModel,~represent,~compute,~band_after,~work_after),~band_kept: BandKept(~WorkModel,~band_after),
  ~step: Step(~Holder,~value,~WorkModel,~work_after,~Holds),+holder: Holder,+low: Nat,+high: Nat,+capacity: U32,
  +capacity_ok: {U32.is_le(capacity,2147483648) == True{} : Bool},+bounded: {Nat.is_le(high,U32.to_nat(capacity)) == True{} : Bool},+layout: Held.Spans,
  +convolution: WindowPipeline.Convolution,+bound: U32,+image: U32,+first: U32,+count: U32,+offset: U32,+start: U32,+end: U32,+position: U32,-state: WindowPipeline.Calling<Work>,
  +holding: Held.Holding<Tile.Tile8>,+spare: Held.SpareModel<Tile.Tile8>,+work: WorkModel,+packed: {state == WindowPipeline.Calling{Held.pack(~Tile.Tile8,holding),Held.pack_spare(~Tile.Tile8,spare),represent(work)} : WindowPipeline.Calling<Work>},+covered: Held.CoveredFact(~Tile.Tile8,~Holder,~value,holder,Move.returned_holding(~Tile.Tile8,Held.band_loan(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),call_first(convolution,image,first,count),call_cells(convolution,first,count),Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare))),Buffer.pack(~Tile.Tile8,band_after(convolution,WindowPipeline.Call{WindowPipeline.band_of(convolution,first,count),image,first,offset,count,Held.band_offset(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),call_first(convolution,image,first,count),call_cells(convolution,first,count),Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare)))},Buffer.remodel(~Tile.Tile8,Held.band_buffer(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),call_first(convolution,image,first,count),call_cells(convolution,first,count),Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare)))),work))),low,high,layout),
  +spare_room: Held.SpareRoom(~Tile.Tile8,Held.spare_after(~Tile.Tile8,holding,call_first(convolution,image,first,count),call_cells(convolution,first,count),spare,band_after(convolution,WindowPipeline.Call{WindowPipeline.band_of(convolution,first,count),image,first,offset,count,Held.band_offset(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),call_first(convolution,image,first,count),call_cells(convolution,first,count),Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare)))},Buffer.remodel(~Tile.Tile8,Held.band_buffer(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),call_first(convolution,image,first,count),call_cells(convolution,first,count),Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare)))),work))),+moved: Holds(holder,convolution,bound,start,end,(position + count : U32),work_after(convolution,WindowPipeline.Call{WindowPipeline.band_of(convolution,first,count),image,first,offset,count,Held.band_offset(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),call_first(convolution,image,first,count),call_cells(convolution,first,count),Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare)))},Buffer.remodel(~Tile.Tile8,Held.band_buffer(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),call_first(convolution,image,first,count),call_cells(convolution,first,count),Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare)))),work))) ->
  Calls<Holder,value,holder,low,high,layout,Work,WorkModel,represent,Holds,convolution,bound,start,end,(position + count : U32),WindowPipeline.call(~Work,~compute,convolution,image,first,count,offset,state)>:
  match convolution:
    case WindowPipeline.Convolution{+h,+w,+k,+s,+p,+oh,+ow,+channels,+inner,+gi,+go,+activation}:
      Held.Covered{+model,+model_packed,+model_tiled,+model_values,+model_ordered} = covered
      +packed_next = {%Equal.sym(WindowPipeline.Calling<Work>,state,WindowPipeline.Calling{Held.pack(~Tile.Tile8,holding),Held.pack_spare(~Tile.Tile8,spare),represent(work)},packed) : {WindowPipeline.call(~Work,~compute,convolution,image,first,count,offset,_) == WindowPipeline.Calling{Held.pack(~Tile.Tile8,model),Held.pack_spare(~Tile.Tile8,Held.spare_after(~Tile.Tile8,holding,call_first(convolution,image,first,count),call_cells(convolution,first,count),spare,band_after(convolution,WindowPipeline.Call{WindowPipeline.band_of(convolution,first,count),image,first,offset,count,Held.band_offset(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),call_first(convolution,image,first,count),call_cells(convolution,first,count),Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare)))},Buffer.remodel(~Tile.Tile8,Held.band_buffer(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),call_first(convolution,image,first,count),call_cells(convolution,first,count),Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare)))),work))),represent(work_after(convolution,WindowPipeline.Call{WindowPipeline.band_of(convolution,first,count),image,first,offset,count,Held.band_offset(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),call_first(convolution,image,first,count),call_cells(convolution,first,count),Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare)))},Buffer.remodel(~Tile.Tile8,Held.band_buffer(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),call_first(convolution,image,first,count),call_cells(convolution,first,count),Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare)))),work))} : WindowPipeline.Calling<Work>}
        %Equal.sym(WindowPipeline.Calling<Work>,WindowPipeline.call_banded(~Work,~compute,convolution,WindowPipeline.band_of(convolution,first,count),image,first,offset,count,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),call_first(convolution,image,first,count),call_cells(convolution,first,count),Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare)),represent(work)),
            WindowPipeline.called(~Work,Held.band_loan(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),call_first(convolution,image,first,count),call_cells(convolution,first,count),Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare))),compute(convolution,WindowPipeline.Call{WindowPipeline.band_of(convolution,first,count),image,first,offset,count,Held.band_offset(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),call_first(convolution,image,first,count),call_cells(convolution,first,count),Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare)))},Held.band_buffer(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),call_first(convolution,image,first,count),call_cells(convolution,first,count),Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare))),represent(work))),
