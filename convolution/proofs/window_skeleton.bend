# ---- The tasks ----

# Facts over the input cells up to high hold up to any later cell.
def placed_wider(+low: Nat,+high: Nat,+wider: Nat,+first: U32,+count: U32,+widened: {Nat.is_le(high,wider) == True{} : Bool},+placed: BandSource.Placed<low,high,first,count>) ->
  BandSource.Placed<low,wider,first,count>:
  match placed:
    case BandSource.EmptyBand{+empty}: BandSource.EmptyBand{empty}
    case BandSource.HeldBand{+after,+fits}: BandSource.HeldBand{after,Order.transitive(Nat.add(U32.to_nat(first),U32.to_nat(count)),high,wider,fits,widened)}

def call_wider(+low: Nat,+high: Nat,+wider: Nat,+convolution: WindowPipeline.Convolution,+position: U32,+end: U32,+widened: {Nat.is_le(high,wider) == True{} : Bool},
  +fact: CallFact<low,high,convolution,position,end>) -> CallFact<low,wider,convolution,position,end>:
  CallFact{+before,+placed,+allocatable} = fact
  CallFact{before,placed_wider(low,high,wider,call_first(convolution,(position / U32.max(WindowPipeline.plane_of(convolution),1) : U32),local_word(U32.max(WindowPipeline.plane_of(convolution),1),position),count_word(U32.max(WindowPipeline.plane_of(convolution),1),position,end)),call_cells(convolution,local_word(U32.max(WindowPipeline.plane_of(convolution),1),position),count_word(U32.max(WindowPipeline.plane_of(convolution),1),position,end)),widened,placed),allocatable}

def calls_wider(remaining: Nat,+low: Nat,+high: Nat,+wider: Nat,+convolution: WindowPipeline.Convolution,+position: U32,+end: U32,+widened: {Nat.is_le(high,wider) == True{} : Bool},
  +facts: CallFacts(remaining,low,high,convolution,position,end)) -> CallFacts(remaining,low,wider,convolution,position,end):
  match remaining:
    case 0n: facts
    case 1n+rest:
      Held.Both{+fact,+others} = facts
      Held.Both{call_wider(low,high,wider,convolution,position,end,widened,fact),calls_wider(rest,low,high,wider,convolution,(position + count_word(U32.max(WindowPipeline.plane_of(convolution),1),position,end) : U32),end,widened,others)}

def piece_wider(+low: Nat,+high: Nat,+wider: Nat,+limits: Machine.Limits,+convolution: WindowPipeline.Convolution,+bound: U32,+first: U32,+count: U32,+cells: Nat,+widened: {Nat.is_le(high,wider) == True{} : Bool},
  +fact: PieceFact(low,high,limits,convolution,bound,first,count,cells)) -> PieceFact(low,wider,limits,convolution,bound,first,count,cells):
  Held.Both{+bounds,+calls} = fact
  Held.Both{bounds,calls_wider(U32.to_nat(WindowPipeline.images_between(U32.max(WindowPipeline.plane_of(convolution),1),(first / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32),((first + count) / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32))),low,high,wider,convolution,(first / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32),((first + count) / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32),widened,calls)}

def pieces_wider(remaining: Nat,+low: Nat,+high: Nat,+wider: Nat,+limits: Machine.Limits,+convolution: WindowPipeline.Convolution,+grid: Grid.Grid,+piece: U32,+from: U32,+to: U32,
  +first: U32,+count: U32,+widened: {Nat.is_le(high,wider) == True{} : Bool},+facts: PieceFacts(remaining,low,high,limits,convolution,grid,piece,from,to,first,count)) ->
  PieceFacts(remaining,low,wider,limits,convolution,grid,piece,from,to,first,count):
  match remaining:
