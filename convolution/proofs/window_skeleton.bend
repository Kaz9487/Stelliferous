  +holds: TaskHolds(~Holder,~Finished,TaskScope{holder,WindowPipeline.Windowed{convolution,Grid.Grid{grid_count,grid_prefix,grid_outer,grid_extent,grid_unit,grid_block,grid_per,(grid_outer * grid_per : U32)}}},first,span,result)) -> Held.Both<PlacedParts.TasksParts(~Tile.Tile8,~Logical,~original,logical_of(holder,convolution),Pieces.ranges_of_grid(Grid.Grid{grid_count,grid_prefix,grid_outer,grid_extent,grid_unit,grid_block,grid_per,(grid_outer * grid_per : U32)}),U32.to_nat(first),result),{PlacedParts.tasks_end(~Tile.Tile8,result,U32.to_nat(first)) == Nat.add(U32.to_nat(first),U32.to_nat(span)) : Nat}>:
