# ---- A task walks its pieces ----

# What every output piece of a task needs: room for its end and the facts of
# its calls.
# The output positions a task of the cells [from, to) prepares for.
def task_bound(+convolution: WindowPipeline.Convolution,+from: U32,+to: U32) -> U32:
  ((to / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32) - (from / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32) : U32)

def PieceFact(+low: Nat,+high: Nat,+limits: Machine.Limits,+convolution: WindowPipeline.Convolution,+bound: U32,+first: U32,+count: U32,+cells: Nat) -> Data:
  Held.Both<Held.Both<Held.Both<{Nat.is_le(U32.to_nat(((first + count) / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32)),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},Runs.Fits<U32.to_nat(U32.max(WindowPipeline.output_groups_of(convolution),1)),U32.to_nat(first),Nat.add(U32.to_nat(first),U32.to_nat(count)),cells>>,{Nat.is_le(U32.to_nat((((first + count) / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32) - (first / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32) : U32)),U32.to_nat(bound)) == True{} : Bool}>,CallFacts(U32.to_nat(WindowPipeline.images_between(U32.max(WindowPipeline.plane_of(convolution),1),(first / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32),((first + count) / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32))),low,high,convolution,(first / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32),((first + count) / U32.max(WindowPipeline.output_groups_of(convolution),1) : U32))>

def PieceFacts(remaining: Nat,+low: Nat,+high: Nat,+limits: Machine.Limits,+convolution: WindowPipeline.Convolution,+grid: Grid.Grid,+piece: U32,+from: U32,+to: U32,
  +first: U32,+count: U32) -> Data:
  match remaining:
    case 0n: PieceFact(low,high,limits,convolution,task_bound(convolution,from,to),first,count,U32.to_nat(Grid.count_of(grid)))
    case 1n+rest: Held.Both<PieceFact(low,high,limits,convolution,task_bound(convolution,from,to),first,count,U32.to_nat(Grid.count_of(grid))),PieceFacts(rest,low,high,limits,convolution,grid,(piece + 1 : U32),from,to,WindowPipeline.clipped_first(grid,(piece + 1 : U32),from),WindowPipeline.clipped_count(grid,(piece + 1 : U32),from,to))>

# The pieces of a task from piece on: each holds its output, and the walk
# gives back the lefts it was given.
def task_walk(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,~Work: Type,~WorkModel: Data,~represent: WorkModel -> Work,~compute: @+convolution: WindowPipeline.Convolution -> @+call: WindowPipeline.Call -> Storage.Buffer<Tile.Tile8> -> Work -> Storage.Buffer<Tile.Tile8> & Work,~band_after: WindowPipeline.Convolution -> WindowPipeline.Call -> Buffer.Model<Tile.Tile8> -> WorkModel -> Buffer.Model<Tile.Tile8>,~work_after: WindowPipeline.Convolution -> WindowPipeline.Call -> Buffer.Model<Tile.Tile8> -> WorkModel -> WorkModel,~Holds: Holder -> WindowPipeline.Convolution -> U32 -> U32 -> U32 -> U32 -> WorkModel -> Data,~cells_of: Holder -> WindowPipeline.Convolution -> Nat,
  ~compute_same: ComputeSame(~Work,~WorkModel,~represent,~compute,~band_after,~work_after),~band_kept: BandKept(~WorkModel,~band_after),
  ~step: Step(~Holder,~value,~WorkModel,~work_after,~Holds),~Kept: Type,~KeptModel: Data,~represent_kept: KeptModel -> Kept,~KeptOk: Holder -> WindowPipeline.Convolution -> U32 -> KeptModel -> Data,~Finished: @+holder: Holder -> @+convolution: WindowPipeline.Convolution -> @+first: U32 -> @+rows: U32 -> @+buffer: Buffer.Content<Tile.Tile8> -> Data,
  ~begin: @+convolution: WindowPipeline.Convolution -> @+positions: U32 -> @+count: U32 -> Kept -> Work,~begin_model: WindowPipeline.Convolution -> U32 -> U32 -> KeptModel -> WorkModel,
  ~finish: @+convolution: WindowPipeline.Convolution -> @+positions: U32 -> Work -> Storage.Buffer<Tile.Tile8> & Kept,~finish_output: WindowPipeline.Convolution -> U32 -> WorkModel -> Buffer.Model<Tile.Tile8>,
  ~finish_kept: WindowPipeline.Convolution -> U32 -> WorkModel -> KeptModel,
  ~begin_same: BeginSame(~Work,~WorkModel,~represent,~Kept,~KeptModel,~represent_kept,~begin,~begin_model),
  ~started: Started(~Holder,~WorkModel,~Holds,~cells_of,~KeptModel,~KeptOk,~begin_model),
  ~finish_same: FinishSame(~Work,~WorkModel,~represent,~Kept,~KeptModel,~represent_kept,~finish,~finish_output,~finish_kept),
  ~ended: Ended(~Holder,~WorkModel,~Holds,~cells_of,~KeptModel,~KeptOk,~Finished,~finish_output,~finish_kept),remaining: Nat,+holder: Holder,+low: Nat,+high: Nat,+capacity: U32,
  +capacity_ok: {U32.is_le(capacity,2147483648) == True{} : Bool},+bounded: {Nat.is_le(high,U32.to_nat(capacity)) == True{} : Bool},+layout: Held.Spans,
  +limits: Machine.Limits,+convolution: WindowPipeline.Convolution,+grid: Grid.Grid,+piece: U32,+from: U32,+to: U32,+first: U32,+count: U32,
  -lefts: Pieces.Lefts<Storage.Buffer<Tile.Tile8>>,-ready: Pieces.Walking<Storage.Buffer<Tile.Tile8>,WindowPipeline.Operands(~Kept)>,
  +holding: Held.Holding<Tile.Tile8>,+tiled: Held.Tiled(~Tile.Tile8,holding,low,high),+values: Held.HoldingValues(~Tile.Tile8,~Holder,~value,holder,holding),
