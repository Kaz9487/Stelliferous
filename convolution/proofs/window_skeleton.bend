def band_reads(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,+holder: Holder,+holding: Held.Holding<Tile.Tile8>,+low: Nat,+high: Nat,+capacity: U32,
  +capacity_ok: {U32.is_le(capacity,2147483648) == True{} : Bool},+bounded: {Nat.is_le(high,U32.to_nat(capacity)) == True{} : Bool},
  +tiled: Held.Tiled(~Tile.Tile8,holding,low,high),+values: Held.HoldingValues(~Tile.Tile8,~Holder,~value,holder,holding),+first: U32,+cells: U32,
  +spare: Held.SpareModel<Tile.Tile8>,+spare_room: Held.SpareRoom(~Tile.Tile8,spare),+placed: BandSource.Placed<low,high,first,cells>,
  +allocatable: {U32.is_le(cells,1073741824) == True{} : Bool},remaining: Nat,+position: Nat,+room: {Nat.is_le(Nat.add(position,remaining),U32.to_nat(cells)) == True{} : Bool}) ->
  Members.All(Nat,{index => BandRead(~Holder,~value,holder,Buffer.remodel(~Tile.Tile8,Held.band_buffer(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),first,cells,Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare)))),Held.band_offset(~Tile.Tile8,Move.band(~Tile.Tile8,Held.pack(~Tile.Tile8,holding),first,cells,Tile.filled(0.0),Held.pack_spare(~Tile.Tile8,spare))),first,index) : Nat -> Data},Ranges.range(remaining,position)):
  match remaining:
    case 0n: Unit{}
    case 1n+ +rest:
      Gemm.Both{band_read(~Holder,~value,holder,holding,low,high,capacity,capacity_ok,bounded,tiled,values,first,cells,spare,spare_room,placed,allocatable,position,Order.room_index(position,rest,U32.to_nat(cells),room)),
