# ---- A task ----

# What a kernel's prepare gives: the kept operands of a task from those it
# shares, and the kept operands a piece needs from those it shares.
def PrepareSame(~Kept: Type,~KeptModel: Data,~represent_kept: KeptModel -> Kept,~prepare: @+convolution: WindowPipeline.Convolution -> @+positions: U32 -> Kept -> Kept,
  ~prepare_model: WindowPipeline.Convolution -> U32 -> KeptModel -> KeptModel) -> Type:
  @+convolution: WindowPipeline.Convolution -> @+positions: U32 -> @+kept: KeptModel ->
    {prepare(convolution,positions,represent_kept(kept)) == represent_kept(prepare_model(convolution,positions,kept)) : Kept}

def Prepared(~Holder: Data,~KeptModel: Data,~KeptOk: Holder -> WindowPipeline.Convolution -> U32 -> KeptModel -> Data,~KeptShared: Holder -> WindowPipeline.Convolution -> KeptModel -> Data,~prepare_model: WindowPipeline.Convolution -> U32 -> KeptModel -> KeptModel) -> Type:
  @+holder: Holder -> @+convolution: WindowPipeline.Convolution -> @+positions: U32 -> @+kept: KeptModel -> @+shared: KeptShared(holder,convolution,kept) ->
    KeptOk(holder,convolution,positions,prepare_model(convolution,positions,kept))

# What a kernel's share gives: two kept operands, each one the tasks can share.
def ShareSame(~Kept: Type,~KeptModel: Data,~represent_kept: KeptModel -> Kept,~share: Kept -> Kept & Kept,~split_kept: KeptModel -> PartitionLaws.Split<KeptModel>) -> Type:
  @+kept: KeptModel -> {share(represent_kept(kept)) ==
    (represent_kept(PartitionLaws.first(~KeptModel,split_kept(kept))),represent_kept(PartitionLaws.second(~KeptModel,split_kept(kept)))) : Kept & Kept}

def SplitShared(~Holder: Data,~KeptModel: Data,~KeptShared: Holder -> WindowPipeline.Convolution -> KeptModel -> Data,~split_kept: KeptModel -> PartitionLaws.Split<KeptModel>) -> Type:
  @+holder: Holder -> @+convolution: WindowPipeline.Convolution -> @+kept: KeptModel -> @+shared: KeptShared(holder,convolution,kept) ->
    Held.Both<KeptShared(holder,convolution,PartitionLaws.first(~KeptModel,split_kept(kept))),KeptShared(holder,convolution,PartitionLaws.second(~KeptModel,split_kept(kept)))>

# The parameters a task holds: its kept operands and its spare.
type Resource<-KeptModel: Data> is Data:
  Resource{kept: KeptModel,spare: Held.SpareModel<Tile.Tile8>}

def pack_resource(~Kept: Type,~KeptModel: Data,~represent_kept: KeptModel -> Kept,resource: Resource<KeptModel>) -> WindowPipeline.Parameters<Kept>:
  Resource{kept,spare} = resource
  WindowPipeline.Parameters{represent_kept(kept),Held.pack_spare(~Tile.Tile8,spare)}

# A split keeps the spare on the left and gives the right a fresh one.
def split_resource(~KeptModel: Data,~split_kept: KeptModel -> PartitionLaws.Split<KeptModel>,resource: Resource<KeptModel>) -> PartitionLaws.Split<Resource<KeptModel>>:
  Resource{+kept,spare} = resource
  PartitionLaws.Split{Resource{PartitionLaws.first(~KeptModel,split_kept(kept)),spare},
    Resource{PartitionLaws.second(~KeptModel,split_kept(kept)),Held.fresh_spare(~Tile.Tile8,Tile.filled(0.0))}}

def ResourceOk(~Holder: Data,~KeptModel: Data,~KeptShared: Holder -> WindowPipeline.Convolution -> KeptModel -> Data,+holder: Holder,+convolution: WindowPipeline.Convolution,resource: Resource<KeptModel>) -> Data:
  match resource:
    case Resource{+kept,+spare}: Held.Both<KeptShared(holder,convolution,kept),Held.SpareRoom(~Tile.Tile8,spare)>

def shared_same(~Kept: Type,~KeptModel: Data,~represent_kept: KeptModel -> Kept,~share: Kept -> Kept & Kept,~split_kept: KeptModel -> PartitionLaws.Split<KeptModel>,~share_same: ShareSame(~Kept,~KeptModel,~represent_kept,~share,~split_kept),
  +resource: Resource<KeptModel>) ->
  {WindowPipeline.shared(~Kept,~share,pack_resource(~Kept,~KeptModel,~represent_kept)(resource)) == (pack_resource(~Kept,~KeptModel,~represent_kept)(PartitionLaws.first(~Resource<KeptModel>,split_resource(~KeptModel,~split_kept)(resource))),
    pack_resource(~Kept,~KeptModel,~represent_kept)(PartitionLaws.second(~Resource<KeptModel>,split_resource(~KeptModel,~split_kept)(resource)))) : WindowPipeline.Parameters<Kept> & WindowPipeline.Parameters<Kept>}:
  match resource:
    case Resource{+kept,+spare}:
      %Equal.sym(Kept & Kept,share(represent_kept(kept)),(represent_kept(PartitionLaws.first(~KeptModel,split_kept(kept))),represent_kept(PartitionLaws.second(~KeptModel,split_kept(kept)))),
          share_same(kept)) :
        {WindowPipeline.split_parameters(~Kept,Held.pack_spare(~Tile.Tile8,spare),_) ==
          (WindowPipeline.Parameters{represent_kept(PartitionLaws.first(~KeptModel,split_kept(kept))),Held.pack_spare(~Tile.Tile8,spare)},
            WindowPipeline.Parameters{represent_kept(PartitionLaws.second(~KeptModel,split_kept(kept))),Held.pack_spare(~Tile.Tile8,Held.fresh_spare(~Tile.Tile8,Tile.filled(0.0)))}) : WindowPipeline.Parameters<Kept> & WindowPipeline.Parameters<Kept>}
      %Held.spare_packed(~Tile.Tile8,Tile.filled(0.0)) :
        {(WindowPipeline.Parameters{represent_kept(PartitionLaws.first(~KeptModel,split_kept(kept))),Held.pack_spare(~Tile.Tile8,spare)},
            WindowPipeline.Parameters{represent_kept(PartitionLaws.second(~KeptModel,split_kept(kept))),Move.spare(~Tile.Tile8,Tile.filled(0.0))}) ==
          (WindowPipeline.Parameters{represent_kept(PartitionLaws.first(~KeptModel,split_kept(kept))),Held.pack_spare(~Tile.Tile8,spare)},
            WindowPipeline.Parameters{represent_kept(PartitionLaws.second(~KeptModel,split_kept(kept))),_}) : WindowPipeline.Parameters<Kept> & WindowPipeline.Parameters<Kept>}
      {==}

def split_ok(~Holder: Data,~KeptModel: Data,~KeptShared: Holder -> WindowPipeline.Convolution -> KeptModel -> Data,~split_kept: KeptModel -> PartitionLaws.Split<KeptModel>,~split_shared: SplitShared(~Holder,~KeptModel,~KeptShared,~split_kept),
  +holder: Holder,+convolution: WindowPipeline.Convolution,+resource: Resource<KeptModel>,+ok: ResourceOk(~Holder,~KeptModel,~KeptShared,holder,convolution,resource)) ->
  Held.Both<ResourceOk(~Holder,~KeptModel,~KeptShared,holder,convolution,PartitionLaws.first(~Resource<KeptModel>,split_resource(~KeptModel,~split_kept)(resource))),
    ResourceOk(~Holder,~KeptModel,~KeptShared,holder,convolution,PartitionLaws.second(~Resource<KeptModel>,split_resource(~KeptModel,~split_kept)(resource)))>:
  match resource:
    case Resource{+kept,+spare}:
      Held.Both{+shared,+room} = ok
      Held.Both{Held.Both{Held.first_of(KeptShared(holder,convolution,PartitionLaws.first(~KeptModel,split_kept(kept))),KeptShared(holder,convolution,PartitionLaws.second(~KeptModel,split_kept(kept))),split_shared(holder,convolution,kept,shared)),room},
        Held.Both{Held.second_of(KeptShared(holder,convolution,PartitionLaws.first(~KeptModel,split_kept(kept))),KeptShared(holder,convolution,PartitionLaws.second(~KeptModel,split_kept(kept))),split_shared(holder,convolution,kept,shared)),Held.fresh_spare_room(~Tile.Tile8,Tile.filled(0.0))}}

# What every task's property reads: the holder of the input values and the
# task context.
type TaskScope<-Holder: Data> is Data:
  TaskScope{holder: Holder,context: WindowPipeline.Windowed}

# What a task gives: the output pieces it walked, laid as the clipped cells
# of its pieces, each holding its output.
def TaskHolds(~Holder: Data,~Finished: @+holder: Holder -> @+convolution: WindowPipeline.Convolution -> @+first: U32 -> @+rows: U32 -> @+buffer: Buffer.Content<Tile.Tile8> -> Data,+scope: TaskScope<Holder>,+first: U32,+count: U32,
  +result: Partition.Tree<&2,PiecesModel.Model<Tile.Tile8>,Unit>) -> Data:
  match scope:
    case TaskScope{+holder,+context}:
      match context:
        case WindowPipeline.Windowed{+convolution,+grid}:
          match result:
            case Partition.Leaf{+tree,+offset,+span,+details}:
              Held.Both<{PiecesModel.layout(~Tile.Tile8,tree) == Clipped.clipped_layout(Grid.later_pieces(grid,first,count),grid,Grid.piece_of(grid,first),first,(first + count : U32),WindowPipeline.clipped_first(grid,Grid.piece_of(grid,first),first),WindowPipeline.clipped_count(grid,Grid.piece_of(grid,first),first,(first + count : U32))) : Pieces.Ranges},
                PiecesModel.ContentAll(~Tile.Tile8,~Finished(holder,convolution),PiecesModel.content(~Tile.Tile8,tree))>
            case Partition.Fork{+left,+right}: Empty

# One task: from the input pieces it holds and its parameters, its output
# pieces hold their outputs.
def task_fact(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,~Work: Type,~WorkModel: Data,~represent: WorkModel -> Work,~compute: @+convolution: WindowPipeline.Convolution -> @+call: WindowPipeline.Call -> Storage.Buffer<Tile.Tile8> -> Work -> Storage.Buffer<Tile.Tile8> & Work,~band_after: WindowPipeline.Convolution -> WindowPipeline.Call -> Buffer.Model<Tile.Tile8> -> WorkModel -> Buffer.Model<Tile.Tile8>,~work_after: WindowPipeline.Convolution -> WindowPipeline.Call -> Buffer.Model<Tile.Tile8> -> WorkModel -> WorkModel,~Holds: Holder -> WindowPipeline.Convolution -> U32 -> U32 -> U32 -> U32 -> WorkModel -> Data,~cells_of: Holder -> WindowPipeline.Convolution -> Nat,
  ~compute_same: ComputeSame(~Work,~WorkModel,~represent,~compute,~band_after,~work_after),~band_kept: BandKept(~WorkModel,~band_after),
  ~step: Step(~Holder,~value,~WorkModel,~work_after,~Holds),~Kept: Type,~KeptModel: Data,~represent_kept: KeptModel -> Kept,~KeptOk: Holder -> WindowPipeline.Convolution -> U32 -> KeptModel -> Data,~Finished: @+holder: Holder -> @+convolution: WindowPipeline.Convolution -> @+first: U32 -> @+rows: U32 -> @+buffer: Buffer.Content<Tile.Tile8> -> Data,
  ~begin: @+convolution: WindowPipeline.Convolution -> @+positions: U32 -> @+count: U32 -> Kept -> Work,~begin_model: WindowPipeline.Convolution -> U32 -> U32 -> KeptModel -> WorkModel,
  ~finish: @+convolution: WindowPipeline.Convolution -> @+positions: U32 -> Work -> Storage.Buffer<Tile.Tile8> & Kept,~finish_output: WindowPipeline.Convolution -> U32 -> WorkModel -> Buffer.Model<Tile.Tile8>,
  ~finish_kept: WindowPipeline.Convolution -> U32 -> WorkModel -> KeptModel,
  ~begin_same: BeginSame(~Work,~WorkModel,~represent,~Kept,~KeptModel,~represent_kept,~begin,~begin_model),
  ~started: Started(~Holder,~WorkModel,~Holds,~cells_of,~KeptModel,~KeptOk,~begin_model),
  ~finish_same: FinishSame(~Work,~WorkModel,~represent,~Kept,~KeptModel,~represent_kept,~finish,~finish_output,~finish_kept),
  ~ended: Ended(~Holder,~WorkModel,~Holds,~cells_of,~KeptModel,~KeptOk,~Finished,~finish_output,~finish_kept),~KeptShared: Holder -> WindowPipeline.Convolution -> KeptModel -> Data,~prepare: @+convolution: WindowPipeline.Convolution -> @+positions: U32 -> Kept -> Kept,~prepare_model: WindowPipeline.Convolution -> U32 -> KeptModel -> KeptModel,
  ~prepare_same: PrepareSame(~Kept,~KeptModel,~represent_kept,~prepare,~prepare_model),~prepared: Prepared(~Holder,~KeptModel,~KeptOk,~KeptShared,~prepare_model),~share: Kept -> Kept & Kept,~split_kept: KeptModel -> PartitionLaws.Split<KeptModel>,
  +holder: Holder,+low: Nat,+high: Nat,+capacity: U32,+capacity_ok: {U32.is_le(capacity,2147483648) == True{} : Bool},+bounded: {Nat.is_le(high,U32.to_nat(capacity)) == True{} : Bool},
  +limits: Machine.Limits,+convolution: WindowPipeline.Convolution,+grid: Grid.Grid,+first: U32,+count: U32,
  +holding: Held.Holding<Tile.Tile8>,+tiled: Held.Tiled(~Tile.Tile8,holding,low,high),+values: Held.HoldingValues(~Tile.Tile8,~Holder,~value,holder,holding),
  +kept: KeptModel,+spare: Held.SpareModel<Tile.Tile8>,+ok: ResourceOk(~Holder,~KeptModel,~KeptShared,holder,convolution,Resource{kept,spare}),
  +plane_room: {Nat.is_le(U32.to_nat(U32.max(WindowPipeline.plane_of(convolution),1)),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},+grid_inside: {Nat.is_le(U32.to_nat(Grid.count_of(grid)),cells_of(holder,convolution)) == True{} : Bool},
  +facts: PieceFacts(Grid.later_pieces(grid,first,count),low,high,limits,convolution,grid,Grid.piece_of(grid,first),first,(first + count : U32),WindowPipeline.clipped_first(grid,Grid.piece_of(grid,first),first),WindowPipeline.clipped_count(grid,Grid.piece_of(grid,first),first,(first + count : U32)))) ->
  Grouped.TaskFact<Tile.Tile8,Pieces.Pieces(~Tile.Tile8),WindowPipeline.Parameters<Kept>,WindowPipeline.Windowed,PiecesModel.Model<Tile.Tile8>,Resource<KeptModel>,WindowPipeline.shared(~Kept,~share),WindowPipeline.task_leaf(~Kept,~Work,~begin,~compute,~finish,~prepare),
    PiecesModel.pack(~Tile.Tile8),pack_resource(~Kept,~KeptModel,~represent_kept),split_resource(~KeptModel,~split_kept),TaskScope<Holder>,TaskHolds(~Holder,~Finished),TaskScope{holder,WindowPipeline.Windowed{convolution,grid}},WindowPipeline.Windowed{convolution,grid},holding,first,count,Resource{kept,spare}>:
  Held.Both{+shared,+spare_room} = ok
  +walked = task_walk(~Holder,~value,~Work,~WorkModel,~represent,~compute,~band_after,~work_after,~Holds,~cells_of,~compute_same,~band_kept,~step,~Kept,~KeptModel,~represent_kept,~KeptOk,~Finished,~begin,~begin_model,~finish,~finish_output,~finish_kept,~begin_same,~started,~finish_same,~ended,Grid.later_pieces(grid,first,count),holder,low,high,capacity,capacity_ok,bounded,Held.spans(~Tile.Tile8,Held.order(~Tile.Tile8,holding)),limits,convolution,grid,Grid.piece_of(grid,first),first,(first + count : U32),WindowPipeline.clipped_first(grid,Grid.piece_of(grid,first),first),WindowPipeline.clipped_count(grid,Grid.piece_of(grid,first),first,(first + count : U32)),
    Pieces.NoLefts{},Pieces.Walking{Pieces.NoLefts{},(Held.pack(~Tile.Tile8,holding),WindowPipeline.prepared(~Kept,~prepare,convolution,WindowPipeline.task_positions(convolution,first,count),WindowPipeline.Parameters{represent_kept(kept),Held.pack_spare(~Tile.Tile8,spare)}))},holding,tiled,values,{==},spare,spare_room,prepare_model(convolution,WindowPipeline.task_positions(convolution,first,count),kept),prepared(holder,convolution,WindowPipeline.task_positions(convolution,first,count),kept,shared),
