# ---- The end of a task ----

# The output a piece finishes with: the cells of its staged pairs, activated
# and padded, and the kept operands.
def finish_output(~custom: F32 -> F32,convolution: WindowPipeline.Convolution,positions: U32,work: Point.PointModel) -> Buffer.Model<Tile.Tile8>:
  WindowPipeline.Convolution{h,w,k,s,p,oh,ow,channels,inner,gi,go,activation} = convolution
  Point.PointModel{pairs,bias,staged} = work
  Buffer.remodel(~Tile.Tile8,Pipeline.point_finished(~custom,activation,channels,positions,Buffer.pack(~Tile.Tile16,staged)))

def finish_kept(convolution: WindowPipeline.Convolution,positions: U32,work: Point.PointModel) -> PointTask.PointOperands:
  Point.PointModel{pairs,bias,staged} = work
  PointTask.PointOperands{pairs,bias}

