# ---- The cells of the staged pairs ----

def staged_lower(-outputs: Nat,-pair: Nat,-value: Tile.Tile16,-low: Tile.Tile8,-high: Tile.Tile8,valid: PointTask.StagedValid<outputs,pair,value,low,high>) ->
  PaddedCells.Valid<outputs,Nat.mul(pair,2n),Gemm.staged_half(value,False{}),low>:
  PointTask.StagedValid{lower,upper} = valid
  lower

def staged_upper(-outputs: Nat,-pair: Nat,-value: Tile.Tile16,-low: Tile.Tile8,-high: Tile.Tile8,valid: PointTask.StagedValid<outputs,pair,value,low,high>) ->
  PaddedCells.Valid<outputs,1n+Nat.mul(pair,2n),Gemm.staged_half(value,True{}),high>:
  PointTask.StagedValid{lower,upper} = valid
  upper

# A group is twice its half and its parity.
def group_halves(+group: Nat,+parity: Nat,+parity_exact: {Nat.mod(group,2n) == parity : Nat}) ->
  {group == Nat.add(Nat.mul(Nat.div(group,2n),2n),parity) : Nat}:
  %parity_exact : {group == Nat.add(Nat.mul(Nat.div(group,2n),2n),_) : Nat}
  DivisionOrder.quotient_exact(group,2n,{==})

# The cell of group group of a position holds the half of the pair of the
# position that holds the group.
def unpaired_cases(~Logical: Data,~original: Logical -> U32 -> F32,+logical: Logical,+channels: Nat,+outputs: Nat,+height: Nat,+width: Nat,+kernel: Nat,+stride: Nat,+padding: Nat,+weight_list: List<&2,F32>,+bias_list: List<&2,F32>,+start: U32,+at: Nat,+group: Nat,+tile: Tile.Tile8,+value: Tile.Tile16,
  +parity: Nat,+parity_exact: {Nat.mod(group,2n) == parity : Nat},+small: {Nat.is_lt(parity,2n) == True{} : Bool},
  +valid: PointTask.StagedValid<outputs,Nat.div(group,2n),value,Calls.written_tile(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,at,Nat.mul(Nat.div(group,2n),2n)),
    Calls.written_tile(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,at,1n+Nat.mul(Nat.div(group,2n),2n))>,
  +read: {tile == Gemm.staged_half(value,U32.is_eq(U32.from_nat(parity),1)) : Tile.Tile8}) ->
  PaddedCells.Valid<outputs,group,tile,Calls.written_tile(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,at,group)>:
  match parity:
    case 0n:
      +even = Equal.trans(Nat,group,Nat.add(Nat.mul(Nat.div(group,2n),2n),0n),Nat.mul(Nat.div(group,2n),2n),group_halves(group,0n,parity_exact),Addition.zero_right(Nat.mul(Nat.div(group,2n),2n)))
      %Equal.sym(Tile.Tile8,tile,Gemm.staged_half(value,False{}),read) : PaddedCells.Valid<outputs,group,_,Calls.written_tile(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,at,group)>
      %Equal.sym(Nat,group,Nat.mul(Nat.div(group,2n),2n),even) : PaddedCells.Valid<outputs,_,Gemm.staged_half(value,False{}),Calls.written_tile(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,at,_)>
      staged_lower(outputs,Nat.div(group,2n),value,Calls.written_tile(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,at,Nat.mul(Nat.div(group,2n),2n)),Calls.written_tile(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,at,1n+Nat.mul(Nat.div(group,2n),2n)),valid)
    case 1n+ +rest:
      match rest:
        case 0n:
          +odd = Equal.trans(Nat,group,Nat.add(Nat.mul(Nat.div(group,2n),2n),1n),1n+Nat.mul(Nat.div(group,2n),2n),group_halves(group,1n,parity_exact),Order.commutative(Nat.mul(Nat.div(group,2n),2n),1n))
          %Equal.sym(Tile.Tile8,tile,Gemm.staged_half(value,True{}),read) : PaddedCells.Valid<outputs,group,_,Calls.written_tile(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,at,group)>
          %Equal.sym(Nat,group,1n+Nat.mul(Nat.div(group,2n),2n),odd) : PaddedCells.Valid<outputs,_,Gemm.staged_half(value,True{}),Calls.written_tile(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,at,_)>
          staged_upper(outputs,Nat.div(group,2n),value,Calls.written_tile(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,at,Nat.mul(Nat.div(group,2n),2n)),Calls.written_tile(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,at,1n+Nat.mul(Nat.div(group,2n),2n)),valid)
        case 1n+ +more:
          Empty.absurd(PaddedCells.Valid<outputs,group,tile,Calls.written_tile(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,at,group)>,Order.below_zero(more,small))

# A cell of a task unpaired from its staged pairs holds the tile of its
# position and group.
def unpaired_cell(~Logical: Data,~original: Logical -> U32 -> F32,+logical: Logical,+channels: Nat,+outputs: Nat,+height: Nat,+width: Nat,+kernel: Nat,+stride: Nat,+padding: Nat,+weight_list: List<&2,F32>,+bias_list: List<&2,F32>,+limits: Machine.Limits,+start: U32,+staged: Tree.Tree<Tile.Tile16>,+output: Tree.Tree<Tile.Tile8>,+depth: Nat,
  +balanced: Shape.Balanced(Tile.Tile8,depth,output),+limit: {Nat.is_le(depth,31n) == True{} : Bool},+capacity_ok: {U32.is_le(Tree.capacity(Tile.Tile8,output),2147483648) == True{} : Bool},
  +count: U32,+room: {Nat.is_le(U32.to_nat(count),U32.to_nat(Tree.capacity(Tile.Tile8,output))) == True{} : Bool},
  +positions: Nat,+count_exact: {Nat.mul(positions,Calls.cell_groups(outputs)) == U32.to_nat(count) : Nat},+count_room: {Nat.is_le(U32.to_nat(count),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},
  +positive: {Nat.is_lt(0n,Calls.cell_groups(outputs)) == True{} : Bool},+groups_room: {Nat.is_le(Calls.cell_groups(outputs),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},
  +pairs_half: {PointTask.pair_total(outputs) == Nat.div(Nat.add(Calls.cell_groups(outputs),1n),2n) : Nat},
  +staged_cells: Members.All(Nat,{cell => PointTask.StagedCell(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,staged,cell) : Nat -> Data},Ranges.range(Nat.mul(positions,PointTask.pair_total(outputs)),0n)),
  +index: Nat,+inside: {Nat.is_lt(index,U32.to_nat(count)) == True{} : Bool}) ->
  Calls.WrittenCell(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,Converted.unpaired_tree(U32.from_nat(outputs),count,staged,output),index):
  +groups = Calls.cell_groups(outputs)
  +pairs = PointTask.pair_total(outputs)
  +at = Nat.div(index,groups)
  +group = Nat.mod(index,groups)
  +half = Nat.div(group,2n)
  +pair = Nat.add(Nat.mul(at,pairs),half)
  +capacity = U32.to_nat(Machine.capacity(limits))
  +seven = Bounds.as_nat_le(7,Machine.capacity(limits),Limits.seven_within_capacity(limits))
  +fewer = {%Equal.sym(Nat,pairs,Nat.div(Nat.add(groups,1n),2n),pairs_half) : {Nat.is_le(_,groups) == True{} : Bool}
    PointReadback.pairs_below(groups) : {Nat.is_le(pairs,groups) == True{} : Bool}}
  +index_room = Order.transitive(index,capacity,U32.to_nat(Machine.half_word(limits)),
    Order.transitive(index,U32.to_nat(count),capacity,Bounds.strict_le(index,U32.to_nat(count),inside),count_room),
    Bounds.as_nat_le(Machine.capacity(limits),Machine.half_word(limits),Limits.capacity_within_half(limits)))
  +read = Converted.unpaired_read(U32.from_nat(outputs),count,staged,output,depth,balanced,limit,capacity_ok,room,index,inside,Machine.half_word(limits),Limits.half_word_fits(limits),
    groups,{==},pairs,{==},positive,fewer,Limits.double_bound(limits,groups,groups_room),
    Limits.double_bound(limits,2n,Order.transitive(2n,7n,capacity,{==},seven)),index_room)
  +group_small = DivisionOrder.remainder_small(index,groups,positive)
  +shifted = {%DivisionOrder.quotient_shift(group,2n,1n,{==}) : {Nat.is_le(_,Nat.div(1n+groups,2n)) == True{} : Bool}
    DivisionOrder.quotient_le(2n+group,1n+groups,2n,{==},Order.strict_follow(group,groups,group_small)) : {Nat.is_le(1n+half,Nat.div(1n+groups,2n)) == True{} : Bool}}
  +half_pairs = {%Order.commutative(1n,groups) : {Nat.is_le(1n+half,Nat.div(_,2n)) == True{} : Bool} shifted : {Nat.is_le(1n+half,Nat.div(Nat.add(groups,1n),2n)) == True{} : Bool}}
  +half_room = {%Equal.sym(Nat,pairs,Nat.div(Nat.add(groups,1n),2n),pairs_half) : {Nat.is_le(1n+half,_) == True{} : Bool} half_pairs : {Nat.is_le(1n+half,pairs) == True{} : Bool}}
  +half_below = Order.succ_le_lt(half,pairs,half_room)
  +pairs_positive = Order.le_lt_trans(0n,half,pairs,Order.zero_le(half),half_below)
  +inside_cells = {%Equal.sym(Nat,Nat.mul(positions,groups),U32.to_nat(count),count_exact) : {Nat.is_lt(index,_) == True{} : Bool}
    inside : {Nat.is_lt(index,Nat.mul(positions,groups)) == True{} : Bool}}
  +at_below = DivisionOrder.quotient_below(index,positions,groups,positive,inside_cells)
  +rows_room = {%Order.commutative(pairs,Nat.mul(at,pairs)) : {Nat.is_le(_,Nat.mul(positions,pairs)) == True{} : Bool}
    RowMajor.mul_le(1n+at,positions,pairs,Order.strict_follow(at,positions,at_below)) : {Nat.is_le(Nat.add(Nat.mul(at,pairs),pairs),Nat.mul(positions,pairs)) == True{} : Bool}}
  +pair_below = Order.lt_le(pair,Nat.add(Nat.mul(at,pairs),pairs),Nat.mul(positions,pairs),Order.offset_lt(Nat.mul(at,pairs),half,pairs,half_below),rows_room)
  +staged_pair = Members.all_member(Nat,{cell => PointTask.StagedCell(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,staged,cell) : Nat -> Data},pair,Ranges.range(Nat.mul(positions,pairs),0n),staged_cells,
    Members.range_member(Nat.mul(positions,pairs),0n,pair,pair_below))
  +pair_at = Radix.quotient(at,half,pairs,pairs_positive,half_below)
  +pair_half = Radix.remainder(at,half,pairs,pairs_positive,half_below)
  +halved = {%pair_half : PointTask.StagedValid<outputs,_,Tree.read(Tile.Tile16,staged,U32.from_nat(pair)),Calls.written_tile(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,Nat.div(pair,pairs),Nat.mul(_,2n)),Calls.written_tile(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,Nat.div(pair,pairs),1n+Nat.mul(_,2n))>
    staged_pair : PointTask.StagedValid<outputs,half,Tree.read(Tile.Tile16,staged,U32.from_nat(pair)),Calls.written_tile(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,Nat.div(pair,pairs),Nat.mul(half,2n)),Calls.written_tile(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,Nat.div(pair,pairs),1n+Nat.mul(half,2n))>}
  +valid = {%pair_at : PointTask.StagedValid<outputs,half,Tree.read(Tile.Tile16,staged,U32.from_nat(pair)),Calls.written_tile(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,_,Nat.mul(half,2n)),Calls.written_tile(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,_,1n+Nat.mul(half,2n))>
    halved : PointTask.StagedValid<outputs,half,Tree.read(Tile.Tile16,staged,U32.from_nat(pair)),Calls.written_tile(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,at,Nat.mul(half,2n)),Calls.written_tile(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,at,1n+Nat.mul(half,2n))>}
  unpaired_cases(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,at,group,Tree.read(Tile.Tile8,Converted.unpaired_tree(U32.from_nat(outputs),count,staged,output),U32.from_nat(index)),Tree.read(Tile.Tile16,staged,U32.from_nat(pair)),Nat.mod(group,2n),{==},
    DivisionOrder.remainder_small(group,2n,{==}),valid,read)

# ---- The pairs of output channel groups ----

# The pairs of the groups of a problem are half its groups, rounded up.
def pairs_half(+limits: Machine.Limits,+outputs: Nat,+groups_room: {Nat.is_le(Calls.cell_groups(outputs),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}) ->
  {PointTask.pair_total(outputs) == Nat.div(Nat.add(Calls.cell_groups(outputs),1n),2n) : Nat}:
  +capacity = U32.to_nat(Machine.capacity(limits))
  +half = U32.to_nat(Machine.half_word(limits))
  +seven = Bounds.as_nat_le(7,Machine.capacity(limits),Limits.seven_within_capacity(limits))
  +doubled = {%Equal.sym(Nat,Nat.add(capacity,capacity),Nat.double(capacity),Addition.double(capacity)) : {Nat.is_le(_,half) == True{} : Bool}
    Limits.double_bound(limits,capacity,Order.reflexive(capacity)) : {Nat.is_le(Nat.add(capacity,capacity),half) == True{} : Bool}}
  +sum_room = Order.transitive(Nat.add(Calls.cell_groups(outputs),1n),Nat.add(capacity,capacity),half,
    Order.transitive(Nat.add(Calls.cell_groups(outputs),1n),Nat.add(capacity,1n),Nat.add(capacity,capacity),Order.add_le(Calls.cell_groups(outputs),capacity,1n,groups_room),
      Order.offset_le(capacity,1n,capacity,Order.transitive(1n,7n,capacity,{==},seven))),doubled)
  U32Division.quotient_exact(Machine.half_word(limits),Limits.half_word_fits(limits),(Gemm.blocks(U32.from_nat(outputs)) + 1 : U32),2,Nat.add(Calls.cell_groups(outputs),1n),2n,
    Arithmetic.sum_exact(Machine.half_word(limits),Limits.half_word_fits(limits),Gemm.blocks(U32.from_nat(outputs)),1,Calls.cell_groups(outputs),1n,{==},{==},sum_room),{==},
    Limits.double_bound(limits,2n,Order.transitive(2n,7n,capacity,{==},seven)),{==})

# ---- The finished piece of a task ----

# The finished piece of a task: the cells it converts from the staged pairs
# of its positions, activated and padded.
type UnpairedCells<-custom: F32 -> F32,-Logical: Data,-original: Logical -> U32 -> F32> is Data:
  UnpairedCells{logical: Logical,channels: Nat,outputs: Nat,height: Nat,width: Nat,kernel: Nat,stride: Nat,padding: Nat,weight_list: List<&2,F32>,bias_list: List<&2,F32>,activation: Activations.Activation,limits: Machine.Limits,outer_word: U32,after_word: U32,lanes_word: U32,groups_word: U32,
    after_exact: {U32.to_nat(after_word) == ImageProblems.plane(height,width,kernel,stride,padding) : Nat},lanes_exact: {U32.to_nat(lanes_word) == outputs : Nat},
    plane_positive: {Nat.is_lt(0n,ImageProblems.plane(height,width,kernel,stride,padding)) == True{} : Bool},start: U32,staged: Tree.Tree<Tile.Tile16>,output: Tree.Tree<Tile.Tile8>,images: Nat,
    elements_room: {Nat.is_le(Nat.mul(Nat.mul(images,Representation.lane_count(TiledCells.Cells{outer_word,after_word,lanes_word,groups_word,Grid.Innermost{}})),Representation.after_count(TiledCells.Cells{outer_word,after_word,lanes_word,groups_word,Grid.Innermost{}})),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},
    first: U32,count: U32,padded: U32,positions: U32,after: U32,total: Nat,cover: Public.Cover<limits,U32.from_nat(outputs),positions,Grid.Innermost{},positions,Grid.Innermost{},total>,
    first_exact: {U32.to_nat(first) == Nat.mul(U32.to_nat(start),Calls.cell_groups(outputs)) : Nat},groups_exact: {U32.to_nat(groups_word) == Calls.cell_groups(outputs) : Nat},
    positive: {Nat.is_lt(0n,Calls.cell_groups(outputs)) == True{} : Bool},padded_exact: {U32.to_nat(padded) == U32.to_nat(count) : Nat},
    cells_inside: {Nat.is_le(Nat.add(U32.to_nat(first),U32.to_nat(count)),Nat.mul(Nat.mul(images,Representation.after_count(TiledCells.Cells{outer_word,after_word,lanes_word,groups_word,Grid.Innermost{}})),Calls.cell_groups(outputs))) == True{} : Bool},
    cells_room: {Nat.is_le(Nat.add(U32.to_nat(first),U32.to_nat(count)),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},outputs_room: {Nat.is_le(outputs,U32.to_nat(Machine.capacity(limits))) == True{} : Bool},
    depth: Nat,balanced: Shape.Balanced(Tile.Tile8,depth,output),depth_ok: {Nat.is_le(depth,30n) == True{} : Bool},
    capacity_ok: {U32.is_le(Tree.capacity(Tile.Tile8,output),2147483648) == True{} : Bool},
    padded_room: {Nat.is_le(U32.to_nat(padded),U32.to_nat(Tree.capacity(Tile.Tile8,output))) == True{} : Bool},
    length: Nat,ready: Buffer.ContentReady<Tile.Tile8,Buffer.Content{Converted.converted_tree(~custom,activation,U32.from_nat(outputs),padded,staged,output),length}>,length_exact: {length == U32.to_nat(padded) : Nat},
    inside: {Nat.is_le(Nat.add(U32.to_nat(0),U32.to_nat(padded)),PaddedCells.layout_total(PaddedCells.Layout{limits,U32.from_nat(outputs),positions,Grid.Innermost{},positions,after,Grid.Innermost{},total,cover})) == True{} : Bool},
    same: {Buffer.content_length(~Tile.Tile8,Padding.step(PaddedCells.layout_padding(PaddedCells.Layout{limits,U32.from_nat(outputs),positions,Grid.Innermost{},positions,after,Grid.Innermost{},total,cover}),0,padded,Buffer.Content{Converted.converted_tree(~custom,activation,U32.from_nat(outputs),padded,staged,output),length})) == length : Nat},
    span: Nat,span_exact: {Nat.mul(span,Calls.cell_groups(outputs)) == U32.to_nat(padded) : Nat},groups_room: {Nat.is_le(Calls.cell_groups(outputs),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},
    pairs_half: {PointTask.pair_total(outputs) == Nat.div(Nat.add(Calls.cell_groups(outputs),1n),2n) : Nat},
    staged_cells: Members.All(Nat,{cell => PointTask.StagedCell(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,staged,cell) : Nat -> Data},Ranges.range(Nat.mul(span,PointTask.pair_total(outputs)),0n))}

def unpaired_count(~custom: F32 -> F32,~Logical: Data,~original: Logical -> U32 -> F32,context: UnpairedCells<custom,Logical,original>) -> Nat:
  UnpairedCells{+logical,+channels,+outputs,+height,+width,+kernel,+stride,+padding,+weight_list,+bias_list,+activation,+limits,+outer_word,+after_word,+lanes_word,+groups_word,+after_exact,+lanes_exact,+plane_positive,+start,+staged,+output,+images,+elements_room,+first,+count,+padded,+positions,+after,+total,+cover,+first_exact,+groups_exact,+positive,+padded_exact,+cells_inside,+cells_room,+outputs_room,+depth,+balanced,+depth_ok,+capacity_ok,+padded_room,+length,+ready,+length_exact,+inside,+same,+span,+span_exact,+groups_room,+pairs_half,+staged_cells} = context
  U32.to_nat(count)

