def upper_channel(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,~Logical: Data,~original: Logical -> U32 -> F32,+context: PointNext<Holder,value,Logical,original>,+cell: Nat,+lane: Nat) -> Nat:
  PointNext{+holder,+limits,+logical,+channels,+outputs,+height,+width,+kernel,+stride,+padding,+weight_list,+bias_list,+groups_out,+activation,+start,+position,+end,+image,+local,+count,+offset,+previous,+next,+after,+word_positive,+plane_positive,+plane_exact,+local_exact,+image_exact,+grid,+offset_exact,+next_exact,+old,+storage,+call} = context
  Nat.add(lane,Nat.mul(1n+Nat.mul(Nat.mod(cell,pair_total(outputs)),2n),8n))

def upper_left(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,~Logical: Data,~original: Logical -> U32 -> F32,+context: PointNext<Holder,value,Logical,original>,+cell: Nat,+lane: Nat) -> F32:
  PointNext{+holder,+limits,+logical,+channels,+outputs,+height,+width,+kernel,+stride,+padding,+weight_list,+bias_list,+groups_out,+activation,+start,+position,+end,+image,+local,+count,+offset,+previous,+next,+after,+word_positive,+plane_positive,+plane_exact,+local_exact,+image_exact,+grid,+offset_exact,+next_exact,+old,+storage,+call} = context
  TileLaws.select_lane(lane,Gemm.staged_half(Tree.read(Tile.Tile16,next,U32.from_nat(cell)),True{}))

def upper_right(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,~Logical: Data,~original: Logical -> U32 -> F32,+context: PointNext<Holder,value,Logical,original>,+cell: Nat,+lane: Nat) -> F32:
  PointNext{+holder,+limits,+logical,+channels,+outputs,+height,+width,+kernel,+stride,+padding,+weight_list,+bias_list,+groups_out,+activation,+start,+position,+end,+image,+local,+count,+offset,+previous,+next,+after,+word_positive,+plane_positive,+plane_exact,+local_exact,+image_exact,+grid,+offset_exact,+next_exact,+old,+storage,+call} = context
  Calls.written_value(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,Nat.div(cell,pair_total(outputs)),Nat.add(lane,Nat.mul(1n+Nat.mul(Nat.mod(cell,pair_total(outputs)),2n),8n)))

# Lane lane of the lower half of a pair the call wrote holds the value of its
# position.
def lower_new_value(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,~Logical: Data,~original: Logical -> U32 -> F32,+context: PointNext<Holder,value,Logical,original>,+cell: Nat,
  +late: {Nat.is_lt(cell,next_early(~Holder,~value,~Logical,~original,context)) == False{} : Bool},+inside_cell: {Nat.is_lt(cell,next_size(~Holder,~value,~Logical,~original,context)) == True{} : Bool},
  +lane: Nat,+small: {Nat.is_lt(lane,8n) == True{} : Bool},
  +inside: {Nat.is_lt(lower_channel(~Holder,~value,~Logical,~original,context,cell,lane),next_outputs(~Holder,~value,~Logical,~original,context)) == True{} : Bool}) ->
  {lower_left(~Holder,~value,~Logical,~original,context,cell,lane) == lower_right(~Holder,~value,~Logical,~original,context,cell,lane) : F32}:
  PointNext{+holder,+limits,+logical,+channels,+outputs,+height,+width,+kernel,+stride,+padding,+weight_list,+bias_list,+groups_out,+activation,+start,+position,+end,+image,+local,+count,+offset,+previous,+next,+after,+word_positive,+plane_positive,+plane_exact,+local_exact,+image_exact,+grid,+offset_exact,+next_exact,+old,+storage,+call} = context
  +pairs = pair_total(outputs)
  +at = Nat.div(cell,pairs)
  +pair = Nat.mod(cell,pairs)
  +channel = PointValues.pair_channel(lane,pair)
  +positive = DivisionOrder.right_factor_positive(Nat.sub(U32.to_nat((position + count : U32)),U32.to_nat(start)),pairs,
    Order.le_lt_trans(0n,cell,Nat.mul(Nat.sub(U32.to_nat((position + count : U32)),U32.to_nat(start)),pair_total(outputs)),Order.zero_le(cell),inside_cell))
  +ordered = {%Equal.sym(Nat,U32.to_nat(offset),Nat.sub(U32.to_nat(position),U32.to_nat(start)),offset_exact) : {Nat.is_le(_,at) == True{} : Bool}
    Calls.position_from(cell,Nat.sub(U32.to_nat(position),U32.to_nat(start)),pairs,positive,late) : {Nat.is_le(U32.to_nat(offset),at) == True{} : Bool}}
  +below = DivisionOrder.quotient_below(cell,Nat.sub(U32.to_nat((position + count : U32)),U32.to_nat(start)),pairs,positive,inside_cell)
  +step_inside = Calls.call_step_inside(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,groups_out,activation,start,position,end,image,local,count,offset,after,offset_exact,next_exact,at,ordered,below)
  +step = Nat.sub(at,U32.to_nat(offset))
  +same = Equal.cong(Nat,Nat,value => Nat.add(lane,value),Nat.mul(Nat.mul(pair,2n),8n),Nat.mul(pair,16n),PointValues.pair_groups(pair))
  +channel_inside = {%same : {Nat.is_lt(_,outputs) == True{} : Bool} inside : {Nat.is_lt(channel,outputs) == True{} : Bool}}
  +index_same = Equal.trans(Nat,Nat.add(Nat.mul(Nat.add(U32.to_nat(offset),step),pairs),pair),Nat.add(Nat.mul(at,pairs),pair),cell,
    Equal.cong(Nat,Nat,value => Nat.add(Nat.mul(value,pairs),pair),Nat.add(U32.to_nat(offset),step),at,Order.restore_shift(U32.to_nat(offset),at,ordered)),
    Equal.sym(Nat,cell,Nat.add(Nat.mul(at,pairs),pair),DivisionOrder.quotient_exact(cell,pairs,positive)))
  +written = {%index_same : {PointSpec.pair_lane(lane,Tree.read(Tile.Tile16,next,U32.from_nat(_))) ==
