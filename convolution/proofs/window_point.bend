# ---- The staged pairs of a task ----

# The pairs of output channel groups of a position.
def pair_total(+outputs: Nat) -> Nat:
  U32.to_nat(Gemm.pairs_of(U32.from_nat(outputs)))

# A staged pair whose halves agree, below the channels, with the tiles of
# groups 2 pair and 2 pair + 1.
type StagedValid<-outputs: Nat,-pair: Nat,-value: Tile.Tile16,-low: Tile.Tile8,-high: Tile.Tile8> is Data:
  StagedValid{lower: PaddedCells.Valid<outputs,Nat.mul(pair,2n),Gemm.staged_half(value,False{}),low>,
    upper: PaddedCells.Valid<outputs,1n+Nat.mul(pair,2n),Gemm.staged_half(value,True{}),high>}

# Staged cell cell of a task from output position start on holds the tiles of
# the pair of its position.
def StagedCell(~Logical: Data,~original: Logical -> U32 -> F32,+logical: Logical,+channels: Nat,+outputs: Nat,+height: Nat,+width: Nat,+kernel: Nat,+stride: Nat,+padding: Nat,+weight_list: List<&2,F32>,+bias_list: List<&2,F32>,+start: U32,+tree: Tree.Tree<Tile.Tile16>,+cell: Nat) -> Data:
  StagedValid<outputs,Nat.mod(cell,pair_total(outputs)),Tree.read(Tile.Tile16,tree,U32.from_nat(cell)),
    Calls.written_tile(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,Nat.div(cell,pair_total(outputs)),Nat.mul(Nat.mod(cell,pair_total(outputs)),2n)),
    Calls.written_tile(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,Nat.div(cell,pair_total(outputs)),1n+Nat.mul(Nat.mod(cell,pair_total(outputs)),2n))>

# The lower half of a pair holds its first eight lanes, the upper half the
# next eight.
def lower_lane(+lane: Nat,+small: {Nat.is_lt(lane,8n) == True{} : Bool},+value: Tile.Tile16) ->
  {TileLaws.select_lane(lane,Gemm.staged_half(value,False{})) == PointSpec.pair_lane(lane,value) : F32}:
  Tile.Tiles{+lower,+upper} = value
  %Equal.sym(Bool,Nat.is_lt(lane,8n),True{},small) : {TileLaws.select_lane(lane,lower) == PointSpec.half_lane(_,lane,lower,upper) : F32}
  {==}

def high_outside(+lane: Nat) -> {Nat.is_lt(8n+lane,8n) == False{} : Bool}:
  Equal.trans(Bool,Nat.is_lt(8n+lane,8n),Bool.not(Nat.is_le(8n,8n+lane)),False{},Order.strict_complement(8n+lane,8n),
    Equal.cong(Bool,Bool,flag => Bool.not(flag),Nat.is_le(8n,8n+lane),True{},Order.le_add(8n,lane)))

def upper_lane(+lane: Nat,+small: {Nat.is_lt(lane,8n) == True{} : Bool},+value: Tile.Tile16) ->
  {TileLaws.select_lane(lane,Gemm.staged_half(value,True{})) == PointSpec.pair_lane(8n+lane,value) : F32}:
  Tile.Tiles{+lower,+upper} = value
  %Equal.sym(Bool,Nat.is_lt(8n+lane,8n),False{},high_outside(lane)) : {TileLaws.select_lane(lane,upper) == PointSpec.half_lane(_,8n+lane,lower,upper) : F32}
  Equal.cong(Nat,F32,index => TileLaws.select_lane(index,upper),lane,Nat.sub(lane,0n),Equal.sym(Nat,Nat.sub(lane,0n),lane,Order.subtract_zero(lane)))

# ---- The staged pairs after a call ----

# The staged pairs of a task after a call: those before it, and the pairs the
# call wrote.
type PointNext<-Holder: Data,-value: Holder -> U32 -> Tile.Tile8,-Logical: Data,-original: Logical -> U32 -> F32> is Data:
  PointNext{holder: Holder,limits: Machine.Limits,logical: Logical,channels: Nat,outputs: Nat,height: Nat,width: Nat,kernel: Nat,stride: Nat,padding: Nat,weight_list: List<&2,F32>,bias_list: List<&2,F32>,groups_out: U32,activation: Activations.Activation,start: U32,position: U32,end: U32,image: U32,local: U32,count: U32,offset: U32,previous: Tree.Tree<Tile.Tile16>,next: Tree.Tree<Tile.Tile16>,after: {Nat.is_le(U32.to_nat(start),U32.to_nat(position)) == True{} : Bool},word_positive: {Nat.is_lt(0n,U32.to_nat(U32.max(WindowPipeline.plane_of(Calls.record(ImageProblems.problem(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,0n),groups_out,activation)),1))) == True{} : Bool},plane_positive: {Nat.is_lt(0n,ImageProblems.plane(height,width,kernel,stride,padding)) == True{} : Bool},plane_exact: {U32.to_nat(U32.max(WindowPipeline.plane_of(Calls.record(ImageProblems.problem(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,0n),groups_out,activation)),1)) == ImageProblems.plane(height,width,kernel,stride,padding) : Nat},local_exact: {U32.to_nat(local) == Nat.mod(U32.to_nat(position),U32.to_nat(U32.max(WindowPipeline.plane_of(Calls.record(ImageProblems.problem(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,0n),groups_out,activation)),1))) : Nat},image_exact: {U32.to_nat(image) == Nat.div(U32.to_nat(position),U32.to_nat(U32.max(WindowPipeline.plane_of(Calls.record(ImageProblems.problem(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,0n),groups_out,activation)),1))) : Nat},grid: {Nat.is_le(Nat.add(U32.to_nat(local),U32.to_nat(count)),U32.to_nat(U32.max(WindowPipeline.plane_of(Calls.record(ImageProblems.problem(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,0n),groups_out,activation)),1))) == True{} : Bool},offset_exact: {U32.to_nat(offset) == Nat.sub(U32.to_nat(position),U32.to_nat(start)) : Nat},next_exact: {U32.to_nat((position + count : U32)) == Nat.add(U32.to_nat(position),U32.to_nat(count)) : Nat},old: Members.All(Nat,{index => StagedCell(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,previous,index) : Nat -> Data},Ranges.range(Nat.mul(Nat.sub(U32.to_nat(position),U32.to_nat(start)),pair_total(outputs)),0n)),storage: Inputs.Contract<ImageProblems.problem(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,U32.to_nat(image))>,call: Spots.PointCall<Holder,value,holder,limits,ImageProblems.problem(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,U32.to_nat(image)),storage,local,count,offset,previous,next>}

def next_outputs(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,~Logical: Data,~original: Logical -> U32 -> F32,context: PointNext<Holder,value,Logical,original>) -> Nat:
  PointNext{holder,limits,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,groups_out,activation,start,position,end,image,local,count,offset,previous,next,after,word_positive,plane_positive,plane_exact,local_exact,image_exact,grid,offset_exact,next_exact,old,storage,call} = context
  outputs

def next_tree(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,~Logical: Data,~original: Logical -> U32 -> F32,context: PointNext<Holder,value,Logical,original>) -> Tree.Tree<Tile.Tile16>:
  PointNext{holder,limits,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,groups_out,activation,start,position,end,image,local,count,offset,previous,next,after,word_positive,plane_positive,plane_exact,local_exact,image_exact,grid,offset_exact,next_exact,old,storage,call} = context
  next

def next_start(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,~Logical: Data,~original: Logical -> U32 -> F32,context: PointNext<Holder,value,Logical,original>) -> U32:
  PointNext{holder,limits,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,groups_out,activation,start,position,end,image,local,count,offset,previous,next,after,word_positive,plane_positive,plane_exact,local_exact,image_exact,grid,offset_exact,next_exact,old,storage,call} = context
  start

def next_logical(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,~Logical: Data,~original: Logical -> U32 -> F32,context: PointNext<Holder,value,Logical,original>) -> Logical:
  PointNext{holder,limits,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,groups_out,activation,start,position,end,image,local,count,offset,previous,next,after,word_positive,plane_positive,plane_exact,local_exact,image_exact,grid,offset_exact,next_exact,old,storage,call} = context
  logical

def next_size(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,~Logical: Data,~original: Logical -> U32 -> F32,context: PointNext<Holder,value,Logical,original>) -> Nat:
  PointNext{+holder,+limits,+logical,+channels,+outputs,+height,+width,+kernel,+stride,+padding,+weight_list,+bias_list,+groups_out,+activation,+start,+position,+end,+image,+local,+count,+offset,+previous,+next,+after,+word_positive,+plane_positive,+plane_exact,+local_exact,+image_exact,+grid,+offset_exact,+next_exact,+old,+storage,+call} = context
  Nat.mul(Nat.sub(U32.to_nat((position + count : U32)),U32.to_nat(start)),pair_total(outputs))

def next_early(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,~Logical: Data,~original: Logical -> U32 -> F32,context: PointNext<Holder,value,Logical,original>) -> Nat:
  PointNext{+holder,+limits,+logical,+channels,+outputs,+height,+width,+kernel,+stride,+padding,+weight_list,+bias_list,+groups_out,+activation,+start,+position,+end,+image,+local,+count,+offset,+previous,+next,+after,+word_positive,+plane_positive,+plane_exact,+local_exact,+image_exact,+grid,+offset_exact,+next_exact,+old,+storage,+call} = context
  Nat.mul(Nat.sub(U32.to_nat(position),U32.to_nat(start)),pair_total(outputs))

def NextCell(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,~Logical: Data,~original: Logical -> U32 -> F32,+context: PointNext<Holder,value,Logical,original>,+cell: Nat) -> Data:
  PointNext{+holder,+limits,+logical,+channels,+outputs,+height,+width,+kernel,+stride,+padding,+weight_list,+bias_list,+groups_out,+activation,+start,+position,+end,+image,+local,+count,+offset,+previous,+next,+after,+word_positive,+plane_positive,+plane_exact,+local_exact,+image_exact,+grid,+offset_exact,+next_exact,+old,+storage,+call} = context
  StagedCell(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,next,cell)
def lower_group(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,~Logical: Data,~original: Logical -> U32 -> F32,+context: PointNext<Holder,value,Logical,original>,+cell: Nat) -> Nat:
  PointNext{+holder,+limits,+logical,+channels,+outputs,+height,+width,+kernel,+stride,+padding,+weight_list,+bias_list,+groups_out,+activation,+start,+position,+end,+image,+local,+count,+offset,+previous,+next,+after,+word_positive,+plane_positive,+plane_exact,+local_exact,+image_exact,+grid,+offset_exact,+next_exact,+old,+storage,+call} = context
  Nat.mul(Nat.mod(cell,pair_total(outputs)),2n)

def lower_channel(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,~Logical: Data,~original: Logical -> U32 -> F32,+context: PointNext<Holder,value,Logical,original>,+cell: Nat,+lane: Nat) -> Nat:
  PointNext{+holder,+limits,+logical,+channels,+outputs,+height,+width,+kernel,+stride,+padding,+weight_list,+bias_list,+groups_out,+activation,+start,+position,+end,+image,+local,+count,+offset,+previous,+next,+after,+word_positive,+plane_positive,+plane_exact,+local_exact,+image_exact,+grid,+offset_exact,+next_exact,+old,+storage,+call} = context
  Nat.add(lane,Nat.mul(Nat.mul(Nat.mod(cell,pair_total(outputs)),2n),8n))

def lower_left(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,~Logical: Data,~original: Logical -> U32 -> F32,+context: PointNext<Holder,value,Logical,original>,+cell: Nat,+lane: Nat) -> F32:
  PointNext{+holder,+limits,+logical,+channels,+outputs,+height,+width,+kernel,+stride,+padding,+weight_list,+bias_list,+groups_out,+activation,+start,+position,+end,+image,+local,+count,+offset,+previous,+next,+after,+word_positive,+plane_positive,+plane_exact,+local_exact,+image_exact,+grid,+offset_exact,+next_exact,+old,+storage,+call} = context
  TileLaws.select_lane(lane,Gemm.staged_half(Tree.read(Tile.Tile16,next,U32.from_nat(cell)),False{}))

def lower_right(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,~Logical: Data,~original: Logical -> U32 -> F32,+context: PointNext<Holder,value,Logical,original>,+cell: Nat,+lane: Nat) -> F32:
  PointNext{+holder,+limits,+logical,+channels,+outputs,+height,+width,+kernel,+stride,+padding,+weight_list,+bias_list,+groups_out,+activation,+start,+position,+end,+image,+local,+count,+offset,+previous,+next,+after,+word_positive,+plane_positive,+plane_exact,+local_exact,+image_exact,+grid,+offset_exact,+next_exact,+old,+storage,+call} = context
  Calls.written_value(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,Nat.div(cell,pair_total(outputs)),Nat.add(lane,Nat.mul(Nat.mul(Nat.mod(cell,pair_total(outputs)),2n),8n)))

def upper_group(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,~Logical: Data,~original: Logical -> U32 -> F32,+context: PointNext<Holder,value,Logical,original>,+cell: Nat) -> Nat:
  PointNext{+holder,+limits,+logical,+channels,+outputs,+height,+width,+kernel,+stride,+padding,+weight_list,+bias_list,+groups_out,+activation,+start,+position,+end,+image,+local,+count,+offset,+previous,+next,+after,+word_positive,+plane_positive,+plane_exact,+local_exact,+image_exact,+grid,+offset_exact,+next_exact,+old,+storage,+call} = context
