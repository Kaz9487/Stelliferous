  PointShared{+convolution_exact,direct,pairs_exact,bias_exact} = shared
  convolution_exact

def ready_pairs(+limits: Machine.Limits,+problem: ConvSpec.Problem,+ready: Spots.PointReady<limits,problem>) ->
  {Nat.is_le(U32.to_nat(Gemm.pairs_of(MicroLeaf.rows(problem))),U32.to_nat(Gemm.blocks(MicroLeaf.rows(problem)))) == True{} : Bool}:
  Spots.PointReady{shape,groups_exact,inner_exact,count_exact,balanced,limit,capacity_ok,room,groups_positive,group_room,+pairs_fewer} = ready
  pairs_fewer

