# The convolution of shared operands is the record of the problem.
def shared_convolution(~Logical: Data,~original: Logical -> U32 -> F32,+holder: Packed.WindowProblem<Logical,original>,+convolution: WindowPipeline.Convolution,+kept: PointOperands,
