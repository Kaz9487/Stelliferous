# ---- A piece begins ----

# The work a piece begins with: the operands and fresh staged pairs for its
# positions.
def begin_model(convolution: WindowPipeline.Convolution,positions: U32,count: U32,kept: PointOperands) -> Point.PointModel:
  PointOperands{pairs,bias} = kept
  Point.PointModel{pairs,bias,Buffer.remodel(~Tile.Tile16,Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),(positions * Gemm.pairs_of(WindowPipeline.channels_of(convolution)) : U32)))}

