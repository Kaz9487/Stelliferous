# A staged cell of the task after the call: one before it keeps its pair, one
# the call wrote holds the pair of its position.
def cell_cases(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,~Logical: Data,~original: Logical -> U32 -> F32,+context: PointNext<Holder,value,Logical,original>,+cell: Nat,+inside: {Nat.is_lt(cell,next_size(~Holder,~value,~Logical,~original,context)) == True{} : Bool},
  early: Bool,+early_exact: {Nat.is_lt(cell,next_early(~Holder,~value,~Logical,~original,context)) == early : Bool}) -> NextCell(~Holder,~value,~Logical,~original,context,cell):
  PointNext{+holder,+limits,+logical,+channels,+outputs,+height,+width,+kernel,+stride,+padding,+weight_list,+bias_list,+groups_out,+activation,+start,+position,+end,+image,+local,+count,+offset,+previous,+next,+after,+word_positive,+plane_positive,+plane_exact,+local_exact,+image_exact,+grid,+offset_exact,+next_exact,+old,+storage,+call} = context
  match early:
    case True{}:
      +pairs = pair_total(outputs)
      +before = {%Equal.sym(Nat,U32.to_nat(offset),Nat.sub(U32.to_nat(position),U32.to_nat(start)),offset_exact) : {Nat.is_lt(cell,Nat.mul(_,pairs)) == True{} : Bool}
        early_exact : {Nat.is_lt(cell,Nat.mul(U32.to_nat(offset),pairs)) == True{} : Bool}}
      %Equal.sym(Tile.Tile16,Tree.read(Tile.Tile16,next,U32.from_nat(cell)),Tree.read(Tile.Tile16,previous,U32.from_nat(cell)),
          Spots.point_kept(~Holder,~value,holder,limits,ImageProblems.problem(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,U32.to_nat(image)),storage,local,count,offset,previous,next,call,cell,before)) :
        StagedValid<outputs,Nat.mod(cell,pairs),_,Calls.written_tile(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,Nat.div(cell,pairs),Nat.mul(Nat.mod(cell,pairs),2n)),
          Calls.written_tile(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,Nat.div(cell,pairs),1n+Nat.mul(Nat.mod(cell,pairs),2n))>
      Members.all_member(Nat,{index => StagedCell(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,previous,index) : Nat -> Data},cell,Ranges.range(Nat.mul(Nat.sub(U32.to_nat(position),U32.to_nat(start)),pair_total(outputs)),0n),old,
        Members.range_member(Nat.mul(Nat.sub(U32.to_nat(position),U32.to_nat(start)),pair_total(outputs)),0n,cell,early_exact))
    case False{}:
      +late = early_exact
      StagedValid{PaddedCells.Valid{lower_new(~Holder,~value,~Logical,~original,context,cell,late,inside,0n,{==}),lower_new(~Holder,~value,~Logical,~original,context,cell,late,inside,1n,{==}),lower_new(~Holder,~value,~Logical,~original,context,cell,late,inside,2n,{==}),lower_new(~Holder,~value,~Logical,~original,context,cell,late,inside,3n,{==}),lower_new(~Holder,~value,~Logical,~original,context,cell,late,inside,4n,{==}),lower_new(~Holder,~value,~Logical,~original,context,cell,late,inside,5n,{==}),lower_new(~Holder,~value,~Logical,~original,context,cell,late,inside,6n,{==}),lower_new(~Holder,~value,~Logical,~original,context,cell,late,inside,7n,{==})},
        PaddedCells.Valid{upper_new(~Holder,~value,~Logical,~original,context,cell,late,inside,0n,{==}),upper_new(~Holder,~value,~Logical,~original,context,cell,late,inside,1n,{==}),upper_new(~Holder,~value,~Logical,~original,context,cell,late,inside,2n,{==}),upper_new(~Holder,~value,~Logical,~original,context,cell,late,inside,3n,{==}),upper_new(~Holder,~value,~Logical,~original,context,cell,late,inside,4n,{==}),upper_new(~Holder,~value,~Logical,~original,context,cell,late,inside,5n,{==}),upper_new(~Holder,~value,~Logical,~original,context,cell,late,inside,6n,{==}),upper_new(~Holder,~value,~Logical,~original,context,cell,late,inside,7n,{==})}}

def next_cell(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,~Logical: Data,~original: Logical -> U32 -> F32,+context: PointNext<Holder,value,Logical,original>,+cell: Nat,+inside: {Nat.is_lt(cell,next_size(~Holder,~value,~Logical,~original,context)) == True{} : Bool}) -> NextCell(~Holder,~value,~Logical,~original,context,cell):
  cell_cases(~Holder,~value,~Logical,~original,context,cell,inside,Nat.is_lt(cell,next_early(~Holder,~value,~Logical,~original,context)),{==})

# ---- The operands and the work of a pointwise task ----

# The pairs of the weights and the bias a task reads.
type PointOperands is Data:
  PointOperands{pairs: Buffer.Model<Tile.Tile16>,bias: Buffer.Model<Tile.Tile8>}

def operand_pairs(model: PointOperands) -> Buffer.Model<Tile.Tile16>:
  PointOperands{pairs,bias} = model
  pairs

def operand_bias(model: PointOperands) -> Buffer.Model<Tile.Tile8>:
  PointOperands{pairs,bias} = model
  bias

def represent_operands(model: PointOperands) -> WindowPipeline.PointKept:
  PointOperands{pairs,bias} = model
  WindowPipeline.PointKept{Buffer.pack(~Tile.Tile16,pairs),Buffer.pack(~Tile.Tile8,bias)}

# The pairs of output channel groups of a problem, the pairs its weights are
# built into and the staged cells of a task.
def pairs_of_holder(~Logical: Data,~original: Logical -> U32 -> F32,+holder: Packed.WindowProblem<Logical,original>) -> Nat:
  Packed.WindowProblem{+limits,+logical,+activation,+channels,+outputs,+height,+width,+kernel,+stride,+padding,+weight_list,+bias_list,+groups_out,+images,+input_outer,+input_after,+input_lanes,+input_groups,+outer_word,+after_word,+lanes_word,+groups_word,+upper,+upper_ok,+upper_bound,+area_positive,+area_room,+weight_evidence,+bias_evidence,+parameters,+valid,+supported,+word_positive,+plane_positive,+plane_exact,+plane_room,+outputs_room,+groups_exact_out,+after_exact,+lanes_exact,+elements_room,+groups_exact,+positive,+input_after_exact,+input_lanes_exact,+input_groups_exact,+groups_room,+images_count_room,+images_outputs_room,+cells_room} = holder
  pair_total(outputs)

def pair_cells_of(~Logical: Data,~original: Logical -> U32 -> F32,+holder: Packed.WindowProblem<Logical,original>) -> Tree.Tree<Tile.Tile16>:
  Packed.WindowProblem{+limits,+logical,+activation,+channels,+outputs,+height,+width,+kernel,+stride,+padding,+weight_list,+bias_list,+groups_out,+images,+input_outer,+input_after,+input_lanes,+input_groups,+outer_word,+after_word,+lanes_word,+groups_word,+upper,+upper_ok,+upper_bound,+area_positive,+area_room,+weight_evidence,+bias_evidence,+parameters,+valid,+supported,+word_positive,+plane_positive,+plane_exact,+plane_room,+outputs_room,+groups_exact_out,+after_exact,+lanes_exact,+elements_room,+groups_exact,+positive,+input_after_exact,+input_lanes_exact,+input_groups_exact,+groups_room,+images_count_room,+images_outputs_room,+cells_room} = holder
  PointBuffer.pair_loop(MicroLeaf.rows(ImageProblems.problem(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,0n)),Coordinates.native_inner(ImageProblems.problem(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,0n)),Calls.weight_tree(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,0n,upper,upper_ok,upper_bound,area_positive,area_room,weight_evidence,bias_evidence,parameters),Spots.pair_source(ImageProblems.problem(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,0n)))

def Staged(~Logical: Data,~original: Logical -> U32 -> F32,+holder: Packed.WindowProblem<Logical,original>,+start: U32,+tree: Tree.Tree<Tile.Tile16>,+cell: Nat) -> Data:
  Packed.WindowProblem{+limits,+logical,+activation,+channels,+outputs,+height,+width,+kernel,+stride,+padding,+weight_list,+bias_list,+groups_out,+images,+input_outer,+input_after,+input_lanes,+input_groups,+outer_word,+after_word,+lanes_word,+groups_word,+upper,+upper_ok,+upper_bound,+area_positive,+area_room,+weight_evidence,+bias_evidence,+parameters,+valid,+supported,+word_positive,+plane_positive,+plane_exact,+plane_room,+outputs_room,+groups_exact_out,+after_exact,+lanes_exact,+elements_room,+groups_exact,+positive,+input_after_exact,+input_lanes_exact,+input_groups_exact,+groups_room,+images_count_room,+images_outputs_room,+cells_room} = holder
  StagedCell(~Logical,~original,logical,channels,outputs,height,width,kernel,stride,padding,weight_list,bias_list,start,tree,cell)

# The operands every task shares: the convolution of its problem, the pairs
# of its weights and its bias, and the kernel it picks.
type PointShared<-Logical: Data,-original: Logical -> U32 -> F32,-holder: Packed.WindowProblem<Logical,original>,-convolution: WindowPipeline.Convolution,-kept: PointOperands> is Data:
  PointShared{convolution_exact: {convolution == Packed.record_of(~Logical,~original,holder) : WindowPipeline.Convolution},
    direct: {WindowPipeline.pointwise(convolution) == True{} : Bool},
    pairs_exact: {Buffer.tree(~Tile.Tile16,operand_pairs(kept)) == pair_cells_of(~Logical,~original,holder) : Tree.Tree<Tile.Tile16>},
    bias_exact: {Buffer.tree(~Tile.Tile8,operand_bias(kept)) == Packed.bias_cells_of(~Logical,~original,holder) : Tree.Tree<Tile.Tile8>}}

# The work of a task between calls: the operands it reads, the staged pairs
# of the positions from start before position, room up to end.
type PointWorkHolds<-Logical: Data,-original: Logical -> U32 -> F32,-holder: Packed.WindowProblem<Logical,original>,-convolution: WindowPipeline.Convolution,-start: U32,-end: U32,-position: U32,-work: Point.PointModel> is Data:
  PointWorkHolds{shared: PointShared<Logical,original,holder,convolution,PointOperands{Point.point_pairs(work),Point.point_bias(work)}>,
    staged_depth: Nat,staged_depth_ok: {Nat.is_le(staged_depth,30n) == True{} : Bool},
