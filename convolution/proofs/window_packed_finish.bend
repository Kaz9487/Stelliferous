# ---- One piece of a task ----

# What a task holds between its pieces: the window it holds, its weights,
# bias and packing workspace.

# A padding step keeps the length of the content and its readiness.
def kept_same(-Ready: Data,-length: Nat,-content: Buffer.Content<Tile.Tile8>,
  +both: Gemm.Both<Ready,{Buffer.content_length(~Tile.Tile8,content) == length : Nat}>) -> {Buffer.content_length(~Tile.Tile8,content) == length : Nat}:
  Gemm.Both{+ready,+same} = both
  same

def kept_ready_of(-Ready: Data,-length: Nat,-content: Buffer.Content<Tile.Tile8>,
  +both: Gemm.Both<Ready,{Buffer.content_length(~Tile.Tile8,content) == length : Nat}>) -> Ready:
  Gemm.Both{+ready,+same} = both
  ready
