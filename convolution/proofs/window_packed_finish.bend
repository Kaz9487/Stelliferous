def first_outer(+outputs: Nat,+start: U32,+first: U32,+cell: Nat,+positive: {Nat.is_lt(0n,Calls.cell_groups(outputs)) == True{} : Bool},
  +first_exact: {U32.to_nat(first) == Nat.mul(U32.to_nat(start),Calls.cell_groups(outputs)) : Nat}) -> {Nat.div(Nat.add(U32.to_nat(first),cell),Calls.cell_groups(outputs)) == Nat.add(U32.to_nat(start),Nat.div(cell,Calls.cell_groups(outputs))) : Nat}:
  %Equal.sym(Nat,U32.to_nat(first),Nat.mul(U32.to_nat(start),Calls.cell_groups(outputs)),first_exact) : {Nat.div(Nat.add(_,cell),Calls.cell_groups(outputs)) == Nat.add(U32.to_nat(start),Nat.div(cell,Calls.cell_groups(outputs))) : Nat}
  DivisionOrder.quotient_shift(cell,Calls.cell_groups(outputs),U32.to_nat(start),positive)

def first_group(+outputs: Nat,+start: U32,+first: U32,+cell: Nat,+positive: {Nat.is_lt(0n,Calls.cell_groups(outputs)) == True{} : Bool},
  +first_exact: {U32.to_nat(first) == Nat.mul(U32.to_nat(start),Calls.cell_groups(outputs)) : Nat}) -> {Nat.mod(Nat.add(U32.to_nat(first),cell),Calls.cell_groups(outputs)) == Nat.mod(cell,Calls.cell_groups(outputs)) : Nat}:
  %Equal.sym(Nat,U32.to_nat(first),Nat.mul(U32.to_nat(start),Calls.cell_groups(outputs)),first_exact) : {Nat.mod(Nat.add(_,cell),Calls.cell_groups(outputs)) == Nat.mod(cell,Calls.cell_groups(outputs)) : Nat}
  DivisionOrder.remainder_shift(cell,Calls.cell_groups(outputs),U32.to_nat(start),positive)

# Where cell first + cell of the output lies: its position and its group.
def word_groups(+outputs: Nat,+groups_word: U32,+groups_exact: {U32.to_nat(groups_word) == Calls.cell_groups(outputs) : Nat},+positive: {Nat.is_lt(0n,Calls.cell_groups(outputs)) == True{} : Bool}) ->
  {Representation.least_one(U32.to_nat(groups_word)) == Calls.cell_groups(outputs) : Nat}:
  Equal.trans(Nat,Representation.least_one(U32.to_nat(groups_word)),U32.to_nat(groups_word),Calls.cell_groups(outputs),
    Representation.least_positive(U32.to_nat(groups_word),%Equal.sym(Nat,U32.to_nat(groups_word),Calls.cell_groups(outputs),groups_exact) : {Nat.is_lt(0n,_) == True{} : Bool} positive),groups_exact)

def global_outer(+outputs: Nat,+outer_word: U32,+after_word: U32,+lanes_word: U32,+groups_word: U32,+limits: Machine.Limits,+start: U32,+first: U32,+cell: Nat,
