    {Nat.div(_,Representation.least_one(U32.to_nat(groups_word))) == Nat.add(U32.to_nat(start),Nat.div(cell,Calls.cell_groups(outputs))) : Nat}
  %Equal.sym(Nat,Representation.least_one(U32.to_nat(groups_word)),Calls.cell_groups(outputs),word_groups(outputs,groups_word,groups_exact,positive)) :
    {Nat.div(Nat.add(U32.to_nat(first),cell),_) == Nat.add(U32.to_nat(start),Nat.div(cell,Calls.cell_groups(outputs))) : Nat}
  first_outer(outputs,start,first,cell,positive,first_exact)

def global_group(+outputs: Nat,+outer_word: U32,+after_word: U32,+lanes_word: U32,+groups_word: U32,+limits: Machine.Limits,+start: U32,+first: U32,+cell: Nat,
