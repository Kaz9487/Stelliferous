    case True{}:
      image_order(Nat.div(position,plane),Nat.div(last,plane),height,BandCover.band_end(height,kernel,stride,padding,Nat.div(Nat.mod(position,plane),width),Nat.div(Nat.sub(Nat.add(Nat.mod(position,plane),count),1n),width)),BandCover.band_end(height,kernel,stride,padding,reach_first,Nat.div(Nat.mod(last,plane),width)),test,end_below_height(height,kernel,stride,padding,Nat.div(Nat.mod(position,plane),width),Nat.div(Nat.sub(Nat.add(Nat.mod(position,plane),count),1n),width)))
    case False{}:
      +image = Nat.div(last,plane)
      +ordered = Order.transitive(position,Nat.sub(Nat.add(position,count),1n),last,before_last(position,count,count_positive),ends)
      +same = Order.antisymmetric(Nat.div(position,plane),image,DivisionOrder.quotient_le(position,last,plane,plane_positive,ordered),Order.not_less(Nat.div(position,plane),image,test))
      +shifted = Equal.trans(Nat,Nat.sub(Nat.add(position,count),1n),Nat.sub(Nat.add(Nat.mul(image,plane),Nat.add(Nat.mod(position,plane),count)),1n),Nat.add(Nat.mul(image,plane),Nat.sub(Nat.add(Nat.mod(position,plane),count),1n)),
        Equal.cong(Nat,Nat,value => Nat.sub(value,1n),Nat.add(position,count),Nat.add(Nat.mul(image,plane),Nat.add(Nat.mod(position,plane),count)),
          Equal.trans(Nat,Nat.add(position,count),Nat.add(Nat.add(Nat.mul(image,plane),Nat.mod(position,plane)),count),Nat.add(Nat.mul(image,plane),Nat.add(Nat.mod(position,plane),count)),
            Equal.cong(Nat,Nat,value => Nat.add(value,count),position,Nat.add(Nat.mul(image,plane),Nat.mod(position,plane)),
