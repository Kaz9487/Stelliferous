          DivisionOrder.quotient_le(Nat.sub(Nat.add(Nat.mod(position,plane),count),1n),Nat.mod(last,plane),width,width_positive,ended)))

# A call from a later position starts at or after the first row of the reach.
def start_inside(+height: Nat,+stride: Nat,+padding: Nat,+width: Nat,+plane: Nat,+first: Nat,+position: Nat,
  +positive: {Nat.is_lt(0n,stride) == True{} : Bool},+height_positive: {Nat.is_lt(0n,height) == True{} : Bool},
  +width_positive: {Nat.is_lt(0n,width) == True{} : Bool},+plane_positive: {Nat.is_lt(0n,plane) == True{} : Bool},
  +ordered: {Nat.is_le(first,position) == True{} : Bool}) ->
  {Nat.is_le(Nat.add(Nat.mul(Nat.div(first,plane),height),BandCover.band_first(height,stride,padding,Nat.div(Nat.mod(first,plane),width))),
    Nat.add(Nat.mul(Nat.div(position,plane),height),BandCover.band_first(height,stride,padding,Nat.div(Nat.mod(position,plane),width)))) == True{} : Bool}:
  start_with(Nat.is_lt(Nat.div(first,plane),Nat.div(position,plane)),height,stride,padding,width,plane,first,position,positive,height_positive,width_positive,plane_positive,ordered,{==})

# A call that ends at or before the last position ends at or before the end
# row of the reach, from any first row of its last band.
def call_end_inside(+height: Nat,+kernel: Nat,+stride: Nat,+padding: Nat,+width: Nat,+plane: Nat,+position: Nat,+count: Nat,+last: Nat,+reach_first: Nat,
  +positive: {Nat.is_lt(0n,stride) == True{} : Bool},+height_positive: {Nat.is_lt(0n,height) == True{} : Bool},
  +kernel_positive: {Nat.is_lt(0n,kernel) == True{} : Bool},+width_positive: {Nat.is_lt(0n,width) == True{} : Bool},+plane_positive: {Nat.is_lt(0n,plane) == True{} : Bool},
  +count_positive: {Nat.is_lt(0n,count) == True{} : Bool},+ends: {Nat.is_le(Nat.sub(Nat.add(position,count),1n),last) == True{} : Bool}) ->
  {Nat.is_le(Nat.add(Nat.mul(Nat.div(position,plane),height),BandCover.band_end(height,kernel,stride,padding,Nat.div(Nat.mod(position,plane),width),
      Nat.div(Nat.sub(Nat.add(Nat.mod(position,plane),count),1n),width))),
    Nat.add(Nat.mul(Nat.div(last,plane),height),BandCover.band_end(height,kernel,stride,padding,reach_first,Nat.div(Nat.mod(last,plane),width)))) == True{} : Bool}:
  end_with(Nat.is_lt(Nat.div(position,plane),Nat.div(last,plane)),height,kernel,stride,padding,width,plane,position,count,last,reach_first,
    positive,height_positive,kernel_positive,width_positive,plane_positive,count_positive,ends,{==})

# ---- Positions of one image ----

# Two positions of one image keep their order inside the image.
def same_order(+first: Nat,+last: Nat,+plane: Nat,+positive: {Nat.is_lt(0n,plane) == True{} : Bool},
  +same: {Nat.div(first,plane) == Nat.div(last,plane) : Nat},+ordered: {Nat.is_le(first,last) == True{} : Bool}) ->
  {Nat.is_le(Nat.mod(first,plane),Nat.mod(last,plane)) == True{} : Bool}:
  +base = Nat.mul(Nat.div(last,plane),plane)
  Order.cancel_offset_le(base,Nat.mod(first,plane),Nat.mod(last,plane),
    {%DivisionOrder.quotient_exact(last,plane,positive) : {Nat.is_le(Nat.add(base,Nat.mod(first,plane)),_) == True{} : Bool}
      %same : {Nat.is_le(Nat.add(Nat.mul(_,plane),Nat.mod(first,plane)),last) == True{} : Bool}
      %DivisionOrder.quotient_exact(first,plane,positive) : {Nat.is_le(_,last) == True{} : Bool}
      ordered : {Nat.is_le(Nat.add(base,Nat.mod(first,plane)),Nat.add(base,Nat.mod(last,plane))) == True{} : Bool}})

# The gap between two positions of one image is the gap inside the image.
def same_gap(+first: Nat,+last: Nat,+plane: Nat,+positive: {Nat.is_lt(0n,plane) == True{} : Bool},
  +same: {Nat.div(first,plane) == Nat.div(last,plane) : Nat},+ordered: {Nat.is_le(first,last) == True{} : Bool}) ->
  {Nat.add(Nat.mod(first,plane),Nat.sub(last,first)) == Nat.mod(last,plane) : Nat}:
  +base = Nat.mul(Nat.div(last,plane),plane)
  +low = Nat.mod(first,plane)
  +high = Nat.mod(last,plane)
  %Equal.sym(Nat,last,Nat.add(base,high),DivisionOrder.quotient_exact(last,plane,positive)) : {Nat.add(low,Nat.sub(_,first)) == high : Nat}
  %Equal.sym(Nat,first,Nat.add(Nat.mul(Nat.div(first,plane),plane),low),DivisionOrder.quotient_exact(first,plane,positive)) :
    {Nat.add(low,Nat.sub(Nat.add(base,high),_)) == high : Nat}
  %Equal.sym(Nat,Nat.div(first,plane),Nat.div(last,plane),same) : {Nat.add(low,Nat.sub(Nat.add(base,high),Nat.add(Nat.mul(_,plane),low))) == high : Nat}
  %Equal.sym(Nat,Nat.sub(Nat.add(base,high),Nat.add(base,low)),Nat.sub(high,low),RowMajor.subtract_common_prefix(base,high,low)) : {Nat.add(low,_) == high : Nat}
  Order.restore_shift(low,high,same_order(first,last,plane,positive,same,ordered))

# ---- The rows of a band as numbers ----

# The first row an output row reads, rounded down to the stride.
def start_word(choice: Bool,+limits: Machine.Limits,+s: U32,+p: U32,+row: U32,+value: Nat,
  +product_exact: {U32.to_nat((row * s : U32)) == Nat.mul(value,U32.to_nat(s)) : Nat},+product_room: {Nat.is_le(Nat.mul(value,U32.to_nat(s)),U32.to_nat(Machine.coordinate(limits))) == True{} : Bool},
  +stride_positive: {Nat.is_lt(0n,U32.to_nat(s)) == True{} : Bool},+stride_room: {Nat.is_le(U32.to_nat(s),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},+guard: {Nat.is_le(U32.to_nat(p),Nat.mul(value,U32.to_nat(s))) == choice : Bool}) ->
  {U32.to_nat(Bool.pick(U32,choice,(((row * s : U32) - p : U32) / s * s : U32),0)) ==
    Bool.pick(Nat,choice,Nat.mul(Nat.div(Nat.sub(Nat.mul(value,U32.to_nat(s)),U32.to_nat(p)),U32.to_nat(s)),U32.to_nat(s)),0n) : Nat}:
  match choice:
    case False{}: {==}
    case True{}:
      +top = Nat.mul(value,U32.to_nat(s))
      +rest = Nat.sub(top,U32.to_nat(p))
      +rest_room = Order.transitive(rest,top,U32.to_nat(Machine.coordinate(limits)),Order.sub_le(top,U32.to_nat(p)),product_room)
      +rest_exact = Arithmetic.difference_exact(Machine.coordinate(limits),LimitBounds.coordinate_fits(limits),(row * s : U32),p,top,U32.to_nat(p),product_exact,{==},guard,product_room)
      +quotient_exact = U32Division.quotient_exact(Machine.half_word(limits),LimitBounds.half_word_fits(limits),((row * s : U32) - p : U32),s,rest,U32.to_nat(s),rest_exact,{==},LimitBounds.double_bound(limits,U32.to_nat(s),stride_room),stride_positive)
      Arithmetic.product_exact(Machine.coordinate(limits),LimitBounds.coordinate_fits(limits),(((row * s : U32) - p : U32) / s : U32),s,Nat.div(rest,U32.to_nat(s)),U32.to_nat(s),quotient_exact,{==},
        Order.transitive(Nat.mul(Nat.div(rest,U32.to_nat(s)),U32.to_nat(s)),rest,U32.to_nat(Machine.coordinate(limits)),DivisionOrder.product_below(rest,U32.to_nat(s),stride_positive),rest_room))

def row_start_number(+limits: Machine.Limits,+s: U32,+p: U32,+row: U32,+value: Nat,+row_exact: {U32.to_nat(row) == value : Nat},
  +room: {Nat.is_le(Nat.mul(value,U32.to_nat(s)),U32.to_nat(Machine.coordinate(limits))) == True{} : Bool},+stride_positive: {Nat.is_lt(0n,U32.to_nat(s)) == True{} : Bool},+stride_room: {Nat.is_le(U32.to_nat(s),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}) ->
  {U32.to_nat(KernelWindow.first_row(s,p,row)) == BandCover.row_start(U32.to_nat(s),U32.to_nat(p),value) : Nat}:
  +product_exact = Arithmetic.product_exact(Machine.coordinate(limits),LimitBounds.coordinate_fits(limits),row,s,value,U32.to_nat(s),row_exact,{==},room)
  %Equal.sym(Bool,U32.is_le(p,(row * s : U32)),Nat.is_le(U32.to_nat(p),Nat.mul(value,U32.to_nat(s))),BandCover.le_exact(p,(row * s : U32),U32.to_nat(p),Nat.mul(value,U32.to_nat(s)),{==},product_exact)) :
    {U32.to_nat(Bool.pick(U32,_,(((row * s : U32) - p : U32) / s * s : U32),0)) == BandCover.row_start(U32.to_nat(s),U32.to_nat(p),value) : Nat}
