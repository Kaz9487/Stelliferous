        Order.not_less(Nat.div(first,plane),image,test))
      +aligned = {%same : {Nat.is_le(Nat.add(Nat.mul(_,plane),Nat.mod(first,plane)),Nat.add(Nat.mul(image,plane),Nat.mod(position,plane))) == True{} : Bool}
        {%DivisionOrder.quotient_exact(position,plane,plane_positive) : {Nat.is_le(Nat.add(Nat.mul(Nat.div(first,plane),plane),Nat.mod(first,plane)),_) == True{} : Bool}
          {%DivisionOrder.quotient_exact(first,plane,plane_positive) : {Nat.is_le(_,position) == True{} : Bool}
            ordered : {Nat.is_le(Nat.add(Nat.mul(Nat.div(first,plane),plane),Nat.mod(first,plane)),position) == True{} : Bool}}
          : {Nat.is_le(Nat.add(Nat.mul(Nat.div(first,plane),plane),Nat.mod(first,plane)),Nat.add(Nat.mul(image,plane),Nat.mod(position,plane))) == True{} : Bool}}
