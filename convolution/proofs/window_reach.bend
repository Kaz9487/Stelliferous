            Addition.associative(Nat.mul(image,plane),Nat.mod(position,plane),count))),
        Order.subtract_from_sum(Nat.mul(image,plane),Nat.add(Nat.mod(position,plane),count),1n,Order.transitive(1n,count,Nat.add(Nat.mod(position,plane),count),Order.positive_one(count,count_positive),Order.right_le(Nat.mod(position,plane),count))))
      +aligned = {%DivisionOrder.quotient_exact(last,plane,plane_positive) : {Nat.is_le(Nat.add(Nat.mul(image,plane),Nat.sub(Nat.add(Nat.mod(position,plane),count),1n)),_) == True{} : Bool}
        {%shifted : {Nat.is_le(_,last) == True{} : Bool} ends : {Nat.is_le(Nat.add(Nat.mul(image,plane),Nat.sub(Nat.add(Nat.mod(position,plane),count),1n)),last) == True{} : Bool}}
        : {Nat.is_le(Nat.add(Nat.mul(image,plane),Nat.sub(Nat.add(Nat.mod(position,plane),count),1n)),Nat.add(Nat.mul(image,plane),Nat.mod(last,plane))) == True{} : Bool}}
      +ended = Order.cancel_offset_le(Nat.mul(image,plane),Nat.sub(Nat.add(Nat.mod(position,plane),count),1n),Nat.mod(last,plane),aligned)
      %Equal.sym(Nat,Nat.div(position,plane),image,same) : {Nat.is_le(Nat.add(Nat.mul(_,height),BandCover.band_end(height,kernel,stride,padding,Nat.div(Nat.mod(position,plane),width),Nat.div(Nat.sub(Nat.add(Nat.mod(position,plane),count),1n),width))),Nat.add(Nat.mul(Nat.div(last,plane),height),BandCover.band_end(height,kernel,stride,padding,reach_first,Nat.div(Nat.mod(last,plane),width)))) == True{} : Bool}
      Order.offset_le(Nat.mul(image,height),BandCover.band_end(height,kernel,stride,padding,Nat.div(Nat.mod(position,plane),width),Nat.div(Nat.sub(Nat.add(Nat.mod(position,plane),count),1n),width)),BandCover.band_end(height,kernel,stride,padding,reach_first,Nat.div(Nat.mod(last,plane),width)),
