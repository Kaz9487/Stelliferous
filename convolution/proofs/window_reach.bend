# ---- Order facts ----

# A value not at or above another lies below it.
def above_of_not_le(+low: Nat,+high: Nat,+guard: {Nat.is_le(high,low) == False{} : Bool}) -> {Nat.is_lt(low,high) == True{} : Bool}:
  match low high:
    case 0n 0n: Empty.absurd({Nat.is_lt(0n,0n) == True{} : Bool},WordEncoding.false_true(Equal.sym(Bool,True{},False{},guard)))
    case 1n+ +rest 0n: Empty.absurd({Nat.is_lt(1n+rest,0n) == True{} : Bool},WordEncoding.false_true(Equal.sym(Bool,True{},False{},guard)))
    case 0n 1n+ +more: {==}
    case 1n+ +rest 1n+ +more: above_of_not_le(rest,more,guard)

# Below a larger value, the difference is positive.
def gap_positive(+low: Nat,+high: Nat,+less: {Nat.is_lt(low,high) == True{} : Bool}) -> {Nat.is_lt(0n,Nat.sub(high,low)) == True{} : Bool}:
  match low high:
    case 0n 0n: Empty.absurd({Nat.is_lt(0n,Nat.sub(0n,0n)) == True{} : Bool},WordEncoding.false_true(less))
    case 1n+ +rest 0n: Empty.absurd({Nat.is_lt(0n,Nat.sub(0n,1n+rest)) == True{} : Bool},WordEncoding.false_true(less))
    case 0n 1n+ +more: {==}
    case 1n+ +rest 1n+ +more: gap_positive(rest,more,less)

# A value at most the predecessor of a positive value lies below it.
def below_predecessor(+value: Nat,+bound: Nat,+positive: {Nat.is_lt(0n,bound) == True{} : Bool},+below: {Nat.is_le(value,Nat.sub(bound,1n)) == True{} : Bool}) ->
  {Nat.is_lt(value,bound) == True{} : Bool}:
  match bound:
    case 0n: Empty.absurd({Nat.is_lt(value,0n) == True{} : Bool},WordEncoding.false_true(positive))
    case 1n+ +rest: Order.lt_succ(value,rest,{%Order.subtract_zero(rest) : {Nat.is_le(value,_) == True{} : Bool} below : {Nat.is_le(value,rest) == True{} : Bool}})

def min_left_monotone(+left: Nat,+right: Nat,+limit: Nat,+ordered: {Nat.is_le(left,right) == True{} : Bool}) ->
  {Nat.is_le(Nat.min(left,limit),Nat.min(right,limit)) == True{} : Bool}:
  NatExtrema.minimum_lower(right,limit,Nat.min(left,limit),
    Order.transitive(Nat.min(left,limit),left,right,NatExtrema.minimum_left(left,limit),ordered),NatExtrema.minimum_right(left,limit))

def max_monotone(+left: Nat,+right: Nat,+larger_left: Nat,+larger_right: Nat,+left_ordered: {Nat.is_le(left,larger_left) == True{} : Bool},
  +right_ordered: {Nat.is_le(right,larger_right) == True{} : Bool}) -> {Nat.is_le(Nat.max(left,right),Nat.max(larger_left,larger_right)) == True{} : Bool}:
  NatExtrema.maximum_upper(left,right,Nat.max(larger_left,larger_right),
    Order.transitive(left,larger_left,Nat.max(larger_left,larger_right),left_ordered,NatExtrema.maximum_left(larger_left,larger_right)),
    Order.transitive(right,larger_right,Nat.max(larger_left,larger_right),right_ordered,NatExtrema.maximum_right(larger_left,larger_right)))

# ---- Rows of a band ----

def start_order(c1: Bool,c2: Bool,+stride: Nat,+padding: Nat,+r1: Nat,+r2: Nat,+positive: {Nat.is_lt(0n,stride) == True{} : Bool},
  +ordered: {Nat.is_le(r1,r2) == True{} : Bool},+e1: {Nat.is_le(padding,Nat.mul(r1,stride)) == c1 : Bool},+e2: {Nat.is_le(padding,Nat.mul(r2,stride)) == c2 : Bool}) ->
  {Nat.is_le(Bool.pick(Nat,c1,Nat.mul(Nat.div(Nat.sub(Nat.mul(r1,stride),padding),stride),stride),0n),
    Bool.pick(Nat,c2,Nat.mul(Nat.div(Nat.sub(Nat.mul(r2,stride),padding),stride),stride),0n)) == True{} : Bool}:
  match c1 c2:
    case False{} c2: Order.zero_le(Bool.pick(Nat,c2,Nat.mul(Nat.div(Nat.sub(Nat.mul(r2,stride),padding),stride),stride),0n))
    case True{} True{}:
      RowMajor.mul_le(Nat.div(Nat.sub(Nat.mul(r1,stride),padding),stride),Nat.div(Nat.sub(Nat.mul(r2,stride),padding),stride),stride,
        DivisionOrder.quotient_le(Nat.sub(Nat.mul(r1,stride),padding),Nat.sub(Nat.mul(r2,stride),padding),stride,positive,
          DivisionOrder.subtract_le(Nat.mul(r1,stride),Nat.mul(r2,stride),padding,RowMajor.mul_le(r1,r2,stride,ordered))))
    case True{} False{}:
      Empty.absurd({Nat.is_le(Nat.mul(Nat.div(Nat.sub(Nat.mul(r1,stride),padding),stride),stride),0n) == True{} : Bool},
        WordEncoding.false_true(Equal.trans(Bool,False{},Nat.is_le(padding,Nat.mul(r2,stride)),True{},Equal.sym(Bool,Nat.is_le(padding,Nat.mul(r2,stride)),False{},e2),
          Order.transitive(padding,Nat.mul(r1,stride),Nat.mul(r2,stride),e1,RowMajor.mul_le(r1,r2,stride,ordered)))))

# The first row a later output row reads is not above the first row of an
# earlier one.
def start_monotone(+stride: Nat,+padding: Nat,+r1: Nat,+r2: Nat,+positive: {Nat.is_lt(0n,stride) == True{} : Bool},+ordered: {Nat.is_le(r1,r2) == True{} : Bool}) ->
  {Nat.is_le(BandCover.row_start(stride,padding,r1),BandCover.row_start(stride,padding,r2)) == True{} : Bool}:
  start_order(Nat.is_le(padding,Nat.mul(r1,stride)),Nat.is_le(padding,Nat.mul(r2,stride)),stride,padding,r1,r2,positive,ordered,{==},{==})

def first_monotone(+height: Nat,+stride: Nat,+padding: Nat,+r1: Nat,+r2: Nat,+positive: {Nat.is_lt(0n,stride) == True{} : Bool},
  +ordered: {Nat.is_le(r1,r2) == True{} : Bool}) ->
  {Nat.is_le(BandCover.band_first(height,stride,padding,r1),BandCover.band_first(height,stride,padding,r2)) == True{} : Bool}:
  min_left_monotone(BandCover.row_start(stride,padding,r1),BandCover.row_start(stride,padding,r2),BandCover.last_start(height,stride),
    start_monotone(stride,padding,r1,r2,positive,ordered))

def end_order(c1: Bool,c2: Bool,+height: Nat,+kernel: Nat,+stride: Nat,+padding: Nat,+r1: Nat,+r2: Nat,+ordered: {Nat.is_le(r1,r2) == True{} : Bool},
  +e1: {Nat.is_le(BandCover.reach(kernel,stride,r1),padding) == c1 : Bool},+e2: {Nat.is_le(BandCover.reach(kernel,stride,r2),padding) == c2 : Bool}) ->
  {Nat.is_le(Bool.pick(Nat,c1,0n,Nat.min(height,Nat.sub(BandCover.reach(kernel,stride,r1),padding))),
    Bool.pick(Nat,c2,0n,Nat.min(height,Nat.sub(BandCover.reach(kernel,stride,r2),padding)))) == True{} : Bool}:
  match c1 c2:
    case True{} c2: Order.zero_le(Bool.pick(Nat,c2,0n,Nat.min(height,Nat.sub(BandCover.reach(kernel,stride,r2),padding))))
    case False{} False{}:
    +reach_le = Order.add_le(Nat.mul(r1,stride),Nat.mul(r2,stride),kernel,RowMajor.mul_le(r1,r2,stride,ordered))
      NatExtrema.minimum_monotone(Nat.sub(BandCover.reach(kernel,stride,r1),padding),Nat.sub(BandCover.reach(kernel,stride,r2),padding),height,
        DivisionOrder.subtract_le(BandCover.reach(kernel,stride,r1),BandCover.reach(kernel,stride,r2),padding,reach_le))
    case False{} True{}:
    +reach_le = Order.add_le(Nat.mul(r1,stride),Nat.mul(r2,stride),kernel,RowMajor.mul_le(r1,r2,stride,ordered))
      Empty.absurd({Nat.is_le(Nat.min(height,Nat.sub(BandCover.reach(kernel,stride,r1),padding)),0n) == True{} : Bool},
        WordEncoding.false_true(Equal.trans(Bool,False{},Nat.is_le(BandCover.reach(kernel,stride,r1),padding),True{},
          Equal.sym(Bool,Nat.is_le(BandCover.reach(kernel,stride,r1),padding),False{},e1),
          Order.transitive(BandCover.reach(kernel,stride,r1),BandCover.reach(kernel,stride,r2),padding,reach_le,e2))))

# The end row a later output row reads is not above the end row of an
# earlier one.
def end_monotone(+height: Nat,+kernel: Nat,+stride: Nat,+padding: Nat,+r1: Nat,+r2: Nat,+ordered: {Nat.is_le(r1,r2) == True{} : Bool}) ->
  {Nat.is_le(BandCover.row_end(height,kernel,stride,padding,r1),BandCover.row_end(height,kernel,stride,padding,r2)) == True{} : Bool}:
  end_order(Nat.is_le(BandCover.reach(kernel,stride,r1),padding),Nat.is_le(BandCover.reach(kernel,stride,r2),padding),height,kernel,stride,padding,r1,r2,ordered,{==},{==})

def start_zero(c: Bool,+stride: Nat,+padding: Nat,+row: Nat,+positive: {Nat.is_lt(0n,stride) == True{} : Bool},
  +below: {Nat.is_le(Nat.mul(row,stride),padding) == True{} : Bool},+e: {Nat.is_le(padding,Nat.mul(row,stride)) == c : Bool}) ->
  {Bool.pick(Nat,c,Nat.mul(Nat.div(Nat.sub(Nat.mul(row,stride),padding),stride),stride),0n) == 0n : Nat}:
  match c:
    case False{}: {==}
    case True{}:
      %Equal.sym(Nat,Nat.sub(Nat.mul(row,stride),padding),0n,Order.subtract_below(Nat.mul(row,stride),padding,below)) :
        {Nat.mul(Nat.div(_,stride),stride) == 0n : Nat}
      %Equal.sym(Nat,Nat.div(0n,stride),0n,Radix.quotient(0n,0n,stride,positive,positive)) : {Nat.mul(_,stride) == 0n : Nat}
      {==}

def reach_gap(c: Bool,+height: Nat,+kernel: Nat,+stride: Nat,+padding: Nat,+row: Nat,+positive: {Nat.is_lt(0n,stride) == True{} : Bool},
  +kernel_positive: {Nat.is_lt(0n,kernel) == True{} : Bool},+above: {Nat.is_lt(padding,BandCover.reach(kernel,stride,row)) == True{} : Bool},
  +e: {Nat.is_le(padding,Nat.mul(row,stride)) == c : Bool}) ->
  {Nat.is_lt(Nat.min(Bool.pick(Nat,c,Nat.mul(Nat.div(Nat.sub(Nat.mul(row,stride),padding),stride),stride),0n),BandCover.last_start(height,stride)),
    Nat.sub(BandCover.reach(kernel,stride,row),padding)) == True{} : Bool}:
  match c:
    case False{}:
      Order.le_lt_trans(Nat.min(0n,BandCover.last_start(height,stride)),0n,Nat.sub(BandCover.reach(kernel,stride,row),padding),
        NatExtrema.minimum_left(0n,BandCover.last_start(height,stride)),gap_positive(padding,BandCover.reach(kernel,stride,row),above))
    case True{}:
      +start = Nat.mul(row,stride)
      +gap = Nat.sub(start,padding)
      +shifted = Equal.trans(Nat,Nat.add(gap,kernel),Nat.add(kernel,gap),Nat.sub(Nat.add(start,kernel),padding),Order.commutative(gap,kernel),
        Equal.trans(Nat,Nat.add(kernel,gap),Nat.sub(Nat.add(kernel,start),padding),Nat.sub(Nat.add(start,kernel),padding),
          Equal.sym(Nat,Nat.sub(Nat.add(kernel,start),padding),Nat.add(kernel,gap),Order.subtract_from_sum(kernel,start,padding,e)),
          Equal.cong(Nat,Nat,value => Nat.sub(value,padding),Nat.add(kernel,start),Nat.add(start,kernel),Order.commutative(kernel,start))))
      +less = {%shifted : {Nat.is_lt(gap,_) == True{} : Bool}
        %Addition.zero_right(gap) : {Nat.is_lt(_,Nat.add(gap,kernel)) == True{} : Bool}
        Order.offset_lt(gap,0n,kernel,kernel_positive) : {Nat.is_lt(gap,Nat.sub(Nat.add(start,kernel),padding)) == True{} : Bool}}
      Order.le_lt_trans(Nat.min(Nat.mul(Nat.div(gap,stride),stride),BandCover.last_start(height,stride)),gap,Nat.sub(BandCover.reach(kernel,stride,row),padding),
        Order.transitive(Nat.min(Nat.mul(Nat.div(gap,stride),stride),BandCover.last_start(height,stride)),Nat.mul(Nat.div(gap,stride),stride),gap,
          NatExtrema.minimum_left(Nat.mul(Nat.div(gap,stride),stride),BandCover.last_start(height,stride)),DivisionOrder.product_below(gap,stride,positive)),less)

def first_end_with(c: Bool,+height: Nat,+kernel: Nat,+stride: Nat,+padding: Nat,+row: Nat,+positive: {Nat.is_lt(0n,stride) == True{} : Bool},
  +height_positive: {Nat.is_lt(0n,height) == True{} : Bool},+kernel_positive: {Nat.is_lt(0n,kernel) == True{} : Bool},
  +e: {Nat.is_le(BandCover.reach(kernel,stride,row),padding) == c : Bool}) ->
  {Nat.is_le(Nat.add(BandCover.band_first(height,stride,padding,row),1n),
    Nat.max(Bool.pick(Nat,c,0n,Nat.min(height,Nat.sub(BandCover.reach(kernel,stride,row),padding))),1n)) == True{} : Bool}:
  match c:
    case True{}:
    +first = BandCover.band_first(height,stride,padding,row)
    +start = BandCover.row_start(stride,padding,row)
    +last = BandCover.last_start(height,stride)
      +below = Order.transitive(Nat.mul(row,stride),BandCover.reach(kernel,stride,row),padding,Order.le_add(Nat.mul(row,stride),kernel),e)
      +zero = {%start_zero(Nat.is_le(padding,Nat.mul(row,stride)),stride,padding,row,positive,below,{==}) : {Nat.is_le(first,_) == True{} : Bool}
        NatExtrema.minimum_left(start,last) : {Nat.is_le(first,0n) == True{} : Bool}}
      Order.add_le(first,0n,1n,zero)
    case False{}:
    +first = BandCover.band_first(height,stride,padding,row)
    +start = BandCover.row_start(stride,padding,row)
    +last = BandCover.last_start(height,stride)
      +above = above_of_not_le(padding,BandCover.reach(kernel,stride,row),e)
      +below_height = below_predecessor(first,height,height_positive,
        Order.transitive(first,last,Nat.sub(height,1n),NatExtrema.minimum_right(start,last),DivisionOrder.product_below(Nat.sub(height,1n),stride,positive)))
      +strict = NatExtrema.minimum_strict_lower(height,Nat.sub(BandCover.reach(kernel,stride,row),padding),first,below_height,
        reach_gap(Nat.is_le(padding,Nat.mul(row,stride)),height,kernel,stride,padding,row,positive,kernel_positive,above,{==}))
      Order.transitive(Nat.add(first,1n),Nat.min(height,Nat.sub(BandCover.reach(kernel,stride,row),padding)),
        Nat.max(Nat.min(height,Nat.sub(BandCover.reach(kernel,stride,row),padding)),1n),
        %Equal.sym(Nat,Nat.add(first,1n),1n+first,Equal.trans(Nat,Nat.add(first,1n),1n+Nat.add(first,0n),1n+first,Addition.successor_right(first,0n),
            Equal.cong(Nat,Nat,value => 1n+value,Nat.add(first,0n),first,Addition.zero_right(first)))) :
          {Nat.is_le(_,Nat.min(height,Nat.sub(BandCover.reach(kernel,stride,row),padding))) == True{} : Bool}
        Order.strict_follow(first,Nat.min(height,Nat.sub(BandCover.reach(kernel,stride,row),padding)),strict),
        NatExtrema.maximum_left(Nat.min(height,Nat.sub(BandCover.reach(kernel,stride,row),padding)),1n))

# The row after the first row of an output row is at most its end row, or the
# row after the top.
def first_end(+height: Nat,+kernel: Nat,+stride: Nat,+padding: Nat,+row: Nat,+positive: {Nat.is_lt(0n,stride) == True{} : Bool},
  +height_positive: {Nat.is_lt(0n,height) == True{} : Bool},+kernel_positive: {Nat.is_lt(0n,kernel) == True{} : Bool}) ->
  {Nat.is_le(Nat.add(BandCover.band_first(height,stride,padding,row),1n),Nat.max(BandCover.row_end(height,kernel,stride,padding,row),1n)) == True{} : Bool}:
  first_end_with(Nat.is_le(BandCover.reach(kernel,stride,row),padding),height,kernel,stride,padding,row,positive,height_positive,kernel_positive,{==})

# A band from a later first row that ends at an earlier last row ends at most
# where the band from the first row of the reach to its last row ends.
def end_inside(+height: Nat,+kernel: Nat,+stride: Nat,+padding: Nat,+first: Nat,+last: Nat,+reach_first: Nat,+reach_last: Nat,
  +positive: {Nat.is_lt(0n,stride) == True{} : Bool},+height_positive: {Nat.is_lt(0n,height) == True{} : Bool},+kernel_positive: {Nat.is_lt(0n,kernel) == True{} : Bool},
  +first_inside: {Nat.is_le(first,reach_last) == True{} : Bool},+last_inside: {Nat.is_le(last,reach_last) == True{} : Bool}) ->
  {Nat.is_le(BandCover.band_end(height,kernel,stride,padding,first,last),BandCover.band_end(height,kernel,stride,padding,reach_first,reach_last)) == True{} : Bool}:
  +end_row = BandCover.row_end(height,kernel,stride,padding,reach_last)
  +start = Nat.add(BandCover.band_first(height,stride,padding,reach_first),1n)
  +top = Nat.max(end_row,start)
  NatExtrema.minimum_monotone(Nat.max(BandCover.row_end(height,kernel,stride,padding,last),Nat.add(BandCover.band_first(height,stride,padding,first),1n)),top,height,
    NatExtrema.maximum_upper(BandCover.row_end(height,kernel,stride,padding,last),Nat.add(BandCover.band_first(height,stride,padding,first),1n),top,
      Order.transitive(BandCover.row_end(height,kernel,stride,padding,last),end_row,top,end_monotone(height,kernel,stride,padding,last,reach_last,last_inside),
        NatExtrema.maximum_left(end_row,start)),
      Order.transitive(Nat.add(BandCover.band_first(height,stride,padding,first),1n),Nat.add(BandCover.band_first(height,stride,padding,reach_last),1n),top,
        Order.add_le(BandCover.band_first(height,stride,padding,first),BandCover.band_first(height,stride,padding,reach_last),1n,
          first_monotone(height,stride,padding,first,reach_last,positive,first_inside)),
        Order.transitive(Nat.add(BandCover.band_first(height,stride,padding,reach_last),1n),Nat.max(end_row,1n),top,
          first_end(height,kernel,stride,padding,reach_last,positive,height_positive,kernel_positive),
          max_monotone(end_row,1n,end_row,start,Order.reflexive(end_row),Order.right_le(BandCover.band_first(height,stride,padding,reach_first),1n))))))

# ---- Rows across images ----

# A row of an earlier image, at most its height in, lies at or before any row
# of a later image.
def image_order(+earlier: Nat,+later: Nat,+height: Nat,+row: Nat,+other: Nat,+less: {Nat.is_lt(earlier,later) == True{} : Bool},
  +inside: {Nat.is_le(row,height) == True{} : Bool}) ->
  {Nat.is_le(Nat.add(Nat.mul(earlier,height),row),Nat.add(Nat.mul(later,height),other)) == True{} : Bool}:
  +next = Nat.add(Nat.mul(earlier,height),height)
  Order.transitive(Nat.add(Nat.mul(earlier,height),row),next,Nat.add(Nat.mul(later,height),other),
    Order.offset_le(Nat.mul(earlier,height),row,height,inside),
    Order.transitive(next,Nat.mul(later,height),Nat.add(Nat.mul(later,height),other),
      {%Order.commutative(height,Nat.mul(earlier,height)) : {Nat.is_le(_,Nat.mul(later,height)) == True{} : Bool}
        RowMajor.mul_le(1n+earlier,later,height,Order.strict_follow(earlier,later,less)) :
        {Nat.is_le(next,Nat.mul(later,height)) == True{} : Bool}},
      Order.le_add(Nat.mul(later,height),other)))

# The first row of a band lies inside the image.
def first_below_height(+height: Nat,+stride: Nat,+padding: Nat,+row: Nat,+positive: {Nat.is_lt(0n,stride) == True{} : Bool},
  +height_positive: {Nat.is_lt(0n,height) == True{} : Bool}) -> {Nat.is_le(BandCover.band_first(height,stride,padding,row),height) == True{} : Bool}:
  Bounds.strict_le(BandCover.band_first(height,stride,padding,row),height,
    below_predecessor(BandCover.band_first(height,stride,padding,row),height,height_positive,
      Order.transitive(BandCover.band_first(height,stride,padding,row),BandCover.last_start(height,stride),Nat.sub(height,1n),
        NatExtrema.minimum_right(BandCover.row_start(stride,padding,row),BandCover.last_start(height,stride)),
        DivisionOrder.product_below(Nat.sub(height,1n),stride,positive))))

# The end row of a band lies inside the image.
def end_below_height(+height: Nat,+kernel: Nat,+stride: Nat,+padding: Nat,+first: Nat,+last: Nat) ->
  {Nat.is_le(BandCover.band_end(height,kernel,stride,padding,first,last),height) == True{} : Bool}:
  NatExtrema.minimum_left(height,Nat.max(BandCover.row_end(height,kernel,stride,padding,last),Nat.add(BandCover.band_first(height,stride,padding,first),1n)))

# ---- The first row of a call ----

def start_with(less: Bool,+height: Nat,+stride: Nat,+padding: Nat,+width: Nat,+plane: Nat,+first: Nat,+position: Nat,
  +positive: {Nat.is_lt(0n,stride) == True{} : Bool},+height_positive: {Nat.is_lt(0n,height) == True{} : Bool},
  +width_positive: {Nat.is_lt(0n,width) == True{} : Bool},+plane_positive: {Nat.is_lt(0n,plane) == True{} : Bool},
  +ordered: {Nat.is_le(first,position) == True{} : Bool},+test: {Nat.is_lt(Nat.div(first,plane),Nat.div(position,plane)) == less : Bool}) ->
  {Nat.is_le(Nat.add(Nat.mul(Nat.div(first,plane),height),BandCover.band_first(height,stride,padding,Nat.div(Nat.mod(first,plane),width))),
    Nat.add(Nat.mul(Nat.div(position,plane),height),BandCover.band_first(height,stride,padding,Nat.div(Nat.mod(position,plane),width)))) == True{} : Bool}:
  match less:
    case True{}:
      image_order(Nat.div(first,plane),Nat.div(position,plane),height,BandCover.band_first(height,stride,padding,Nat.div(Nat.mod(first,plane),width)),
        BandCover.band_first(height,stride,padding,Nat.div(Nat.mod(position,plane),width)),test,
        first_below_height(height,stride,padding,Nat.div(Nat.mod(first,plane),width),positive,height_positive))
    case False{}:
      +image = Nat.div(position,plane)
