# A value is at most its sum with a positive count, less one.
def before_last(+value: Nat,+count: Nat,+count_positive: {Nat.is_lt(0n,count) == True{} : Bool}) ->
  {Nat.is_le(value,Nat.sub(Nat.add(value,count),1n)) == True{} : Bool}:
  %Equal.sym(Nat,Nat.sub(Nat.add(value,count),1n),Nat.add(value,Nat.sub(count,1n)),Order.subtract_from_sum(value,count,1n,Order.positive_one(count,count_positive))) : {Nat.is_le(value,_) == True{} : Bool}
  Order.le_add(value,Nat.sub(count,1n))

# ---- The end row of a call ----

def end_with(less: Bool,+height: Nat,+kernel: Nat,+stride: Nat,+padding: Nat,+width: Nat,+plane: Nat,+position: Nat,+count: Nat,+last: Nat,+reach_first: Nat,
  +positive: {Nat.is_lt(0n,stride) == True{} : Bool},+height_positive: {Nat.is_lt(0n,height) == True{} : Bool},+kernel_positive: {Nat.is_lt(0n,kernel) == True{} : Bool},+width_positive: {Nat.is_lt(0n,width) == True{} : Bool},+plane_positive: {Nat.is_lt(0n,plane) == True{} : Bool},+count_positive: {Nat.is_lt(0n,count) == True{} : Bool},+ends: {Nat.is_le(Nat.sub(Nat.add(position,count),1n),last) == True{} : Bool},+test: {Nat.is_lt(Nat.div(position,plane),Nat.div(last,plane)) == less : Bool}) ->
  {Nat.is_le(Nat.add(Nat.mul(Nat.div(position,plane),height),BandCover.band_end(height,kernel,stride,padding,Nat.div(Nat.mod(position,plane),width),Nat.div(Nat.sub(Nat.add(Nat.mod(position,plane),count),1n),width))),Nat.add(Nat.mul(Nat.div(last,plane),height),BandCover.band_end(height,kernel,stride,padding,reach_first,Nat.div(Nat.mod(last,plane),width)))) == True{} : Bool}:
