    Order.transitive(Nat.mul(Nat.div(lower,U32.to_nat(s)),U32.to_nat(s)),lower,U32.to_nat(Machine.capacity(limits)),DivisionOrder.product_below(lower,U32.to_nat(s),stride_positive),Order.transitive(lower,U32.to_nat(h),U32.to_nat(Machine.capacity(limits)),Order.sub_le(U32.to_nat(h),1n),height_room)))

# The first row of the band of positions [offset, offset + span) of an image.
def first_number(+limits: Machine.Limits,+h: U32,+k: U32,+s: U32,+p: U32,+ow: U32,+offset: U32,+span: U32,+height_positive: {Nat.is_lt(0n,U32.to_nat(h)) == True{} : Bool},+height_room: {Nat.is_le(U32.to_nat(h),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},+stride_positive: {Nat.is_lt(0n,U32.to_nat(s)) == True{} : Bool},+stride_room: {Nat.is_le(U32.to_nat(s),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},+width_positive: {Nat.is_lt(0n,U32.to_nat(ow)) == True{} : Bool},+width_room: {Nat.is_le(U32.to_nat(ow),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},
  +row_room: {Nat.is_le(Nat.mul(Nat.div(U32.to_nat(offset),U32.to_nat(ow)),U32.to_nat(s)),U32.to_nat(Machine.coordinate(limits))) == True{} : Bool}) -> {U32.to_nat(Band.band_first(KernelWindow.band(0,h,h,k,s,p,ow,offset,span))) == BandCover.band_first(U32.to_nat(h),U32.to_nat(s),U32.to_nat(p),Nat.div(U32.to_nat(offset),U32.to_nat(ow))) : Nat}:
