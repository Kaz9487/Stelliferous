  +row_exact = Laws.word_quotient(limits,offset,ow,width_room,width_positive)
  +start = KernelWindow.first_row(s,p,row)
  +top = (((0 + h : U32) - 1 : U32) / s * s : U32)
  +lower = U32.min(start,top)
  +lower_exact = Equal.trans(Nat,U32.to_nat(lower),Nat.min(U32.to_nat(start),U32.to_nat(top)),BandCover.band_first(U32.to_nat(h),U32.to_nat(s),U32.to_nat(p),Nat.div(U32.to_nat(offset),U32.to_nat(ow))),Extrema.minimum(start,top),
    %Equal.sym(Nat,U32.to_nat(start),BandCover.row_start(U32.to_nat(s),U32.to_nat(p),Nat.div(U32.to_nat(offset),U32.to_nat(ow))),row_start_number(limits,s,p,row,Nat.div(U32.to_nat(offset),U32.to_nat(ow)),row_exact,row_room,stride_positive,stride_room)) :
      {Nat.min(_,U32.to_nat(top)) == BandCover.band_first(U32.to_nat(h),U32.to_nat(s),U32.to_nat(p),Nat.div(U32.to_nat(offset),U32.to_nat(ow))) : Nat}
    %Equal.sym(Nat,U32.to_nat(top),BandCover.last_start(U32.to_nat(h),U32.to_nat(s)),last_start_number(limits,h,s,height_positive,height_room,stride_positive,stride_room)) :
      {Nat.min(BandCover.row_start(U32.to_nat(s),U32.to_nat(p),Nat.div(U32.to_nat(offset),U32.to_nat(ow))),_) == BandCover.band_first(U32.to_nat(h),U32.to_nat(s),U32.to_nat(p),Nat.div(U32.to_nat(offset),U32.to_nat(ow))) : Nat}
    {==})
  %lower_exact : {U32.to_nat(U32.max(0,lower)) == _ : Nat}
  %BandCover.max_zero(U32.to_nat(lower)) : {U32.to_nat(U32.max(0,lower)) == _ : Nat}
  Extrema.maximum(0,lower)

# The row of the last of the positions [offset, offset + span).
def last_row_number(+limits: Machine.Limits,+ow: U32,+offset: U32,+span: U32,+positive: {Nat.is_lt(0n,U32.to_nat(span)) == True{} : Bool},+sum_room: {Nat.is_le(Nat.add(U32.to_nat(offset),U32.to_nat(span)),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},+width_positive: {Nat.is_lt(0n,U32.to_nat(ow)) == True{} : Bool},+width_room: {Nat.is_le(U32.to_nat(ow),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}) ->
  {U32.to_nat(((offset + span - 1) / ow : U32)) == Nat.div(Nat.sub(Nat.add(U32.to_nat(offset),U32.to_nat(span)),1n),U32.to_nat(ow)) : Nat}:
