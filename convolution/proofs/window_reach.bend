# The last stride-aligned row of an image.
def last_start_number(+limits: Machine.Limits,+h: U32,+s: U32,+height_positive: {Nat.is_lt(0n,U32.to_nat(h)) == True{} : Bool},+height_room: {Nat.is_le(U32.to_nat(h),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},+stride_positive: {Nat.is_lt(0n,U32.to_nat(s)) == True{} : Bool},+stride_room: {Nat.is_le(U32.to_nat(s),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}) ->
  {U32.to_nat((((0 + h : U32) - 1 : U32) / s * s : U32)) == BandCover.last_start(U32.to_nat(h),U32.to_nat(s)) : Nat}:
