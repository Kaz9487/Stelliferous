  +quotient_exact = U32Division.quotient_exact(Machine.half_word(limits),LimitBounds.half_word_fits(limits),((0 + h : U32) - 1 : U32),s,lower,U32.to_nat(s),lower_exact,{==},LimitBounds.double_bound(limits,U32.to_nat(s),stride_room),stride_positive)
