  match batched:
    case True{}: {==}
    case False{}: {==}

def shape_known_of(batched: Bool,+count: U32,+channels: U32,+height: U32,+width: U32) ->
  {TensorConvolution.input_shape(TensorConvolution.output_shape(batched,images(batched,count),channels,height,width)) == Some{TensorConvolution.InputShape{images(batched,count),batched,channels,height,width}} : Maybe<&2,TensorConvolution.InputShape>}:
  match batched:
    case True{}: {==}
    case False{}: {==}

