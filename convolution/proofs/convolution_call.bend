    Order.product_positive(U32.to_nat(channels),ShapeLaws.elements([kernel,kernel]),h0,Order.product_positive(U32.to_nat(kernel),ShapeLaws.elements([kernel]),h4,Order.product_positive(U32.to_nat(kernel),1n,h4,{==}))))

def bias_count_positive(~custom: F32 -> F32,~Logical: Data,~original: Logical -> U32 -> F32,~Weights: Data,~weight_value: Weights -> U32 -> F32,~Bias: Data,~bias_value: Bias -> U32 -> F32,+logical: Logical,+weight_logical: Weights,+bias_logical: Bias,+channels: U32,+outputs: U32,+height: U32,+width: U32,+kernel: U32,+stride: U32,+padding: U32,+facts: Guards.Valid<ImageProblems.problem(~Logical,~original,logical,U32.to_nat(channels),U32.to_nat(outputs),U32.to_nat(height),U32.to_nat(width),U32.to_nat(kernel),U32.to_nat(stride),U32.to_nat(padding),Contract.listed(~F32,~Weights,~weight_value,ShapeLaws.elements([outputs,channels,kernel,kernel]),0n,weight_logical),Contract.listed(~F32,~Bias,~bias_value,ShapeLaws.elements([outputs]),0n,bias_logical),0n)>) ->
