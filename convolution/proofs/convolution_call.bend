  {Nat.is_lt(0n,ShapeLaws.elements([outputs,channels,kernel,kernel])) == True{} : Bool}:
  Guards.Valid{+h0,+h1,+h2,+h3,+h4,+h5,+h6,+h7,+h8,+h9,+h10} = facts
