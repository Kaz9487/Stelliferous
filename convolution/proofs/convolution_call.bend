def rank_four_of(batched: Bool,+count: U32,+channels: U32,+height: U32,+width: U32) -> {Nat.is_le(List.length(&2,U32,TensorConvolution.output_shape(batched,images(batched,count),channels,height,width)),4n) == True{} : Bool}:
