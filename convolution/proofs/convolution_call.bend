# The images of a call: the batch of an NCHW input, one of a CHW input.
def images(batched: Bool,+count: U32) -> U32:
  match batched:
    case True{}: count
    case False{}: 1

# Shaped input cells of the values of a call with their lanes on the channels.
def InputCells(~Logical: Data,~original: Logical -> U32 -> F32,+logical: Logical,+batched: Bool,+batch: U32,+channels: U32,+height: U32,+width: U32,+cells: List<&2,U32>,
  pieces: Pieces.Pieces(~Tile.Tile8),+fill: Tile.Tile8,+status: Tensors.Status,+workers: U32) -> Data:
  Global.Shaped(~Tile.Tile8,~Representation.Lifted<Logical>,~Representation.lifted(~Logical,~original),
    Representation.Lifted{logical,TiledPublic.geometry_of(TensorConvolution.output_shape(batched,batch,channels,height,width),TensorConvolution.lane_of(batched),Grid.Innermost{})},
    cells,Tensors.Tensor{pieces,cells,fill,status,workers})

def InputImage(~Logical: Data,~original: Logical -> U32 -> F32,+logical: Logical,+batched: Bool,+batch: U32,+channels: U32,+height: U32,+width: U32,
  pieces: Pieces.Pieces(~Tile.Tile8),+fill: Tile.Tile8,+status: Tensors.Status,+workers: U32) -> Data:
  InputCells(~Logical,~original,logical,batched,batch,channels,height,width,TensorConvolution.image_cells(batched,batch,height,width,Tiled.groups(channels)),pieces,fill,status,workers)

# The input of a supported problem fits the capacity.
def input_room(+limits: Machine.Limits,+problem: ConvSpec.Problem,+support: Guards.Supported<problem,Machine.dimension(limits),Machine.capacity(limits),Machine.coordinate(limits)>) ->
  {Nat.is_le(ConvSpec.length(Guards.input(problem)),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}:
  Guards.Supported{+h0,+h1,+h2,+h3,+h4,+h5,+h6,+h7,+h8,+h9,+h10,+h11} = support
  h7

# The weights, bias and images of a valid problem hold values.
