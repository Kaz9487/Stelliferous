# ---- The kept operands ----

# A task reads the shared pairs and bias as they are.
def prepare_model(convolution: WindowPipeline.Convolution,positions: U32,kept: PointTask.PointOperands) -> PointTask.PointOperands:
  kept

def prepare_same(+convolution: WindowPipeline.Convolution,+positions: U32,+kept: PointTask.PointOperands) ->
  {WindowPipeline.point_prepare(convolution,positions,PointTask.represent_operands(kept)) == PointTask.represent_operands(prepare_model(convolution,positions,kept)) : WindowPipeline.PointKept}:
  {==}

def prepared(~Logical: Data,~original: Logical -> U32 -> F32,+holder: Packed.WindowProblem<Logical,original>,+convolution: WindowPipeline.Convolution,+positions: U32,
  +kept: PointTask.PointOperands,+shared: PointTask.KeptShared(~Logical,~original,holder,convolution,kept)) ->
  PointTask.KeptOk(~Logical,~original,holder,convolution,positions,prepare_model(convolution,positions,kept)):
  shared

# Sharing gives each task its copies of the pairs and bias.
def split_observed(-pairs: Buffer.Model<Tile.Tile16>,-bias: Buffer.Model<Tile.Tile8>,pairs_seen: CloneLaws.Observation<Tile.Tile16,Clone.clone(~Tile.Tile16,Buffer.pack(~Tile.Tile16,pairs))>,
  bias_seen: CloneLaws.Observation<Tile.Tile8,Clone.clone(~Tile.Tile8,Buffer.pack(~Tile.Tile8,bias))>) -> PartitionLaws.Split<PointTask.PointOperands>:
  CloneLaws.Observation{left_pairs,right_pairs,pairs_equation} = pairs_seen
  CloneLaws.Observation{left_bias,right_bias,bias_equation} = bias_seen
  PartitionLaws.Split{PointTask.PointOperands{left_pairs,left_bias},PointTask.PointOperands{right_pairs,right_bias}}

def split_kept(kept: PointTask.PointOperands) -> PartitionLaws.Split<PointTask.PointOperands>:
  PointTask.PointOperands{pairs,bias} = kept
  split_observed(pairs,bias,CloneLaws.observe_pair(~Tile.Tile16,Clone.clone(~Tile.Tile16,Buffer.pack(~Tile.Tile16,pairs))),CloneLaws.observe_pair(~Tile.Tile8,Clone.clone(~Tile.Tile8,Buffer.pack(~Tile.Tile8,bias))))

def shared_observed(+pairs: Buffer.Model<Tile.Tile16>,+bias: Buffer.Model<Tile.Tile8>,+pairs_seen: CloneLaws.Observation<Tile.Tile16,Clone.clone(~Tile.Tile16,Buffer.pack(~Tile.Tile16,pairs))>,
  +bias_seen: CloneLaws.Observation<Tile.Tile8,Clone.clone(~Tile.Tile8,Buffer.pack(~Tile.Tile8,bias))>) ->
  {WindowPipeline.point_shared(Clone.clone(~Tile.Tile16,Buffer.pack(~Tile.Tile16,pairs)),Clone.clone(~Tile.Tile8,Buffer.pack(~Tile.Tile8,bias))) ==
    (PointTask.represent_operands(PartitionLaws.first(~PointTask.PointOperands,split_observed(pairs,bias,pairs_seen,bias_seen))),
      PointTask.represent_operands(PartitionLaws.second(~PointTask.PointOperands,split_observed(pairs,bias,pairs_seen,bias_seen)))) : WindowPipeline.PointKept & WindowPipeline.PointKept}:
  CloneLaws.Observation{+left_pairs,+right_pairs,+pairs_equation} = pairs_seen
  CloneLaws.Observation{+left_bias,+right_bias,+bias_equation} = bias_seen
  %pairs_equation : {WindowPipeline.point_shared(_,Clone.clone(~Tile.Tile8,Buffer.pack(~Tile.Tile8,bias))) ==
    ({WindowPipeline.PointKept{Buffer.pack(~Tile.Tile16,left_pairs),Buffer.pack(~Tile.Tile8,left_bias)} : WindowPipeline.PointKept},
      {WindowPipeline.PointKept{Buffer.pack(~Tile.Tile16,right_pairs),Buffer.pack(~Tile.Tile8,right_bias)} : WindowPipeline.PointKept}) : WindowPipeline.PointKept & WindowPipeline.PointKept}
  %bias_equation : {WindowPipeline.point_shared((Buffer.pack(~Tile.Tile16,left_pairs),Buffer.pack(~Tile.Tile16,right_pairs)),_) ==
    ({WindowPipeline.PointKept{Buffer.pack(~Tile.Tile16,left_pairs),Buffer.pack(~Tile.Tile8,left_bias)} : WindowPipeline.PointKept},
      {WindowPipeline.PointKept{Buffer.pack(~Tile.Tile16,right_pairs),Buffer.pack(~Tile.Tile8,right_bias)} : WindowPipeline.PointKept}) : WindowPipeline.PointKept & WindowPipeline.PointKept}
  {==}

def share_same(+kept: PointTask.PointOperands) ->
  {WindowPipeline.point_share(PointTask.represent_operands(kept)) ==
    (PointTask.represent_operands(PartitionLaws.first(~PointTask.PointOperands,split_kept(kept))),PointTask.represent_operands(PartitionLaws.second(~PointTask.PointOperands,split_kept(kept)))) :
    WindowPipeline.PointKept & WindowPipeline.PointKept}:
  PointTask.PointOperands{+pairs,+bias} = kept
  shared_observed(pairs,bias,CloneLaws.observe_pair(~Tile.Tile16,Clone.clone(~Tile.Tile16,Buffer.pack(~Tile.Tile16,pairs))),CloneLaws.observe_pair(~Tile.Tile8,Clone.clone(~Tile.Tile8,Buffer.pack(~Tile.Tile8,bias))))

# Each copy holds the cells of the pairs and bias.
def split_shared_observed(~Logical: Data,~original: Logical -> U32 -> F32,+holder: Packed.WindowProblem<Logical,original>,+convolution: WindowPipeline.Convolution,
  +pairs: Buffer.Model<Tile.Tile16>,+bias: Buffer.Model<Tile.Tile8>,+shared: PointTask.KeptShared(~Logical,~original,holder,convolution,PointTask.PointOperands{pairs,bias}),
  +pairs_seen: CloneLaws.Observation<Tile.Tile16,Clone.clone(~Tile.Tile16,Buffer.pack(~Tile.Tile16,pairs))>,+bias_seen: CloneLaws.Observation<Tile.Tile8,Clone.clone(~Tile.Tile8,Buffer.pack(~Tile.Tile8,bias))>) ->
  Held.Both<PointTask.KeptShared(~Logical,~original,holder,convolution,PartitionLaws.first(~PointTask.PointOperands,split_observed(pairs,bias,pairs_seen,bias_seen))),
    PointTask.KeptShared(~Logical,~original,holder,convolution,PartitionLaws.second(~PointTask.PointOperands,split_observed(pairs,bias,pairs_seen,bias_seen)))>:
  PointTask.PointShared{+convolution_exact,+direct,+pairs_exact,+bias_exact} = shared
  CloneLaws.Observation{+left_pairs,+right_pairs,+pairs_equation} = pairs_seen
  CloneLaws.Observation{+left_bias,+right_bias,+bias_equation} = bias_seen
  Held.Both{PointTask.PointShared{convolution_exact,direct,
      CloneLaws.copied_tree(~Tile.Tile16,pairs,left_pairs,CloneLaws.left_contents(~Tile.Tile16,pairs,left_pairs,right_pairs,pairs_equation),PointTask.pair_cells_of(~Logical,~original,holder),pairs_exact),
      CloneLaws.copied_tree(~Tile.Tile8,bias,left_bias,CloneLaws.left_contents(~Tile.Tile8,bias,left_bias,right_bias,bias_equation),Packed.bias_cells_of(~Logical,~original,holder),bias_exact)},
    PointTask.PointShared{convolution_exact,direct,
      CloneLaws.copied_tree(~Tile.Tile16,pairs,right_pairs,CloneLaws.right_contents(~Tile.Tile16,pairs,left_pairs,right_pairs,pairs_equation),PointTask.pair_cells_of(~Logical,~original,holder),pairs_exact),
      CloneLaws.copied_tree(~Tile.Tile8,bias,right_bias,CloneLaws.right_contents(~Tile.Tile8,bias,left_bias,right_bias,bias_equation),Packed.bias_cells_of(~Logical,~original,holder),bias_exact)}}

def split_shared(~Logical: Data,~original: Logical -> U32 -> F32,+holder: Packed.WindowProblem<Logical,original>,+convolution: WindowPipeline.Convolution,+kept: PointTask.PointOperands,
  +shared: PointTask.KeptShared(~Logical,~original,holder,convolution,kept)) ->
  Held.Both<PointTask.KeptShared(~Logical,~original,holder,convolution,PartitionLaws.first(~PointTask.PointOperands,split_kept(kept))),
    PointTask.KeptShared(~Logical,~original,holder,convolution,PartitionLaws.second(~PointTask.PointOperands,split_kept(kept)))>:
  PointTask.PointOperands{+pairs,+bias} = kept
  split_shared_observed(~Logical,~original,holder,convolution,pairs,bias,shared,CloneLaws.observe_pair(~Tile.Tile16,Clone.clone(~Tile.Tile16,Buffer.pack(~Tile.Tile16,pairs))),
    CloneLaws.observe_pair(~Tile.Tile8,Clone.clone(~Tile.Tile8,Buffer.pack(~Tile.Tile8,bias))))

# ---- The pairs of the weights ----

# The weights and pairs a builder returns, as models.
type BuiltSeen<-built: Storage.Buffer<Tile.Tile8> & Storage.Buffer<Tile.Tile16>> is Data:
  BuiltSeen{weights: Buffer.Model<Tile.Tile8>,pairs: Buffer.Model<Tile.Tile16>,
    equation: {(Buffer.pack(~Tile.Tile8,weights),Buffer.pack(~Tile.Tile16,pairs)) == built : Storage.Buffer<Tile.Tile8> & Storage.Buffer<Tile.Tile16>}}

def built_observed(-left: Storage.Buffer<Tile.Tile8>,-right: Storage.Buffer<Tile.Tile16>,
  left_observation: Buffer.Observation<Tile.Tile8,left>,right_observation: Buffer.Observation<Tile.Tile16,right>) -> BuiltSeen<(left,right)>:
  Buffer.Observation{+left_model,left_equal} = left_observation
  Buffer.Observation{+right_model,right_equal} = right_observation
  BuiltSeen{left_model,right_model,
    %left_equal : {(Buffer.pack(~Tile.Tile8,left_model),Buffer.pack(~Tile.Tile16,right_model)) == (_,right) : Storage.Buffer<Tile.Tile8> & Storage.Buffer<Tile.Tile16>}
    %right_equal : {(Buffer.pack(~Tile.Tile8,left_model),Buffer.pack(~Tile.Tile16,right_model)) == (Buffer.pack(~Tile.Tile8,left_model),_) : Storage.Buffer<Tile.Tile8> & Storage.Buffer<Tile.Tile16>}
    {==}}

def observe_built(built: Storage.Buffer<Tile.Tile8> & Storage.Buffer<Tile.Tile16>) -> BuiltSeen<built>:
  (left,right) = built
  built_observed(left,right,Buffer.observe(~Tile.Tile8,left),Buffer.observe(~Tile.Tile16,right))

def built_seen(-built: Storage.Buffer<Tile.Tile8> & Storage.Buffer<Tile.Tile16>,+seen: BuiltSeen<built>) ->
  {Buffer.contents(~Tile.Tile16,WindowPipeline.pairs_built(built)) ==
    Pair.snd(Buffer.Content<Tile.Tile8>,Buffer.Content<Tile.Tile16>,ReadInto.buffers_contents(~Tile.Tile8,~Tile.Tile16,built)) : Buffer.Content<Tile.Tile16>}:
  BuiltSeen{+weights,+pairs,+equation} = seen
  %equation : {Buffer.contents(~Tile.Tile16,WindowPipeline.pairs_built(_)) ==
    Pair.snd(Buffer.Content<Tile.Tile8>,Buffer.Content<Tile.Tile16>,ReadInto.buffers_contents(~Tile.Tile8,~Tile.Tile16,_)) : Buffer.Content<Tile.Tile16>}
  {==}

# Building the pairs keeps the pairs buffer its builder returns.
def built_second(built: Storage.Buffer<Tile.Tile8> & Storage.Buffer<Tile.Tile16>) ->
  {Buffer.contents(~Tile.Tile16,WindowPipeline.pairs_built(built)) ==
    Pair.snd(Buffer.Content<Tile.Tile8>,Buffer.Content<Tile.Tile16>,ReadInto.buffers_contents(~Tile.Tile8,~Tile.Tile16,built)) : Buffer.Content<Tile.Tile16>}:
  built_seen(built,observe_built(built))

# The pairs built from the weights read the pair tiles of the weights.
def built_pairs(+channels: U32,+inner: U32,+weights: Buffer.Model<Tile.Tile8>) ->
  {Buffer.tree(~Tile.Tile16,Buffer.remodel(~Tile.Tile16,WindowPipeline.pairs_built(GemmBuffer.point_pairs(channels,inner,Buffer.pack(~Tile.Tile8,weights),Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),(Gemm.pairs_of(channels) * inner : U32)))))) ==
    PointBuffer.pair_loop(channels,inner,Buffer.tree(~Tile.Tile8,weights),Tree.fresh(Tile.Tile16,Tensors.depth_for((Gemm.pairs_of(channels) * inner : U32)),Tile.filled_pair(0.0))) : Tree.Tree<Tile.Tile16>}:
  +model = Buffer.remodel(~Tile.Tile16,Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),(Gemm.pairs_of(channels) * inner : U32)))
  +loop = PointBuffer.pair_loop(channels,inner,Buffer.tree(~Tile.Tile8,weights),Buffer.tree(~Tile.Tile16,model))
  +read = {%Buffer.remodeled(~Tile.Tile16,Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),(Gemm.pairs_of(channels) * inner : U32))) : {ReadInto.buffers_contents(~Tile.Tile8,~Tile.Tile16,GemmBuffer.point_pairs(channels,inner,Buffer.pack(~Tile.Tile8,weights),_)) ==
      (Buffer.content(~Tile.Tile8,weights),Buffer.Content{loop,Buffer.length(~Tile.Tile16,model)}) : Buffer.Content<Tile.Tile8> & Buffer.Content<Tile.Tile16>}
    PointBuffer.pairs_contents(channels,inner,weights,model) : {ReadInto.buffers_contents(~Tile.Tile8,~Tile.Tile16,GemmBuffer.point_pairs(channels,inner,Buffer.pack(~Tile.Tile8,weights),Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),(Gemm.pairs_of(channels) * inner : U32)))) ==
      (Buffer.content(~Tile.Tile8,weights),Buffer.Content{loop,Buffer.length(~Tile.Tile16,model)}) : Buffer.Content<Tile.Tile8> & Buffer.Content<Tile.Tile16>}}
  +second = Equal.cong(Buffer.Content<Tile.Tile8> & Buffer.Content<Tile.Tile16>,Buffer.Content<Tile.Tile16>,pair => Pair.snd(Buffer.Content<Tile.Tile8>,Buffer.Content<Tile.Tile16>,pair),
    ReadInto.buffers_contents(~Tile.Tile8,~Tile.Tile16,GemmBuffer.point_pairs(channels,inner,Buffer.pack(~Tile.Tile8,weights),Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),(Gemm.pairs_of(channels) * inner : U32)))),
    (Buffer.content(~Tile.Tile8,weights),Buffer.Content{loop,Buffer.length(~Tile.Tile16,model)}),read)
  +contents_exact = Equal.trans(Buffer.Content<Tile.Tile16>,Buffer.contents(~Tile.Tile16,WindowPipeline.pairs_built(GemmBuffer.point_pairs(channels,inner,Buffer.pack(~Tile.Tile8,weights),Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),(Gemm.pairs_of(channels) * inner : U32))))),
    Pair.snd(Buffer.Content<Tile.Tile8>,Buffer.Content<Tile.Tile16>,ReadInto.buffers_contents(~Tile.Tile8,~Tile.Tile16,GemmBuffer.point_pairs(channels,inner,Buffer.pack(~Tile.Tile8,weights),Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),(Gemm.pairs_of(channels) * inner : U32))))),
    Buffer.Content{loop,Buffer.length(~Tile.Tile16,model)},built_second(GemmBuffer.point_pairs(channels,inner,Buffer.pack(~Tile.Tile8,weights),Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),(Gemm.pairs_of(channels) * inner : U32)))),second)
  +tree_exact = Equal.trans(Tree.Tree<Tile.Tile16>,Buffer.tree(~Tile.Tile16,Buffer.remodel(~Tile.Tile16,WindowPipeline.pairs_built(GemmBuffer.point_pairs(channels,inner,Buffer.pack(~Tile.Tile8,weights),Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),(Gemm.pairs_of(channels) * inner : U32)))))),
    Buffer.content_tree(~Tile.Tile16,Buffer.content(~Tile.Tile16,Buffer.remodel(~Tile.Tile16,WindowPipeline.pairs_built(GemmBuffer.point_pairs(channels,inner,Buffer.pack(~Tile.Tile8,weights),Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),(Gemm.pairs_of(channels) * inner : U32))))))),loop,
    Equal.sym(Tree.Tree<Tile.Tile16>,Buffer.content_tree(~Tile.Tile16,Buffer.content(~Tile.Tile16,Buffer.remodel(~Tile.Tile16,WindowPipeline.pairs_built(GemmBuffer.point_pairs(channels,inner,Buffer.pack(~Tile.Tile8,weights),Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),(Gemm.pairs_of(channels) * inner : U32))))))),Buffer.tree(~Tile.Tile16,Buffer.remodel(~Tile.Tile16,WindowPipeline.pairs_built(GemmBuffer.point_pairs(channels,inner,Buffer.pack(~Tile.Tile8,weights),Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),(Gemm.pairs_of(channels) * inner : U32)))))),
      Buffer.content_tree_of(~Tile.Tile16,Buffer.remodel(~Tile.Tile16,WindowPipeline.pairs_built(GemmBuffer.point_pairs(channels,inner,Buffer.pack(~Tile.Tile8,weights),Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),(Gemm.pairs_of(channels) * inner : U32))))))),
    Equal.cong(Buffer.Content<Tile.Tile16>,Tree.Tree<Tile.Tile16>,content => Buffer.content_tree(~Tile.Tile16,content),Buffer.content(~Tile.Tile16,Buffer.remodel(~Tile.Tile16,WindowPipeline.pairs_built(GemmBuffer.point_pairs(channels,inner,Buffer.pack(~Tile.Tile8,weights),Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),(Gemm.pairs_of(channels) * inner : U32)))))),
      Buffer.Content{loop,Buffer.length(~Tile.Tile16,model)},
      Equal.trans(Buffer.Content<Tile.Tile16>,Buffer.content(~Tile.Tile16,Buffer.remodel(~Tile.Tile16,WindowPipeline.pairs_built(GemmBuffer.point_pairs(channels,inner,Buffer.pack(~Tile.Tile8,weights),Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),(Gemm.pairs_of(channels) * inner : U32)))))),Buffer.contents(~Tile.Tile16,WindowPipeline.pairs_built(GemmBuffer.point_pairs(channels,inner,Buffer.pack(~Tile.Tile8,weights),Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),(Gemm.pairs_of(channels) * inner : U32))))),Buffer.Content{loop,Buffer.length(~Tile.Tile16,model)},
        Buffer.remodel_content(~Tile.Tile16,WindowPipeline.pairs_built(GemmBuffer.point_pairs(channels,inner,Buffer.pack(~Tile.Tile8,weights),Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),(Gemm.pairs_of(channels) * inner : U32))))),contents_exact)))
  %AllocationLaws.buffer_tree(~Tile.Tile16,Tile.filled_pair(0.0),(Gemm.pairs_of(channels) * inner : U32)) :
    {Buffer.tree(~Tile.Tile16,Buffer.remodel(~Tile.Tile16,WindowPipeline.pairs_built(GemmBuffer.point_pairs(channels,inner,Buffer.pack(~Tile.Tile8,weights),Tensors.buffer(~Tile.Tile16,Tile.filled_pair(0.0),(Gemm.pairs_of(channels) * inner : U32)))))) == PointBuffer.pair_loop(channels,inner,Buffer.tree(~Tile.Tile8,weights),_) : Tree.Tree<Tile.Tile16>}
  tree_exact

# ---- The placed tasks ----

# The pointwise tasks of the decision that may cut the pieces of an output
# grid of whole output positions place every output piece with its values.
