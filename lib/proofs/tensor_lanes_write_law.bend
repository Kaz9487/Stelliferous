  components => origins => target => target_grid => fill => context => index => piece => rest => models => holdings => agrees => ready => inside => kept => member => after =>
    lanes_lawful(~Logical,~original,~Part,~part_value,logical,part,limits,position,others,groups,bound,count,start,width,components,origins,target,target_grid,fill,context,index,piece,rest,models,holdings,agrees,ready,inside,kept,member)
