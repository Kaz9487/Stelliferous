# Before a task writes a target piece of its component, every target piece
# of the component lies on the target stack in order, and the part pieces in
# the order the component took them.
def lanes_begin(~Logical: Data,~original: Logical -> U32 -> F32,~Part: Data,~part_value: Part -> U32 -> F32,+logical: Representation.Lifted<Logical>,+part: Representation.Lifted<Part>,+limits: Machine.Limits,+position: Grid.Position,+others: List<&2,U32>,+groups: U32,+bound: U32,+count: U32,+start: U32,+width: U32) ->
  Moved.KeptBegin(~Tile.Tile8,~Tiled.Write,~lanes_source(~Logical,~original,~Part,~part_value,logical,part),~LanesAgrees(limits,position,others,groups,bound,count,start,width),~lanes_kept(~Logical,~original,logical)):
  components => origins => target => target_grid => fill => context => layout => index => models => agrees => ready => inside => targets =>
    lanes_begun(~Logical,~original,~Part,~part_value,logical,part,limits,position,others,groups,bound,count,start,width,components,origins,target,target_grid,fill,context,layout,index,models,agrees,ready,inside,targets)

# ---- The facts of a component ----

def part_ends(+own: List<&2,Tasks.Reading>,+row: List<&2,Tasks.Reading>,+classes: List<&2,Tasks.Class>,+ends: Components.AllEnds([own,row],classes)) ->
  Components.RowEnds(row,classes):
  Held.Both{+first,Held.Both{+second,+none}} = ends
  second

# The classes of a component end inside the axes of a target whose reads fit
# the word.
def class_ends_of(classes: List<&2,Tasks.Class>,extents: List<&2,U32>,+grid: Grid.Grid,+axis: U32,+cap: U32,
  +paired: {Nat.is_eq(List.length(&2,Tasks.Class,classes),List.length(&2,U32,extents)) == True{} : Bool},
  +rooms: Components.ReadingsRoom(Tiled.own_readings(extents,grid,axis),cap),+ends: Components.RowEnds(Tiled.own_readings(extents,grid,axis),classes)) ->
  Targets.ClassEnds(classes,grid,extents,axis,cap):
  match classes extents:
    case Con{+class,+more} Con{+extent,+rest}:
      Held.Both{Held.Both{Held.Both{+blocks_exact,Held.Both{+ceiling_room,Held.Both{+block_positive,+sum_room}}},+read_room},+rest_rooms} = rooms
      Held.Both{+end,+rest_ends} = ends
      Held.Both{end,Held.Both{sum_room,class_ends_of(more,rest,grid,(axis + 1 : U32),cap,paired,rest_rooms,rest_ends)}}
    case Nil{} Nil{}:
      Unit{}
    case Con{+class,+more} Nil{}:
      Empty.absurd(Targets.ClassEnds(Con{class,more},grid,Nil{},axis,cap),WordEncoding.false_true(paired))
    case Nil{} Con{+extent,+rest}:
      Empty.absurd(Targets.ClassEnds(Nil{},grid,Con{extent,rest},axis,cap),WordEncoding.false_true(paired))

# ---- The groups a part reaches ----

