# ---- What a write gives ----

# The target and the part a write reads, and the write.
type Written<-Logical: Data,-PContext: Data> is Data:
  Written{target: Representation.Lifted<Logical>,part: PContext,write: Tiled.Write}

# A cell after a write: merged with the part cells it reads when its group is
# one the part reaches, the target cell otherwise.
def written_cell(~Logical: Data,~original: Logical -> U32 -> F32,~PContext: Data,~pvalue: PContext -> U32 -> Tile.Tile8,+written: Written<Logical,PContext>,+word: U32) -> Tile.Tile8:
  Written{+target,+part,+write} = written
  Tiled.Write{+start,+width,+groups,+part_groups,+others,+position} = write
  +cell = U32.to_nat(word)
  +group = Gather.cell_group(position,groups,others,cell)
  +first_group = U32.to_nat((start / 8 : U32))
  +held = Representation.lifted(~Logical,~original,target,word)
  Bool.pick(Tile.Tile8,Nat.is_le(first_group,group) && Nat.is_lt(group,Nat.add(first_group,U32.to_nat(Gather.reached_groups(start,width)))),
    Gather.touched_value(~PContext,~pvalue,part,start,width,part_groups,others,position,U32.from_nat(group),U32.from_nat(Gather.cell_other(position,groups,others,cell)),held),held)

def written_value(~Logical: Data,~original: Logical -> U32 -> F32,~PContext: Data,~pvalue: PContext -> U32 -> Tile.Tile8,written: Written<Logical,PContext>,word: U32) -> Tile.Tile8:
  written_cell(~Logical,~original,~PContext,~pvalue,written,word)

# ---- The sources ----

# A piece of the target holds the target values, a piece of the part the part
# values.
def SourceAt(~Logical: Data,~original: Logical -> U32 -> F32,~Part: Data,~part_value: Part -> U32 -> F32,at_target: Bool,+target: Representation.Lifted<Logical>,+part: Representation.Lifted<Part>,+first: U32,+rows: U32,
  +buffer: Buffer.Content<Tile.Tile8>) -> Data:
  match at_target:
    case True{}: Placed.PieceHolds(~Tile.Tile8,~Representation.Lifted<Logical>,~Representation.lifted(~Logical,~original),target,first,rows,buffer)
    case False{}: Placed.PieceHolds(~Tile.Tile8,~Representation.Lifted<Part>,~Representation.lifted(~Part,~part_value),part,first,rows,buffer)

def lanes_source(~Logical: Data,~original: Logical -> U32 -> F32,~Part: Data,~part_value: Part -> U32 -> F32,+target: Representation.Lifted<Logical>,+part: Representation.Lifted<Part>,+source: U32,+first: U32,+rows: U32,
  +buffer: Buffer.Content<Tile.Tile8>) -> Data:
  SourceAt(~Logical,~original,~Part,~part_value,U32.is_zero(source),target,part,first,rows,buffer)

# ---- What a task keeps from one target piece to the next ----

# Every held target piece holds the target values.
def StackHolds(~Logical: Data,~original: Logical -> U32 -> F32,+target: Representation.Lifted<Logical>,stack: Held.Stack<Tile.Tile8>) -> Data:
  match stack:
    case Held.Bottom{}:
      Unit
    case Held.Held{+buffer,+first,+count,below}:
      Held.Both<Placed.PieceHolds(~Tile.Tile8,~Representation.Lifted<Logical>,~Representation.lifted(~Logical,~original),target,first,count,Buffer.content(~Tile.Tile8,buffer)),StackHolds(~Logical,~original,target,below)>

# The target pieces a component took, stacked onto held pieces, hold the
# target values.
def stacked_holds(~Logical: Data,~original: Logical -> U32 -> F32,~Part: Data,~part_value: Part -> U32 -> F32,+target: Representation.Lifted<Logical>,+part: Representation.Lifted<Part>,+model: PiecesModel.Model<Tile.Tile8>,+rest: Held.Stack<Tile.Tile8>,
  +holds: PiecesModel.ContentAll(~Tile.Tile8,~lanes_source(~Logical,~original,~Part,~part_value,target,part,0),PiecesModel.content(~Tile.Tile8,model)),+after: StackHolds(~Logical,~original,target,rest)) ->
  StackHolds(~Logical,~original,target,Held.stacked_model(~Tile.Tile8,model,rest)):
  match model:
    case PiecesModel.Leaf{+buffer,+first,+count}:
      Held.Both{holds,after}
    case PiecesModel.Fork{+left,+right}:
      KernelGemm.Both{+left_holds,+right_holds} = holds
      stacked_holds(~Logical,~original,~Part,~part_value,target,part,left,Held.stacked_model(~Tile.Tile8,right,rest),left_holds,stacked_holds(~Logical,~original,~Part,~part_value,target,part,right,rest,right_holds,after))

# The target pieces still to write, each held whole on the stack in order:
# its cells, a nonempty count, and the target values.
def TargetStack(~Logical: Data,~original: Logical -> U32 -> F32,+target: Representation.Lifted<Logical>,+grid: Grid.Grid,pieces: List<&2,U32>,stack: Held.Stack<Tile.Tile8>) -> Data:
  match pieces stack:
    case Con{+piece,rest} Held.Held{+buffer,+first,+count,below}:
      Held.Both<{first == Grid.start(grid,piece) : U32},Held.Both<{count == Grid.span(grid,piece) : U32},Held.Both<{U32.is_zero(count) == False{} : Bool},
        Held.Both<Placed.PieceHolds(~Tile.Tile8,~Representation.Lifted<Logical>,~Representation.lifted(~Logical,~original),target,first,count,Buffer.content(~Tile.Tile8,buffer)),TargetStack(~Logical,~original,target,grid,rest,below)>>>>
    case Con{+piece,rest} Held.Bottom{}:
      Empty
    case Nil{} +stack:
      Unit

def KeptOf(~Logical: Data,~original: Logical -> U32 -> F32,+target: Representation.Lifted<Logical>,+grid: Grid.Grid,holdings: Moved.Holdings<Tile.Tile8>,models: Moved.Models<Tile.Tile8>,+pieces: List<&2,U32>) -> Data:
  match holdings models:
    case Moved.Holds{Held.Holding{Held.Bottom{},+stack},Moved.Holds{+part,+others}} Moved.Models{+target_model,Moved.Models{+part_model,+more}}:
      Held.Both<TargetStack(~Logical,~original,target,grid,pieces,stack),{Held.order(~Tile.Tile8,part) == Held.stacked_model(~Tile.Tile8,part_model,Held.Bottom{}) : Held.Stack<Tile.Tile8>}>
    case holdings models:
      Empty

# What a lane write keeps: the target pieces still to write on the target
# stack, and the part pieces in the order the component took them.
def lanes_kept(~Logical: Data,~original: Logical -> U32 -> F32,+target: Representation.Lifted<Logical>,+grid: Grid.Grid,+models: Moved.Models<Tile.Tile8>,+holdings: Moved.Holdings<Tile.Tile8>,
  +pieces: List<&2,U32>) -> Data:
  KeptOf(~Logical,~original,target,grid,holdings,models,pieces)

# ---- The target stack from the pieces a component took ----

def span_first(+spans: Held.Spans) -> U32:
  match spans:
    case Held.Spanned{+first,+count,+rest}: first
    case Held.Ended{}: 0

def span_count(+spans: Held.Spans) -> U32:
  match spans:
    case Held.Spanned{+first,+count,+rest}: count
    case Held.Ended{}: 0

def span_rest(+spans: Held.Spans) -> Held.Spans:
  match spans:
    case Held.Spanned{+first,+count,+rest}: rest
    case Held.Ended{}: Held.Ended{}

# No empty stack has the spans of a taken piece.
def spans_apart(+first: U32,+count: U32,+rest: Held.Spans,+same: {Held.Ended{} == Held.Spanned{first,count,rest} : Held.Spans}) -> Empty:
  WordEncoding.false_true(Equal.cong(Held.Spans,Bool,spans => Held.spanned(spans),Held.Ended{},Held.Spanned{first,count,rest},same))

# A stack whose spans are those of the target pieces of a component, each of
# which starts a leaf, holds each of them in order.
def targets_stacked(~Logical: Data,~original: Logical -> U32 -> F32,+target: Representation.Lifted<Logical>,+grid: Grid.Grid,pieces: List<&2,U32>,stack: Held.Stack<Tile.Tile8>,+layout: Pieces.Ranges,
  +same: {Held.spans(~Tile.Tile8,stack) == Moved.taken_spans(pieces,grid) : Held.Spans},+holds: StackHolds(~Logical,~original,target,stack),
  +targets: Moved.TargetsAt(layout,grid,pieces)) -> TargetStack(~Logical,~original,target,grid,pieces,stack):
  match pieces stack:
    case Con{+piece,Nil{}} Held.Held{+buffer,+first,+count,+below}:
      Held.Both{+here,+later} = holds
      Held.Both{+leaf,Held.Both{+rows,+nonzero}} = targets
      +taken = {Held.Spanned{Grid.start(grid,piece),Grid.span(grid,piece),Held.Ended{}} : Held.Spans}
      +held = {Held.Spanned{first,count,Held.spans(~Tile.Tile8,below)} : Held.Spans}
      +count_same = Equal.cong(Held.Spans,U32,spans => span_count(spans),held,taken,same)
      Held.Both{Equal.cong(Held.Spans,U32,spans => span_first(spans),held,taken,same),Held.Both{count_same,
        Held.Both{{%Equal.sym(U32,count,Grid.span(grid,piece),count_same) : {U32.is_zero(_) == False{} : Bool} nonzero : {U32.is_zero(count) == False{} : Bool}},
          Held.Both{here,Unit{}}}}}
    case Con{+piece,Con{+next,+more}} Held.Held{+buffer,+first,+count,+below}:
      Held.Both{+here,+later} = holds
      Held.Both{Held.Both{+leaf,Held.Both{+rows,+nonzero}},Held.Both{+after,+rest_targets}} = targets
      +taken = {Held.Spanned{Grid.start(grid,piece),Grid.span(grid,piece),Moved.taken_spans(Con{next,more},grid)} : Held.Spans}
      +held = {Held.Spanned{first,count,Held.spans(~Tile.Tile8,below)} : Held.Spans}
      +count_same = Equal.cong(Held.Spans,U32,spans => span_count(spans),held,taken,same)
      Held.Both{Equal.cong(Held.Spans,U32,spans => span_first(spans),held,taken,same),Held.Both{count_same,
        Held.Both{{%Equal.sym(U32,count,Grid.span(grid,piece),count_same) : {U32.is_zero(_) == False{} : Bool} nonzero : {U32.is_zero(count) == False{} : Bool}},
          Held.Both{here,targets_stacked(~Logical,~original,target,grid,Con{next,more},below,layout,Equal.cong(Held.Spans,Held.Spans,spans => span_rest(spans),held,taken,same),later,
            rest_targets)}}}}
    case Con{+piece,Nil{}} Held.Bottom{}:
      Empty.absurd(TargetStack(~Logical,~original,target,grid,Con{piece,Nil{}},Held.Bottom{}),spans_apart(Grid.start(grid,piece),Grid.span(grid,piece),Held.Ended{},same))
    case Con{+piece,Con{+next,+more}} Held.Bottom{}:
      Empty.absurd(TargetStack(~Logical,~original,target,grid,Con{piece,Con{next,more}},Held.Bottom{}),
        spans_apart(Grid.start(grid,piece),Grid.span(grid,piece),Moved.taken_spans(Con{next,more},grid),same))
    case Nil{} +stack:
      Unit{}

# ---- The target pieces a component reads of the target ----

# The target reads one axis for each of its axes.
def own_count(extents: List<&2,U32>,+grid: Grid.Grid,+axis: U32) ->
  {List.length(&2,Tasks.Reading,Tiled.own_readings(extents,grid,axis)) == List.length(&2,U32,extents) : Nat}:
  match extents:
    case Nil{}:
      {==}
    case Con{+extent,+rest}:
      Equal.cong(Nat,Nat,length => 1n+length,List.length(&2,Tasks.Reading,Tiled.own_readings(rest,grid,(axis + 1 : U32))),List.length(&2,U32,rest),
        own_count(rest,grid,(axis + 1 : U32)))

# A class that ends inside the blocks of an axis that fits the word fits it.
def class_fits(class: Tasks.Class,+extent: U32,+block: U32,+cap: U32,+end: Components.EndIn(class,NatCeiling.ceiling(U32.to_nat(extent),U32.to_nat(block))),
  +block_positive: {Nat.is_lt(0n,U32.to_nat(block)) == True{} : Bool},+extent_positive: {Nat.is_lt(0n,U32.to_nat(extent)) == True{} : Bool},
  +sum_room: {Nat.is_le(Nat.add(U32.to_nat(extent),U32.to_nat(block)),U32.to_nat(cap)) == True{} : Bool},+double_room: {Nat.is_le(Nat.double(U32.to_nat(U32.max(block,1))),U32.to_nat(cap)) == True{} : Bool}) ->
  Reads.ClassFits(class,extent,block,cap):
  match class:
    case Tasks.Class{+first,+count,+source_first,+source_count}:
      Held.Both{+begun,+ended} = end
      Held.Both{begun,Held.Both{ended,Held.Both{block_positive,Held.Both{extent_positive,Held.Both{sum_room,double_room}}}}}

# The classes of a component fit the axes of a nonempty target whose reads
# and blocks fit the word.
def own_fits_of(extents: List<&2,U32>,classes: List<&2,Tasks.Class>,+grid: Grid.Grid,+axis: U32,+cap: U32,
  +paired: {Nat.is_eq(List.length(&2,Tasks.Class,classes),List.length(&2,U32,extents)) == True{} : Bool},
  +rooms: Components.ReadingsRoom(Tiled.own_readings(extents,grid,axis),cap),+blocks: ViewReads.BlocksIn(grid,extents,axis,cap),
  +ends: Components.RowEnds(Tiled.own_readings(extents,grid,axis),classes),+filled: {Nat.is_lt(0n,ShapeLaws.elements(extents)) == True{} : Bool}) ->
  Reads.OwnFits(extents,classes,grid,axis,cap):
  match extents classes:
    case Con{+extent,+rest} Con{+class,+more}:
      Held.Both{Held.Both{Held.Both{+blocks_exact,Held.Both{+ceiling_room,Held.Both{+block_positive,+sum_room}}},+read_room},+rest_rooms} = rooms
      Held.Both{+positive,Held.Both{+double_room,+rest_blocks}} = blocks
      Held.Both{+end,+rest_ends} = ends
      Held.Both{class_fits(class,extent,Grid.block(grid,axis,extent),cap,end,block_positive,
          RowMajor.left_factor_positive(U32.to_nat(extent),ShapeLaws.elements(rest),filled),sum_room,double_room),
        own_fits_of(rest,more,grid,(axis + 1 : U32),cap,paired,rest_rooms,rest_blocks,rest_ends,
          DivisionOrder.right_factor_positive(U32.to_nat(extent),ShapeLaws.elements(rest),filled))}
    case Con{+extent,+rest} Nil{}:
      Empty.absurd(Reads.OwnFits(Con{extent,rest},Nil{},grid,axis,cap),WordEncoding.false_true(paired))
    case Nil{} Con{+class,+more}:
      Empty.absurd(Reads.OwnFits(Nil{},Con{class,more},grid,axis,cap),WordEncoding.false_true(paired))
    case Nil{} Nil{}:
      Unit{}

# Every axis of a target whose reads and blocks fit the word fits whole.
def whole_fits_of(extents: List<&2,U32>,+grid: Grid.Grid,+axis: U32,+cap: U32,+rooms: Components.ReadingsRoom(Tiled.own_readings(extents,grid,axis),cap),
  +blocks: ViewReads.BlocksIn(grid,extents,axis,cap)) -> Reads.WholeFits(extents,grid,axis,cap):
  match extents:
    case Con{+extent,+rest}:
      Held.Both{Held.Both{Held.Both{+blocks_exact,Held.Both{+ceiling_room,Held.Both{+block_positive,+sum_room}}},+read_room},+rest_rooms} = rooms
      Held.Both{+positive,Held.Both{+double_room,+rest_blocks}} = blocks
      Held.Both{Held.Both{block_positive,Held.Both{sum_room,double_room}},whole_fits_of(rest,grid,(axis + 1 : U32),cap,rest_rooms,rest_blocks)}
    case Nil{}:
      Unit{}

# The pieces a component reads of the target are its target pieces, on a
# grid given by its fields.
def own_flat(separate: Bool,+cells: List<&2,U32>,+classes: List<&2,Tasks.Class>,+count: U32,+prefix: U32,+outer: U32,+extent: U32,+unit_cells: U32,+block: U32,
  +per: U32,+cap: U32,+cap_ok: {U32.is_le(cap,2147483648) == True{} : Bool},+room: {Nat.is_le(List.length(&2,U32,cells),U32.to_nat(cap)) == True{} : Bool},
  +cells_room: {Nat.is_le(ShapeLaws.elements(cells),U32.to_nat(cap)) == True{} : Bool},+filled: {Nat.is_lt(0n,ShapeLaws.elements(cells)) == True{} : Bool},
  +fits: Logic.When(separate,Reads.OwnFits(cells,classes,Grid.Grid{count,prefix,outer,extent,unit_cells,block,per,(outer * per : U32)},0,cap)),+whole: Reads.WholeFits(cells,Grid.Grid{count,prefix,outer,extent,unit_cells,block,per,(outer * per : U32)},0,cap)) ->
  {Tasks.box_pieces(Grid.Grid{count,prefix,outer,extent,unit_cells,block,per,(outer * per : U32)},cells,Tasks.box_when(separate,Tiled.own_readings(cells,Grid.Grid{count,prefix,outer,extent,unit_cells,block,per,(outer * per : U32)},0),classes,Grid.Grid{count,prefix,outer,extent,unit_cells,block,per,(outer * per : U32)},cells,0)) ==
    Tasks.target_when(separate,classes,Grid.Grid{count,prefix,outer,extent,unit_cells,block,per,(outer * per : U32)},cells,prefix) : List<&2,U32>}:
  match separate:
    case True{}:
      Reads.own_pieces(cells,0,classes,count,prefix,outer,extent,unit_cells,block,per,(outer * per : U32),cap,cap_ok,room,cells_room,fits)
    case False{}:
      Reads.whole_pieces(cells,classes,count,prefix,outer,extent,unit_cells,block,per,(outer * per : U32),cap,cap_ok,room,cells_room,filled,whole)

def own_taken_facts(+limits: Machine.Limits,+cells: List<&2,U32>,+facts: Laws.GridFacts<limits,Grid.grid(cells,Grid.piece_target())>,+separate: Bool,
  +readings: List<&2,List<&2,Tasks.Reading>>,+lists: List<&2,Tasks.Classes>,+total: U32,+index: U32,+room: {Nat.is_le(List.length(&2,U32,cells),U32.to_nat(Machine.half_word(limits))) == True{} : Bool},
  +cells_room: {Nat.is_le(ShapeLaws.elements(cells),U32.to_nat(Machine.half_word(limits))) == True{} : Bool},+filled: {Nat.is_lt(0n,ShapeLaws.elements(cells)) == True{} : Bool},
  +fits: Logic.When(separate,Reads.OwnFits(cells,Tasks.chosen(lists,index),Grid.grid(cells,Grid.piece_target()),0,Machine.half_word(limits))),+whole: Reads.WholeFits(cells,Grid.grid(cells,Grid.piece_target()),0,Machine.half_word(limits))) ->
  {Tasks.box_pieces(Grid.grid(cells,Grid.piece_target()),cells,Tasks.box_when(separate,Tiled.own_readings(cells,Grid.grid(cells,Grid.piece_target()),0),Tasks.chosen(lists,index),Grid.grid(cells,Grid.piece_target()),cells,0)) ==
    Tasks.target_pieces(Tasks.Components{readings,lists,total,separate},Grid.grid(cells,Grid.piece_target()),cells,index) : List<&2,U32>}:
  Laws.GridFacts{+count,+prefix,+outer,+extent,+unit_cells,+block,+per,+shape,+exact,+cell_count} = facts
  %Equal.sym(Grid.Grid,Grid.grid(cells,Grid.piece_target()),Grid.Grid{count,prefix,outer,extent,unit_cells,block,per,(outer * per : U32)},exact) :
    {Tasks.box_pieces(_,cells,Tasks.box_when(separate,Tiled.own_readings(cells,_,0),Tasks.chosen(lists,index),_,cells,0)) ==
      Tasks.target_pieces(Tasks.Components{readings,lists,total,separate},_,cells,index) : List<&2,U32>}
  own_flat(separate,cells,Tasks.chosen(lists,index),count,prefix,outer,extent,unit_cells,block,per,Machine.half_word(limits),Limits.half_word_fits(limits),room,cells_room,filled,
    {%exact : Logic.When(separate,Reads.OwnFits(cells,Tasks.chosen(lists,index),_,0,Machine.half_word(limits))) fits : Logic.When(separate,Reads.OwnFits(cells,Tasks.chosen(lists,index),Grid.Grid{count,prefix,outer,extent,unit_cells,block,per,(outer * per : U32)},0,Machine.half_word(limits)))},
    {%exact : Reads.WholeFits(cells,_,0,Machine.half_word(limits)) whole : Reads.WholeFits(cells,Grid.Grid{count,prefix,outer,extent,unit_cells,block,per,(outer * per : U32)},0,Machine.half_word(limits))})

# A component of readings whose first row is the target read in place takes
# of the target exactly its target pieces.
def own_taken(+limits: Machine.Limits,+cells: List<&2,U32>,+rest: List<&2,List<&2,Tasks.Reading>>,+index: U32,+room: {Nat.is_le(ShapeLaws.elements(cells),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},
  +nonempty: {Nat.is_lt(0n,ShapeLaws.elements(cells)) == True{} : Bool},+rank_room: {Nat.is_le(List.length(&2,U32,cells),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},
  +fits: Logic.When(Tasks.separable(Con{Tiled.own_readings(cells,Grid.grid(cells,Grid.piece_target()),0),rest}),Reads.OwnFits(cells,Tasks.chosen(Tasks.class_lists(Tasks.target_rank(Con{Tiled.own_readings(cells,Grid.grid(cells,Grid.piece_target()),0),rest}),Con{Tiled.own_readings(cells,Grid.grid(cells,Grid.piece_target()),0),rest}),index),Grid.grid(cells,Grid.piece_target()),0,Machine.half_word(limits))),+whole: Reads.WholeFits(cells,Grid.grid(cells,Grid.piece_target()),0,Machine.half_word(limits))) ->
  {Moved.source_pieces(Tasks.components_of(Con{Tiled.own_readings(cells,Grid.grid(cells,Grid.piece_target()),0),rest}),0,index,Tensors.origin(cells,0)) == Tasks.target_pieces(Tasks.components_of(Con{Tiled.own_readings(cells,Grid.grid(cells,Grid.piece_target()),0),rest}),Tensors.grid_of(cells),cells,index) :
    List<&2,U32>}:
  +half = Bounds.as_nat_le(Machine.capacity(limits),Machine.half_word(limits),Limits.capacity_within_half(limits))
  +lists = Tasks.class_lists(Tasks.target_rank(Con{Tiled.own_readings(cells,Grid.grid(cells,Grid.piece_target()),0),rest}),Con{Tiled.own_readings(cells,Grid.grid(cells,Grid.piece_target()),0),rest})
