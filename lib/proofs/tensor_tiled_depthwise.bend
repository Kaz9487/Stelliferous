  Public.Contract(~Spec.Spec<Logical,Parameters<Weights,Bias>>,~Spec.spec_value(~Logical,~original,~Parameters<Weights,Bias>,~weight_of(~Weights,~weight_value,~Bias),~bias_of(~Weights,~Bias,~bias_value),~F32.add),depthwise_spec(~Logical,~Weights,~Bias,logical,weights,bias,Grid.lanes_at(shape,Tiled.lane_axis(List.length(&2,U32,shape))),Window.geometry(shape,kernel,stride,padding)),
    Window.output_shape(shape,Window.geometry(shape,kernel,stride,padding)),tiled)

