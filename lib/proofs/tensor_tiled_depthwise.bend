# ---- The list of tiled values ----

def listed_facts(~Logical: Data,~original: Logical -> U32 -> F32,+logical: Logical,+geometry: Cells.Cells,+shape: List<&2,U32>,+kept: Buffer.Model<Tile.Tile8>,
  +held: Held.Both<Contract.WellFormed<Tile.Tile8,shape,Buffer.content(~Tile.Tile8,kept)>,Contract.Values(~Tile.Tile8,~Representation.Lifted<Logical>,~Representation.lifted(~Logical,~original),Representation.Lifted{logical,geometry},Buffer.content(~Tile.Tile8,kept))>) ->
  Contract.Facts(~Tile.Tile8,~Representation.Lifted<Logical>,~Representation.lifted(~Logical,~original),Representation.Lifted{logical,geometry},shape,Buffer.content(~Tile.Tile8,kept)):
  Held.Both{+formed,+values} = held
  KernelGemm.Both{formed,values}

# Usable cells that hold the lifted values list them in order.
def joined_listed(~Logical: Data,~original: Logical -> U32 -> F32,+logical: Logical,+geometry: Cells.Cells,+model: PiecesModel.Model<Tile.Tile8>,+shape: List<&2,U32>,+fill: Tile.Tile8,
  +workers: U32,+global: Global.Contract(~Tile.Tile8,~Representation.Lifted<Logical>,~Representation.lifted(~Logical,~original),Representation.Lifted{logical,geometry},Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),shape,fill,Tensors.Usable{},workers}),+observation: Buffer.Observation<Tile.Tile8,Tensors.joined(~Tile.Tile8,Tensors.count_or_zero(shape),fill,PiecesModel.pack(~Tile.Tile8,model))>) ->
  {Tensors.to_list(~Tile.Tile8,Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),shape,fill,Tensors.Usable{},workers}) == Done{Contract.listed(~Tile.Tile8,~Representation.Lifted<Logical>,~Representation.lifted(~Logical,~original),ShapeLaws.elements(shape),0n,Representation.Lifted{logical,geometry})} : Result<&2,&2,Tensors.Problem,List<&2,Tile.Tile8>>}:
  Buffer.Observation{+kept,+equation} = observation
  %equation : {Tensors.listed_buffer(~Tile.Tile8,Tensors.Usable{},_) == Done{Contract.listed(~Tile.Tile8,~Representation.Lifted<Logical>,~Representation.lifted(~Logical,~original),ShapeLaws.elements(shape),0n,Representation.Lifted{logical,geometry})} : Result<&2,&2,Tensors.Problem,List<&2,Tile.Tile8>>}
  ExitValues.listed(~Tile.Tile8,~Representation.Lifted<Logical>,~Representation.lifted(~Logical,~original),Representation.Lifted{logical,geometry},shape,kept,
    listed_facts(~Logical,~original,logical,geometry,shape,kept,Joined.joined_facts(~Tile.Tile8,~Representation.Lifted<Logical>,~Representation.lifted(~Logical,~original),Representation.Lifted{logical,geometry},model,shape,fill,workers,global,kept,equation)))

def tiles_observed(~Logical: Data,~original: Logical -> U32 -> F32,+logical: Logical,+values: List<&2,U32>,+axis: Nat,+lanes: U32,+position: Grid.Position,
  -pieces: Pieces.Pieces(~Tile.Tile8),+shape: List<&2,U32>,+fill: Tile.Tile8,+workers: U32,+observation: PiecesModel.Observation<Tile.Tile8,pieces>,
  +contract: Public.Contract(~Logical,~original,logical,values,Tiled.Tiled{Tensors.Tensor{pieces,shape,fill,Tensors.Usable{},workers},axis,lanes,position})) ->
  {Tensors.to_list(~Tile.Tile8,Tensors.Tensor{pieces,shape,fill,Tensors.Usable{},workers}) == Done{Contract.listed(~Tile.Tile8,~Representation.Lifted<Logical>,~Representation.lifted(~Logical,~original),ShapeLaws.elements(Tiled.cell_shape(values,axis,position)),0n,Representation.Lifted{logical,Public.geometry_of(values,axis,position)})} : Result<&2,&2,Tensors.Problem,List<&2,Tile.Tile8>>}:
  PiecesModel.Observation{+model,+equation} = observation
  KernelGemm.Both{+global,Public.Laid{+inside,+shaped,+restored,+counted,+pinned}} = contract
  %equation : {Tensors.to_list(~Tile.Tile8,Tensors.Tensor{_,shape,fill,Tensors.Usable{},workers}) == Done{Contract.listed(~Tile.Tile8,~Representation.Lifted<Logical>,~Representation.lifted(~Logical,~original),ShapeLaws.elements(Tiled.cell_shape(values,axis,position)),0n,Representation.Lifted{logical,Public.geometry_of(values,axis,position)})} : Result<&2,&2,Tensors.Problem,List<&2,Tile.Tile8>>}
  %Equal.sym(List<&2,U32>,Tiled.cell_shape(values,axis,position),shape,shaped) :
    {Tensors.to_list(~Tile.Tile8,Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),shape,fill,Tensors.Usable{},workers}) == Done{Contract.listed(~Tile.Tile8,~Representation.Lifted<Logical>,~Representation.lifted(~Logical,~original),ShapeLaws.elements(_),0n,Representation.Lifted{logical,Public.geometry_of(values,axis,position)})} : Result<&2,&2,Tensors.Problem,List<&2,Tile.Tile8>>}
  joined_listed(~Logical,~original,logical,Public.geometry_of(values,axis,position),model,shape,fill,workers,
    {%Equal.sym(Pieces.Pieces(~Tile.Tile8),PiecesModel.pack(~Tile.Tile8,model),pieces,equation) :
        Global.Contract(~Tile.Tile8,~Representation.Lifted<Logical>,~Representation.lifted(~Logical,~original),Representation.Lifted{logical,Public.geometry_of(values,axis,position)},Tensors.Tensor{_,shape,fill,Tensors.Usable{},workers})
      global : Global.Contract(~Tile.Tile8,~Representation.Lifted<Logical>,~Representation.lifted(~Logical,~original),Representation.Lifted{logical,Public.geometry_of(values,axis,position)},Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),shape,fill,Tensors.Usable{},workers})},
    Buffer.observe(~Tile.Tile8,Tensors.joined(~Tile.Tile8,Tensors.count_or_zero(shape),fill,PiecesModel.pack(~Tile.Tile8,model))))

# The cells of tiled values of the contract list the lifted values of their
# cells in order.
def tiles_listed(~Logical: Data,~original: Logical -> U32 -> F32,+logical: Logical,+values: List<&2,U32>,+axis: Nat,+lanes: U32,+position: Grid.Position,
  cells: Tensors.Tensor<Tile.Tile8>,+contract: Public.Contract(~Logical,~original,logical,values,Tiled.Tiled{cells,axis,lanes,position})) ->
  {Tensors.to_list(~Tile.Tile8,cells) == Done{Contract.listed(~Tile.Tile8,~Representation.Lifted<Logical>,~Representation.lifted(~Logical,~original),ShapeLaws.elements(Tiled.cell_shape(values,axis,position)),0n,Representation.Lifted{logical,Public.geometry_of(values,axis,position)})} : Result<&2,&2,Tensors.Problem,List<&2,Tile.Tile8>>}:
  match cells:
    case Tensors.Tensor{pieces,+shape,+fill,Tensors.Usable{},+workers}:
      tiles_observed(~Logical,~original,logical,values,axis,lanes,position,pieces,shape,fill,workers,PiecesModel.observe(~Tile.Tile8,pieces),contract)
    case Tensors.Tensor{pieces,+shape,+fill,Tensors.Failed{+problem},+workers}:
      Empty.absurd({Tensors.to_list(~Tile.Tile8,Tensors.Tensor{pieces,shape,fill,Tensors.Failed{problem},workers}) == Done{Contract.listed(~Tile.Tile8,~Representation.Lifted<Logical>,~Representation.lifted(~Logical,~original),ShapeLaws.elements(Tiled.cell_shape(values,axis,position)),0n,Representation.Lifted{logical,Public.geometry_of(values,axis,position)})} : Result<&2,&2,Tensors.Problem,List<&2,Tile.Tile8>>},contract)

# ---- The convolution of logical values ----

# The convolution of logical values of channels channels over the extents of
# a pool with the parameters of the channels.
def depthwise_spec(~Logical: Data,~Weights: Data,~Bias: Data,logical: Logical,weights: Weights,bias: Bias,+channels: U32,pool: Access.Pool) -> Spec.Spec<Logical,Parameters<Weights,Bias>>:
  Access.Pool{+height,+width,+kernel,+stride,+padding,+out_height,+out_width} = pool
  Spec.Spec{Spec.Input{logical,channels,height,width},Parameters{weights,bias,channels,kernel},Values.Weighting{0.0},Window.Taps{kernel,stride,padding,height,width,Tiled.groups(channels)},
    out_height,out_width}

# Tiled values that hold the depthwise convolution of the logical values of a
# shape.
def Convolved(~Logical: Data,~original: Logical -> U32 -> F32,~Weights: Data,~weight_value: Weights -> U32 -> F32,~Bias: Data,~bias_value: Bias -> U32 -> F32,+logical: Logical,+weights: Weights,+bias: Bias,+shape: List<&2,U32>,+kernel: U32,+stride: U32,+padding: U32,
