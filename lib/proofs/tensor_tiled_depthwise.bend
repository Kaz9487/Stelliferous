# Depthwise convolution on the tiled form. Lane l of a cell of group g of the
# output is channel 8g + l of the input convolved with its own weights of
# shape 1,K,K and added to its own bias: the parameter tiles hold the weights
# of eight channels at every tap, the groups outermost, and then their bias.
import Base
import ../kernel_tile.bend as Tile
import ../kernel_gemm.bend as KernelGemm
import ../tensor.bend as Tensors
import ../tensor_grid.bend as Grid
import ../tensor_tiled.bend as Tiled
import ../tensor_tiled_cells.bend as Cells
import ../storage_buffer.bend as Storage
import ../storage_allocation.bend as Allocation
import ../machine_limits.bend as Machine
import ../default_machine_limits.bend as Default
import ../tensor_window.bend as Window
import ../tensor_tiled_map.bend as TiledMap
import ../tensor_tiled_depthwise.bend as TiledDepthwise
import ./tensor_pieces_model.bend as PiecesModel
import ./tensor_window_values.bend as Values
import ./tensor_window_public.bend as WindowPublic
import ../tensor_shape.bend as Shapes
import ../tensor_access.bend as Access
import ../tensor_pieces.bend as Pieces
import ./tensor_joined.bend as Joined
import ./tensor_move_readback.bend as Held
import ./tensor_global_shape_count.bend as Global
import ./tensor_tiled_relane.bend as Relane
import ./tensor_count_completion.bend as CountCompletion
import ./tensor_tiled_pool.bend as PoolProof
import ./boolean_logic.bend as Boolean
import ./word_encoding.bend as WordEncoding
import ./kernel_tile_refinement.bend as TileLaws
import ./storage_buffer_model.bend as Buffer
import ./storage_tree_model.bend as Tree
import ./storage_allocation_refinement.bend as AllocationLaws
import ./tensor_list_values.bend as TensorList
import ./list_storage_readback.bend as ListRead
import ./tensor_exit_values.bend as ExitValues
