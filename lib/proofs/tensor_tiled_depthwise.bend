# ---- The parameters of logical values ----

# The weights of shape C,1,K,K and the bias of shape C of C channels.
type Parameters<-Weights: Data,-Bias: Data> is Data:
  Parameters{weights: Weights,bias: Bias,channels: U32,kernel: U32}

# The weight of a channel at a tap: index (c K + r) K + s of the weights.
def weight_of(~Weights: Data,~weight_value: Weights -> U32 -> F32,~Bias: Data,parameters: Parameters<Weights,Bias>,channel: Nat,kernel_row: U32,column: U32) -> F32:
  Parameters{weights,bias,channels,+kernel} = parameters
  weight_value(weights,((U32.from_nat(channel) * kernel * kernel : U32) + kernel_row * kernel + column : U32))

def bias_of(~Weights: Data,~Bias: Data,~bias_value: Bias -> U32 -> F32,parameters: Parameters<Weights,Bias>,channel: Nat) -> F32:
  Parameters{weights,bias,channels,kernel} = parameters
  bias_value(bias,U32.from_nat(channel))

# ---- The parameter tiles ----

# The weights and the bias with their lanes on the channels, the groups
# outermost.
def weight_geometry(+channels: U32,+kernel: U32) -> Cells.Cells:
  Public.geometry_of([channels,1,kernel,kernel],0n,Grid.Outermost{})

def bias_geometry(+channels: U32) -> Cells.Cells:
  Public.geometry_of([channels],0n,Grid.Outermost{})

def weight_tiles(~Weights: Data,~weight_value: Weights -> U32 -> F32,+weights: Weights,+channels: U32,+kernel: U32) -> List<&2,Tile.Tile8>:
  Contract.listed(~Tile.Tile8,~Representation.Lifted<Weights>,~Representation.lifted(~Weights,~weight_value),ShapeLaws.elements(Tiled.cell_shape([channels,1,kernel,kernel],0n,Grid.Outermost{})),0n,
    Representation.Lifted{weights,weight_geometry(channels,kernel)})

def bias_tiles(~Bias: Data,~bias_value: Bias -> U32 -> F32,+bias: Bias,+channels: U32) -> List<&2,Tile.Tile8>:
  Contract.listed(~Tile.Tile8,~Representation.Lifted<Bias>,~Representation.lifted(~Bias,~bias_value),ShapeLaws.elements(Tiled.cell_shape([channels],0n,Grid.Outermost{})),0n,
    Representation.Lifted{bias,bias_geometry(channels)})

# The tree of the parameter buffer: the tiles written from 0 into a buffer of
# count +0 tiles.
def parameter_tree(+values: List<&2,Tile.Tile8>,+count: U32) -> Tree.Tree<Tile.Tile8>:
  Buffer.tree(~Tile.Tile8,Buffer.remodel(~Tile.Tile8,Storage.write_at(~Tile.Tile8,values,0,Tensors.buffer(~Tile.Tile8,Tile.filled(0.0),count))))

def parameter_cells(~Weights: Data,~weight_value: Weights -> U32 -> F32,~Bias: Data,~bias_value: Bias -> U32 -> F32,parameters: Parameters<Weights,Bias>) -> Rows.Weights:
  Parameters{+weights,+bias,+lanes,+kernel} = parameters
  Rows.Weights{parameter_tree(List.append(&2,Tile.Tile8,weight_tiles(~Weights,~weight_value,weights,lanes,kernel),bias_tiles(~Bias,~bias_value,bias,lanes)),(Tiled.groups(lanes) * kernel * kernel + Tiled.groups(lanes) : U32)),kernel,Tiled.groups(lanes)}

# What the parameters of lanes channels need of the machine: room for the
# taps of the kernel and for the parameter tiles.
type Room<-limits: Machine.Limits,-lanes: U32,-kernel: U32> is Data:
  Room{area_room: {Nat.is_le(ShapeLaws.elements([kernel,kernel]),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},tiles_room: {Nat.is_le(Nat.add(Nat.mul(U32.to_nat(Tiled.groups(lanes)),U32.to_nat(Tiled.product([kernel,kernel]))),U32.to_nat(Tiled.groups(lanes))),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}}

def ParameterFacts(~Weights: Data,~Bias: Data,parameters: Parameters<Weights,Bias>,+channels: Nat) -> Data:
  Parameters{weights,bias,+lanes,+kernel} = parameters
  KernelGemm.Both<{U32.to_nat(lanes) == channels : Nat},Room<Default.limits(),lanes,kernel>>

# Parameter cells of the parameters of a channel count.
def Related(~Weights: Data,~weight_value: Weights -> U32 -> F32,~Bias: Data,~bias_value: Bias -> U32 -> F32,cells: Rows.Weights,parameters: Parameters<Weights,Bias>,+channels: Nat) -> Data:
  KernelGemm.Both<{cells == parameter_cells(~Weights,~weight_value,~Bias,~bias_value,parameters) : Rows.Weights},ParameterFacts(~Weights,~Bias,parameters,channels)>

# ---- Words of the parameters ----

def area_exact(+limits: Machine.Limits,+kernel: U32,+area_room: {Nat.is_le(ShapeLaws.elements([kernel,kernel]),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}) -> {U32.to_nat(Tiled.product([kernel,kernel])) == Nat.mul(U32.to_nat(kernel),U32.to_nat(kernel)) : Nat}:
  %Order.times_one(U32.to_nat(kernel)) : {U32.to_nat(Tiled.product([kernel,kernel])) == Nat.mul(U32.to_nat(kernel),_) : Nat}
  Public.product_exact(Machine.capacity(limits),Limits.capacity_fits(limits),[kernel,kernel],area_room)

# The words of the taps: channel c, kernel row r and column s stand at
# c K K + r K + s, on any machine.
def scaled_word(+channel: Nat,+kernel: U32) ->
  {(U32.from_nat(channel) * kernel * kernel : U32) == U32.from_nat(Nat.mul(channel,U32.to_nat(Tiled.product([kernel,kernel])))) : U32}:
  +area = Tiled.product([kernel,kernel])
  Equal.trans(U32,(U32.from_nat(channel) * kernel * kernel : U32),(U32.from_nat(channel) * (kernel * kernel : U32) : U32),U32.from_nat(Nat.mul(channel,U32.to_nat(area))),
    Arithmetic.multiply_associative(U32.from_nat(channel),kernel,kernel),
    %Arithmetic.multiply_one(kernel) : {(U32.from_nat(channel) * (kernel * _ : U32) : U32) == U32.from_nat(Nat.mul(channel,U32.to_nat(area))) : U32}
    %Arithmetic.native_roundtrip(area) : {(U32.from_nat(channel) * _ : U32) == U32.from_nat(Nat.mul(channel,U32.to_nat(area))) : U32}
    Multiplication.native_encoded_multiply(channel,U32.to_nat(area)))

def channels_word(+channels: U32,+kernel: U32) ->
  {(channels * kernel * kernel : U32) == U32.from_nat(Nat.mul(U32.to_nat(channels),U32.to_nat(Tiled.product([kernel,kernel])))) : U32}:
  %Arithmetic.native_roundtrip(channels) : {(_ * kernel * kernel : U32) == U32.from_nat(Nat.mul(U32.to_nat(channels),U32.to_nat(Tiled.product([kernel,kernel])))) : U32}
  scaled_word(U32.to_nat(channels),kernel)

def tap_word(+group: Nat,+row: Nat,+column: Nat,+kernel: U32) -> {((U32.from_nat(group) * kernel * kernel : U32) + U32.from_nat(row) * kernel + U32.from_nat(column) : U32) == U32.from_nat(Nat.add(Nat.mul(group,U32.to_nat(Tiled.product([kernel,kernel]))),Nat.add(Nat.mul(row,U32.to_nat(kernel)),column))) : U32}:
  +scaled = U32.from_nat(Nat.mul(group,U32.to_nat(Tiled.product([kernel,kernel]))))
  +line = U32.from_nat(Nat.mul(row,U32.to_nat(kernel)))
  +step = U32.from_nat(column)
  +goal = U32.from_nat(Nat.add(Nat.mul(group,U32.to_nat(Tiled.product([kernel,kernel]))),Nat.add(Nat.mul(row,U32.to_nat(kernel)),column)))
  +lined = {%Arithmetic.native_roundtrip(kernel) : {(U32.from_nat(row) * _ : U32) == line : U32}
    Multiplication.native_encoded_multiply(row,U32.to_nat(kernel)) : {(U32.from_nat(row) * kernel : U32) == line : U32}}
  %Equal.sym(U32,(U32.from_nat(group) * kernel * kernel : U32),scaled,scaled_word(group,kernel)) : {(_ + U32.from_nat(row) * kernel + step : U32) == goal : U32}
  %Equal.sym(U32,(U32.from_nat(row) * kernel : U32),line,lined) : {(scaled + _ + step : U32) == goal : U32}
  %Equal.sym(U32,(scaled + line + step : U32),(scaled + (line + step : U32) : U32),Arithmetic.add_associative(scaled,line,step)) : {_ == goal : U32}
  %Equal.sym(U32,(line + step : U32),U32.from_nat(Nat.add(Nat.mul(row,U32.to_nat(kernel)),column)),WordArithmetic.native_add(Nat.mul(row,U32.to_nat(kernel)),column)) : {(scaled + _ : U32) == goal : U32}
  WordArithmetic.native_add(Nat.mul(group,U32.to_nat(Tiled.product([kernel,kernel]))),Nat.add(Nat.mul(row,U32.to_nat(kernel)),column))

# The tiles of the weights hold groups K K tiles.
def weight_count(+limits: Machine.Limits,+lanes: U32,+kernel: U32,+area_room: {Nat.is_le(ShapeLaws.elements([kernel,kernel]),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}) -> {ShapeLaws.elements([Tiled.groups(lanes),1,kernel,kernel]) == Nat.mul(U32.to_nat(Tiled.groups(lanes)),U32.to_nat(Tiled.product([kernel,kernel]))) : Nat}:
  +taps = ShapeLaws.elements([kernel,kernel])
  +exact = Public.product_exact(Machine.capacity(limits),Limits.capacity_fits(limits),[kernel,kernel],area_room)
  %Equal.sym(Nat,Nat.add(taps,0n),taps,Addition.zero_right(taps)) : {Nat.mul(U32.to_nat(Tiled.groups(lanes)),_) == Nat.mul(U32.to_nat(Tiled.groups(lanes)),U32.to_nat(Tiled.product([kernel,kernel]))) : Nat}
  %Equal.sym(Nat,U32.to_nat(Tiled.product([kernel,kernel])),taps,exact) : {Nat.mul(U32.to_nat(Tiled.groups(lanes)),taps) == Nat.mul(U32.to_nat(Tiled.groups(lanes)),_) : Nat}
  {==}

