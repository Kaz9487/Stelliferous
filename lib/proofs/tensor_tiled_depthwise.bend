# Depthwise convolution of tiled values of the contract of a nonempty input of
# shape C,H,W or N,C,H,W, nonempty weights of shape C,1,K,K and a bias of
# shape C, that fit the machine. When the call returns Ready, the result holds
# at every index the convolution of the channel of the index with its own
# weights, from its own bias.
def depthwise_conv2d(~Logical: Data,~original: Logical -> U32 -> F32,~Weights: Data,~weight_value: Weights -> U32 -> F32,~Bias: Data,~bias_value: Bias -> U32 -> F32,+logical: Logical,+weights: Weights,+bias: Bias,+shape: List<&2,U32>,+channels: U32,+kernel: U32,+stride: U32,+padding: U32,+limits: Machine.Limits,
  +default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},input: Tiled.Tiled,weight_tiled: Tiled.Tiled,bias_tiled: Tiled.Tiled,
  +contract: Public.Contract(~Logical,~original,logical,shape,input),+weight_contract: Public.Contract(~Weights,~weight_value,weights,[channels,1,kernel,kernel],weight_tiled),
  +bias_contract: Public.Contract(~Bias,~bias_value,bias,[channels],bias_tiled),+nonzero: {Shapes.has_zero(shape) == False{} : Bool},
  +weights_nonzero: {Shapes.has_zero([channels,1,kernel,kernel]) == False{} : Bool},+fits: PoolProof.PoolFits(limits,shape,kernel,stride,padding),+room: Room<Default.limits(),channels,kernel>,
  accepted: {Contract.tensor_ready(~Tile.Tile8,Tiled.cells_of(TiledDepthwise.depthwise_conv2d(input,weight_tiled,bias_tiled,stride,padding))) == True{} : Bool}) ->
  Convolved(~Logical,~original,~Weights,~weight_value,~Bias,~bias_value,logical,weights,bias,shape,kernel,stride,padding,TiledDepthwise.depthwise_conv2d(input,weight_tiled,bias_tiled,stride,padding)):
  depthwise_described(~Logical,~original,~Weights,~weight_value,~Bias,~bias_value,logical,weights,bias,shape,channels,kernel,stride,padding,limits,default_capacity,input,Public.packed(~Logical,~original,logical,shape,input,contract),
    weight_tiled,Public.packed(~Weights,~weight_value,weights,[channels,1,kernel,kernel],weight_tiled,weight_contract),bias_tiled,Public.packed(~Bias,~bias_value,bias,[channels],bias_tiled,bias_contract),
    contract,weight_contract,bias_contract,nonzero,weights_nonzero,fits,room,accepted)
