  %Equal.sym(Nat,ShapeLaws.elements([Tiled.groups(lanes),1,kernel,kernel]),Nat.mul(U32.to_nat(Tiled.groups(lanes)),U32.to_nat(Tiled.product([kernel,kernel]))),weight_count(limits,lanes,kernel,area_room)) : {Nat.add(_,ShapeLaws.elements([Tiled.groups(lanes)])) == Nat.add(Nat.mul(U32.to_nat(Tiled.groups(lanes)),U32.to_nat(Tiled.product([kernel,kernel]))),U32.to_nat(Tiled.groups(lanes))) : Nat}
