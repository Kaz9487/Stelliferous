  %Equal.sym(U32,(U32.from_nat(Nat.mul(U32.to_nat(Tiled.groups(lanes)),U32.to_nat(Tiled.product([kernel,kernel])))) + U32.from_nat(U32.to_nat(Tiled.groups(lanes))) : U32),U32.from_nat(Nat.add(Nat.mul(U32.to_nat(Tiled.groups(lanes)),U32.to_nat(Tiled.product([kernel,kernel]))),U32.to_nat(Tiled.groups(lanes)))),WordArithmetic.native_add(Nat.mul(U32.to_nat(Tiled.groups(lanes)),U32.to_nat(Tiled.product([kernel,kernel]))),U32.to_nat(Tiled.groups(lanes)))) : {U32.to_nat(_) == Nat.add(Nat.mul(U32.to_nat(Tiled.groups(lanes)),U32.to_nat(Tiled.product([kernel,kernel]))),U32.to_nat(Tiled.groups(lanes))) : Nat}
