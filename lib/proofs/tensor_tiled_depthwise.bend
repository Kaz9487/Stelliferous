# ---- The parameter tree ----

def tree_value(+model: Buffer.Model<Tile.Tile8>,+index: U32) ->
  {Tree.read(Tile.Tile8,Buffer.tree(~Tile.Tile8,model),index) == Buffer.value(~Tile.Tile8,index,Buffer.content(~Tile.Tile8,model)) : Tile.Tile8}:
  Buffer.Model{+tree,+length,certificate} = model
  {==}

def written_value(+values: List<&2,Tile.Tile8>,+count: U32,+index: Nat,+equal: {List.length(&2,Tile.Tile8,values) == U32.to_nat(count) : Nat},
  +within: {Nat.is_lt(index,U32.to_nat(count)) == True{} : Bool},+sized: Depth.Sized<count>) ->
  {Buffer.value(~Tile.Tile8,U32.from_nat(index),Buffer.contents(~Tile.Tile8,Storage.write_at(~Tile.Tile8,values,0,Tensors.buffer(~Tile.Tile8,Tile.filled(0.0),count)))) ==
    ListRead.at(~Tile.Tile8,Tile.filled(0.0),index,values) : Tile.Tile8}:
  %Equal.sym(Storage.Buffer<Tile.Tile8>,Allocation.allocate(~Tile.Tile8,Tensors.depth_for(count),Tile.filled(0.0),U32.to_nat(count)),Storage.allocate(~Tile.Tile8,Tensors.depth_for(count),Tile.filled(0.0),U32.to_nat(count)),
      AllocationLaws.dispatch_same(Tile.Tile8,Allocation.allocated(~Tile.Tile8),Tensors.depth_for(count),Tile.filled(0.0),U32.to_nat(count))) :
    {Buffer.value(~Tile.Tile8,U32.from_nat(index),Buffer.contents(~Tile.Tile8,Storage.write_at(~Tile.Tile8,values,0,_))) == ListRead.at(~Tile.Tile8,Tile.filled(0.0),index,values) : Tile.Tile8}
  TensorList.written(~Tile.Tile8,values,count,Tile.filled(0.0),index,equal,within,sized)

# The parameter tree reads, below the length of its list, the list.
def parameter_read(+values: List<&2,Tile.Tile8>,+count: U32,+index: Nat,+equal: {List.length(&2,Tile.Tile8,values) == U32.to_nat(count) : Nat},
  +within: {Nat.is_lt(index,U32.to_nat(count)) == True{} : Bool},+sized: Depth.Sized<count>) ->
  {Tree.read(Tile.Tile8,parameter_tree(values,count),U32.from_nat(index)) == ListRead.at(~Tile.Tile8,Tile.filled(0.0),index,values) : Tile.Tile8}:
  +model = Buffer.remodel(~Tile.Tile8,Storage.write_at(~Tile.Tile8,values,0,Tensors.buffer(~Tile.Tile8,Tile.filled(0.0),count)))
  +same = Equal.trans(Buffer.Content<Tile.Tile8>,Buffer.content(~Tile.Tile8,model),Buffer.contents(~Tile.Tile8,Buffer.pack(~Tile.Tile8,model)),Buffer.contents(~Tile.Tile8,Storage.write_at(~Tile.Tile8,values,0,Tensors.buffer(~Tile.Tile8,Tile.filled(0.0),count))),
    Equal.sym(Buffer.Content<Tile.Tile8>,Buffer.contents(~Tile.Tile8,Buffer.pack(~Tile.Tile8,model)),Buffer.content(~Tile.Tile8,model),Buffer.packed_contents(~Tile.Tile8,model)),
    Equal.cong(Storage.Buffer<Tile.Tile8>,Buffer.Content<Tile.Tile8>,stored => Buffer.contents(~Tile.Tile8,stored),Buffer.pack(~Tile.Tile8,model),Storage.write_at(~Tile.Tile8,values,0,Tensors.buffer(~Tile.Tile8,Tile.filled(0.0),count)),Buffer.remodeled(~Tile.Tile8,Storage.write_at(~Tile.Tile8,values,0,Tensors.buffer(~Tile.Tile8,Tile.filled(0.0),count)))))
  %Equal.sym(Tile.Tile8,Tree.read(Tile.Tile8,Buffer.tree(~Tile.Tile8,model),U32.from_nat(index)),Buffer.value(~Tile.Tile8,U32.from_nat(index),Buffer.content(~Tile.Tile8,model)),tree_value(model,U32.from_nat(index))) :
    {_ == ListRead.at(~Tile.Tile8,Tile.filled(0.0),index,values) : Tile.Tile8}
  %Equal.sym(Buffer.Content<Tile.Tile8>,Buffer.content(~Tile.Tile8,model),Buffer.contents(~Tile.Tile8,Storage.write_at(~Tile.Tile8,values,0,Tensors.buffer(~Tile.Tile8,Tile.filled(0.0),count))),same) :
    {Buffer.value(~Tile.Tile8,U32.from_nat(index),_) == ListRead.at(~Tile.Tile8,Tile.filled(0.0),index,values) : Tile.Tile8}
  written_value(values,count,index,equal,within,sized)

# ---- A lane of a parameter tile ----

# Lane l of the weight tile of group g at a tap is the weight of channel
# 8g + l at the tap.
