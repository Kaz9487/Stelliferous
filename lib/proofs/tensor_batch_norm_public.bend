  +room: TiledExit.Room<Public.geometry_of([images,channels,height,width],1n,Grid.Outermost{}),cap>,+outer: Nat,+outer_inside: {Nat.is_lt(outer,Representation.outer_count(Public.geometry_of([images,channels,height,width],1n,Grid.Outermost{}))) == True{} : Bool},+group: Nat) ->
