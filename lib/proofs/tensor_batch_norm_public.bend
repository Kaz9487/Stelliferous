# Batch normalization in training: for x [N,C,H,W] without a zero extent and
# gamma, beta and the running statistics [C], each of the contract, with
# M = N * H * W, the mean of a channel the sum of its values divided by M and
# s the sum of the squares of its values minus the mean: the output holds
# ((x - mean) * (1 / sqrt(s / M + epsilon))) * gamma + beta and xhat holds
# (x - mean) * (1 / sqrt(s / M + epsilon)) at every index, the saved
# deviation holds 1 / sqrt(s / M + epsilon), gamma and beta come back as they
# were given, and each running statistic holds
# running * (1 - momentum) + statistic * momentum with the mean and with
# s / (M - 1). The sums of the cells [N,H,W,G] of x need a word cap of at
# most 2^31 above twice their count and four.
def forward(~X: Data,~xv: X -> U32 -> F32,~RM: Data,~rmv: RM -> U32 -> F32,~RV: Data,~rvv: RV -> U32 -> F32,~G: Data,~gv: G -> U32 -> F32,~B: Data,~bv: B -> U32 -> F32,+x: X,+gamma: G,+beta: B,+mean: RM,+variance: RV,+images: U32,+channels: U32,+height: U32,+width: U32,+epsilon: F32,+momentum: F32,
  +limits: Machine.Limits,+default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},
  +nonempty: {Nat.is_lt(0n,ShapeLaws.elements([images,channels,height,width])) == True{} : Bool},+rank_room: {Nat.is_le(4n,U32.to_nat(Machine.capacity(limits))) == True{} : Bool},+cap: U32,+cap_ok: {U32.is_le(cap,2147483648) == True{} : Bool},+count_room: {Nat.is_le(Nat.add(Nat.double(ShapeLaws.elements([images,height,width,Tiled.groups(channels)])),4n),U32.to_nat(cap)) == True{} : Bool},
  x_tensor: Tiled.Tiled,+x_contract: Public.Contract(~X,~xv,x,[images,channels,height,width],x_tensor),gamma_tensor: Tiled.Tiled,+gamma_contract: Public.Contract(~G,~gv,gamma,[channels],gamma_tensor),beta_tensor: Tiled.Tiled,+beta_contract: Public.Contract(~B,~bv,beta,[channels],beta_tensor),mean_tensor: Tiled.Tiled,+mean_contract: Public.Contract(~RM,~rmv,mean,[channels],mean_tensor),variance_tensor: Tiled.Tiled,+variance_contract: Public.Contract(~RV,~rvv,variance,[channels],variance_tensor)) ->
  ForwardHolds(~X,~xv,~RM,~rmv,~RV,~rvv,~G,~gv,~B,~bv,x,gamma,beta,mean,variance,images,channels,height,width,epsilon,momentum,BN.forward(x_tensor,(gamma_tensor,beta_tensor),(mean_tensor,variance_tensor),BN.Settings{epsilon,momentum})):
  Relane.along_then(~X,~xv,(tiled => ForwardHolds(~X,~xv,~RM,~rmv,~RV,~rvv,~G,~gv,~B,~bv,x,gamma,beta,mean,variance,images,channels,height,width,epsilon,momentum,Tiled.with_metadata(~BN.Forward(),tiled,cells_x => shape => status => cells_workers => BN.forward_status(BN.Settings{epsilon,momentum},status,shape,cells_workers,cells_x,(gamma_tensor,beta_tensor),(mean_tensor,variance_tensor))))),x,[images,channels,height,width],x_tensor,1n,limits,default_capacity,{==},nonempty,rank_room,x_contract,
    cells => lanes => position => contract => forward_along(~X,~xv,~RM,~rmv,~RV,~rvv,~G,~gv,~B,~bv,x,gamma,beta,mean,variance,images,channels,height,width,epsilon,momentum,limits,default_capacity,nonempty,rank_room,
      cap,cap_ok,count_room,cells,lanes,position,contract,gamma_tensor,gamma_contract,beta_tensor,beta_contract,mean_tensor,mean_contract,variance_tensor,variance_contract))

# ---- The backward pass ----

# dy and xhat with the sums of dy and of dy * xhat, the scale and the count
# of the values of the channel of each value.
type BackChannels<-DY: Data,-XH: Data,-S: Data,-P: Data,-C: Data> is Data:
  BackChannels{dy: DY,xhat: XH,shift: S,product: P,scale: C,total: F32,geometry: Cells.Cells}

# ((dy * total - shift) - xhat * product) * scale.
def back_value(~DY: Data,~dyv: DY -> U32 -> F32,~XH: Data,~xhv: XH -> U32 -> F32,~S: Data,~sv: S -> U32 -> F32,~P: Data,~pv: P -> U32 -> F32,~C: Data,~cv: C -> U32 -> F32,context: BackChannels<DY,XH,S,P,C>,index: U32) -> F32:
  BackChannels{dy,xhat,shift,product,scale,+total,+geometry} = context
  +at = index
  +channel = channel_of(geometry,at)
  ((((dyv(dy,at) * total : F32) - sv(shift,channel) : F32) - (xhv(xhat,at) * pv(product,channel) : F32) : F32) * cv(scale,channel) : F32)

def back_picked(~DY: Data,~dyv: DY -> U32 -> F32,~XH: Data,~xhv: XH -> U32 -> F32,~S: Data,~sv: S -> U32 -> F32,~P: Data,~pv: P -> U32 -> F32,~C: Data,~cv: C -> U32 -> F32,valid: Bool,+dy: DY,+xhat: XH,+shift: S,+product: P,+scale: C,+total: F32,+at: U32,+channel: U32,+target: U32,
  same: @+inside: {valid == True{} : Bool} -> {channel == target : U32}) ->
  {Bool.pick(F32,valid,((((Bool.pick(F32,valid,dyv(dy,at),0.0) * total : F32) - Bool.pick(F32,valid,sv(shift,channel),0.0) : F32) -
      (Bool.pick(F32,valid,xhv(xhat,at),0.0) * Bool.pick(F32,valid,pv(product,channel),0.0) : F32) : F32) * Bool.pick(F32,valid,cv(scale,channel),0.0) : F32),0.0) ==
    Bool.pick(F32,valid,((((dyv(dy,at) * total : F32) - sv(shift,target) : F32) - (xhv(xhat,at) * pv(product,target) : F32) : F32) * cv(scale,target) : F32),0.0) : F32}:
  match valid:
    case True{}:
      Equal.cong(U32,F32,word => ((((dyv(dy,at) * total : F32) - sv(shift,word) : F32) - (xhv(xhat,at) * pv(product,word) : F32) : F32) * cv(scale,word) : F32),channel,target,same({==}))
    case False{}: {==}

# The dy of a group updated with the cells [C] of its sums and scale holds
# the backward value at the lanes below the channels and +0 past them.
