# Both pieces of the forward pass are canonical pieces of the shape.
def PairCanonical(+shape: List<&2,U32>,pair: PiecesModel.Content<Tile.Tile8> & PiecesModel.Content<Tile.Tile8>) -> Data:
  (left,right) = pair
  KernelGemm.Both<Global.Canonical(~Tile.Tile8,shape,left),Global.Canonical(~Tile.Tile8,shape,right)>

