  Public.Packed{+model,+shape,+fill,+workers,+axis,+lanes,+position,+equation} = packed
  %equation : ListedTiles(~Deviation(~V),~deviation_value(~V,~vv),deviation_context(~V,variance,epsilon),channels,Tiled.listed(BN.inverse_deviation(_,channels,epsilon)))
  listed_tiles(~Deviation(~V),~deviation_value(~V,~vv),deviation_context(~V,variance,epsilon),channels,BN.inverse_deviation(Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),shape,fill,Tensors.Usable{},workers},axis,lanes,position},channels,epsilon),limits,default_capacity,nonempty,rank_room,
    deviation_of(~V,~vv,variance,channels,epsilon,limits,default_capacity,nonempty,rank_room,room,model,shape,fill,workers,axis,lanes,position,
      {%Equal.sym(Tiled.Tiled,Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),shape,fill,Tensors.Usable{},workers},axis,lanes,position},tiled,equation) : Public.Contract(~V,~vv,variance,[channels],_) contract : Public.Contract(~V,~vv,variance,[channels],Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),shape,fill,Tensors.Usable{},workers},axis,lanes,position})}))

# A tensor and the cells of what it lists.
def Kept(~L: Data,~o: L -> U32 -> F32,+logical: L,+channels: U32,pair: BN.Tensor() & BN.Listed()) -> Data:
  (tensor,listed) = pair
  KernelGemm.Both<Public.Contract(~L,~o,logical,[channels],tensor),ListedTiles(~L,~o,logical,channels,listed)>

# A tensor [C] reshaped to [C] and read as [C]: the lifted cells of its
# values.
def reshaped_listed(~L: Data,~o: L -> U32 -> F32,+logical: L,+channels: U32,+limits: Machine.Limits,
  +default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},+nonempty: {Nat.is_lt(0n,ShapeLaws.elements([channels])) == True{} : Bool},
  +rank_room: {Nat.is_le(1n,U32.to_nat(Machine.capacity(limits))) == True{} : Bool},-tiled: Tiled.Tiled,+packed: Public.Packed<tiled>,
  +contract: Public.Contract(~L,~o,logical,[channels],tiled)) -> ListedTiles(~L,~o,logical,channels,Tiled.listed(F.reshape(tiled,[channels]))):
  Public.Packed{+model,+shape,+fill,+workers,+axis,+lanes,+position,+equation} = packed
  %equation : ListedTiles(~L,~o,logical,channels,Tiled.listed(F.reshape(_,[channels])))
  listed_tiles(~L,~o,logical,channels,F.reshape(Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),shape,fill,Tensors.Usable{},workers},axis,lanes,position},[channels]),limits,default_capacity,nonempty,rank_room,
    Reshape.reshaped(~L,~o,logical,limits,[channels],[channels],Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),shape,fill,Tensors.Usable{},workers},axis,lanes,position},CountCompletion.positive_not_zero([channels],nonempty),{==},rank_room,rank_room,default_capacity,
      {%Equal.sym(Tiled.Tiled,Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),shape,fill,Tensors.Usable{},workers},axis,lanes,position},tiled,equation) : Public.Contract(~L,~o,logical,[channels],_) contract : Public.Contract(~L,~o,logical,[channels],Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),shape,fill,Tensors.Usable{},workers},axis,lanes,position})}))

# gamma or beta copied, the copy read as [C]: the tensor and the lifted cells
# of its values.
def parameter_held(~L: Data,~o: L -> U32 -> F32,+logical: L,+channels: U32,+limits: Machine.Limits,
  +default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},+nonempty: {Nat.is_lt(0n,ShapeLaws.elements([channels])) == True{} : Bool},
  +rank_room: {Nat.is_le(1n,U32.to_nat(Machine.capacity(limits))) == True{} : Bool},tiled: Tiled.Tiled,+contract: Public.Contract(~L,~o,logical,[channels],tiled)) ->
  Kept(~L,~o,logical,channels,BN.parameter_kept(channels,F.copy(tiled))):
  Copy.tiled_copied(~L,~o,~(pair => Kept(~L,~o,logical,channels,BN.parameter_kept(channels,pair))),logical,[channels],tiled,contract,
    first => second => first_contract => second_contract => KernelGemm.Both{first_contract,
      reshaped_listed(~L,~o,logical,channels,limits,default_capacity,nonempty,rank_room,second,Public.packed(~L,~o,logical,[channels],second,second_contract),second_contract)})

# A statistic copied: the tensor and the lifted cells of its values.
def read_held(~L: Data,~o: L -> U32 -> F32,+logical: L,+channels: U32,+limits: Machine.Limits,
  +default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},+nonempty: {Nat.is_lt(0n,ShapeLaws.elements([channels])) == True{} : Bool},
  +rank_room: {Nat.is_le(1n,U32.to_nat(Machine.capacity(limits))) == True{} : Bool},tiled: Tiled.Tiled,+contract: Public.Contract(~L,~o,logical,[channels],tiled)) ->
  Kept(~L,~o,logical,channels,BN.read_kept(F.copy(tiled))):
  Copy.tiled_copied(~L,~o,~(pair => Kept(~L,~o,logical,channels,BN.read_kept(pair))),logical,[channels],tiled,contract,
    first => second => first_contract => second_contract => KernelGemm.Both{first_contract,listed_tiles(~L,~o,logical,channels,second,limits,default_capacity,nonempty,rank_room,second_contract)})

# ---- What evaluate returns ----

# The output of the running statistics: x normalized by the running mean and
# 1 / sqrt(running variance + epsilon), times gamma, plus beta; then gamma,
# beta and the running statistics as they were given.
def EvaluateHolds(~X: Data,~xv: X -> U32 -> F32,~RM: Data,~rmv: RM -> U32 -> F32,~RV: Data,~rvv: RV -> U32 -> F32,~G: Data,~gv: G -> U32 -> F32,~B: Data,~bv: B -> U32 -> F32,+x: X,+gamma: G,+beta: B,+mean: RM,+variance: RV,+images: U32,+channels: U32,+height: U32,+width: U32,+epsilon: F32,result: BN.Evaluated()) -> Data:
  (output,((gammas,betas),(means,variances))) = result
  KernelGemm.Both<Public.Contract(~Channels<X,RM,Deviation(~RV),G,B>,~output_value(~X,~xv,~RM,~rmv,~Deviation(~RV),~deviation_value(~RV,~rvv),~G,~gv,~B,~bv),Channels{x,mean,deviation_context(~RV,variance,epsilon),gamma,beta,Public.geometry_of([images,channels,height,width],1n,Grid.Outermost{})},[images,channels,height,width],output),
    KernelGemm.Both<Public.Contract(~G,~gv,gamma,[channels],gammas),KernelGemm.Both<Public.Contract(~B,~bv,beta,[channels],betas),
      KernelGemm.Both<Public.Contract(~RM,~rmv,mean,[channels],means),Public.Contract(~RV,~rvv,variance,[channels],variances)>>>>

def no_normal() -> Kernel.Normal:
  Kernel.Normal{Tiled.zero_tile(),Tiled.zero_tile(),Tiled.zero_tile(),Tiled.zero_tile()}

# The evaluation of the cells of x with the statistics and parameters read
# as [C].
def evaluate_read(~X: Data,~xv: X -> U32 -> F32,~RM: Data,~rmv: RM -> U32 -> F32,~RV: Data,~rvv: RV -> U32 -> F32,~G: Data,~gv: G -> U32 -> F32,~B: Data,~bv: B -> U32 -> F32,+x: X,+gamma: G,+beta: B,+mean: RM,+variance: RV,+images: U32,+channels: U32,+height: U32,+width: U32,+workers: U32,+epsilon: F32,
  +limits: Machine.Limits,+default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},
  +nonempty: {Nat.is_lt(0n,ShapeLaws.elements([images,channels,height,width])) == True{} : Bool},+rank_room: {Nat.is_le(1n,U32.to_nat(Machine.capacity(limits))) == True{} : Bool},
  +model: PiecesModel.Model<Tile.Tile8>,+fill: Tile.Tile8,+cell_workers: U32,+contract: Public.Contract(~X,~xv,x,[images,channels,height,width],Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),Tiled.cell_shape([images,channels,height,width],1n,Grid.Innermost{}),fill,Tensors.Usable{},cell_workers},1n,Grid.lanes_at([images,channels,height,width],1n),Grid.Innermost{}}),
  gamma_pair: BN.Tensor() & BN.Listed(),+gamma_kept: Kept(~G,~gv,gamma,channels,gamma_pair),beta_pair: BN.Tensor() & BN.Listed(),+beta_kept: Kept(~B,~bv,beta,channels,beta_pair),
  mean_pair: BN.Tensor() & BN.Listed(),+mean_kept: Kept(~RM,~rmv,mean,channels,mean_pair),variance_pair: BN.Tensor() & BN.Tensor(),
  +variance_copies: Copy.Copies(~RV,~rvv,variance,[channels],variance_pair)) ->
  EvaluateHolds(~X,~xv,~RM,~rmv,~RV,~rvv,~G,~gv,~B,~bv,x,gamma,beta,mean,variance,images,channels,height,width,epsilon,
    BN.evaluate_read(BN.Layer{images,channels,height,width,workers},epsilon,PiecesModel.pack(~Tile.Tile8,model),gamma_pair,beta_pair,mean_pair,variance_pair)):
  (gamma_tensor,gammas) = gamma_pair
  KernelGemm.Both{+gamma_contract,+gammas_listed} = gamma_kept
  (beta_tensor,betas) = beta_pair
  KernelGemm.Both{+beta_contract,+betas_listed} = beta_kept
  (mean_tensor,means) = mean_pair
  KernelGemm.Both{+mean_contract,+means_listed} = mean_kept
  (variance_tensor,variance_kept) = variance_pair
  KernelGemm.Both{+variance_contract,+kept_contract} = variance_copies
  +geometry = Public.geometry_of([channels],0n,Grid.Outermost{})
  +count = ShapeLaws.elements(Tiled.cell_shape([channels],0n,Grid.Outermost{}))
  +values_room = values_room_of(~X,~xv,x,images,channels,height,width,limits,default_capacity,model,fill,cell_workers,contract)
  +channels_nonempty = channels_positive(images,channels,height,width,nonempty)
  +deviation = deviation_context(~RV,variance,epsilon)
  +deviations_listed = deviation_listed(~RV,~rvv,variance,channels,epsilon,limits,default_capacity,channels_nonempty,rank_room,
    channels_room(limits,images,channels,height,width,values_room,nonempty),variance_tensor,Public.packed(~RV,~rvv,variance,[channels],variance_tensor,variance_contract),variance_contract)
  +mean_list = Contract.listed(~Tile.Tile8,~Representation.Lifted<RM>,~Representation.lifted(~RM,~rmv),count,0n,Representation.Lifted{mean,geometry})
  +deviation_list = Contract.listed(~Tile.Tile8,~Representation.Lifted<Deviation(~RV)>,~Representation.lifted(~Deviation(~RV),~deviation_value(~RV,~rvv)),count,0n,Representation.Lifted{deviation,geometry})
  +gamma_list = Contract.listed(~Tile.Tile8,~Representation.Lifted<G>,~Representation.lifted(~G,~gv),count,0n,Representation.Lifted{gamma,geometry})
  +beta_list = Contract.listed(~Tile.Tile8,~Representation.Lifted<B>,~Representation.lifted(~B,~bv),count,0n,Representation.Lifted{beta,geometry})
  %Equal.sym(BN.Listed(),means,Done{mean_list},means_listed) :
    EvaluateHolds(~X,~xv,~RM,~rmv,~RV,~rvv,~G,~gv,~B,~bv,x,gamma,beta,mean,variance,images,channels,height,width,epsilon,BN.evaluate_grouped(BN.Layer{images,channels,height,width,workers},PiecesModel.pack(~Tile.Tile8,model),(gamma_tensor,beta_tensor),(mean_tensor,variance_kept),
      BN.normal_tiles(_,Tiled.listed(BN.inverse_deviation(variance_tensor,channels,epsilon)),gammas,betas)))
  %Equal.sym(BN.Listed(),Tiled.listed(BN.inverse_deviation(variance_tensor,channels,epsilon)),Done{deviation_list},deviations_listed) :
    EvaluateHolds(~X,~xv,~RM,~rmv,~RV,~rvv,~G,~gv,~B,~bv,x,gamma,beta,mean,variance,images,channels,height,width,epsilon,BN.evaluate_grouped(BN.Layer{images,channels,height,width,workers},PiecesModel.pack(~Tile.Tile8,model),(gamma_tensor,beta_tensor),(mean_tensor,variance_kept),
      BN.normal_tiles(Done{mean_list},_,gammas,betas)))
  %Equal.sym(BN.Listed(),gammas,Done{gamma_list},gammas_listed) :
    EvaluateHolds(~X,~xv,~RM,~rmv,~RV,~rvv,~G,~gv,~B,~bv,x,gamma,beta,mean,variance,images,channels,height,width,epsilon,BN.evaluate_grouped(BN.Layer{images,channels,height,width,workers},PiecesModel.pack(~Tile.Tile8,model),(gamma_tensor,beta_tensor),(mean_tensor,variance_kept),
      BN.normal_tiles(Done{mean_list},Done{deviation_list},_,betas)))
  %Equal.sym(BN.Listed(),betas,Done{beta_list},betas_listed) :
    EvaluateHolds(~X,~xv,~RM,~rmv,~RV,~rvv,~G,~gv,~B,~bv,x,gamma,beta,mean,variance,images,channels,height,width,epsilon,BN.evaluate_grouped(BN.Layer{images,channels,height,width,workers},PiecesModel.pack(~Tile.Tile8,model),(gamma_tensor,beta_tensor),(mean_tensor,variance_kept),
      BN.normal_tiles(Done{mean_list},Done{deviation_list},Done{gamma_list},_)))
  %Equal.sym(List<&2,Kernel.Normal>,BN.normal_groups(mean_list,deviation_list,gamma_list,beta_list),Contract.listed(~Kernel.Normal,~Groups.Normals<Representation.Lifted<RM>,Representation.Lifted<Deviation(~RV)>,Representation.Lifted<G>,Representation.Lifted<B>>,~Groups.normal_at(~Representation.Lifted<RM>,~Representation.lifted(~RM,~rmv),~Representation.Lifted<Deviation(~RV)>,~Representation.lifted(~Deviation(~RV),~deviation_value(~RV,~rvv)),~Representation.Lifted<G>,~Representation.lifted(~G,~gv),~Representation.Lifted<B>,~Representation.lifted(~B,~bv)),count,0n,Groups.Normals{Representation.Lifted{mean,geometry},Representation.Lifted{deviation,geometry},Representation.Lifted{gamma,geometry},Representation.Lifted{beta,geometry}}),
      Groups.normal_listed(~Representation.Lifted<RM>,~Representation.lifted(~RM,~rmv),~Representation.Lifted<Deviation(~RV)>,~Representation.lifted(~Deviation(~RV),~deviation_value(~RV,~rvv)),~Representation.Lifted<G>,~Representation.lifted(~G,~gv),~Representation.Lifted<B>,~Representation.lifted(~B,~bv),count,0n,Representation.Lifted{mean,geometry},Representation.Lifted{deviation,geometry},Representation.Lifted{gamma,geometry},Representation.Lifted{beta,geometry})) :
    EvaluateHolds(~X,~xv,~RM,~rmv,~RV,~rvv,~G,~gv,~B,~bv,x,gamma,beta,mean,variance,images,channels,height,width,epsilon,BN.evaluate_grouped(BN.Layer{images,channels,height,width,workers},PiecesModel.pack(~Tile.Tile8,model),(gamma_tensor,beta_tensor),(mean_tensor,variance_kept),Done{_}))
  KernelGemm.Both{evaluated_layer(~X,~xv,~RM,~rmv,~Deviation(~RV),~deviation_value(~RV,~rvv),~G,~gv,~B,~bv,x,mean,deviation,gamma,beta,no_normal(),images,channels,height,width,workers,limits,default_capacity,nonempty,model,fill,cell_workers,contract),
    KernelGemm.Both{gamma_contract,KernelGemm.Both{beta_contract,KernelGemm.Both{mean_contract,kept_contract}}}}

# The evaluation of the cells of x with the copies of the statistics and
# parameters.
def evaluate_cells(~X: Data,~xv: X -> U32 -> F32,~RM: Data,~rmv: RM -> U32 -> F32,~RV: Data,~rvv: RV -> U32 -> F32,~G: Data,~gv: G -> U32 -> F32,~B: Data,~bv: B -> U32 -> F32,+x: X,+gamma: G,+beta: B,+mean: RM,+variance: RV,+images: U32,+channels: U32,+height: U32,+width: U32,+workers: U32,+epsilon: F32,
  +limits: Machine.Limits,+default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},
  +nonempty: {Nat.is_lt(0n,ShapeLaws.elements([images,channels,height,width])) == True{} : Bool},+rank_room: {Nat.is_le(1n,U32.to_nat(Machine.capacity(limits))) == True{} : Bool},
  +model: PiecesModel.Model<Tile.Tile8>,+fill: Tile.Tile8,+cell_workers: U32,+contract: Public.Contract(~X,~xv,x,[images,channels,height,width],Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),Tiled.cell_shape([images,channels,height,width],1n,Grid.Innermost{}),fill,Tensors.Usable{},cell_workers},1n,Grid.lanes_at([images,channels,height,width],1n),Grid.Innermost{}}),
  -gamma_tensor: Tiled.Tiled,+gamma_packed: Public.Packed<gamma_tensor>,+gamma_contract: Public.Contract(~G,~gv,gamma,[channels],gamma_tensor),
  -beta_tensor: Tiled.Tiled,+beta_packed: Public.Packed<beta_tensor>,+beta_contract: Public.Contract(~B,~bv,beta,[channels],beta_tensor),
  -mean_tensor: Tiled.Tiled,+mean_packed: Public.Packed<mean_tensor>,+mean_contract: Public.Contract(~RM,~rmv,mean,[channels],mean_tensor),
  -variance_tensor: Tiled.Tiled,+variance_packed: Public.Packed<variance_tensor>,+variance_contract: Public.Contract(~RV,~rvv,variance,[channels],variance_tensor)) ->
  EvaluateHolds(~X,~xv,~RM,~rmv,~RV,~rvv,~G,~gv,~B,~bv,x,gamma,beta,mean,variance,images,channels,height,width,epsilon,
    BN.evaluate_cells(BN.Layer{images,channels,height,width,workers},epsilon,(gamma_tensor,beta_tensor),(mean_tensor,variance_tensor),Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),Tiled.cell_shape([images,channels,height,width],1n,Grid.Innermost{}),fill,Tensors.Usable{},cell_workers},1n,Grid.lanes_at([images,channels,height,width],1n),Grid.Innermost{}})):
  Public.Packed{+gamma_model,+gamma_shape,+gamma_fill,+gamma_workers,+gamma_axis,+gamma_lanes,+gamma_position,+gamma_equation} = gamma_packed
  Public.Packed{+beta_model,+beta_shape,+beta_fill,+beta_workers,+beta_axis,+beta_lanes,+beta_position,+beta_equation} = beta_packed
  Public.Packed{+mean_model,+mean_shape,+mean_fill,+mean_workers,+mean_axis,+mean_lanes,+mean_position,+mean_equation} = mean_packed
  Public.Packed{+variance_model,+variance_shape,+variance_fill,+variance_workers,+variance_axis,+variance_lanes,+variance_position,+variance_equation} = variance_packed
  +channels_nonempty = channels_positive(images,channels,height,width,nonempty)
  +gamma_held = {%Equal.sym(Tiled.Tiled,Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,gamma_model),gamma_shape,gamma_fill,Tensors.Usable{},gamma_workers},gamma_axis,gamma_lanes,gamma_position},gamma_tensor,gamma_equation) : Public.Contract(~G,~gv,gamma,[channels],_) gamma_contract : Public.Contract(~G,~gv,gamma,[channels],Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,gamma_model),gamma_shape,gamma_fill,Tensors.Usable{},gamma_workers},gamma_axis,gamma_lanes,gamma_position})}
  +beta_held = {%Equal.sym(Tiled.Tiled,Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,beta_model),beta_shape,beta_fill,Tensors.Usable{},beta_workers},beta_axis,beta_lanes,beta_position},beta_tensor,beta_equation) : Public.Contract(~B,~bv,beta,[channels],_) beta_contract : Public.Contract(~B,~bv,beta,[channels],Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,beta_model),beta_shape,beta_fill,Tensors.Usable{},beta_workers},beta_axis,beta_lanes,beta_position})}
  +mean_held = {%Equal.sym(Tiled.Tiled,Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,mean_model),mean_shape,mean_fill,Tensors.Usable{},mean_workers},mean_axis,mean_lanes,mean_position},mean_tensor,mean_equation) : Public.Contract(~RM,~rmv,mean,[channels],_) mean_contract : Public.Contract(~RM,~rmv,mean,[channels],Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,mean_model),mean_shape,mean_fill,Tensors.Usable{},mean_workers},mean_axis,mean_lanes,mean_position})}
  +variance_held = {%Equal.sym(Tiled.Tiled,Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,variance_model),variance_shape,variance_fill,Tensors.Usable{},variance_workers},variance_axis,variance_lanes,variance_position},variance_tensor,variance_equation) : Public.Contract(~RV,~rvv,variance,[channels],_) variance_contract :
