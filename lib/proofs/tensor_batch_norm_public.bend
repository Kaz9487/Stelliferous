  %Equal.sym(PiecesModel.Content<Tile.Tile8> & PiecesModel.Content<Tile.Tile8>,Passes.pieces_contents(BNCells.forward(groups,cells,padding,shape,workers,PiecesModel.pack(~Tile.Tile8,model))),
      (Each.content_map(~Tile.Tile8,~Tile.Tile8,~BNCells.Mapping<Kernel.Normal>,~Passes.mapped_model(~Kernel.Normal,~Passes.sample_at(~Kernel.Normal,~Tile.Tile8,~Kernel.normalized)),BNCells.Mapping{groups,cells,padding},model),Each.content_map(~Tile.Tile8,~Tile.Tile8,~BNCells.Mapping<Kernel.Normal>,~Passes.mapped_model(~Kernel.Normal,~Passes.sample_at(~Kernel.Normal,~Tile.Tile8,~Passes.output_of)),BNCells.Mapping{groups,cells,padding},model)),Passes.forward_pieces(groups,cells,padding,shape,workers,model)) :
    PairCanonical(shape,_)
  KernelGemm.Both{mapped_canonical(~Kernel.normalized,groups,cells,padding,shape,model,canonical),mapped_canonical(~Passes.output_of,groups,cells,padding,shape,model,canonical)}


