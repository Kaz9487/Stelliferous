  +contract: Public.Contract(~X,~xv,x,[images,channels,height,width],Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),Tiled.cell_shape([images,channels,height,width],1n,Grid.Innermost{}),fill,Tensors.Usable{},cell_workers},1n,Grid.lanes_at([images,channels,height,width],1n),Grid.Innermost{}})) -> {Nat.is_le(ShapeLaws.elements([images,channels,height,width]),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}:
