# The inverse deviation of a variance [C] read as [C]: the lifted cells of
# 1 / sqrt(variance + epsilon).
def deviation_listed(~V: Data,~vv: V -> U32 -> F32,+variance: V,+channels: U32,+epsilon: F32,+limits: Machine.Limits,
  +default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},+nonempty: {Nat.is_lt(0n,ShapeLaws.elements([channels])) == True{} : Bool},
  +rank_room: {Nat.is_le(1n,U32.to_nat(Machine.capacity(limits))) == True{} : Bool},+room: {Nat.is_le(ShapeLaws.elements([channels]),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},
