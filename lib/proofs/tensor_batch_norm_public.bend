# ---- The output of a pass ----

def padding_groups(+padding: TiledMap.Padding) -> U32:
  TiledMap.Padding{lanes,+groups,outer,position} = padding
  groups

# What a pass needs of the cells of a layout: the cells and the groups within
# half the word, the cells allocatable and covered by the padding.
def layout_rooms(+layout: PaddedCells.Layout,+limit: U32,+limit_exact: {U32.to_nat(limit) == PaddedCells.layout_total(layout) : Nat},
  +allocatable: {U32.is_le(limit,1073741824) == True{} : Bool},+positive: {Nat.is_lt(0n,PaddedCells.layout_total(layout)) == True{} : Bool},
  +fit: {PaddedPieces.groups_fit(Machine.half_word(PaddedPieces.layout_limits(layout)),PaddedCells.layout_padding(layout)) == True{} : Bool}) ->
  Passes.Rooms<limit,padding_groups(PaddedCells.layout_padding(layout)),PaddedCells.layout_padding(layout)>:
  match layout:
    case PaddedCells.Layout{+limits,+lanes,+padded_outer,+padded_position,+outer,+after,+position,+total,+cover}:
      Public.Cover{+counted,+cells_count,+padded_count,+placement} = cover
      +groups = U32.to_nat(Grid.groups(lanes))
      +outer_count = U32.to_nat(outer)
      +lane_count = U32.to_nat(lanes)
      +capacity = U32.to_nat(Machine.capacity(limits))
      +half = U32.to_nat(Machine.half_word(limits))
      +padded_count_nat = Nat.mul(groups,U32.to_nat(padded_outer))
      +product_positive = {%Equal.sym(Nat,Nat.mul(groups,outer_count),total,cells_count) : {Nat.is_lt(0n,_) == True{} : Bool} positive :
          {Nat.is_lt(0n,Nat.mul(groups,outer_count)) == True{} : Bool}}
      +outer_positive = DivisionOrder.right_factor_positive(groups,outer_count,product_positive)
      +lanes_bound = Order.transitive(lane_count,Nat.mul(lane_count,outer_count),capacity,RowMajor.product_covers(lane_count,outer_count,outer_positive),counted)
      +facts = TiledValues.grouped(limits,lanes,lanes_bound)
      +total_bound = {%cells_count : {Nat.is_le(_,capacity) == True{} : Bool}
          Order.transitive(Nat.mul(groups,outer_count),Nat.mul(lane_count,outer_count),capacity,RowMajor.mul_le(groups,lane_count,outer_count,TiledValues.fewer_of(limits,lanes,facts)),counted) :
          {Nat.is_le(total,capacity) == True{} : Bool}}
      +groups_total = {%cells_count : {Nat.is_le(groups,_) == True{} : Bool} RowMajor.product_covers(groups,outer_count,outer_positive) : {Nat.is_le(groups,total) == True{} : Bool}}
      +doubled = {%Equal.sym(Nat,half,Nat.double(capacity),Limits.doubled_capacity(limits)) : {Nat.is_le(Nat.double(total),_) == True{} : Bool}
          Order.double_le(total,capacity,total_bound) : {Nat.is_le(Nat.double(total),half) == True{} : Bool}}
      +twice = {%Equal.sym(Nat,Nat.add(total,total),Nat.double(total),Addition.double(total)) : {Nat.is_le(_,half) == True{} : Bool} doubled :
          {Nat.is_le(Nat.add(total,total),half) == True{} : Bool}}
      +sum_bound = {%Order.commutative(groups,total) : {Nat.is_le(_,half) == True{} : Bool}
          Order.transitive(Nat.add(groups,total),Nat.add(total,total),half,Order.add_le(groups,total,total,groups_total),twice) :
          {Nat.is_le(Nat.add(total,groups),half) == True{} : Bool}}
      +total_room = {%Equal.sym(Nat,U32.to_nat(limit),total,limit_exact) : {Nat.is_le(Nat.add(_,groups),half) == True{} : Bool} sum_bound :
          {Nat.is_le(Nat.add(U32.to_nat(limit),groups),half) == True{} : Bool}}
      +rest = Boolean.and_true_right(Nat.is_lt(0n,groups),Nat.is_le(Nat.double(groups),half) && Nat.is_le(padded_count_nat,half),fit)
      +groups_positive = Boolean.and_true_left(Nat.is_lt(0n,groups),Nat.is_le(Nat.double(groups),half) && Nat.is_le(padded_count_nat,half),fit)
      +double_room = Boolean.and_true_left(Nat.is_le(Nat.double(groups),half),Nat.is_le(padded_count_nat,half),rest)
      +whole = {%Equal.sym(Nat,U32.to_nat(limit),total,limit_exact) : {Nat.is_le(_,padded_count_nat) == True{} : Bool}
          %Equal.sym(Nat,padded_count_nat,total,padded_count) : {Nat.is_le(total,_) == True{} : Bool}
          Order.reflexive(total) : {Nat.is_le(U32.to_nat(limit),padded_count_nat) == True{} : Bool}}
      Passes.Rooms{Machine.half_word(limits),Limits.half_word_fits(limits),double_room,groups_positive,total_room,allocatable,fit,whole}

def rooms_positive(+limit: U32,+cells: U32,+padding: TiledMap.Padding,+rooms: Passes.Rooms<limit,cells,padding>) -> {Nat.is_lt(0n,U32.to_nat(cells)) == True{} : Bool}:
  Passes.Rooms{+cap,+cap_ok,+double_room,+positive,+total_room,+allocatable,+fit,+whole} = rooms
  positive

def split_lanes(+limits: Machine.Limits,+values: List<&2,U32>,+axis: Nat,+lanes: U32,+split: Public.Split<limits,values,axis,lanes>) ->
  {Nat.is_le(U32.to_nat(lanes),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}:
  Public.Split{+blocks,+outer_exact,+elements_exact,+lanes_within,+after_positive} = split
  lanes_within

# A word below the cells of a layout names a group and an outer index below
# those of its geometry.
def layout_inside(+layout: PaddedCells.Layout,+word: U32,+inside: {Nat.is_lt(U32.to_nat(word),PaddedCells.layout_total(layout)) == True{} : Bool}) ->
  {Nat.is_lt(U32.to_nat(word),Nat.mul(Representation.group_count(PaddedCells.layout_geometry(layout)),Representation.outer_count(PaddedCells.layout_geometry(layout)))) == True{} : Bool}:
  match layout:
    case PaddedCells.Layout{+limits,+lanes,+padded_outer,+padded_position,+outer,+after,+position,+total,+cover}:
      Public.Cover{+counted,+cells_count,+padded_count,+placement} = cover
      %Equal.sym(Nat,Nat.mul(U32.to_nat(Grid.groups(lanes)),U32.to_nat(outer)),total,cells_count) : {Nat.is_lt(U32.to_nat(word),_) == True{} : Bool}
      inside

def cells_inside(+layout: PaddedCells.Layout,+geometry: Cells.Cells,+geometry_exact: {PaddedCells.layout_geometry(layout) == geometry : Cells.Cells},+word: U32,
  +inside: {Nat.is_lt(U32.to_nat(word),PaddedCells.layout_total(layout)) == True{} : Bool}) ->
  {Nat.is_lt(U32.to_nat(word),Nat.mul(Representation.group_count(geometry),Representation.outer_count(geometry))) == True{} : Bool}:
  %geometry_exact : {Nat.is_lt(U32.to_nat(word),Nat.mul(Representation.group_count(_),Representation.outer_count(_))) == True{} : Bool}
  layout_inside(layout,word,inside)

def usable_pieces(-pieces: Pieces.Pieces(~Tile.Tile8),+shape: List<&2,U32>,+fill: Tile.Tile8,+workers: U32,+observation: PiecesModel.Observation<Tile.Tile8,pieces>) ->
  Global.Usable<Tile.Tile8,shape,Tensors.Tensor{pieces,shape,fill,Tensors.Usable{},workers}>:
  Global.usable_observed(~Tile.Tile8,pieces,shape,fill,Tensors.Usable{},workers,observation,{==})

