# ---- What backward returns ----

# The sums of axes [0, 2, 3] of dy and of dy * xhat.
def shift_sums(~DL: Data,~dv: DL -> U32 -> F32,+dy: DL,+images: U32,+channels: U32,+height: U32,+width: U32) -> PartialsValues.Box<Sum.Parts>:
  Statistics.plane_box(~DL,~dv,dy,images,channels,height,width)

def product_sums(~DL: Data,~dv: DL -> U32 -> F32,~XL: Data,~xv: XL -> U32 -> F32,+dy: DL,+xhat: XL,+images: U32,+channels: U32,+height: U32,+width: U32) -> PartialsValues.Box<Sum.Parts>:
  Statistics.plane_box(~Leaf.Context<DL,XL>,~Leaf.value(~F32,~DL,~XL,~Statistics.product_pair,~dv,~xv),Leaf.Context{dy,xhat},images,channels,height,width)

# (gamma * deviation) / (N * H * W), as backward composes it.
def Scale(~G: Data,~V: Data) -> Data:
  PiecesMap.Context<F32,Leaf.Context<G,V>>

def scale_value(~G: Data,~gv: G -> U32 -> F32,~V: Data,~vv: V -> U32 -> F32) -> Scale(~G,~V) -> U32 -> F32:
  PiecesMap.value(~F32,~F32,~Leaf.Context<G,V>,~F.scalar_value(~F32.div),~Leaf.value(~F32,~G,~V,~F32.mul,~gv,~vv))

def scale_context(~G: Data,~V: Data,+gamma: G,+deviation: V,+images: U32,+height: U32,+width: U32) -> Scale(~G,~V):
  PiecesMap.Context{U32.to_f32((images * (height * width : U32) : U32)),Leaf.Context{gamma,deviation}}

# dx of dy and xhat with the sums and the scale of their channels, the sums
# of dy * xhat and of dy, and gamma as it was given.
def BackwardHolds(~DL: Data,~dv: DL -> U32 -> F32,~XL: Data,~xv: XL -> U32 -> F32,~V: Data,~vv: V -> U32 -> F32,~G: Data,~gv: G -> U32 -> F32,+dy: DL,+xhat: XL,+deviation: V,+gamma: G,+images: U32,+channels: U32,+height: U32,+width: U32,result: BN.Backward()) -> Data:
  (dx,(dgamma,(dbeta,gammas))) = result
  KernelGemm.Both<Public.Contract(~BackChannels<DL,XL,PartialsValues.Box<Sum.Parts>,PartialsValues.Box<Sum.Parts>,Scale(~G,~V)>,~back_value(~DL,~dv,~XL,~xv,~PartialsValues.Box<Sum.Parts>,~PartialsValues.box_value(~F32,~Sum.Parts,~Sum.merge,~Sum.rounded),~PartialsValues.Box<Sum.Parts>,~PartialsValues.box_value(~F32,~Sum.Parts,~Sum.merge,~Sum.rounded),~Scale(~G,~V),~scale_value(~G,~gv,~V,~vv)),BackChannels{dy,xhat,shift_sums(~DL,~dv,dy,images,channels,height,width),product_sums(~DL,~dv,~XL,~xv,dy,xhat,images,channels,height,width),scale_context(~G,~V,gamma,deviation,images,height,width),U32.to_f32((images * (height * width : U32) : U32)),Public.geometry_of([images,channels,height,width],1n,Grid.Outermost{})},[images,channels,height,width],dx),
    KernelGemm.Both<Public.Contract(~PartialsValues.Box<Sum.Parts>,~PartialsValues.box_value(~F32,~Sum.Parts,~Sum.merge,~Sum.rounded),product_sums(~DL,~dv,~XL,~xv,dy,xhat,images,channels,height,width),[channels],dgamma),
      KernelGemm.Both<Public.Contract(~PartialsValues.Box<Sum.Parts>,~PartialsValues.box_value(~F32,~Sum.Parts,~Sum.merge,~Sum.rounded),shift_sums(~DL,~dv,dy,images,channels,height,width),[channels],dbeta),Public.Contract(~G,~gv,gamma,[channels],gammas)>>>

def no_back() -> Kernel.Back:
  Kernel.Back{Tiled.zero_tile(),Tiled.zero_tile(),Tiled.zero_tile(),0.0}

# The backward pass with the sums and the scale read as [C].
def back_read_holds(~DL: Data,~dv: DL -> U32 -> F32,~XL: Data,~xv: XL -> U32 -> F32,~V: Data,~vv: V -> U32 -> F32,~G: Data,~gv: G -> U32 -> F32,+dy: DL,+xhat: XL,+deviation: V,+gamma: G,+images: U32,+channels: U32,+height: U32,+width: U32,+workers: U32,+limits: Machine.Limits,+default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},+nonempty: {Nat.is_lt(0n,ShapeLaws.elements([images,channels,height,width])) == True{} : Bool},+rank_room: {Nat.is_le(1n,U32.to_nat(Machine.capacity(limits))) == True{} : Bool},
