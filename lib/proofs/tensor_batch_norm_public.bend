  scales: BN.Listed(),+scales_listed: ListedTiles(~Scale(~G,~V),~scale_value(~G,~gv,~V,~vv),scale_context(~G,~V,gamma,deviation,images,height,width),channels,scales),
  -gamma_kept: Tiled.Tiled,+gamma_kept_contract: Public.Contract(~G,~gv,gamma,[channels],gamma_kept),+dmodel: PiecesModel.Model<Tile.Tile8>,+dfill: Tile.Tile8,+dworkers: U32,+dcontract: Public.Contract(~DL,~dv,dy,[images,channels,height,width],Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,dmodel),Tiled.cell_shape([images,channels,height,width],1n,Grid.Innermost{}),dfill,Tensors.Usable{},dworkers},1n,Grid.lanes_at([images,channels,height,width],1n),Grid.Innermost{}}),+xmodel: PiecesModel.Model<Tile.Tile8>,+xfill: Tile.Tile8,+xworkers: U32,+xcontract: Public.Contract(~XL,~xv,xhat,[images,channels,height,width],Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,xmodel),Tiled.cell_shape([images,channels,height,width],1n,Grid.Innermost{}),xfill,Tensors.Usable{},xworkers},1n,Grid.lanes_at([images,channels,height,width],1n),Grid.Innermost{}})) ->
  BackwardHolds(~DL,~dv,~XL,~xv,~V,~vv,~G,~gv,dy,xhat,deviation,gamma,images,channels,height,width,BN.back_read(BN.Layer{images,channels,height,width,workers},beta_pair,sum_pair,scales,gamma_kept,Pieces.zip(~BNCells.Cells(),~BNCells.Cells(),PiecesModel.pack(~Tile.Tile8,dmodel),PiecesModel.pack(~Tile.Tile8,xmodel)))):
  (dbeta,betas) = beta_pair
  KernelGemm.Both{+dbeta_contract,+betas_listed} = beta_kept
  (dgamma,gammas) = sum_pair
  KernelGemm.Both{+dgamma_contract,+gammas_listed} = sum_kept
