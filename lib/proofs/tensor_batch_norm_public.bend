# The backward groups listed from the cells [C] read at a group are those
# cells.
def back_cells_at(~DY: Data,~dyv: DY -> U32 -> F32,~XH: Data,~xhv: XH -> U32 -> F32,~S: Data,~sv: S -> U32 -> F32,~P: Data,~pv: P -> U32 -> F32,~C: Data,~cv: C -> U32 -> F32,+shift: S,+product: P,+scale: C,+total: F32,+channels: U32,+group: Nat,+index: Nat,
