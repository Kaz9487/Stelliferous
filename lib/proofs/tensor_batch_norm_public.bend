  +root = {FunctionValues.sqrt(~PiecesMap.Context<F32,V>,~PiecesMap.value(~F32,~F32,~V,~F.scalar_value(~F32.add),~vv))(PiecesMap.Context{epsilon,variance},[channels],F.add_scalar(Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),shape,fill,Tensors.Usable{},workers},axis,lanes,position},epsilon),shifted) :
