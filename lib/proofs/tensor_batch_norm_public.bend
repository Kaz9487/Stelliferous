  xhat_tensor: Tiled.Tiled,+xhat_contract: Public.Contract(~XL,~xv,xhat,[images,channels,height,width],xhat_tensor),deviation_tensor: Tiled.Tiled,+deviation_contract: Public.Contract(~V,~vv,deviation,[channels],deviation_tensor),gamma_tensor: Tiled.Tiled,+gamma_contract: Public.Contract(~G,~gv,gamma,[channels],gamma_tensor)) ->
  BackwardHolds(~DL,~dv,~XL,~xv,~V,~vv,~G,~gv,dy,xhat,deviation,gamma,images,channels,height,width,Tiled.with_metadata(~BN.Backward(),Tiled.Tiled{cells,1n,lanes,position},cells_dy => shape => status => cells_workers => BN.back_status(status,shape,cells_workers,cells_dy,xhat_tensor,deviation_tensor,gamma_tensor))):
  Relane.modeled(~DL,~dv,(tiled => BackwardHolds(~DL,~dv,~XL,~xv,~V,~vv,~G,~gv,dy,xhat,deviation,gamma,images,channels,height,width,Tiled.with_metadata(~BN.Backward(),tiled,cells_dy => shape => status => cells_workers => BN.back_status(status,shape,cells_workers,cells_dy,xhat_tensor,deviation_tensor,gamma_tensor)))),dy,[images,channels,height,width],cells,1n,lanes,position,contract,
    dy_model => dy_fill => workers => dy_contract =>
      backward_modeled(~DL,~dv,~XL,~xv,~V,~vv,~G,~gv,dy,xhat,deviation,gamma,images,channels,height,width,workers,limits,default_capacity,nonempty,rank_room,cap,cap_ok,count_room,dy_model,dy_fill,position,dy_contract,xhat_tensor,xhat_contract,deviation_tensor,deviation_contract,gamma_tensor,gamma_contract))

# Batch normalization backward: for dy and xhat [N,C,H,W] without a zero
# extent and the saved deviation and gamma [C], each of the contract, with
# M = N * H * W, dbeta the sums of axes [0, 2, 3] of dy and dgamma those of
# dy * xhat: dx holds
# ((dy * M - dbeta) - xhat * dgamma) * ((gamma * deviation) / M) with the
# sums and parameters of the channel of each index, dgamma and dbeta hold
# those sums, and gamma comes back as it was given. The sums of the cells
# [N,H,W,G] need a word cap of at most 2^31 above twice their count and
# four.
def backward(~DL: Data,~dv: DL -> U32 -> F32,~XL: Data,~xv: XL -> U32 -> F32,~V: Data,~vv: V -> U32 -> F32,~G: Data,~gv: G -> U32 -> F32,+dy: DL,+xhat: XL,+deviation: V,+gamma: G,+images: U32,+channels: U32,+height: U32,+width: U32,
  +limits: Machine.Limits,+default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},
  +nonempty: {Nat.is_lt(0n,ShapeLaws.elements([images,channels,height,width])) == True{} : Bool},+rank_room: {Nat.is_le(4n,U32.to_nat(Machine.capacity(limits))) == True{} : Bool},+cap: U32,+cap_ok: {U32.is_le(cap,2147483648) == True{} : Bool},+count_room: {Nat.is_le(Nat.add(Nat.double(ShapeLaws.elements([images,height,width,Tiled.groups(channels)])),4n),U32.to_nat(cap)) == True{} : Bool},
  dy_tensor: Tiled.Tiled,+dy_contract: Public.Contract(~DL,~dv,dy,[images,channels,height,width],dy_tensor),xhat_tensor: Tiled.Tiled,+xhat_contract: Public.Contract(~XL,~xv,xhat,[images,channels,height,width],xhat_tensor),
  deviation_tensor: Tiled.Tiled,+deviation_contract: Public.Contract(~V,~vv,deviation,[channels],deviation_tensor),gamma_tensor: Tiled.Tiled,+gamma_contract: Public.Contract(~G,~gv,gamma,[channels],gamma_tensor)) -> BackwardHolds(~DL,~dv,~XL,~xv,~V,~vv,~G,~gv,dy,xhat,deviation,gamma,images,channels,height,width,BN.backward(dy_tensor,(xhat_tensor,deviation_tensor),gamma_tensor)):
  Relane.along_then(~DL,~dv,(tiled => BackwardHolds(~DL,~dv,~XL,~xv,~V,~vv,~G,~gv,dy,xhat,deviation,gamma,images,channels,height,width,Tiled.with_metadata(~BN.Backward(),tiled,cells_dy => shape => status => cells_workers => BN.back_status(status,shape,cells_workers,cells_dy,xhat_tensor,deviation_tensor,gamma_tensor)))),dy,[images,channels,height,width],dy_tensor,1n,limits,default_capacity,{==},nonempty,rank_room,dy_contract,
    cells => lanes => position => contract => backward_along(~DL,~dv,~XL,~xv,~V,~vv,~G,~gv,dy,xhat,deviation,gamma,images,channels,height,width,limits,default_capacity,nonempty,rank_room,cap,cap_ok,count_room,
      cells,lanes,position,contract,xhat_tensor,xhat_contract,deviation_tensor,deviation_contract,gamma_tensor,gamma_contract))
