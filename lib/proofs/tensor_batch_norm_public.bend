  Public.Contract(~PiecesMap.Context<F32,F32>,~PiecesMap.value(~F32,~F32,~F32,~TiledMap.constant,~FullValues.constant(~F32)),PiecesMap.Context{1.0,0.0},[channels],F.ones([channels])):
