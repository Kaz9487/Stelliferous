# ---- The tiles of a tensor read as [C] ----

def ListedTiles(~Logical: Data,~original: Logical -> U32 -> F32,+logical: Logical,+channels: U32,result: Result<&2,&2,Tensors.Problem,List<&2,Tile.Tile8>>) -> Data:
  {result == Done{Contract.listed(~Tile.Tile8,~Representation.Lifted<Logical>,~Representation.lifted(~Logical,~original),
      ShapeLaws.elements(Tiled.cell_shape([channels],0n,Grid.Outermost{})),0n,Representation.Lifted{logical,Public.geometry_of([channels],0n,Grid.Outermost{})})} :
    Result<&2,&2,Tensors.Problem,List<&2,Tile.Tile8>>}

def listed_arranged(~Logical: Data,~original: Logical -> U32 -> F32,+logical: Logical,+channels: U32,tiled: Tiled.Tiled,
  held: Relane.Arranged(~Logical,~original,logical,[channels],tiled,0n,Grid.Outermost{})) ->
  ListedTiles(~Logical,~original,logical,channels,Tiled.listed(tiled)):
  KernelGemm.Both{equation,+contract} = held
  Depthwise.tiles_listed(~Logical,~original,logical,[channels],0n,Grid.lanes_at([channels],0n),Grid.Outermost{},
    Tiled.cells_of(Tiled.arranged(tiled,0n,Grid.Outermost{})),contract)

def listed_packed(~Logical: Data,~original: Logical -> U32 -> F32,+logical: Logical,+channels: U32,-tiled: Tiled.Tiled,+limits: Machine.Limits,+default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},+nonempty: {Nat.is_lt(0n,ShapeLaws.elements([channels])) == True{} : Bool},
  +rank_room: {Nat.is_le(1n,U32.to_nat(Machine.capacity(limits))) == True{} : Bool},
  +packed: Public.Packed<tiled>,+contract: Public.Contract(~Logical,~original,logical,[channels],tiled)) ->
  ListedTiles(~Logical,~original,logical,channels,Tiled.listed(tiled)):
  Public.Packed{+model,+shape,+fill,+workers,+axis,+lanes,+position,+equation} = packed
  %equation : ListedTiles(~Logical,~original,logical,channels,Tiled.listed(_))
  listed_arranged(~Logical,~original,logical,channels,Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),shape,fill,Tensors.Usable{},workers},axis,lanes,position},
    Relane.arranged_held(~Logical,~original,logical,[channels],Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),shape,fill,Tensors.Usable{},workers},axis,lanes,position},0n,Grid.Outermost{},limits,default_capacity,{==},nonempty,rank_room,
      %Equal.sym(Tiled.Tiled,Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),shape,fill,Tensors.Usable{},workers},axis,lanes,position},tiled,equation) : Public.Contract(~Logical,~original,logical,[channels],_)
      contract))

# The tiles of a tensor [C] of the contract are the lifted cells of its
# values, in order.
def listed_tiles(~Logical: Data,~original: Logical -> U32 -> F32,+logical: Logical,+channels: U32,tiled: Tiled.Tiled,+limits: Machine.Limits,+default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},+nonempty: {Nat.is_lt(0n,ShapeLaws.elements([channels])) == True{} : Bool},
  +rank_room: {Nat.is_le(1n,U32.to_nat(Machine.capacity(limits))) == True{} : Bool},
  +contract: Public.Contract(~Logical,~original,logical,[channels],tiled)) ->
  ListedTiles(~Logical,~original,logical,channels,Tiled.listed(tiled)):
  listed_packed(~Logical,~original,logical,channels,tiled,limits,default_capacity,nonempty,rank_room,Public.packed(~Logical,~original,logical,[channels],tiled,contract),contract)

# ---- The values of a normalization ----

# x with the statistics and parameters of the channel of each value. The
# geometry names the channel of an index.
type Channels<-X: Data,-M: Data,-D: Data,-G: Data,-B: Data> is Data:
  Channels{x: X,mean: M,deviation: D,gamma: G,beta: B,geometry: Cells.Cells}

def channel_of(+geometry: Cells.Cells,index: U32) -> U32:
  U32.from_nat(Representation.value_channel(geometry,U32.to_nat(index)))

# (x - mean) * deviation.
def normalized_value(~X: Data,~xv: X -> U32 -> F32,~M: Data,~mv: M -> U32 -> F32,~D: Data,~dv: D -> U32 -> F32,~G: Data,~B: Data,context: Channels<X,M,D,G,B>,index: U32) -> F32:
  Channels{x,mean,deviation,gamma,beta,+geometry} = context
  +at = index
  +channel = channel_of(geometry,at)
  ((xv(x,at) - mv(mean,channel) : F32) * dv(deviation,channel) : F32)

# ((x - mean) * deviation) * gamma + beta.
def output_value(~X: Data,~xv: X -> U32 -> F32,~M: Data,~mv: M -> U32 -> F32,~D: Data,~dv: D -> U32 -> F32,~G: Data,~gv: G -> U32 -> F32,~B: Data,~bv: B -> U32 -> F32,context: Channels<X,M,D,G,B>,index: U32) -> F32:
  Channels{x,mean,deviation,gamma,beta,+geometry} = context
  +at = index
  +channel = channel_of(geometry,at)
  ((((xv(x,at) - mv(mean,channel) : F32) * dv(deviation,channel) : F32) * gv(gamma,channel) : F32) + bv(beta,channel) : F32)

# ---- The lanes of a group ----

# A lane below the channels holds the value at its index with the statistics
# of its channel, a lane past them +0.
def normalized_picked(~X: Data,~xv: X -> U32 -> F32,~M: Data,~mv: M -> U32 -> F32,~D: Data,~dv: D -> U32 -> F32,valid: Bool,+x: X,+mean: M,+deviation: D,+at: U32,+channel: U32,+target: U32,
  same: @+inside: {valid == True{} : Bool} -> {channel == target : U32}) ->
  {Bool.pick(F32,valid,((Bool.pick(F32,valid,xv(x,at),0.0) - Bool.pick(F32,valid,mv(mean,channel),0.0) : F32) * Bool.pick(F32,valid,dv(deviation,channel),0.0) : F32),0.0) ==
    Bool.pick(F32,valid,((xv(x,at) - mv(mean,target) : F32) * dv(deviation,target) : F32),0.0) : F32}:
  match valid:
    case True{}: Equal.cong(U32,F32,word => ((xv(x,at) - mv(mean,word) : F32) * dv(deviation,word) : F32),channel,target,same({==}))
    case False{}: {==}

def output_picked(~X: Data,~xv: X -> U32 -> F32,~M: Data,~mv: M -> U32 -> F32,~D: Data,~dv: D -> U32 -> F32,~G: Data,~gv: G -> U32 -> F32,~B: Data,~bv: B -> U32 -> F32,valid: Bool,+x: X,+mean: M,+deviation: D,+gamma: G,+beta: B,+at: U32,+channel: U32,+target: U32,
  same: @+inside: {valid == True{} : Bool} -> {channel == target : U32}) ->
  {Bool.pick(F32,valid,((((Bool.pick(F32,valid,xv(x,at),0.0) - Bool.pick(F32,valid,mv(mean,channel),0.0) : F32) * Bool.pick(F32,valid,dv(deviation,channel),0.0) : F32) *
      Bool.pick(F32,valid,gv(gamma,channel),0.0) : F32) + Bool.pick(F32,valid,bv(beta,channel),0.0) : F32),0.0) ==
    Bool.pick(F32,valid,((((xv(x,at) - mv(mean,target) : F32) * dv(deviation,target) : F32) * gv(gamma,target) : F32) + bv(beta,target) : F32),0.0) : F32}:
  match valid:
    case True{}:
      Equal.cong(U32,F32,word => ((((xv(x,at) - mv(mean,word) : F32) * dv(deviation,word) : F32) * gv(gamma,word) : F32) + bv(beta,word) : F32),channel,target,same({==}))
    case False{}: {==}

# The lane of the cells [C] at a lane below the channels reads the channel of
# the index of that lane of x.
def channel_same(+images: U32,+channels: U32,+height: U32,+width: U32,+cap: U32,+room: TiledExit.Room<Public.geometry_of([images,channels,height,width],1n,Grid.Outermost{}),cap>,+outer: Nat,
  +outer_inside: {Nat.is_lt(outer,Representation.outer_count(Public.geometry_of([images,channels,height,width],1n,Grid.Outermost{}))) == True{} : Bool},+channel: Nat,
  +inside: {Nat.is_lt(channel,Representation.lane_count(Public.geometry_of([images,channels,height,width],1n,Grid.Outermost{}))) == True{} : Bool}) ->
  {U32.from_nat(Representation.logical_index(Public.geometry_of([channels],0n,Grid.Outermost{}),0n,channel)) == channel_of(Public.geometry_of([images,channels,height,width],1n,Grid.Outermost{}),U32.from_nat(Representation.logical_index(Public.geometry_of([images,channels,height,width],1n,Grid.Innermost{}),outer,channel))) : U32}:
  TiledExit.Room{+blocks,+outer_exact,+total,+fits} = room
  +geometry = Public.geometry_of([images,channels,height,width],1n,Grid.Outermost{})
  +index = Representation.logical_index(geometry,outer,channel)
  +outer_blocks = {%outer_exact : {Nat.is_lt(outer,_) == True{} : Bool} outer_inside : {Nat.is_lt(outer,Nat.mul(blocks,Representation.after_count(geometry))) == True{} : Bool}}
  +below = Representation.logical_below(geometry,outer,channel,blocks,outer_blocks,inside)
  +fitting = Bounds.strict_le(index,U32.to_nat(cap),Bounds.nat_trans(index,Nat.mul(Nat.mul(blocks,Representation.lane_count(geometry)),Representation.after_count(geometry)),U32.to_nat(cap),below,total))
  +read = Representation.value_channel(geometry,U32.to_nat(U32.from_nat(index)))
  +found = Equal.trans(Nat,read,Representation.value_channel(geometry,index),channel,
    Equal.cong(Nat,Nat,number => Representation.value_channel(geometry,number),U32.to_nat(U32.from_nat(index)),index,FullRange.roundtrip(index,cap,fitting)),
    Representation.lane_channel(geometry,outer,channel,inside))
  Equal.cong(Nat,U32,number => U32.from_nat(number),Representation.logical_index(Public.geometry_of([channels],0n,Grid.Outermost{}),0n,channel),read,
    Equal.trans(Nat,Representation.logical_index(Public.geometry_of([channels],0n,Grid.Outermost{}),0n,channel),channel,read,Statistics.mean_index(channels,channel),Equal.sym(Nat,read,channel,found)))

