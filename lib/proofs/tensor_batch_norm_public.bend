# The fields, readiness and values of every piece of dy, and the values of
# every piece of xhat.
def dy_facts(~DL: Data,~dl_value: DL -> U32 -> Tile.Tile8,~XL: Data,+dl: DL,+xl: XL,+total: Nat,content: PiecesModel.Content<Tile.Tile8>,
  fields: Content.Contents(~Tile.Tile8,total,content),ready: PiecesModel.ContentReady(~Tile.Tile8,content),values: Content.Values(~Tile.Tile8,~DL,~dl_value,dl,content)) ->
  PiecesModel.ContentAll(~Tile.Tile8,~Passes.dy_part(~DL,~dl_value,~XL,Passes.BackScope{dl,xl,total}),content):
  match content:
    case PiecesModel.PieceContent{+buffer,+first,+rows}: KernelGemm.Both{fields,KernelGemm.Both{ready,values}}
    case PiecesModel.Joined{+left,+right}:
      KernelGemm.Both{left_fields,right_fields} = fields
      KernelGemm.Both{left_ready,right_ready} = ready
      KernelGemm.Both{left_values,right_values} = values
      KernelGemm.Both{dy_facts(~DL,~dl_value,~XL,dl,xl,total,left,left_fields,left_ready,left_values),dy_facts(~DL,~dl_value,~XL,dl,xl,total,right,right_fields,right_ready,right_values)}

def xhat_facts(~DL: Data,~XL: Data,~xl_value: XL -> U32 -> Tile.Tile8,+dl: DL,+xl: XL,+total: Nat,content: PiecesModel.Content<Tile.Tile8>,values: Content.Values(~Tile.Tile8,~XL,~xl_value,xl,content)) ->
  PiecesModel.ContentAll(~Tile.Tile8,~Passes.xhat_part(~DL,~XL,~xl_value,Passes.BackScope{dl,xl,total}),content):
  match content:
    case PiecesModel.PieceContent{+buffer,+first,+rows}: values
    case PiecesModel.Joined{+left,+right}:
      KernelGemm.Both{left_values,right_values} = values
      KernelGemm.Both{xhat_facts(~DL,~XL,~xl_value,dl,xl,total,left,left_values),xhat_facts(~DL,~XL,~xl_value,dl,xl,total,right,right_values)}

