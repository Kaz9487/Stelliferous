    {_ == ranges : Pieces.Ranges}
  %Equal.sym(Pieces.Ranges,PiecesModel.layout(~Tile.Tile8,model),PiecesModel.content_layout(~Tile.Tile8,PiecesModel.content(~Tile.Tile8,model)),PiecesModel.layout_matches_content(~Tile.Tile8,model)) :
    {_ == ranges : Pieces.Ranges}
  %PiecesModel.packed_contents(~Tile.Tile8,model) : {PiecesModel.content_layout(~Tile.Tile8,_) == ranges : Pieces.Ranges}
  canonical

# The pieces of the evaluation pass are the canonical pieces of its input.
def evaluated_canonical(+groups: List<&2,Kernel.Normal>,+cells: U32,+padding: TiledMap.Padding,+shape: List<&2,U32>,+workers: U32,+model: PiecesModel.Model<Tile.Tile8>,
  +canonical: Global.Canonical(~Tile.Tile8,shape,PiecesModel.contents(~Tile.Tile8,PiecesModel.pack(~Tile.Tile8,model)))) ->
