  %Equal.sym(PiecesModel.Content<Tile.Tile8>,PiecesModel.contents(~Tile.Tile8,BNCells.evaluated(groups,cells,padding,shape,workers,PiecesModel.pack(~Tile.Tile8,model))),Each.content_map(~Tile.Tile8,~Tile.Tile8,~BNCells.Mapping<Kernel.Normal>,~Passes.mapped_model(~Kernel.Normal,~Passes.sample_at(~Kernel.Normal,~Tile.Tile8,~Passes.output_of)),BNCells.Mapping{groups,cells,padding},model),
      Passes.evaluated_contents(groups,cells,padding,shape,workers,model)) :
    {PiecesModel.content_layout(~Tile.Tile8,_) == Pieces.ranges_of_grid(Tensors.grid_of(shape)) : Pieces.Ranges}
