# ---- The statistics and parameters read as [C] ----

# 1 / sqrt(variance + epsilon) as the runtime composes it.
def Deviation(~V: Data) -> Data:
  Leaf.Context<PiecesMap.Context<F32,F32>,PiecesMap.Context<Unit,PiecesMap.Context<F32,V>>>

def deviation_value(~V: Data,~vv: V -> U32 -> F32) -> Deviation(~V) -> U32 -> F32:
  Leaf.value(~F32,~PiecesMap.Context<F32,F32>,~PiecesMap.Context<Unit,PiecesMap.Context<F32,V>>,~F32.div,~PiecesMap.value(~F32,~F32,~F32,~TiledMap.constant,~FullValues.constant(~F32)),
    ~PiecesMap.value(~F32,~Unit,~PiecesMap.Context<F32,V>,~Access.apply_element(~F32,~Arithmetic.sqrt),~PiecesMap.value(~F32,~F32,~V,~F.scalar_value(~F32.add),~vv)))

def deviation_context(~V: Data,+variance: V,+epsilon: F32) -> Deviation(~V):
  Leaf.Context{PiecesMap.Context{1.0,0.0},PiecesMap.Context{Unit{},PiecesMap.Context{epsilon,variance}}}

# The channels of [N,C,H,W] with at least one value: some, and within the
# capacity when the values are.
def channels_positive(+images: U32,+channels: U32,+height: U32,+width: U32,+nonempty: {Nat.is_lt(0n,ShapeLaws.elements([images,channels,height,width])) == True{} : Bool}) ->
  {Nat.is_lt(0n,ShapeLaws.elements([channels])) == True{} : Bool}:
  +inner = Nat.mul(U32.to_nat(height),Nat.mul(U32.to_nat(width),1n))
  +rest = DivisionOrder.right_factor_positive(U32.to_nat(images),Nat.mul(U32.to_nat(channels),inner),nonempty)
  %Equal.sym(Nat,Nat.mul(U32.to_nat(channels),1n),U32.to_nat(channels),Order.times_one(U32.to_nat(channels))) : {Nat.is_lt(0n,_) == True{} : Bool}
  RowMajor.left_factor_positive(U32.to_nat(channels),inner,rest)

def channels_room(+limits: Machine.Limits,+images: U32,+channels: U32,+height: U32,+width: U32,
  +values_room: {Nat.is_le(ShapeLaws.elements([images,channels,height,width]),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},
  +nonempty: {Nat.is_lt(0n,ShapeLaws.elements([images,channels,height,width])) == True{} : Bool}) ->
  {Nat.is_le(ShapeLaws.elements([channels]),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}:
  %Equal.sym(Nat,Nat.mul(U32.to_nat(channels),1n),U32.to_nat(channels),Order.times_one(U32.to_nat(channels))) : {Nat.is_le(_,U32.to_nat(Machine.capacity(limits))) == True{} : Bool}
  split_lanes(limits,[images,channels,height,width],1n,channels,Public.values_split(limits,[images,channels,height,width],1n,channels,{==},values_room,nonempty))

