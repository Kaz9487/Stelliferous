# Batch normalization with the running statistics: for x [N,C,H,W] without a
# zero extent and gamma, beta and the running statistics [C], each of the
# contract, the output holds at every index
# ((x - mean) * (1 / sqrt(variance + epsilon))) * gamma + beta with the
# statistics and parameters of its channel, and the parameters and running
# statistics are returned as they were given.
def evaluate(~X: Data,~xv: X -> U32 -> F32,~RM: Data,~rmv: RM -> U32 -> F32,~RV: Data,~rvv: RV -> U32 -> F32,~G: Data,~gv: G -> U32 -> F32,~B: Data,~bv: B -> U32 -> F32,+x: X,+gamma: G,+beta: B,+mean: RM,+variance: RV,+images: U32,+channels: U32,+height: U32,+width: U32,+epsilon: F32,+momentum: F32,
  +limits: Machine.Limits,+default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},
  +nonempty: {Nat.is_lt(0n,ShapeLaws.elements([images,channels,height,width])) == True{} : Bool},+rank_room: {Nat.is_le(4n,U32.to_nat(Machine.capacity(limits))) == True{} : Bool},
  x_tensor: Tiled.Tiled,+x_contract: Public.Contract(~X,~xv,x,[images,channels,height,width],x_tensor),gamma_tensor: Tiled.Tiled,+gamma_contract: Public.Contract(~G,~gv,gamma,[channels],gamma_tensor),beta_tensor: Tiled.Tiled,+beta_contract: Public.Contract(~B,~bv,beta,[channels],beta_tensor),mean_tensor: Tiled.Tiled,+mean_contract: Public.Contract(~RM,~rmv,mean,[channels],mean_tensor),variance_tensor: Tiled.Tiled,+variance_contract: Public.Contract(~RV,~rvv,variance,[channels],variance_tensor)) ->
  EvaluateHolds(~X,~xv,~RM,~rmv,~RV,~rvv,~G,~gv,~B,~bv,x,gamma,beta,mean,variance,images,channels,height,width,epsilon,BN.evaluate(x_tensor,(gamma_tensor,beta_tensor),(mean_tensor,variance_tensor),BN.Settings{epsilon,momentum})):
  Relane.along_then(~X,~xv,(tiled => EvaluateHolds(~X,~xv,~RM,~rmv,~RV,~rvv,~G,~gv,~B,~bv,x,gamma,beta,mean,variance,images,channels,height,width,epsilon,Tiled.with_metadata(~BN.Evaluated(),tiled,cells_x => shape => status => cells_workers => BN.evaluate_status(BN.Settings{epsilon,momentum},status,shape,cells_workers,cells_x,(gamma_tensor,beta_tensor),(mean_tensor,variance_tensor))))),x,[images,channels,height,width],x_tensor,1n,limits,default_capacity,{==},nonempty,rank_room,x_contract,
    cells => lanes => position => contract => evaluate_along(~X,~xv,~RM,~rmv,~RV,~rvv,~G,~gv,~B,~bv,x,gamma,beta,mean,variance,images,channels,height,width,epsilon,momentum,limits,default_capacity,nonempty,rank_room,
      cells,lanes,position,contract,gamma_tensor,gamma_contract,beta_tensor,beta_contract,mean_tensor,mean_contract,variance_tensor,variance_contract))

# ---- The statistics of forward ----

# Sums of axes [0, 2, 3] divided by a count, as forward divides them.
def Quotient() -> Data:
  PiecesMap.Context<F32,PartialsValues.Box<Sum.Parts>>

def quotient_value() -> Quotient() -> U32 -> F32:
  PiecesMap.value(~F32,~F32,~PartialsValues.Box<Sum.Parts>,~F.scalar_value(~F32.div),~PartialsValues.box_value(~F32,~Sum.Parts,~Sum.merge,~Sum.rounded))

# The mean of each channel of x [N,C,H,W]: the sums of axes [0, 2, 3]
# divided by N * H * W.
def channel_means(~X: Data,~xv: X -> U32 -> F32,+x: X,+images: U32,+channels: U32,+height: U32,+width: U32) -> Quotient():
  PiecesMap.Context{U32.to_f32((images * (height * width : U32) : U32)),Statistics.plane_box(~X,~xv,x,images,channels,height,width)}

# The sums of axes [0, 2, 3] of (x - mean) * (x - mean) with the mean of the
# channel of each value.
def centered_box(~X: Data,~xv: X -> U32 -> F32,+x: X,+images: U32,+channels: U32,+height: U32,+width: U32) -> PartialsValues.Box<Sum.Parts>:
  Statistics.plane_box(~Leaf.Context<X,Statistics.ChannelMeans<Quotient()>>,~Leaf.value(~F32,~X,~Statistics.ChannelMeans<Quotient()>,~Statistics.centered_pair,~xv,~Statistics.channel_mean(~Quotient(),~quotient_value())),Leaf.Context{x,Statistics.ChannelMeans{channel_means(~X,~xv,x,images,channels,height,width),Public.geometry_of([images,channels,height,width],1n,Grid.Outermost{})}},images,channels,height,width)

# Those sums divided by N * H * W and by N * H * W - 1.
def channel_variances(~X: Data,~xv: X -> U32 -> F32,+x: X,+images: U32,+channels: U32,+height: U32,+width: U32) -> Quotient():
  PiecesMap.Context{U32.to_f32((images * (height * width : U32) : U32)),centered_box(~X,~xv,x,images,channels,height,width)}

def unbiased_variances(~X: Data,~xv: X -> U32 -> F32,+x: X,+images: U32,+channels: U32,+height: U32,+width: U32) -> Quotient():
  PiecesMap.Context{U32.to_f32(((images * (height * width : U32) : U32) - 1 : U32)),centered_box(~X,~xv,x,images,channels,height,width)}

# running * (1 - momentum) + statistic * momentum, as the runtime composes it.
def Moved(~R: Data) -> Data:
  Leaf.Context<PiecesMap.Context<F32,R>,PiecesMap.Context<F32,Quotient()>>

def moved_value(~R: Data,~rv: R -> U32 -> F32) -> Moved(~R) -> U32 -> F32:
  Leaf.value(~F32,~PiecesMap.Context<F32,R>,~PiecesMap.Context<F32,Quotient()>,~F32.add,~PiecesMap.value(~F32,~F32,~R,~F.scalar_value(~F32.mul),~rv),
    ~PiecesMap.value(~F32,~F32,~Quotient(),~F.scalar_value(~F32.mul),~quotient_value()))

def moved_context(~R: Data,+running: R,+statistic: Quotient(),+momentum: F32) -> Moved(~R):
  Leaf.Context{PiecesMap.Context{(1.0 - momentum : F32),running},PiecesMap.Context{momentum,statistic}}

# A running statistic [C] moved towards a statistic [C].
def moved_of(~R: Data,~rv: R -> U32 -> F32,+running: R,+statistic: Quotient(),+channels: U32,+momentum: F32,+limits: Machine.Limits,
  +default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},+nonempty: {Nat.is_lt(0n,ShapeLaws.elements([channels])) == True{} : Bool},
  +rank_room: {Nat.is_le(1n,U32.to_nat(Machine.capacity(limits))) == True{} : Bool},
  -running_tensor: Tiled.Tiled,+running_packed: Public.Packed<running_tensor>,+running_contract: Public.Contract(~R,~rv,running,[channels],running_tensor),
  -statistic_tensor: Tiled.Tiled,+statistic_packed: Public.Packed<statistic_tensor>,
  +statistic_contract: Public.Contract(~Quotient(),~quotient_value(),statistic,[channels],statistic_tensor)) ->
  Public.Contract(~Moved(~R),~moved_value(~R,~rv),moved_context(~R,running,statistic,momentum),[channels],BN.moved(running_tensor,statistic_tensor,momentum)):
  Public.Packed{+running_model,+running_shape,+running_fill,+running_workers,+running_axis,+running_lanes,+running_position,+running_equation} = running_packed
  Public.Packed{+statistic_model,+statistic_shape,+statistic_fill,+statistic_workers,+statistic_axis,+statistic_lanes,+statistic_position,+statistic_equation} = statistic_packed
  +running_held = {%Equal.sym(Tiled.Tiled,Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,running_model),running_shape,running_fill,Tensors.Usable{},running_workers},running_axis,running_lanes,running_position},running_tensor,running_equation) : Public.Contract(~R,~rv,running,[channels],_) running_contract :
    Public.Contract(~R,~rv,running,[channels],Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,running_model),running_shape,running_fill,Tensors.Usable{},running_workers},running_axis,running_lanes,running_position})}
  +statistic_held = {%Equal.sym(Tiled.Tiled,Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,statistic_model),statistic_shape,statistic_fill,Tensors.Usable{},statistic_workers},statistic_axis,statistic_lanes,statistic_position},statistic_tensor,statistic_equation) : Public.Contract(~Quotient(),~quotient_value(),statistic,[channels],_) statistic_contract :
    Public.Contract(~Quotient(),~quotient_value(),statistic,[channels],Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,statistic_model),statistic_shape,statistic_fill,Tensors.Usable{},statistic_workers},statistic_axis,statistic_lanes,statistic_position})}
  %running_equation : Public.Contract(~Moved(~R),~moved_value(~R,~rv),moved_context(~R,running,statistic,momentum),[channels],BN.moved(_,statistic_tensor,momentum))
  %statistic_equation : Public.Contract(~Moved(~R),~moved_value(~R,~rv),moved_context(~R,running,statistic,momentum),[channels],BN.moved(Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,running_model),running_shape,running_fill,Tensors.Usable{},running_workers},running_axis,running_lanes,running_position},_,momentum))
  Binary.same(~PiecesMap.Context<F32,R>,~PiecesMap.value(~F32,~F32,~R,~F.scalar_value(~F32.mul),~rv),~PiecesMap.Context<F32,Quotient()>,
    ~PiecesMap.value(~F32,~F32,~Quotient(),~F.scalar_value(~F32.mul),~quotient_value()),~F32.add,PiecesMap.Context{(1.0 - momentum : F32),running},PiecesMap.Context{momentum,statistic},
    "add",1.0,limits,default_capacity,[channels],nonempty,rank_room,
    F.mul_scalar(Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,running_model),running_shape,running_fill,Tensors.Usable{},running_workers},running_axis,running_lanes,running_position},(1.0 - momentum : F32)),FunctionValues.scalar_public(~R,~rv,~F32.mul,(1.0 - momentum : F32),1.0)(running,[channels],Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,running_model),running_shape,running_fill,Tensors.Usable{},running_workers},running_axis,running_lanes,running_position},running_held),
    F.mul_scalar(Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,statistic_model),statistic_shape,statistic_fill,Tensors.Usable{},statistic_workers},statistic_axis,statistic_lanes,statistic_position},momentum),FunctionValues.scalar_public(~Quotient(),~quotient_value(),~F32.mul,momentum,1.0)(statistic,[channels],Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,statistic_model),statistic_shape,statistic_fill,Tensors.Usable{},statistic_workers},statistic_axis,statistic_lanes,statistic_position},statistic_held))

# The inverse deviation of a variance [C] of the contract holds
# 1 / sqrt(variance + epsilon).
def deviation_tensor(~V: Data,~vv: V -> U32 -> F32,+variance: V,+channels: U32,+epsilon: F32,+limits: Machine.Limits,
  +default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},+nonempty: {Nat.is_lt(0n,ShapeLaws.elements([channels])) == True{} : Bool},
  +rank_room: {Nat.is_le(1n,U32.to_nat(Machine.capacity(limits))) == True{} : Bool},+room: {Nat.is_le(ShapeLaws.elements([channels]),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},
  -tiled: Tiled.Tiled,+packed: Public.Packed<tiled>,+contract: Public.Contract(~V,~vv,variance,[channels],tiled)) ->
  Public.Contract(~Deviation(~V),~deviation_value(~V,~vv),deviation_context(~V,variance,epsilon),[channels],BN.inverse_deviation(tiled,channels,epsilon)):
  Public.Packed{+model,+shape,+fill,+workers,+axis,+lanes,+position,+equation} = packed
  %equation : Public.Contract(~Deviation(~V),~deviation_value(~V,~vv),deviation_context(~V,variance,epsilon),[channels],BN.inverse_deviation(_,channels,epsilon))
  deviation_of(~V,~vv,variance,channels,epsilon,limits,default_capacity,nonempty,rank_room,room,model,shape,fill,workers,axis,lanes,position,
    {%Equal.sym(Tiled.Tiled,Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),shape,fill,Tensors.Usable{},workers},axis,lanes,position},tiled,equation) : Public.Contract(~V,~vv,variance,[channels],_) contract : Public.Contract(~V,~vv,variance,[channels],Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),shape,fill,Tensors.Usable{},workers},axis,lanes,position})})

# The cells [C] listed lane by lane are the cells of the means of the
# groups.
def means_from(~L: Data,~o: L -> U32 -> F32,+logical: L,+channels: U32,+remaining: Nat,+first: Nat,
  +room: {Nat.is_le(Nat.add(first,remaining),U32.to_nat(Tiled.groups(channels))) == True{} : Bool}) ->
  {Contract.listed(~Tile.Tile8,~Representation.Lifted<L>,~Representation.lifted(~L,~o),remaining,first,Representation.Lifted{logical,Public.geometry_of([channels],0n,Grid.Outermost{})}) ==
    ListReadback.enumerate(~Tile.Tile8,~Representation.Lifted<L>,~Statistics.mean_cell(~L,~o),remaining,first,Representation.Lifted{logical,Public.geometry_of([channels],0n,Grid.Outermost{})}) : List<&2,Tile.Tile8>}:
  match remaining:
    case 0n: {==}
    case 1n+ +rest:
      +groups = U32.to_nat(Tiled.groups(channels))
      +inside = Passes.taken_here(first,rest,groups,room)
      +exact = Equal.trans(Nat,U32.to_nat(U32.from_nat(first)),first,Nat.add(Nat.mul(first,1n),0n),
        FullRange.roundtrip(first,Tiled.groups(channels),Bounds.strict_le(first,groups,inside)),
        Equal.sym(Nat,Nat.add(Nat.mul(first,1n),0n),first,Equal.trans(Nat,Nat.add(Nat.mul(first,1n),0n),Nat.mul(first,1n),first,Addition.zero_right(Nat.mul(first,1n)),Order.times_one(first))))
      +cell = Representation.cell(~L,~o,logical,Public.geometry_of([channels],0n,Grid.Outermost{}),0n,first)
      +listed_rest = Contract.listed(~Tile.Tile8,~Representation.Lifted<L>,~Representation.lifted(~L,~o),rest,1n+first,Representation.Lifted{logical,Public.geometry_of([channels],0n,Grid.Outermost{})})
      +cells_rest = ListReadback.enumerate(~Tile.Tile8,~Representation.Lifted<L>,~Statistics.mean_cell(~L,~o),rest,1n+first,Representation.Lifted{logical,Public.geometry_of([channels],0n,Grid.Outermost{})})
      %Equal.sym(Tile.Tile8,Representation.lifted(~L,~o,Representation.Lifted{logical,Public.geometry_of([channels],0n,Grid.Outermost{})},U32.from_nat(first)),cell,
          Representation.decoded(~L,~o,logical,Public.geometry_of([channels],0n,Grid.Outermost{}),0n,first,U32.from_nat(first),exact,{==},inside)) :
        {_ <> listed_rest == cell <> cells_rest : List<&2,Tile.Tile8>}
      Equal.cong(List<&2,Tile.Tile8>,List<&2,Tile.Tile8>,tail => cell <> tail,listed_rest,cells_rest,
        means_from(~L,~o,logical,channels,rest,1n+first,Passes.taken_next(first,rest,groups,room)))

def means_bridge(~L: Data,~o: L -> U32 -> F32,+logical: L,+channels: U32) ->
  {Contract.listed(~Tile.Tile8,~Representation.Lifted<L>,~Representation.lifted(~L,~o),ShapeLaws.elements(Tiled.cell_shape([channels],0n,Grid.Outermost{})),0n,Representation.Lifted{logical,Public.geometry_of([channels],0n,Grid.Outermost{})}) ==
    ListReadback.enumerate(~Tile.Tile8,~Representation.Lifted<L>,~Statistics.mean_cell(~L,~o),U32.to_nat(Tiled.groups(channels)),0n,
      Representation.Lifted{logical,Public.geometry_of([1,channels,1,1],1n,Grid.Outermost{})}) : List<&2,Tile.Tile8>}:
  +groups = U32.to_nat(Tiled.groups(channels))
  %Equal.sym(Nat,Nat.mul(groups,1n),groups,Order.times_one(groups)) :
    {Contract.listed(~Tile.Tile8,~Representation.Lifted<L>,~Representation.lifted(~L,~o),_,0n,Representation.Lifted{logical,Public.geometry_of([channels],0n,Grid.Outermost{})}) ==
      ListReadback.enumerate(~Tile.Tile8,~Representation.Lifted<L>,~Statistics.mean_cell(~L,~o),groups,0n,Representation.Lifted{logical,Public.geometry_of([channels],0n,Grid.Outermost{})}) : List<&2,Tile.Tile8>}
  means_from(~L,~o,logical,channels,groups,0n,Order.reflexive(groups))

# ---- What forward returns ----

# The output and xhat of the statistics of x, the saved 1 / sqrt(variance +
# epsilon), gamma and beta as they were given, and the running statistics
# moved towards the mean and the unbiased variance.
def ForwardHolds(~X: Data,~xv: X -> U32 -> F32,~RM: Data,~rmv: RM -> U32 -> F32,~RV: Data,~rvv: RV -> U32 -> F32,~G: Data,~gv: G -> U32 -> F32,~B: Data,~bv: B -> U32 -> F32,+x: X,+gamma: G,+beta: B,+mean: RM,+variance: RV,+images: U32,+channels: U32,+height: U32,+width: U32,+epsilon: F32,+momentum: F32,
  result: BN.Forward()) -> Data:
  (output,((xhat,inverse),((gammas,betas),(means,variances)))) = result
  KernelGemm.Both<Public.Contract(~Channels<X,Quotient(),Deviation(~Quotient()),G,B>,~output_value(~X,~xv,~Quotient(),~quotient_value(),~Deviation(~Quotient()),~deviation_value(~Quotient(),~quotient_value()),~G,~gv,~B,~bv),Channels{x,channel_means(~X,~xv,x,images,channels,height,width),deviation_context(~Quotient(),channel_variances(~X,~xv,x,images,channels,height,width),epsilon),gamma,beta,Public.geometry_of([images,channels,height,width],1n,Grid.Outermost{})},[images,channels,height,width],output),
    KernelGemm.Both<Public.Contract(~Channels<X,Quotient(),Deviation(~Quotient()),G,B>,~normalized_value(~X,~xv,~Quotient(),~quotient_value(),~Deviation(~Quotient()),~deviation_value(~Quotient(),~quotient_value()),~G,~B),Channels{x,channel_means(~X,~xv,x,images,channels,height,width),deviation_context(~Quotient(),channel_variances(~X,~xv,x,images,channels,height,width),epsilon),gamma,beta,Public.geometry_of([images,channels,height,width],1n,Grid.Outermost{})},[images,channels,height,width],xhat),
      KernelGemm.Both<Public.Contract(~Deviation(~Quotient()),~deviation_value(~Quotient(),~quotient_value()),deviation_context(~Quotient(),channel_variances(~X,~xv,x,images,channels,height,width),epsilon),[channels],inverse),
        KernelGemm.Both<Public.Contract(~G,~gv,gamma,[channels],gammas),KernelGemm.Both<Public.Contract(~B,~bv,beta,[channels],betas),
          KernelGemm.Both<Public.Contract(~Moved(~RM),~moved_value(~RM,~rmv),moved_context(~RM,mean,channel_means(~X,~xv,x,images,channels,height,width),momentum),[channels],means),
            Public.Contract(~Moved(~RV),~moved_value(~RV,~rvv),moved_context(~RV,variance,unbiased_variances(~X,~xv,x,images,channels,height,width),momentum),[channels],variances)>>>>>>

# The output and xhat of the forward pass with the statistics and the copies
# of the parameters.
def forward_passed_holds(~X: Data,~xv: X -> U32 -> F32,~RM: Data,~rmv: RM -> U32 -> F32,~RV: Data,~rvv: RV -> U32 -> F32,~G: Data,~gv: G -> U32 -> F32,~B: Data,~bv: B -> U32 -> F32,+x: X,+gamma: G,+beta: B,+mean: RM,+variance: RV,+images: U32,+channels: U32,+height: U32,+width: U32,+workers: U32,+epsilon: F32,+momentum: F32,+limits: Machine.Limits,+default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},+nonempty: {Nat.is_lt(0n,ShapeLaws.elements([images,channels,height,width])) == True{} : Bool},+channels_nonempty: {Nat.is_lt(0n,ShapeLaws.elements([channels])) == True{} : Bool},+rank_room: {Nat.is_le(1n,U32.to_nat(Machine.capacity(limits))) == True{} : Bool},
  -inverse: Tiled.Tiled,+inverse_contract: Public.Contract(~Deviation(~Quotient()),~deviation_value(~Quotient(),~quotient_value()),deviation_context(~Quotient(),channel_variances(~X,~xv,x,images,channels,height,width),epsilon),[channels],inverse),
  -statistic: Tiled.Tiled,+statistic_packed: Public.Packed<statistic>,+statistic_contract: Public.Contract(~Quotient(),~quotient_value(),channel_means(~X,~xv,x,images,channels,height,width),[channels],statistic),
  -unbiased: Tiled.Tiled,+unbiased_packed: Public.Packed<unbiased>,+unbiased_contract: Public.Contract(~Quotient(),~quotient_value(),unbiased_variances(~X,~xv,x,images,channels,height,width),[channels],unbiased),
  -gamma_out: Tiled.Tiled,+gamma_out_contract: Public.Contract(~G,~gv,gamma,[channels],gamma_out),-beta_out: Tiled.Tiled,+beta_out_contract: Public.Contract(~B,~bv,beta,[channels],beta_out),
  -mean_tensor: Tiled.Tiled,+mean_packed: Public.Packed<mean_tensor>,+mean_contract: Public.Contract(~RM,~rmv,mean,[channels],mean_tensor),-variance_tensor: Tiled.Tiled,+variance_packed: Public.Packed<variance_tensor>,+variance_contract: Public.Contract(~RV,~rvv,variance,[channels],variance_tensor),passes: Pieces.Pieces(~Tile.Tile8) & Pieces.Pieces(~Tile.Tile8),+pair: PairHolds(~X,~xv,~Quotient(),~quotient_value(),~Deviation(~Quotient()),~deviation_value(~Quotient(),~quotient_value()),~G,~gv,~B,~bv,x,channel_means(~X,~xv,x,images,channels,height,width),deviation_context(~Quotient(),channel_variances(~X,~xv,x,images,channels,height,width),epsilon),gamma,beta,images,channels,height,width,workers,passes)) ->
  ForwardHolds(~X,~xv,~RM,~rmv,~RV,~rvv,~G,~gv,~B,~bv,x,gamma,beta,mean,variance,images,channels,height,width,epsilon,momentum,BN.forward_passed(BN.Layer{images,channels,height,width,workers},momentum,inverse,statistic,unbiased,(gamma_out,beta_out),(mean_tensor,variance_tensor),passes)):
  match passes:
    case (xhat,output):
      KernelGemm.Both{+output_contract,+xhat_contract} = pair
      KernelGemm.Both{output_contract,KernelGemm.Both{xhat_contract,KernelGemm.Both{inverse_contract,KernelGemm.Both{gamma_out_contract,KernelGemm.Both{beta_out_contract,
        KernelGemm.Both{moved_of(~RM,~rmv,mean,channel_means(~X,~xv,x,images,channels,height,width),channels,momentum,limits,default_capacity,channels_nonempty,rank_room,mean_tensor,mean_packed,mean_contract,
            statistic,statistic_packed,statistic_contract),
          moved_of(~RV,~rvv,variance,unbiased_variances(~X,~xv,x,images,channels,height,width),channels,momentum,limits,default_capacity,channels_nonempty,rank_room,variance_tensor,variance_packed,variance_contract,
            unbiased,unbiased_packed,unbiased_contract)}}}}}}

# The forward pass with the statistics and parameters read as [C].
def forward_read_holds(~X: Data,~xv: X -> U32 -> F32,~RM: Data,~rmv: RM -> U32 -> F32,~RV: Data,~rvv: RV -> U32 -> F32,~G: Data,~gv: G -> U32 -> F32,~B: Data,~bv: B -> U32 -> F32,+x: X,+gamma: G,+beta: B,+mean: RM,+variance: RV,+images: U32,+channels: U32,+height: U32,+width: U32,+workers: U32,+epsilon: F32,+momentum: F32,+limits: Machine.Limits,+default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},+nonempty: {Nat.is_lt(0n,ShapeLaws.elements([images,channels,height,width])) == True{} : Bool},+rank_room: {Nat.is_le(1n,U32.to_nat(Machine.capacity(limits))) == True{} : Bool},+model: PiecesModel.Model<Tile.Tile8>,+fill: Tile.Tile8,+cell_workers: U32,+contract: Public.Contract(~X,~xv,x,[images,channels,height,width],Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),Tiled.cell_shape([images,channels,height,width],1n,Grid.Innermost{}),fill,Tensors.Usable{},cell_workers},1n,Grid.lanes_at([images,channels,height,width],1n),Grid.Innermost{}}),
  statistic_pair: BN.Tensor() & BN.Listed(),+statistic_kept: Kept(~Quotient(),~quotient_value(),channel_means(~X,~xv,x,images,channels,height,width),channels,statistic_pair),
  inverse_pair: BN.Tensor() & BN.Listed(),+inverse_kept: Kept(~Deviation(~Quotient()),~deviation_value(~Quotient(),~quotient_value()),deviation_context(~Quotient(),channel_variances(~X,~xv,x,images,channels,height,width),epsilon),channels,inverse_pair),
  -unbiased: Tiled.Tiled,+unbiased_packed: Public.Packed<unbiased>,+unbiased_contract: Public.Contract(~Quotient(),~quotient_value(),unbiased_variances(~X,~xv,x,images,channels,height,width),[channels],unbiased),
  gamma_pair: BN.Tensor() & BN.Listed(),+gamma_kept: Kept(~G,~gv,gamma,channels,gamma_pair),beta_pair: BN.Tensor() & BN.Listed(),+beta_kept: Kept(~B,~bv,beta,channels,beta_pair),
  -mean_tensor: Tiled.Tiled,+mean_packed: Public.Packed<mean_tensor>,+mean_contract: Public.Contract(~RM,~rmv,mean,[channels],mean_tensor),-variance_tensor: Tiled.Tiled,+variance_packed: Public.Packed<variance_tensor>,+variance_contract: Public.Contract(~RV,~rvv,variance,[channels],variance_tensor)) ->
  ForwardHolds(~X,~xv,~RM,~rmv,~RV,~rvv,~G,~gv,~B,~bv,x,gamma,beta,mean,variance,images,channels,height,width,epsilon,momentum,BN.forward_read(BN.Layer{images,channels,height,width,workers},momentum,PiecesModel.pack(~Tile.Tile8,model),statistic_pair,inverse_pair,unbiased,gamma_pair,beta_pair,(mean_tensor,variance_tensor))):
  (statistic,statistics) = statistic_pair
  KernelGemm.Both{+statistic_contract,+statistics_listed} = statistic_kept
  (inverse,inverses) = inverse_pair
  KernelGemm.Both{+inverse_contract,+inverses_listed} = inverse_kept
  (gamma_out,gammas) = gamma_pair
  KernelGemm.Both{+gamma_out_contract,+gammas_listed} = gamma_kept
  (beta_out,betas) = beta_pair
  KernelGemm.Both{+beta_out_contract,+betas_listed} = beta_kept
  +geometry = Public.geometry_of([channels],0n,Grid.Outermost{})
  +count = ShapeLaws.elements(Tiled.cell_shape([channels],0n,Grid.Outermost{}))
  +channels_nonempty = channels_positive(images,channels,height,width,nonempty)
  +mean_list = Contract.listed(~Tile.Tile8,~Representation.Lifted<Quotient()>,~Representation.lifted(~Quotient(),~quotient_value()),count,0n,Representation.Lifted{channel_means(~X,~xv,x,images,channels,height,width),geometry})
  +inverse_list = Contract.listed(~Tile.Tile8,~Representation.Lifted<Deviation(~Quotient())>,~Representation.lifted(~Deviation(~Quotient()),~deviation_value(~Quotient(),~quotient_value())),count,0n,Representation.Lifted{deviation_context(~Quotient(),channel_variances(~X,~xv,x,images,channels,height,width),epsilon),geometry})
  +gamma_list = Contract.listed(~Tile.Tile8,~Representation.Lifted<G>,~Representation.lifted(~G,~gv),count,0n,Representation.Lifted{gamma,geometry})
  +beta_list = Contract.listed(~Tile.Tile8,~Representation.Lifted<B>,~Representation.lifted(~B,~bv),count,0n,Representation.Lifted{beta,geometry})
  %Equal.sym(BN.Listed(),statistics,Done{mean_list},statistics_listed) :
    ForwardHolds(~X,~xv,~RM,~rmv,~RV,~rvv,~G,~gv,~B,~bv,x,gamma,beta,mean,variance,images,channels,height,width,epsilon,momentum,BN.forward_grouped(BN.Layer{images,channels,height,width,workers},momentum,PiecesModel.pack(~Tile.Tile8,model),inverse,statistic,unbiased,(gamma_out,beta_out),(mean_tensor,variance_tensor),
      BN.normal_tiles(_,inverses,gammas,betas)))
  %Equal.sym(BN.Listed(),inverses,Done{inverse_list},inverses_listed) :
    ForwardHolds(~X,~xv,~RM,~rmv,~RV,~rvv,~G,~gv,~B,~bv,x,gamma,beta,mean,variance,images,channels,height,width,epsilon,momentum,BN.forward_grouped(BN.Layer{images,channels,height,width,workers},momentum,PiecesModel.pack(~Tile.Tile8,model),inverse,statistic,unbiased,(gamma_out,beta_out),(mean_tensor,variance_tensor),
      BN.normal_tiles(Done{mean_list},_,gammas,betas)))
  %Equal.sym(BN.Listed(),gammas,Done{gamma_list},gammas_listed) :
    ForwardHolds(~X,~xv,~RM,~rmv,~RV,~rvv,~G,~gv,~B,~bv,x,gamma,beta,mean,variance,images,channels,height,width,epsilon,momentum,BN.forward_grouped(BN.Layer{images,channels,height,width,workers},momentum,PiecesModel.pack(~Tile.Tile8,model),inverse,statistic,unbiased,(gamma_out,beta_out),(mean_tensor,variance_tensor),
      BN.normal_tiles(Done{mean_list},Done{inverse_list},_,betas)))
  %Equal.sym(BN.Listed(),betas,Done{beta_list},betas_listed) :
    ForwardHolds(~X,~xv,~RM,~rmv,~RV,~rvv,~G,~gv,~B,~bv,x,gamma,beta,mean,variance,images,channels,height,width,epsilon,momentum,BN.forward_grouped(BN.Layer{images,channels,height,width,workers},momentum,PiecesModel.pack(~Tile.Tile8,model),inverse,statistic,unbiased,(gamma_out,beta_out),(mean_tensor,variance_tensor),
      BN.normal_tiles(Done{mean_list},Done{inverse_list},Done{gamma_list},_)))
  %Equal.sym(List<&2,Kernel.Normal>,BN.normal_groups(mean_list,inverse_list,gamma_list,beta_list),Contract.listed(~Kernel.Normal,~Groups.Normals<Representation.Lifted<Quotient()>,Representation.Lifted<Deviation(~Quotient())>,Representation.Lifted<G>,Representation.Lifted<B>>,~Groups.normal_at(~Representation.Lifted<Quotient()>,~Representation.lifted(~Quotient(),~quotient_value()),~Representation.Lifted<Deviation(~Quotient())>,~Representation.lifted(~Deviation(~Quotient()),~deviation_value(~Quotient(),~quotient_value())),~Representation.Lifted<G>,~Representation.lifted(~G,~gv),~Representation.Lifted<B>,~Representation.lifted(~B,~bv)),ShapeLaws.elements(Tiled.cell_shape([channels],0n,Grid.Outermost{})),0n,Groups.Normals{Representation.Lifted{channel_means(~X,~xv,x,images,channels,height,width),Public.geometry_of([channels],0n,Grid.Outermost{})},Representation.Lifted{deviation_context(~Quotient(),channel_variances(~X,~xv,x,images,channels,height,width),epsilon),Public.geometry_of([channels],0n,Grid.Outermost{})},Representation.Lifted{gamma,Public.geometry_of([channels],0n,Grid.Outermost{})},Representation.Lifted{beta,Public.geometry_of([channels],0n,Grid.Outermost{})}}),
