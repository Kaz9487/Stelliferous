  %Equal.sym(Pieces.Ranges,PiecesModel.content_layout(~Tile.Tile8,PiecesModel.shaped_content(~Each.PiecePair<Tile.Tile8>,~Tile.Tile8,~BNCells.Mapping<Kernel.Back>,~Passes.back_content,BNCells.Mapping{groups,cells,padding},tree)),PiecesModel.shaped_plan(~Each.PiecePair<Tile.Tile8>,~Each.piece_rows(~Each.PiecePair<Tile.Tile8>),tree),
