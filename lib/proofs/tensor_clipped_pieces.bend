# ---- Whole units ----

# A value that is a whole number of units.
type Multiple<-unit: Nat,-value: Nat> is Data:
  Multiple{units: Nat,exact: {value == Nat.mul(units,unit) : Nat}}

def maximum_with(+choice: Bool,+left: Nat,+right: Nat,+unit: Nat,+test: {Nat.is_le(left,right) == choice : Bool},
  +left_whole: Multiple<unit,left>,+right_whole: Multiple<unit,right>) -> Multiple<unit,Nat.max(left,right)>:
  match choice:
    case True{}:
      {%Equal.sym(Nat,Nat.max(left,right),right,NatExtrema.maximum_when_ordered(left,right,test)) : Multiple<unit,_> right_whole : Multiple<unit,Nat.max(left,right)>}
    case False{}:
      {%Equal.sym(Nat,Nat.max(left,right),left,NatExtrema.maximum_when_above(left,right,Bounds.strict_le(right,left,Held.le_false_lt(left,right,test)))) : Multiple<unit,_>
        left_whole : Multiple<unit,Nat.max(left,right)>}

# The larger of two whole values is whole.
def maximum_units(+left: Nat,+right: Nat,+unit: Nat,+left_whole: Multiple<unit,left>,+right_whole: Multiple<unit,right>) -> Multiple<unit,Nat.max(left,right)>:
  maximum_with(Nat.is_le(left,right),left,right,unit,{==},left_whole,right_whole)

# A run of whole units from two whole ends.
def fits_of(+unit: Nat,+low: Nat,+high: Nat,+bound: Nat,+low_whole: Multiple<unit,low>,+high_whole: Multiple<unit,high>,
  +less: {Nat.is_lt(low,high) == True{} : Bool},+inside: {Nat.is_le(high,bound) == True{} : Bool}) -> Runs.Fits<unit,low,high,bound>:
  Multiple{+low_units,+low_exact} = low_whole
  Multiple{+high_units,+high_exact} = high_whole
  Runs.Fits{low_units,high_units,low_exact,high_exact,less,inside}

