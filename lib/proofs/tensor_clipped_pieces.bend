# ---- The slot of a piece ----

def covers_after(+grid: Grid.Grid,count: Nat,+piece: Nat,+rest: Held.Spans,+position: Nat,+size: Nat,+covers: PlacedParts.Covers(rest,position,size)) ->
  PlacedParts.Covers(GridRanges.piece_spans(grid,count,piece,rest),position,size):
  match count:
    case 0n: covers
    case 1n+more: Placed.OnRight{covers_after(grid,more,1n+piece,rest,position,size,covers)}

