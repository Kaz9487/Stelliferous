# The first piece of a clipped layout starts where the layout is laid.
def clipped_at(remaining: Nat,+grid: Grid.Grid,+piece: U32,+from: U32,+to: U32,+first: U32,+count: U32,+target: Pieces.Ranges,+position: Nat,
  +laid: PlacedParts.LaidParts(target,clipped_layout(remaining,grid,piece,from,to,first,count),position)) -> {U32.to_nat(first) == position : Nat}:
  match remaining:
    case 0n:
      KernelGemm.Both{+at,+rest} = laid
      at
    case 1n+ +rest:
      KernelGemm.Both{+head,+tail} = laid
      KernelGemm.Both{+at,+other} = head
      at

def clipped_low(remaining: Nat,+grid: Grid.Grid,+piece: U32,+from: U32,+to: U32,+first: U32,+count: U32) ->
  {Runs.range_low(clipped_layout(remaining,grid,piece,from,to,first,count)) == U32.to_nat(first) : Nat}:
  match remaining:
    case 0n: {==}
    case 1n+ +rest: {==}

