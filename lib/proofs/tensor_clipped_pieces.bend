# ---- The piece of a cell ----
# A cell inside the grid lies in piece q * per + j: q images and j pieces of
# its image before it.
def cell_piece_exact(+limits: Machine.Limits,+outer: U32,+extent: U32,+unit_cells: U32,+block: U32,+per: U32,+count: U32,+prefix: U32,+shape: Laws.Shape<limits,outer,extent,unit_cells,block,per>,+cells: {U32.to_nat(count) == Nat.mul(Nat.mul(U32.to_nat(outer),U32.to_nat(extent)),U32.to_nat(unit_cells)) : Nat},+index: U32,+below: {Nat.is_lt(U32.to_nat(index),Nat.mul(Nat.mul(U32.to_nat(outer),U32.to_nat(extent)),U32.to_nat(unit_cells))) == True{} : Bool}) ->
  {U32.to_nat(Grid.piece_of(Grid.Grid{count,prefix,outer,extent,unit_cells,block,per,(outer * per : U32)},index)) == Nat.add(Nat.mul(Nat.div(U32.to_nat(index),Nat.mul(U32.to_nat(extent),U32.to_nat(unit_cells))),U32.to_nat(per)),Nat.div(Nat.mod(U32.to_nat(index),Nat.mul(U32.to_nat(extent),U32.to_nat(unit_cells))),Nat.mul(U32.to_nat(block),U32.to_nat(unit_cells)))) : Nat}:
  Laws.piece_word(limits,outer,extent,unit_cells,block,per,count,prefix,(outer * per : U32),shape,index,Bounds.strict_le(U32.to_nat(index),Nat.mul(Nat.mul(U32.to_nat(outer),U32.to_nat(extent)),U32.to_nat(unit_cells)),below))

