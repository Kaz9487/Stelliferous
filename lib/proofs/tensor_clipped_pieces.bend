# A cell inside the grid lies before the first cell of the piece after its
# piece: the next piece of its image, or the first piece of the next image.
def cell_next_with(+choice: Bool,+limits: Machine.Limits,+outer: U32,+extent: U32,+unit_cells: U32,+block: U32,+per: U32,+count: U32,+prefix: U32,+shape: Laws.Shape<limits,outer,extent,unit_cells,block,per>,+cells: {U32.to_nat(count) == Nat.mul(Nat.mul(U32.to_nat(outer),U32.to_nat(extent)),U32.to_nat(unit_cells)) : Nat},+index: U32,+below: {Nat.is_lt(U32.to_nat(index),Nat.mul(Nat.mul(U32.to_nat(outer),U32.to_nat(extent)),U32.to_nat(unit_cells))) == True{} : Bool},+test: {Nat.is_lt(1n+Nat.div(Nat.mod(U32.to_nat(index),Nat.mul(U32.to_nat(extent),U32.to_nat(unit_cells))),Nat.mul(U32.to_nat(block),U32.to_nat(unit_cells))),U32.to_nat(per)) == choice : Bool}) ->
