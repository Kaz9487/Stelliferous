# ---- The extents of the rows ----

def row_nonzero(+images: U32,+classes: U32,nonzero: {Shapes.has_zero([images,classes]) == False{} : Bool}) -> {Shapes.has_zero([images,1]) == False{} : Bool}:
  %Equal.sym(Bool,U32.is_zero(images),False{},Boolean.or_false_left(U32.is_zero(images),U32.is_zero(classes) || False{},nonzero)) : {_ || False{} == False{} : Bool}
  {==}

def unit_product(count: Maybe<&2,U32>) -> {Shapes.product([1],count) == count : Maybe<&2,U32>}:
  match count:
    case Some{+value}: UnitProducts.one_right(value)
    case None{}: {==}

def unit_counted(empty: Bool,+images: U32) -> {Shapes.count_nonempty(empty,[images,1]) == Shapes.count_nonempty(empty,[images]) : Maybe<&2,U32>}:
  match empty:
    case True{}: {==}
    case False{}: unit_product(CheckedWord.multiply(1,images))

def row_count(+images: U32) -> {Tensors.count_of([images,1]) == Tensors.count_of([images]) : Maybe<&2,U32>}:
  Equal.cong(Maybe<&2,U32>,Maybe<&2,U32>,count => Tensors.allocatable(count),Shapes.count_nonempty(U32.is_zero(images) || False{},[images,1]),
    Shapes.count_nonempty(U32.is_zero(images) || False{},[images]),unit_counted(U32.is_zero(images) || False{},images))

def row_room(+limits: Machine.Limits,+rank_room: {Nat.is_le(2n,U32.to_nat(Machine.capacity(limits))) == True{} : Bool}) ->
  {Nat.is_le(1n,U32.to_nat(Machine.capacity(limits))) == True{} : Bool}:
  Order.transitive(1n,2n,U32.to_nat(Machine.capacity(limits)),{==},rank_room)

# ---- The loss and the gradient of the log probabilities ----

