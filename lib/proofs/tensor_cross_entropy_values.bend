    %Equal.sym(Tiled.Tiled,Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,om),os,of,Tensors.Usable{},ow},oa,ol,op},logits,logits_equation) : Public.Contract(~Logical,~original,logical,shape,_) contract,
