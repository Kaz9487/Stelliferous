def entropy_packed(~Logical: Data,~original: Logical -> U32 -> F32,~Target: Data,~target_value: Target -> U32 -> F32,+logical: Logical,+target: Target,+limits: Machine.Limits,+shape: List<&2,U32>,+default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},
