  Public.Packed{+km,+ks,+kf,+kw,+ka,+kl,+kp,+target_equation} = target_packed
  %logits_equation : Entropy(~Logical,~original,~Target,~target_value,logical,target,shape,laxes,loffset,raxes,roffset,Loss.cross_entropy(_,target_tiled))
  %target_equation : Entropy(~Logical,~original,~Target,~target_value,logical,target,shape,laxes,loffset,raxes,roffset,Loss.cross_entropy(Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,om),os,of,Tensors.Usable{},ow},oa,ol,op},_))
