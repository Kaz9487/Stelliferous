# ---- What the loss, the gradient and the target hold ----

# The number of rows of [N,K]; zero for another rank.
def rows(shape: List<&2,U32>) -> U32:
  match shape:
    case [images,classes]: images
    case shape: 0

# The rows of the logits centered by their maximum, and the log
# probabilities p, the centered rows minus the logarithm of the sum of their
# exponentials, both through the views that stretch [N,1] along the rows.
# The rank-0 loss is the sum of target * p, from the partials of
# math_sum.bend, divided by -N; the gradient at i is (exp(p[i]) - target[i])
# / N; the target returns as it was given.
