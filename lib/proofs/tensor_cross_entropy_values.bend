  +count_room: {Nat.is_le(Nat.add(Nat.double(ShapeLaws.elements(shape)),4n),U32.to_nat(cap)) == True{} : Bool},
  +laxes: List<&2,Views.Axis>,+loffset: U32,+raxes: List<&2,Views.Axis>,+roffset: U32,+own_stretched: {Tensors.stretched(Tensors.view_of(shape),shape) == Some{Views.View{laxes,loffset}} : Maybe<&2,Views.View>},
  +row_stretched: {Tensors.stretched(Tensors.view_of(Layout.with_extent(shape,1n,1)),shape) == Some{Views.View{raxes,roffset}} : Maybe<&2,Views.View>},+target_shape: List<&2,U32>,
  -logits: Loss.Tensor(),logits_packed: Public.Packed<logits>,-target_tiled: Loss.Tensor(),target_packed: Public.Packed<target_tiled>,
  +contract: Public.Contract(~Logical,~original,logical,shape,logits),+k_contract: Public.Contract(~Target,~target_value,target,target_shape,target_tiled),
  +matched: {Shapes.same_extents(shape,target_shape) == True{} : Bool},+rank_two: {Nat.is_eq(List.length(&2,U32,shape),2n) == True{} : Bool}) -> Entropy(~Logical,~original,~Target,~target_value,logical,target,shape,laxes,loffset,raxes,roffset,Loss.cross_entropy(logits,target_tiled)):
