  match shape:
    case []: Empty.absurd(ForwardHolds(~X,~x_value,~G,~g_value,~B,~b_value,x,gamma,beta,[],features,epsilon,laxes,loffset,raxes,roffset,gaxes,goffset,Norm.forward(x_tiled,(gamma_tiled,beta_tiled),epsilon)),Words.false_true(fits))
