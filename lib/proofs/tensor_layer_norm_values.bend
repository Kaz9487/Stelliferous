def beta_copies(~X: Data,~x_value: X -> U32 -> F32,~G: Data,~g_value: G -> U32 -> F32,~B: Data,~b_value: B -> U32 -> F32,+x: X,+gamma: G,+beta: B,+head: U32,+tail: List<&2,U32>,+features: U32,+epsilon: F32,+laxes: List<&2,Views.Axis>,+loffset: U32,+raxes: List<&2,Views.Axis>,+roffset: U32,+gaxes: List<&2,Views.Axis>,+goffset: U32,+limits: Machine.Limits,+default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},
