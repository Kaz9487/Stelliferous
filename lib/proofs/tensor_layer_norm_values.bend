  backward_saved(~X,~x_value,~G,~g_value,~Y,~y_value,x,gamma,y,head,tail,features,epsilon,laxes,loffset,raxes,roffset,gaxes,goffset,limits,default_capacity,rank_room,nonempty,cap,cap_ok,count_room,own_stretched,row_stretched,fits,gamma_stretched,ym,ys,yf,yw,ya,yl,yp,y_contract,gm,gs,gf,gw,ga,gl,gp,g_contract,saved,holds)

def backward_packed(~X: Data,~x_value: X -> U32 -> F32,~G: Data,~g_value: G -> U32 -> F32,~Y: Data,~y_value: Y -> U32 -> F32,+x: X,+gamma: G,+y: Y,+head: U32,+tail: List<&2,U32>,+features: U32,+epsilon: F32,+laxes: List<&2,Views.Axis>,+loffset: U32,+raxes: List<&2,Views.Axis>,+roffset: U32,+gaxes: List<&2,Views.Axis>,+goffset: U32,+limits: Machine.Limits,+default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},
  +rank_room: {Nat.is_le(List.length(&2,U32,Con{head,tail}),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},+nonempty: {Nat.is_lt(0n,ShapeLaws.elements(Con{head,tail})) == True{} : Bool},+cap: U32,+cap_ok: {U32.is_le(cap,2147483648) == True{} : Bool},
  +count_room: {Nat.is_le(Nat.add(Nat.double(ShapeLaws.elements(Con{head,tail})),4n),U32.to_nat(cap)) == True{} : Bool},
  +own_stretched: {Tensors.stretched(Tensors.view_of(Con{head,tail}),Con{head,tail}) == Some{Views.View{laxes,loffset}} : Maybe<&2,Views.View>},
  +row_stretched: {Tensors.stretched(Tensors.view_of(Norm.unit_extents(Con{head,tail})),Con{head,tail}) == Some{Views.View{raxes,roffset}} : Maybe<&2,Views.View>},
  +fits: {Shapes.same_extents(Norm.last_of(Con{head,tail}),[features]) == True{} : Bool},
  +gamma_stretched: {Tensors.stretched(Tensors.view_of([features]),Con{head,tail}) == Some{Views.View{gaxes,goffset}} : Maybe<&2,Views.View>},
  -dy: Tiled.Tiled,y_packed: Public.Packed<dy>,-gamma_tiled: Tiled.Tiled,g_packed: Public.Packed<gamma_tiled>,
  +y_contract: Public.Contract(~Y,~y_value,y,Con{head,tail},dy),+g_contract: Public.Contract(~G,~g_value,gamma,[features],gamma_tiled),saved: Norm.Saved(),+holds: SavedHolds(~X,~x_value,x,Con{head,tail},epsilon,laxes,loffset,raxes,roffset,saved)) -> BackwardHolds(~X,~x_value,~G,~g_value,~Y,~y_value,x,gamma,y,Con{head,tail},features,epsilon,laxes,loffset,raxes,roffset,gaxes,goffset,Norm.backward(dy,saved,gamma_tiled)):
  Public.Packed{+ym,+ys,+yf,+yw,+ya,+yl,+yp,+y_equation} = y_packed
  Public.Packed{+gm,+gs,+gf,+gw,+ga,+gl,+gp,+g_equation} = g_packed
  %y_equation : BackwardHolds(~X,~x_value,~G,~g_value,~Y,~y_value,x,gamma,y,Con{head,tail},features,epsilon,laxes,loffset,raxes,roffset,gaxes,goffset,Norm.backward(_,saved,gamma_tiled))
  %g_equation : BackwardHolds(~X,~x_value,~G,~g_value,~Y,~y_value,x,gamma,y,Con{head,tail},features,epsilon,laxes,loffset,raxes,roffset,gaxes,goffset,Norm.backward(Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,ym),ys,yf,Tensors.Usable{},yw},ya,yl,yp},saved,_))
  backward_model(~X,~x_value,~G,~g_value,~Y,~y_value,x,gamma,y,head,tail,features,epsilon,laxes,loffset,raxes,roffset,gaxes,goffset,limits,default_capacity,rank_room,nonempty,cap,cap_ok,count_room,own_stretched,row_stretched,fits,gamma_stretched,ym,ys,yf,yw,ya,yl,yp,%Equal.sym(Tiled.Tiled,Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,ym),ys,yf,Tensors.Usable{},yw},ya,yl,yp},dy,y_equation) : Public.Contract(~Y,~y_value,y,Con{head,tail},_) y_contract,
    gm,gs,gf,gw,ga,gl,gp,%Equal.sym(Tiled.Tiled,Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,gm),gs,gf,Tensors.Usable{},gw},ga,gl,gp},gamma_tiled,g_equation) : Public.Contract(~G,~g_value,gamma,[features],_) g_contract,saved,holds)

# Backward of dy of the shape of forward, what forward saved and gamma, each
# of its contract: the gradients hold dx, and dgamma and dbeta the sums of
# dy * xhat and of dy over the axes before the last, and gamma returns as it
# was given.
def backward(~X: Data,~x_value: X -> U32 -> F32,~G: Data,~g_value: G -> U32 -> F32,~Y: Data,~y_value: Y -> U32 -> F32,+x: X,+gamma: G,+y: Y,+shape: List<&2,U32>,+features: U32,+epsilon: F32,+laxes: List<&2,Views.Axis>,+loffset: U32,+raxes: List<&2,Views.Axis>,+roffset: U32,+gaxes: List<&2,Views.Axis>,+goffset: U32,+limits: Machine.Limits,+default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},
  +rank_room: {Nat.is_le(List.length(&2,U32,shape),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},+nonempty: {Nat.is_lt(0n,ShapeLaws.elements(shape)) == True{} : Bool},+cap: U32,+cap_ok: {U32.is_le(cap,2147483648) == True{} : Bool},
  +count_room: {Nat.is_le(Nat.add(Nat.double(ShapeLaws.elements(shape)),4n),U32.to_nat(cap)) == True{} : Bool},
  +own_stretched: {Tensors.stretched(Tensors.view_of(shape),shape) == Some{Views.View{laxes,loffset}} : Maybe<&2,Views.View>},
  +row_stretched: {Tensors.stretched(Tensors.view_of(Norm.unit_extents(shape)),shape) == Some{Views.View{raxes,roffset}} : Maybe<&2,Views.View>},
  +fits: {Shapes.same_extents(Norm.last_of(shape),[features]) == True{} : Bool},
  +gamma_stretched: {Tensors.stretched(Tensors.view_of([features]),shape) == Some{Views.View{gaxes,goffset}} : Maybe<&2,Views.View>},
  dy: Tiled.Tiled,+y_contract: Public.Contract(~Y,~y_value,y,shape,dy),saved: Norm.Saved(),+holds: SavedHolds(~X,~x_value,x,shape,epsilon,laxes,loffset,raxes,roffset,saved),
  gamma_tiled: Tiled.Tiled,+g_contract: Public.Contract(~G,~g_value,gamma,[features],gamma_tiled)) -> BackwardHolds(~X,~x_value,~G,~g_value,~Y,~y_value,x,gamma,y,shape,features,epsilon,laxes,loffset,raxes,roffset,gaxes,goffset,Norm.backward(dy,saved,gamma_tiled)):
  match shape:
    case []: Empty.absurd(BackwardHolds(~X,~x_value,~G,~g_value,~Y,~y_value,x,gamma,y,[],features,epsilon,laxes,loffset,raxes,roffset,gaxes,goffset,Norm.backward(dy,saved,gamma_tiled)),Words.false_true(fits))
    case +head <> +tail:
      backward_packed(~X,~x_value,~G,~g_value,~Y,~y_value,x,gamma,y,head,tail,features,epsilon,laxes,loffset,raxes,roffset,gaxes,goffset,limits,default_capacity,rank_room,nonempty,cap,cap_ok,count_room,own_stretched,row_stretched,fits,gamma_stretched,dy,Public.packed(~Y,~y_value,y,Con{head,tail},dy,y_contract),gamma_tiled,Public.packed(~G,~g_value,gamma,[features],gamma_tiled,g_contract),
        y_contract,g_contract,saved,holds)
