def evaluate_packed(~X: Data,~x_value: X -> U32 -> F32,~G: Data,~g_value: G -> U32 -> F32,~B: Data,~b_value: B -> U32 -> F32,+x: X,+gamma: G,+beta: B,+head: U32,+tail: List<&2,U32>,+features: U32,+epsilon: F32,+laxes: List<&2,Views.Axis>,+loffset: U32,+raxes: List<&2,Views.Axis>,+roffset: U32,+gaxes: List<&2,Views.Axis>,+goffset: U32,+limits: Machine.Limits,+default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},
  +rank_room: {Nat.is_le(List.length(&2,U32,Con{head,tail}),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},+nonempty: {Nat.is_lt(0n,ShapeLaws.elements(Con{head,tail})) == True{} : Bool},+cap: U32,+cap_ok: {U32.is_le(cap,2147483648) == True{} : Bool},
  +count_room: {Nat.is_le(Nat.add(Nat.double(ShapeLaws.elements(Con{head,tail})),4n),U32.to_nat(cap)) == True{} : Bool},
  +own_stretched: {Tensors.stretched(Tensors.view_of(Con{head,tail}),Con{head,tail}) == Some{Views.View{laxes,loffset}} : Maybe<&2,Views.View>},
  +row_stretched: {Tensors.stretched(Tensors.view_of(Norm.unit_extents(Con{head,tail})),Con{head,tail}) == Some{Views.View{raxes,roffset}} : Maybe<&2,Views.View>},
  +fits: {Shapes.same_extents(Norm.last_of(Con{head,tail}),[features]) == True{} : Bool},
  +gamma_stretched: {Tensors.stretched(Tensors.view_of([features]),Con{head,tail}) == Some{Views.View{gaxes,goffset}} : Maybe<&2,Views.View>},
  -x_tiled: Tiled.Tiled,x_packed: Public.Packed<x_tiled>,-gamma_tiled: Tiled.Tiled,g_packed: Public.Packed<gamma_tiled>,-beta_tiled: Tiled.Tiled,b_packed: Public.Packed<beta_tiled>,
  +x_contract: Public.Contract(~X,~x_value,x,Con{head,tail},x_tiled),+g_contract: Public.Contract(~G,~g_value,gamma,[features],gamma_tiled),+b_contract: Public.Contract(~B,~b_value,beta,[features],beta_tiled)) -> EvaluateHolds(~X,~x_value,~G,~g_value,~B,~b_value,x,gamma,beta,Con{head,tail},features,epsilon,laxes,loffset,raxes,roffset,gaxes,goffset,Norm.evaluate(x_tiled,(gamma_tiled,beta_tiled),epsilon)):
  Public.Packed{+xm,+xs,+xf,+xw,+xa,+xl,+xp,+x_equation} = x_packed
  Public.Packed{+gm,+gs,+gf,+gw,+ga,+gl,+gp,+g_equation} = g_packed
  Public.Packed{+bm,+bs,+bf,+bw,+ba,+bl,+bp,+b_equation} = b_packed
  %x_equation : EvaluateHolds(~X,~x_value,~G,~g_value,~B,~b_value,x,gamma,beta,Con{head,tail},features,epsilon,laxes,loffset,raxes,roffset,gaxes,goffset,Norm.evaluate(_,(gamma_tiled,beta_tiled),epsilon))
  %g_equation : EvaluateHolds(~X,~x_value,~G,~g_value,~B,~b_value,x,gamma,beta,Con{head,tail},features,epsilon,laxes,loffset,raxes,roffset,gaxes,goffset,Norm.evaluate(Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,xm),xs,xf,Tensors.Usable{},xw},xa,xl,xp},(_,beta_tiled),epsilon))
  %b_equation : EvaluateHolds(~X,~x_value,~G,~g_value,~B,~b_value,x,gamma,beta,Con{head,tail},features,epsilon,laxes,loffset,raxes,roffset,gaxes,goffset,Norm.evaluate(Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,xm),xs,xf,Tensors.Usable{},xw},xa,xl,xp},(Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,gm),gs,gf,Tensors.Usable{},gw},ga,gl,gp},_),epsilon))
  evaluate_model(~X,~x_value,~G,~g_value,~B,~b_value,x,gamma,beta,head,tail,features,epsilon,laxes,loffset,raxes,roffset,gaxes,goffset,limits,default_capacity,rank_room,nonempty,cap,cap_ok,count_room,own_stretched,row_stretched,fits,gamma_stretched,xm,xs,xf,xw,xa,xl,xp,gm,gs,gf,gw,ga,gl,gp,%Equal.sym(Tiled.Tiled,Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,gm),gs,gf,Tensors.Usable{},gw},ga,gl,gp},gamma_tiled,g_equation) : Public.Contract(~G,~g_value,gamma,[features],_) g_contract,bm,bs,bf,bw,ba,bl,bp,%Equal.sym(Tiled.Tiled,Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,bm),bs,bf,Tensors.Usable{},bw},ba,bl,bp},beta_tiled,b_equation) : Public.Contract(~B,~b_value,beta,[features],_) b_contract,
    %Equal.sym(Tiled.Tiled,Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,xm),xs,xf,Tensors.Usable{},xw},xa,xl,xp},x_tiled,x_equation) : Public.Contract(~X,~x_value,x,Con{head,tail},_) x_contract)

# Evaluate of x, gamma and beta as for forward: the output holds xhat *
# gamma + beta, and gamma and beta return as they were given.
def evaluate(~X: Data,~x_value: X -> U32 -> F32,~G: Data,~g_value: G -> U32 -> F32,~B: Data,~b_value: B -> U32 -> F32,+x: X,+gamma: G,+beta: B,+shape: List<&2,U32>,+features: U32,+epsilon: F32,+laxes: List<&2,Views.Axis>,+loffset: U32,+raxes: List<&2,Views.Axis>,+roffset: U32,+gaxes: List<&2,Views.Axis>,+goffset: U32,+limits: Machine.Limits,+default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},
  +rank_room: {Nat.is_le(List.length(&2,U32,shape),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},+nonempty: {Nat.is_lt(0n,ShapeLaws.elements(shape)) == True{} : Bool},+cap: U32,+cap_ok: {U32.is_le(cap,2147483648) == True{} : Bool},
  +count_room: {Nat.is_le(Nat.add(Nat.double(ShapeLaws.elements(shape)),4n),U32.to_nat(cap)) == True{} : Bool},
  +own_stretched: {Tensors.stretched(Tensors.view_of(shape),shape) == Some{Views.View{laxes,loffset}} : Maybe<&2,Views.View>},
  +row_stretched: {Tensors.stretched(Tensors.view_of(Norm.unit_extents(shape)),shape) == Some{Views.View{raxes,roffset}} : Maybe<&2,Views.View>},
  +fits: {Shapes.same_extents(Norm.last_of(shape),[features]) == True{} : Bool},
  +gamma_stretched: {Tensors.stretched(Tensors.view_of([features]),shape) == Some{Views.View{gaxes,goffset}} : Maybe<&2,Views.View>},
  x_tiled: Tiled.Tiled,+x_contract: Public.Contract(~X,~x_value,x,shape,x_tiled),gamma_tiled: Tiled.Tiled,+g_contract: Public.Contract(~G,~g_value,gamma,[features],gamma_tiled),
  beta_tiled: Tiled.Tiled,+b_contract: Public.Contract(~B,~b_value,beta,[features],beta_tiled)) -> EvaluateHolds(~X,~x_value,~G,~g_value,~B,~b_value,x,gamma,beta,shape,features,epsilon,laxes,loffset,raxes,roffset,gaxes,goffset,Norm.evaluate(x_tiled,(gamma_tiled,beta_tiled),epsilon)):
  match shape:
    case []: Empty.absurd(EvaluateHolds(~X,~x_value,~G,~g_value,~B,~b_value,x,gamma,beta,[],features,epsilon,laxes,loffset,raxes,roffset,gaxes,goffset,Norm.evaluate(x_tiled,(gamma_tiled,beta_tiled),epsilon)),Words.false_true(fits))
    case +head <> +tail:
      evaluate_packed(~X,~x_value,~G,~g_value,~B,~b_value,x,gamma,beta,head,tail,features,epsilon,laxes,loffset,raxes,roffset,gaxes,goffset,limits,default_capacity,rank_room,nonempty,cap,cap_ok,count_room,own_stretched,row_stretched,fits,gamma_stretched,x_tiled,Public.packed(~X,~x_value,x,Con{head,tail},x_tiled,x_contract),gamma_tiled,Public.packed(~G,~g_value,gamma,[features],gamma_tiled,g_contract),
        beta_tiled,Public.packed(~B,~b_value,beta,[features],beta_tiled,b_contract),x_contract,g_contract,b_contract)

# ---- Backward ----

# The gradients of gamma and beta: the sums over every axis but the last of
# dy * xhat and of dy.
