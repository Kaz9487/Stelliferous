# ---- The line of the last axis ----

def last_inside(+tail: List<&2,U32>) -> {Nat.is_lt(List.length(&2,U32,tail),1n+List.length(&2,U32,tail)) == True{} : Bool}:
  Order.lt_succ(List.length(&2,U32,tail),List.length(&2,U32,tail),Order.reflexive(List.length(&2,U32,tail)))

# The last axis of a shape within the rank room, as a word.
def last_exact(+limits: Machine.Limits,+tail: List<&2,U32>,
  +rank_room: {Nat.is_le(1n+List.length(&2,U32,tail),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}) ->
  {U32.to_nat(U32.from_nat(List.length(&2,U32,tail))) == List.length(&2,U32,tail) : Nat}:
  FullRange.roundtrip(List.length(&2,U32,tail),Machine.capacity(limits),Order.transitive(List.length(&2,U32,tail),1n+List.length(&2,U32,tail),U32.to_nat(Machine.capacity(limits)),
    Order.successor(List.length(&2,U32,tail),List.length(&2,U32,tail),Order.reflexive(List.length(&2,U32,tail))),rank_room))

def last_word(+limits: Machine.Limits,+head: U32,+tail: List<&2,U32>,
  +rank_room: {Nat.is_le(1n+List.length(&2,U32,tail),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}) ->
  {Layout.naturals([Norm.last_axis(head <> tail)]) == [List.length(&2,U32,tail)] : List<&2,Nat>}:
  Equal.cong(Nat,List<&2,Nat>,value => [value],U32.to_nat(U32.from_nat(List.length(&2,U32,tail))),List.length(&2,U32,tail),last_exact(limits,tail,rank_room))

# The last axis is below the rank.
def last_below(+limits: Machine.Limits,+head: U32,+tail: List<&2,U32>,
  +rank_room: {Nat.is_le(1n+List.length(&2,U32,tail),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}) ->
  {Layout.all_below([Norm.last_axis(head <> tail)],1n+List.length(&2,U32,tail)) == True{} : Bool}:
  %Equal.sym(Nat,U32.to_nat(U32.from_nat(List.length(&2,U32,tail))),List.length(&2,U32,tail),last_exact(limits,tail,rank_room)) :
    {(Nat.is_lt(_,1n+List.length(&2,U32,tail)) && True{}) == True{} : Bool}
  %Equal.sym(Bool,Nat.is_lt(List.length(&2,U32,tail),1n+List.length(&2,U32,tail)),True{},
    Order.lt_succ(List.length(&2,U32,tail),List.length(&2,U32,tail),Order.reflexive(List.length(&2,U32,tail)))) : {(_ && True{}) == True{} : Bool}
  {==}

# The extent of the last axis.
def last_extent(+head: U32,+tail: List<&2,U32>) -> U32:
  Layout.extent_at(head <> tail,List.length(&2,U32,tail))

# The last of the extents is the extent of the last axis.
def last_listed(+tail: List<&2,U32>,+head: U32) -> {Norm.last_of(head <> tail) == [last_extent(head,tail)] : List<&2,U32>}:
  match tail:
    case []: {==}
    case +next <> +rest: last_listed(rest,next)

# Gamma of the last extent holds cells.
def features_nonzero(+head: U32,+tail: List<&2,U32>,+features: U32,+positive: {Nat.is_lt(0n,ShapeLaws.elements(head <> tail)) == True{} : Bool},
  +fits: {Shapes.same_extents(Norm.last_of(head <> tail),[features]) == True{} : Bool}) -> {Shapes.has_zero([features]) == False{} : Bool}:
  +same = Equal.trans(List<&2,U32>,[last_extent(head,tail)],Norm.last_of(head <> tail),[features],Equal.sym(List<&2,U32>,Norm.last_of(head <> tail),[last_extent(head,tail)],last_listed(tail,head)),
    ShapeLaws.same_extents(Norm.last_of(head <> tail),[features],fits))
  %same : {Shapes.has_zero(_) == False{} : Bool}
  CountCompletion.positive_not_zero([last_extent(head,tail)],
    %Equal.sym(Nat,Nat.mul(U32.to_nat(last_extent(head,tail)),1n),U32.to_nat(last_extent(head,tail)),Order.times_one(U32.to_nat(last_extent(head,tail)))) :
      {Nat.is_lt(0n,_) == True{} : Bool} UnitLine.axis_positive(head <> tail,List.length(&2,U32,tail),last_inside(tail),positive))

# Gamma takes one rank of room.
def one_room(+limits: Machine.Limits,+tail: List<&2,U32>,+rank_room: {Nat.is_le(1n+List.length(&2,U32,tail),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}) ->
  {Nat.is_le(1n,U32.to_nat(Machine.capacity(limits))) == True{} : Bool}:
  Order.transitive(1n,1n+List.length(&2,U32,tail),U32.to_nat(Machine.capacity(limits)),Order.zero_le(List.length(&2,U32,tail)),rank_room)

def last_broadcast_extent(same: Bool,+left_one: Bool,+right_one: Bool,+head: U32,+features: U32,+fits: {(same && True{}) == True{} : Bool}) ->
  {Shapes.broadcast_extent(same,left_one,right_one,head,features) == Some{head} : Maybe<&2,U32>}:
  match same:
    case True{}: {==}
    case False{}: Empty.absurd({Shapes.broadcast_extent(False{},left_one,right_one,head,features) == Some{head} : Maybe<&2,U32>},Words.false_true(fits))

def last_same_rank(+tail: List<&2,U32>,+head: U32,+features: U32,+fits: {Shapes.same_extents(Norm.last_of(Con{head,tail}),[features]) == True{} : Bool}) ->
  {Shapes.broadcast_same_rank(Con{head,tail},List.append(&2,U32,List.replicate(U32,List.length(&2,U32,tail),1),[features])) == Some{Con{head,tail}} : Maybe<&2,List<&2,U32>>}:
  match tail:
    case Nil{}:
      %Equal.sym(Maybe<&2,U32>,Shapes.broadcast_extent(U32.is_eq(head,features),U32.is_eq(head,1),U32.is_eq(features,1),head,features),Some{head},
        last_broadcast_extent(U32.is_eq(head,features),U32.is_eq(head,1),U32.is_eq(features,1),head,features,fits)) : {Shapes.prepend_extent(_,Some{[]}) == Some{[head]} : Maybe<&2,List<&2,U32>>}
      {==}
    case Con{+next,+rest}:
      %Equal.sym(Bool,U32.is_eq(1,1),True{},Arithmetic.equal_reflexive(1)) : {Shapes.prepend_extent(Shapes.broadcast_extent(U32.is_eq(head,1),U32.is_eq(head,1),_,head,1),Shapes.broadcast_same_rank(Con{next,rest},List.append(&2,U32,List.replicate(U32,List.length(&2,U32,rest),1),[features]))) == Some{Con{head,Con{next,rest}}} : Maybe<&2,List<&2,U32>>}
      %Equal.sym(Maybe<&2,U32>,Shapes.broadcast_extent(U32.is_eq(head,1),U32.is_eq(head,1),True{},head,1),Some{head},UnitBroadcast.singleton(head,U32.is_eq(head,1),U32.is_eq(head,1),{==},{==})) : {Shapes.prepend_extent(_,Shapes.broadcast_same_rank(Con{next,rest},List.append(&2,U32,List.replicate(U32,List.length(&2,U32,rest),1),[features]))) == Some{Con{head,Con{next,rest}}} : Maybe<&2,List<&2,U32>>}
      %Equal.sym(Maybe<&2,List<&2,U32>>,Shapes.broadcast_same_rank(Con{next,rest},List.append(&2,U32,List.replicate(U32,List.length(&2,U32,rest),1),[features])),Some{Con{next,rest}},last_same_rank(rest,next,features,fits)) : {Shapes.prepend_extent(Some{head},_) == Some{Con{head,Con{next,rest}}} : Maybe<&2,List<&2,U32>>}
      {==}

# [D] broadcasts to a shape whose last extent is D.
def last_common(+shape: List<&2,U32>,+features: U32,+fits: {Shapes.same_extents(Norm.last_of(shape),[features]) == True{} : Bool}) ->
  {Shapes.broadcast(shape,[features]) == Some{shape} : Maybe<&2,List<&2,U32>>}:
  match shape:
    case Nil{}: Empty.absurd({Shapes.broadcast([],[features]) == Some{[]} : Maybe<&2,List<&2,U32>>},Words.false_true(fits))
    case Con{+head,+tail}:
      %Equal.sym(Nat,Nat.sub(0n,List.length(&2,U32,tail)),0n,Order.zero_subtract(List.length(&2,U32,tail))) : {Shapes.broadcast_same_rank(List.append(&2,U32,List.replicate(U32,_,1),Con{head,tail}),List.append(&2,U32,List.replicate(U32,Nat.sub(List.length(&2,U32,tail),0n),1),[features])) == Some{Con{head,tail}} : Maybe<&2,List<&2,U32>>}
      %Equal.sym(Nat,Nat.sub(List.length(&2,U32,tail),0n),List.length(&2,U32,tail),Order.subtract_zero(List.length(&2,U32,tail))) : {Shapes.broadcast_same_rank(Con{head,tail},List.append(&2,U32,List.replicate(U32,_,1),[features])) == Some{Con{head,tail}} : Maybe<&2,List<&2,U32>>}
      last_same_rank(tail,head,features,fits)

# The mean along the last axis, reshaped to the shape with the last extent 1.
def line_reshaped(~Logical: Data,~original: Logical -> U32 -> F32,+logical: Logical,+limits: Machine.Limits,+head: U32,+tail: List<&2,U32>,tiled: Tiled.Tiled,
  +default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},
  +rank_room: {Nat.is_le(1n+List.length(&2,U32,tail),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},
  +nonempty: {Nat.is_lt(0n,ShapeLaws.elements(head <> tail)) == True{} : Bool},
  +contract: Public.Contract(~Logical,~original,logical,Layout.extents_at(head <> tail,Reduce.kept_axes(head <> tail,[Norm.last_axis(head <> tail)])),tiled)) ->
  Public.Contract(~Logical,~original,logical,Norm.unit_extents(head <> tail),F.reshape(tiled,Norm.unit_extents(head <> tail))):
  UnitLine.kept_reshaped(~Logical,~original,logical,limits,head <> tail,List.length(&2,U32,tail),tiled,default_capacity,rank_room,last_inside(tail),nonempty,
    %last_word(limits,head,tail,rank_room) : Public.Contract(~Logical,~original,logical,Layout.extents_at(head <> tail,Layout.axes_where(1n+List.length(&2,U32,tail),0n,_,False{})),tiled)
      contract)

# ---- The axes before the last ----

# The axes before the last, as the words from axis on.
def before_every(remaining: Nat,+axis: U32) -> {Norm.before_last(1n+remaining,axis) == TiledReduce.every_axis(remaining,axis) : List<&2,U32>}:
  match remaining:
    case 0n: {==}
    case 1n+ +rest:
      Equal.cong(List<&2,U32>,List<&2,U32>,items => axis <> items,Norm.before_last(1n+rest,(axis + 1 : U32)),TiledReduce.every_axis(rest,(axis + 1 : U32)),before_every(rest,(axis + 1 : U32)))

# The indices from start on hold start + offset below their count.
def every_member(remaining: Nat,offset: Nat,+start: Nat,+below: {Nat.is_lt(offset,remaining) == True{} : Bool}) ->
  {Views.contains_index(Layout.every_index(remaining,start),Nat.add(start,offset)) == True{} : Bool}:
  match remaining offset:
    case 0n offset: Empty.absurd({Views.contains_index([],Nat.add(start,offset)) == True{} : Bool},Order.below_zero(offset,below))
    case 1n+ +rest 0n:
      %Equal.sym(Nat,Nat.add(start,0n),start,Addition.zero_right(start)) : {Views.contains_index(Layout.every_index(1n+rest,start),_) == True{} : Bool}
      %Equal.sym(Bool,Nat.is_eq(start,start),True{},Order.equal_reflexive(start)) : {(_ || Views.contains_index(Layout.every_index(rest,1n+start),start)) == True{} : Bool}
      {==}
    case 1n+ +rest 1n+ +previous:
      +apart = Order.less_not_equal(start,Nat.add(start,1n+previous),Order.below_sum(start,previous))
      %Equal.sym(Bool,Nat.is_eq(start,Nat.add(start,1n+previous)),False{},apart) :
        {(_ || Views.contains_index(Layout.every_index(rest,1n+start),Nat.add(start,1n+previous))) == True{} : Bool}
      %Equal.sym(Nat,Nat.add(start,1n+previous),1n+Nat.add(start,previous),Addition.successor_right(start,previous)) :
        {Views.contains_index(Layout.every_index(rest,1n+start),_) == True{} : Bool}
      every_member(rest,previous,1n+start,below)

# The indices from start on hold no index at or past their end.
def every_beyond(remaining: Nat,+start: Nat,+axis: Nat,+beyond: {Nat.is_le(Nat.add(start,remaining),axis) == True{} : Bool}) ->
  {Views.contains_index(Layout.every_index(remaining,start),axis) == False{} : Bool}:
  match remaining:
    case 0n: {==}
    case 1n+ +rest:
      +apart = Order.less_not_equal(start,axis,Order.room_index(start,rest,axis,beyond))
      %Equal.sym(Bool,Nat.is_eq(start,axis),False{},apart) : {(_ || Views.contains_index(Layout.every_index(rest,1n+start),axis)) == False{} : Bool}
      every_beyond(rest,1n+start,axis,Order.advance_room(start,rest,axis,beyond))

# The axes before the last keep only the last.
def kept_every(count: Nat,+index: Nat,+last: Nat,+placed: {Nat.add(index,count) == last : Nat}) ->
  {Layout.axes_where(1n+count,index,Layout.every_index(last,0n),False{}) == [last] : List<&2,Nat>}:
  match count:
    case 0n:
      +exact = Equal.trans(Nat,index,Nat.add(index,0n),last,Equal.sym(Nat,Nat.add(index,0n),index,Addition.zero_right(index)),placed)
      %exact : {Layout.axes_where(1n,index,Layout.every_index(last,0n),False{}) == [_] : List<&2,Nat>}
      %Equal.sym(Bool,Views.contains_index(Layout.every_index(last,0n),index),False{},
          every_beyond(last,0n,index,%exact : {Nat.is_le(_,index) == True{} : Bool} Order.reflexive(index))) :
        {Layout.chosen(_,False{},index,[]) == [index] : List<&2,Nat>}
      {==}
    case 1n+ +previous:
      %Equal.sym(Bool,Views.contains_index(Layout.every_index(last,0n),index),True{},every_member(last,index,0n,Order.below_complement(index,previous,last,placed))) :
        {Layout.chosen(_,False{},index,Layout.axes_where(1n+previous,1n+index,Layout.every_index(last,0n),False{})) == [last] : List<&2,Nat>}
      kept_every(previous,1n+index,last,
        Equal.trans(Nat,1n+Nat.add(index,previous),Nat.add(index,1n+previous),last,Equal.sym(Nat,Nat.add(index,1n+previous),1n+Nat.add(index,previous),Addition.successor_right(index,previous)),placed))

# The axes before the last as indices.
def gradient_axes(+limits: Machine.Limits,+tail: List<&2,U32>,
  +rank_room: {Nat.is_le(1n+List.length(&2,U32,tail),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}) ->
  {Layout.naturals(Norm.before_last(1n+List.length(&2,U32,tail),0)) == Layout.every_index(List.length(&2,U32,tail),0n) : List<&2,Nat>}:
  +length = List.length(&2,U32,tail)
  %Equal.sym(List<&2,U32>,Norm.before_last(1n+length,0),TiledReduce.every_axis(length,0),before_every(length,0)) :
    {Layout.naturals(_) == Layout.every_index(length,0n) : List<&2,Nat>}
  ReduceLaws.every_words(length,0,0n,Machine.capacity(limits),Limits.capacity_fits(limits),{==},
    Order.transitive(length,1n+length,U32.to_nat(Machine.capacity(limits)),Order.successor(length,length,Order.reflexive(length)),rank_room))

def gradient_unique(+limits: Machine.Limits,+tail: List<&2,U32>,
  +rank_room: {Nat.is_le(1n+List.length(&2,U32,tail),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}) ->
  {Views.unique_axes(Layout.naturals(Norm.before_last(1n+List.length(&2,U32,tail),0))) == True{} : Bool}:
  %Equal.sym(List<&2,Nat>,Layout.naturals(Norm.before_last(1n+List.length(&2,U32,tail),0)),Layout.every_index(List.length(&2,U32,tail),0n),gradient_axes(limits,tail,rank_room)) :
    {Views.unique_axes(_) == True{} : Bool}
  Reduce.every_unique(List.length(&2,U32,tail),0n)

def gradient_below(+limits: Machine.Limits,+tail: List<&2,U32>,
  +rank_room: {Nat.is_le(1n+List.length(&2,U32,tail),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}) ->
  {Layout.all_below(Norm.before_last(1n+List.length(&2,U32,tail),0),1n+List.length(&2,U32,tail)) == True{} : Bool}:
  +length = List.length(&2,U32,tail)
  %Equal.sym(Bool,Layout.all_below(Norm.before_last(1n+length,0),1n+length),ReduceLaws.below_all(Layout.naturals(Norm.before_last(1n+length,0)),1n+length),
      ReduceLaws.below_naturals(Norm.before_last(1n+length,0),1n+length)) : {_ == True{} : Bool}
  %Equal.sym(List<&2,Nat>,Layout.naturals(Norm.before_last(1n+length,0)),Layout.every_index(length,0n),gradient_axes(limits,tail,rank_room)) :
    {ReduceLaws.below_all(_,1n+length) == True{} : Bool}
  ReduceLaws.every_index_below(length,0n,1n+length,Order.successor(length,length,Order.reflexive(length)))

# The extent of the last axis is the extent of gamma.
def last_features(+head: U32,+tail: List<&2,U32>,+features: U32,+fits: {Shapes.same_extents(Norm.last_of(head <> tail),[features]) == True{} : Bool}) ->
  {[last_extent(head,tail)] == [features] : List<&2,U32>}:
  Equal.trans(List<&2,U32>,[last_extent(head,tail)],Norm.last_of(head <> tail),[features],Equal.sym(List<&2,U32>,Norm.last_of(head <> tail),[last_extent(head,tail)],last_listed(tail,head)),
    ShapeLaws.same_extents(Norm.last_of(head <> tail),[features],fits))

# The sums over the axes before the last keep [features].
def gradient_kept(+limits: Machine.Limits,+head: U32,+tail: List<&2,U32>,+features: U32,
  +rank_room: {Nat.is_le(1n+List.length(&2,U32,tail),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},
  +fits: {Shapes.same_extents(Norm.last_of(head <> tail),[features]) == True{} : Bool}) ->
  {Layout.extents_at(head <> tail,Reduce.kept_axes(head <> tail,Norm.before_last(1n+List.length(&2,U32,tail),0))) == [features] : List<&2,U32>}:
  +length = List.length(&2,U32,tail)
  %Equal.sym(List<&2,Nat>,Layout.naturals(Norm.before_last(1n+length,0)),Layout.every_index(length,0n),gradient_axes(limits,tail,rank_room)) :
    {Layout.extents_at(head <> tail,Layout.axes_where(1n+length,0n,_,False{})) == [features] : List<&2,U32>}
  %Equal.sym(List<&2,Nat>,Layout.axes_where(1n+length,0n,Layout.every_index(length,0n),False{}),[length],kept_every(length,0n,length,{==})) :
    {Layout.extents_at(head <> tail,_) == [features] : List<&2,U32>}
  last_features(head,tail,features,fits)

# ---- What the results hold ----

# The output xhat * gamma + beta, gamma and beta read through the view that
# stretches [features] to the shape: its context, reader and value.
def Output(~X: Data,~G: Data,~B: Data) -> Data:
  CombineLeaf.Context<ViewGather.Viewing<CombineLeaf.Context<ViewGather.Viewing<CombineLeaf.Context<ViewGather.Viewing<CombineLeaf.Context<ViewGather.Viewing<X>,ViewGather.Viewing<PiecesMap.Context<F32,PartialsValues.Box<Sum.Parts>>>>>,ViewGather.Viewing<PiecesMap.Context<F32,PiecesMap.Context<F32,PartialsValues.Box<Sum.Parts>>>>>>,ViewGather.Viewing<G>>>,ViewGather.Viewing<B>>

