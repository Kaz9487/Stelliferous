# ---- The window of an output cell ----

# The window of output cell index of cells [N,out_height,out_width,groups].
def output_cell(+taps: Window.Taps,+out_height: U32,+out_width: U32,+index: Nat) -> Values.Cell:
  Window.Taps{kernel,+stride,padding,height,width,+groups} = taps
  +position = Nat.div(index,U32.to_nat(groups))
  +row = Nat.div(position,U32.to_nat(out_width))
  Values.Cell{Nat.div(row,U32.to_nat(out_height)),Nat.mod(index,U32.to_nat(groups)),(U32.from_nat(Nat.mod(row,U32.to_nat(out_height))) * stride : U32),
    (U32.from_nat(Nat.mod(position,U32.to_nat(out_width))) * stride : U32)}

# A position moved by less than the rest of its row stays in the row.
def same_row(+position: Nat,+shift: Nat,+width: Nat,+positive: {Nat.is_lt(0n,width) == True{} : Bool},
  +inside: {Nat.is_lt(Nat.add(position,shift),Nat.mul(1n+Nat.div(position,width),width)) == True{} : Bool}) ->
  KernelGemm.Both<{Nat.div(Nat.add(position,shift),width) == Nat.div(position,width) : Nat},
    {Nat.mod(Nat.add(position,shift),width) == Nat.add(Nat.mod(position,width),shift) : Nat}>:
  +row = Nat.div(position,width)
  +rest = Nat.add(Nat.mod(position,width),shift)
  +split = Equal.trans(Nat,Nat.add(position,shift),Nat.add(Nat.add(Nat.mul(row,width),Nat.mod(position,width)),shift),Nat.add(Nat.mul(row,width),rest),
    Equal.cong(Nat,Nat,whole => Nat.add(whole,shift),position,Nat.add(Nat.mul(row,width),Nat.mod(position,width)),DivisionOrder.quotient_exact(position,width,positive)),
    Addition.associative(Nat.mul(row,width),Nat.mod(position,width),shift))
  +small = Order.cancel_offset_lt(Nat.mul(row,width),rest,width,
    %split : {Nat.is_lt(_,Nat.add(Nat.mul(row,width),width)) == True{} : Bool}
    %Order.commutative(width,Nat.mul(row,width)) : {Nat.is_lt(Nat.add(position,shift),_) == True{} : Bool}
    inside)
  +pair = Division.small(rest,width,small)
  KernelGemm.Both{
    Equal.trans(Nat,Nat.div(Nat.add(position,shift),width),Nat.div(Nat.add(Nat.mul(row,width),rest),width),row,
      Equal.cong(Nat,Nat,whole => Nat.div(whole,width),Nat.add(position,shift),Nat.add(Nat.mul(row,width),rest),split),
      Equal.trans(Nat,Nat.div(Nat.add(Nat.mul(row,width),rest),width),Nat.add(row,Nat.div(rest,width)),row,
        DivisionOrder.quotient_shift(rest,width,row,positive),
        Equal.trans(Nat,Nat.add(row,Nat.div(rest,width)),Nat.add(row,0n),row,
          Equal.cong(Nat,Nat,quotient => Nat.add(row,quotient),Nat.div(rest,width),0n,
            Equal.cong(Nat & Nat,Nat,divided => Pair.fst(Nat,Nat,divided),Nat.divmod(rest,width),(0n,rest),pair)),
          Addition.zero_right(row)))),
    Equal.trans(Nat,Nat.mod(Nat.add(position,shift),width),Nat.mod(Nat.add(Nat.mul(row,width),rest),width),rest,
      Equal.cong(Nat,Nat,whole => Nat.mod(whole,width),Nat.add(position,shift),Nat.add(Nat.mul(row,width),rest),split),
      Equal.trans(Nat,Nat.mod(Nat.add(Nat.mul(row,width),rest),width),Nat.mod(rest,width),rest,
        DivisionOrder.remainder_shift(rest,width,row,positive),
        Equal.cong(Nat & Nat,Nat,divided => Pair.snd(Nat,Nat,divided),Nat.divmod(rest,width),(0n,rest),pair)))}

# Where cell index of a segment from position lies among the output cells.
type Placed<-cell: Nat,-position: Nat,-groups: Nat,-width: Nat,-index: Nat> is Data:
  Placed{quotient: {Nat.div(cell,groups) == Nat.add(position,Nat.div(index,groups)) : Nat},remainder: {Nat.mod(cell,groups) == Nat.mod(index,groups) : Nat},
    row: {Nat.div(Nat.div(cell,groups),width) == Nat.div(position,width) : Nat},
    column: {Nat.mod(Nat.div(cell,groups),width) == Nat.add(Nat.mod(position,width),Nat.div(index,groups)) : Nat}}

def placed(+first: Nat,+position: Nat,+stop: Nat,+groups: Nat,+width: Nat,+index: Nat,+groups_positive: {Nat.is_lt(0n,groups) == True{} : Bool},
  +width_positive: {Nat.is_lt(0n,width) == True{} : Bool},+first_below: {Nat.is_le(first,Nat.mul(position,groups)) == True{} : Bool},
  +stop_row: {Nat.is_le(stop,Nat.mul(1n+Nat.div(position,width),width)) == True{} : Bool},
  +inside: {Nat.is_lt(index,Nat.mul(Nat.sub(stop,position),groups)) == True{} : Bool}) ->
  Placed<Nat.add(first,Nat.add(Nat.sub(Nat.mul(position,groups),first),index)),position,groups,width,index>:
  +cell = Nat.add(first,Nat.add(Nat.sub(Nat.mul(position,groups),first),index))
  +shift = Nat.div(index,groups)
  +flat = Equal.trans(Nat,cell,Nat.add(Nat.add(first,Nat.sub(Nat.mul(position,groups),first)),index),Nat.add(Nat.mul(position,groups),index),
    Equal.sym(Nat,Nat.add(Nat.add(first,Nat.sub(Nat.mul(position,groups),first)),index),cell,Addition.associative(first,Nat.sub(Nat.mul(position,groups),first),index)),
    Equal.cong(Nat,Nat,whole => Nat.add(whole,index),Nat.add(first,Nat.sub(Nat.mul(position,groups),first)),Nat.mul(position,groups),
      Order.restore_shift(first,Nat.mul(position,groups),first_below)))
  +quotient = Equal.trans(Nat,Nat.div(cell,groups),Nat.div(Nat.add(Nat.mul(position,groups),index),groups),Nat.add(position,shift),
    Equal.cong(Nat,Nat,whole => Nat.div(whole,groups),cell,Nat.add(Nat.mul(position,groups),index),flat),
    DivisionOrder.quotient_shift(index,groups,position,groups_positive))
  +below = DivisionOrder.quotient_below(index,Nat.sub(stop,position),groups,groups_positive,inside)
  +before = Order.difference_positive(position,stop,Order.le_lt_trans(0n,shift,Nat.sub(stop,position),Order.zero_le(shift),below))
  +ahead = Bounds.nat_trans(Nat.add(position,shift),stop,Nat.mul(1n+Nat.div(position,width),width),
    %Order.restore_shift(position,stop,Bounds.strict_le(position,stop,before)) :
      {Nat.is_lt(Nat.add(position,shift),_) == True{} : Bool}
    Order.offset_lt(position,shift,Nat.sub(stop,position),below),
    stop_row)
  +row = same_row(position,shift,width,width_positive,ahead)
  Placed{quotient,
    Equal.trans(Nat,Nat.mod(cell,groups),Nat.mod(Nat.add(Nat.mul(position,groups),index),groups),Nat.mod(index,groups),
      Equal.cong(Nat,Nat,whole => Nat.mod(whole,groups),cell,Nat.add(Nat.mul(position,groups),index),flat),
      DivisionOrder.remainder_shift(index,groups,position,groups_positive)),
    Equal.trans(Nat,Nat.div(Nat.div(cell,groups),width),Nat.div(Nat.add(position,shift),width),Nat.div(position,width),
      Equal.cong(Nat,Nat,whole => Nat.div(whole,width),Nat.div(cell,groups),Nat.add(position,shift),quotient),
      Shape.first({Nat.div(Nat.add(position,shift),width) == Nat.div(position,width) : Nat},
        {Nat.mod(Nat.add(position,shift),width) == Nat.add(Nat.mod(position,width),shift) : Nat},row)),
    Equal.trans(Nat,Nat.mod(Nat.div(cell,groups),width),Nat.mod(Nat.add(position,shift),width),Nat.add(Nat.mod(position,width),shift),
      Equal.cong(Nat,Nat,whole => Nat.mod(whole,width),Nat.div(cell,groups),Nat.add(position,shift),quotient),
      Shape.second({Nat.div(Nat.add(position,shift),width) == Nat.div(position,width) : Nat},
        {Nat.mod(Nat.add(position,shift),width) == Nat.add(Nat.mod(position,width),shift) : Nat},row))}

def word_quotient(+value: U32,+divisor: U32,+capacity: U32,+capacity_ok: {U32.is_le(capacity,2147483648) == True{} : Bool},
  +room: {Nat.is_le(Nat.double(U32.to_nat(divisor)),U32.to_nat(capacity)) == True{} : Bool},+positive: {Nat.is_lt(0n,U32.to_nat(divisor)) == True{} : Bool}) ->
  {U32.to_nat((value / U32.max(divisor,1) : U32)) == Nat.div(U32.to_nat(value),U32.to_nat(divisor)) : Nat}:
  %Equal.sym(U32,U32.max(divisor,1),divisor,AllocationDepth.positive_max(divisor,positive)) :
    {U32.to_nat((value / _ : U32)) == Nat.div(U32.to_nat(value),U32.to_nat(divisor)) : Nat}
  U32Division.divide(value,divisor,capacity,capacity_ok,room,positive)

def word_remainder(+value: U32,+divisor: U32,+capacity: U32,+capacity_ok: {U32.is_le(capacity,2147483648) == True{} : Bool},
  +room: {Nat.is_le(Nat.double(U32.to_nat(divisor)),U32.to_nat(capacity)) == True{} : Bool},+positive: {Nat.is_lt(0n,U32.to_nat(divisor)) == True{} : Bool}) ->
  {U32.to_nat((value % U32.max(divisor,1) : U32)) == Nat.mod(U32.to_nat(value),U32.to_nat(divisor)) : Nat}:
  %Equal.sym(U32,U32.max(divisor,1),divisor,AllocationDepth.positive_max(divisor,positive)) :
    {U32.to_nat((value % _ : U32)) == Nat.mod(U32.to_nat(value),U32.to_nat(divisor)) : Nat}
  U32Division.modulo(value,divisor,capacity,capacity_ok,room,positive)

# The extents of a window operation the words of its cells divide by.
type Divisors<-capacity: U32,-groups: U32,-out_height: U32,-out_width: U32> is Data:
  Divisors{capacity_ok: {U32.is_le(capacity,2147483648) == True{} : Bool},
    groups_room: {Nat.is_le(Nat.double(U32.to_nat(groups)),U32.to_nat(capacity)) == True{} : Bool},groups_positive: {Nat.is_lt(0n,U32.to_nat(groups)) == True{} : Bool},
    height_room: {Nat.is_le(Nat.double(U32.to_nat(out_height)),U32.to_nat(capacity)) == True{} : Bool},
    height_positive: {Nat.is_lt(0n,U32.to_nat(out_height)) == True{} : Bool},
    width_room: {Nat.is_le(Nat.double(U32.to_nat(out_width)),U32.to_nat(capacity)) == True{} : Bool},width_positive: {Nat.is_lt(0n,U32.to_nat(out_width)) == True{} : Bool}}

# Cell index of the segment from position is the window of its output cell.
def segment_cell(+kernel: U32,+stride: U32,+padding: U32,+height: U32,+width: U32,+groups: U32,+out_height: U32,+out_width: U32,+position: U32,+first: U32,+index: Nat,
  +capacity: U32,+divisors: Divisors<capacity,groups,out_height,out_width>,+index_room: {Nat.is_le(index,U32.to_nat(capacity)) == True{} : Bool},
  +facts: Placed<Nat.add(U32.to_nat(first),Nat.add(Nat.sub(Nat.mul(U32.to_nat(position),U32.to_nat(groups)),U32.to_nat(first)),index)),U32.to_nat(position),U32.to_nat(groups),
    U32.to_nat(out_width),index>) ->
  {Rows.cell_at(Window.Taps{kernel,stride,padding,height,width,groups},U32.to_nat((segment_row(position,out_width) / U32.max(out_height,1) : U32)),
      ((segment_row(position,out_width) % U32.max(out_height,1)) * stride : U32),((position % U32.max(out_width,1)) * stride : U32),U32.from_nat(index)) ==
    output_cell(Window.Taps{kernel,stride,padding,height,width,groups},out_height,out_width,
      Nat.add(U32.to_nat(first),Nat.add(Nat.sub(Nat.mul(U32.to_nat(position),U32.to_nat(groups)),U32.to_nat(first)),index))) : Values.Cell}:
  Divisors{+capacity_ok,+groups_room,+groups_positive,+height_room,+height_positive,+width_room,+width_positive} = divisors
  Placed{+quotient,+remainder,+row,+column} = facts
  +cell = Nat.add(U32.to_nat(first),Nat.add(Nat.sub(Nat.mul(U32.to_nat(position),U32.to_nat(groups)),U32.to_nat(first)),index))
  +g = U32.to_nat(groups)
  +w = U32.to_nat(out_width)
  +h = U32.to_nat(out_height)
  +line = segment_row(position,out_width)
  +line_exact = word_quotient(position,out_width,capacity,capacity_ok,width_room,width_positive)
  +index_exact = Bounds.roundtrip(index,capacity,capacity_ok,index_room)
  +image = Equal.trans(Nat,U32.to_nat((line / U32.max(out_height,1) : U32)),Nat.div(U32.to_nat(line),h),Nat.div(Nat.div(Nat.div(cell,g),w),h),
    word_quotient(line,out_height,capacity,capacity_ok,height_room,height_positive),
    Equal.cong(Nat,Nat,value => Nat.div(value,h),U32.to_nat(line),Nat.div(Nat.div(cell,g),w),
      Equal.trans(Nat,U32.to_nat(line),Nat.div(U32.to_nat(position),w),Nat.div(Nat.div(cell,g),w),line_exact,Equal.sym(Nat,Nat.div(Nat.div(cell,g),w),Nat.div(U32.to_nat(position),w),row))))
  +channel = Equal.trans(Nat,U32.to_nat((U32.from_nat(index) % U32.max(groups,1) : U32)),Nat.mod(U32.to_nat(U32.from_nat(index)),g),Nat.mod(cell,g),
    word_remainder(U32.from_nat(index),groups,capacity,capacity_ok,groups_room,groups_positive),
    Equal.trans(Nat,Nat.mod(U32.to_nat(U32.from_nat(index)),g),Nat.mod(index,g),Nat.mod(cell,g),
      Equal.cong(Nat,Nat,value => Nat.mod(value,g),U32.to_nat(U32.from_nat(index)),index,index_exact),Equal.sym(Nat,Nat.mod(cell,g),Nat.mod(index,g),remainder)))
  +top = Equal.cong(U32,U32,word => (word * stride : U32),(line % U32.max(out_height,1) : U32),U32.from_nat(Nat.mod(Nat.div(Nat.div(cell,g),w),h)),
    Equal.sym(U32,U32.from_nat(Nat.mod(Nat.div(Nat.div(cell,g),w),h)),(line % U32.max(out_height,1) : U32),
      Arithmetic.from_nat_exact((line % U32.max(out_height,1) : U32),Nat.mod(Nat.div(Nat.div(cell,g),w),h),
        Equal.trans(Nat,U32.to_nat((line % U32.max(out_height,1) : U32)),Nat.mod(U32.to_nat(line),h),Nat.mod(Nat.div(Nat.div(cell,g),w),h),
          word_remainder(line,out_height,capacity,capacity_ok,height_room,height_positive),
          Equal.cong(Nat,Nat,value => Nat.mod(value,h),U32.to_nat(line),Nat.div(Nat.div(cell,g),w),
            Equal.trans(Nat,U32.to_nat(line),Nat.div(U32.to_nat(position),w),Nat.div(Nat.div(cell,g),w),line_exact,
              Equal.sym(Nat,Nat.div(Nat.div(cell,g),w),Nat.div(U32.to_nat(position),w),row)))))))
  +across = (position % U32.max(out_width,1) : U32)
  +shift = (U32.from_nat(index) / U32.max(groups,1) : U32)
  +sum = Equal.trans(U32,(across + shift : U32),U32.from_nat(Nat.add(U32.to_nat(across),U32.to_nat(shift))),U32.from_nat(Nat.mod(Nat.div(cell,g),w)),
    Arithmetic.native_add(across,shift),
    Equal.cong(Nat,U32,U32.from_nat,Nat.add(U32.to_nat(across),U32.to_nat(shift)),Nat.mod(Nat.div(cell,g),w),
      Equal.trans(Nat,Nat.add(U32.to_nat(across),U32.to_nat(shift)),Nat.add(Nat.mod(U32.to_nat(position),w),Nat.div(index,g)),Nat.mod(Nat.div(cell,g),w),
        Equal.trans(Nat,Nat.add(U32.to_nat(across),U32.to_nat(shift)),Nat.add(Nat.mod(U32.to_nat(position),w),U32.to_nat(shift)),
          Nat.add(Nat.mod(U32.to_nat(position),w),Nat.div(index,g)),
          Equal.cong(Nat,Nat,value => Nat.add(value,U32.to_nat(shift)),U32.to_nat(across),Nat.mod(U32.to_nat(position),w),
            word_remainder(position,out_width,capacity,capacity_ok,width_room,width_positive)),
          Equal.cong(Nat,Nat,value => Nat.add(Nat.mod(U32.to_nat(position),w),value),U32.to_nat(shift),Nat.div(index,g),
            Equal.trans(Nat,U32.to_nat(shift),Nat.div(U32.to_nat(U32.from_nat(index)),g),Nat.div(index,g),
              word_quotient(U32.from_nat(index),groups,capacity,capacity_ok,groups_room,groups_positive),
              Equal.cong(Nat,Nat,value => Nat.div(value,g),U32.to_nat(U32.from_nat(index)),index,index_exact)))),
        Equal.sym(Nat,Nat.mod(Nat.div(cell,g),w),Nat.add(Nat.mod(U32.to_nat(position),w),Nat.div(index,g)),column))))
  +left = Equal.trans(U32,(across * stride + shift * stride : U32),((across + shift : U32) * stride : U32),(U32.from_nat(Nat.mod(Nat.div(cell,g),w)) * stride : U32),
    Equal.sym(U32,((across + shift : U32) * stride : U32),(across * stride + shift * stride : U32),Arithmetic.multiply_additive(across,shift,stride)),
    Equal.cong(U32,U32,word => (word * stride : U32),(across + shift : U32),U32.from_nat(Nat.mod(Nat.div(cell,g),w)),sum))
  %image : {Values.Cell{U32.to_nat((line / U32.max(out_height,1) : U32)),U32.to_nat((U32.from_nat(index) % U32.max(groups,1) : U32)),((line % U32.max(out_height,1)) * stride : U32),
      (across * stride + shift * stride : U32)} ==
    Values.Cell{_,Nat.mod(cell,g),(U32.from_nat(Nat.mod(Nat.div(Nat.div(cell,g),w),h)) * stride : U32),(U32.from_nat(Nat.mod(Nat.div(cell,g),w)) * stride : U32)} : Values.Cell}
  %channel : {Values.Cell{U32.to_nat((line / U32.max(out_height,1) : U32)),U32.to_nat((U32.from_nat(index) % U32.max(groups,1) : U32)),((line % U32.max(out_height,1)) * stride : U32),
      (across * stride + shift * stride : U32)} ==
    Values.Cell{U32.to_nat((line / U32.max(out_height,1) : U32)),_,(U32.from_nat(Nat.mod(Nat.div(Nat.div(cell,g),w),h)) * stride : U32),
      (U32.from_nat(Nat.mod(Nat.div(cell,g),w)) * stride : U32)} : Values.Cell}
  %top : {Values.Cell{U32.to_nat((line / U32.max(out_height,1) : U32)),U32.to_nat((U32.from_nat(index) % U32.max(groups,1) : U32)),((line % U32.max(out_height,1)) * stride : U32),
      (across * stride + shift * stride : U32)} ==
    Values.Cell{U32.to_nat((line / U32.max(out_height,1) : U32)),U32.to_nat((U32.from_nat(index) % U32.max(groups,1) : U32)),_,
      (U32.from_nat(Nat.mod(Nat.div(cell,g),w)) * stride : U32)} : Values.Cell}
  %left : {Values.Cell{U32.to_nat((line / U32.max(out_height,1) : U32)),U32.to_nat((U32.from_nat(index) % U32.max(groups,1) : U32)),((line % U32.max(out_height,1)) * stride : U32),
      (across * stride + shift * stride : U32)} ==
    Values.Cell{U32.to_nat((line / U32.max(out_height,1) : U32)),U32.to_nat((U32.from_nat(index) % U32.max(groups,1) : U32)),((line % U32.max(out_height,1)) * stride : U32),
      _} : Values.Cell}
  {==}

# ---- The words of a segment ----

# The position a segment stops at.
def stop_value(+position: U32,+end: U32,+out_width: U32) -> Nat:
  Nat.min(U32.to_nat(end),Nat.mul(1n+Nat.div(U32.to_nat(position),U32.to_nat(out_width)),U32.to_nat(out_width)))

# A segment stops after its position, by the end and by the end of its row.
def stop_ahead(+position: U32,+end: U32,+out_width: U32,+positive: {Nat.is_lt(0n,U32.to_nat(out_width)) == True{} : Bool},+more: {U32.is_lt(position,end) == True{} : Bool}) ->
  {Nat.is_lt(U32.to_nat(position),stop_value(position,end,out_width)) == True{} : Bool}:
  +p = U32.to_nat(position)
  +w = U32.to_nat(out_width)
  Extrema.minimum_strict_lower(U32.to_nat(end),Nat.mul(1n+Nat.div(p,w),w),p,Bounds.as_nat_lt(position,end,more),DivisionOrder.next_above(p,w,positive))

def stop_end(+position: U32,+end: U32,+out_width: U32) -> {Nat.is_le(stop_value(position,end,out_width),U32.to_nat(end)) == True{} : Bool}:
  Extrema.minimum_left(U32.to_nat(end),Nat.mul(1n+Nat.div(U32.to_nat(position),U32.to_nat(out_width)),U32.to_nat(out_width)))

def stop_row(+position: U32,+end: U32,+out_width: U32) ->
  {Nat.is_le(stop_value(position,end,out_width),Nat.mul(1n+Nat.div(U32.to_nat(position),U32.to_nat(out_width)),U32.to_nat(out_width))) == True{} : Bool}:
  Extrema.minimum_right(U32.to_nat(end),Nat.mul(1n+Nat.div(U32.to_nat(position),U32.to_nat(out_width)),U32.to_nat(out_width)))

# The positions of a piece fit the words: its first cell lies before its
# position, and its cells and a row past its end fit the bound.
type Positions<-bound: U32,-position: U32,-end: U32,-first: U32,-groups: U32,-out_width: U32> is Data:
  Positions{first_below: {Nat.is_le(U32.to_nat(first),Nat.mul(U32.to_nat(position),U32.to_nat(groups))) == True{} : Bool},
    end_room: {Nat.is_le(Nat.add(U32.to_nat(out_width),U32.to_nat(end)),U32.to_nat(bound)) == True{} : Bool},
    cells_room: {Nat.is_le(Nat.mul(U32.to_nat(end),U32.to_nat(groups)),U32.to_nat(bound)) == True{} : Bool}}

# The word of the position a segment stops at.
def stop_exact(+position: U32,+end: U32,+out_width: U32,+bound: U32,+bound_ok: {U32.is_le(bound,2147483648) == True{} : Bool},
  +width_room: {Nat.is_le(Nat.double(U32.to_nat(out_width)),U32.to_nat(bound)) == True{} : Bool},+width_positive: {Nat.is_lt(0n,U32.to_nat(out_width)) == True{} : Bool},
  +end_room: {Nat.is_le(Nat.add(U32.to_nat(out_width),U32.to_nat(end)),U32.to_nat(bound)) == True{} : Bool},+more: {U32.is_lt(position,end) == True{} : Bool}) ->
  {U32.to_nat(segment_stop(position,end,out_width)) == stop_value(position,end,out_width) : Nat}:
  +w = U32.to_nat(out_width)
  +p = U32.to_nat(position)
  +line = segment_row(position,out_width)
  +next = {1n+Nat.div(p,w) : Nat}
  +row_room = Order.transitive(Nat.add(w,Nat.mul(Nat.div(p,w),w)),Nat.add(w,U32.to_nat(end)),U32.to_nat(bound),
    Order.transitive(Nat.add(w,Nat.mul(Nat.div(p,w),w)),Nat.add(w,p),Nat.add(w,U32.to_nat(end)),
      Order.offset_le(w,Nat.mul(Nat.div(p,w),w),p,DivisionOrder.product_below(p,w,width_positive)),
      Order.offset_le(w,p,U32.to_nat(end),Bounds.strict_le(p,U32.to_nat(end),Bounds.as_nat_lt(position,end,more)))),
    end_room)
  +next_room = Order.transitive(next,Nat.mul(next,w),U32.to_nat(bound),
    %RowMajor.multiply_commutative(w,next) : {Nat.is_le(next,_) == True{} : Bool}
    DivisionOrder.le_multiple(w,next,width_positive),row_room)
  +next_exact = Equal.trans(Nat,U32.to_nat((line + 1 : U32)),Nat.add(Nat.div(p,w),1n),next,
    Arithmetic.sum_exact(bound,bound_ok,line,1,Nat.div(p,w),1n,word_quotient(position,out_width,bound,bound_ok,width_room,width_positive),{==},
      %Equal.sym(Nat,Nat.add(Nat.div(p,w),1n),next,Addition.successor_width(Nat.div(p,w))) : {Nat.is_le(_,U32.to_nat(bound)) == True{} : Bool} next_room),
    Addition.successor_width(Nat.div(p,w)))
  Equal.trans(Nat,U32.to_nat(segment_stop(position,end,out_width)),Nat.min(U32.to_nat(end),U32.to_nat(((line + 1) * out_width : U32))),stop_value(position,end,out_width),
    U32Extrema.minimum(end,((line + 1) * out_width : U32)),
    Equal.cong(Nat,Nat,row_end => Nat.min(U32.to_nat(end),row_end),U32.to_nat(((line + 1) * out_width : U32)),Nat.mul(next,w),
      Arithmetic.product_exact(bound,bound_ok,(line + 1 : U32),out_width,next,w,next_exact,{==},row_room)))

# The first cell of a segment as a word.
def start_exact(+position: U32,+end: U32,+first: U32,+groups: U32,+bound: U32,+bound_ok: {U32.is_le(bound,2147483648) == True{} : Bool},
  +first_below: {Nat.is_le(U32.to_nat(first),Nat.mul(U32.to_nat(position),U32.to_nat(groups))) == True{} : Bool},
  +cells_room: {Nat.is_le(Nat.mul(U32.to_nat(end),U32.to_nat(groups)),U32.to_nat(bound)) == True{} : Bool},
  +before: {Nat.is_le(U32.to_nat(position),U32.to_nat(end)) == True{} : Bool}) ->
  {U32.to_nat((position * groups - first : U32)) == Nat.sub(Nat.mul(U32.to_nat(position),U32.to_nat(groups)),U32.to_nat(first)) : Nat}:
  +cells = Nat.mul(U32.to_nat(position),U32.to_nat(groups))
  +room = Order.transitive(cells,Nat.mul(U32.to_nat(end),U32.to_nat(groups)),U32.to_nat(bound),RowMajor.mul_le(U32.to_nat(position),U32.to_nat(end),U32.to_nat(groups),before),cells_room)
  Arithmetic.difference_exact(bound,bound_ok,(position * groups : U32),first,cells,U32.to_nat(first),
    Arithmetic.product_exact(bound,bound_ok,position,groups,U32.to_nat(position),U32.to_nat(groups),{==},{==},room),{==},first_below,room)

# The cells of a segment as a word.
def count_exact(+position: U32,+end: U32,+groups: U32,+out_width: U32,+bound: U32,+bound_ok: {U32.is_le(bound,2147483648) == True{} : Bool},
  +width_room: {Nat.is_le(Nat.double(U32.to_nat(out_width)),U32.to_nat(bound)) == True{} : Bool},+width_positive: {Nat.is_lt(0n,U32.to_nat(out_width)) == True{} : Bool},
  +end_room: {Nat.is_le(Nat.add(U32.to_nat(out_width),U32.to_nat(end)),U32.to_nat(bound)) == True{} : Bool},
  +cells_room: {Nat.is_le(Nat.mul(U32.to_nat(end),U32.to_nat(groups)),U32.to_nat(bound)) == True{} : Bool},+more: {U32.is_lt(position,end) == True{} : Bool}) ->
  {U32.to_nat(((segment_stop(position,end,out_width) - position) * groups : U32)) ==
    Nat.mul(Nat.sub(stop_value(position,end,out_width),U32.to_nat(position)),U32.to_nat(groups)) : Nat}:
  +stop = stop_value(position,end,out_width)
  +p = U32.to_nat(position)
  +span = Nat.sub(stop,p)
  +span_room = Order.transitive(Nat.mul(span,U32.to_nat(groups)),Nat.mul(U32.to_nat(end),U32.to_nat(groups)),U32.to_nat(bound),
    RowMajor.mul_le(span,U32.to_nat(end),U32.to_nat(groups),Order.transitive(span,stop,U32.to_nat(end),Order.sub_le(stop,p),stop_end(position,end,out_width))),cells_room)
  +end_bound = Order.transitive(U32.to_nat(end),Nat.add(U32.to_nat(out_width),U32.to_nat(end)),U32.to_nat(bound),Order.right_le(U32.to_nat(out_width),U32.to_nat(end)),end_room)
  Arithmetic.product_exact(bound,bound_ok,(segment_stop(position,end,out_width) - position : U32),groups,span,U32.to_nat(groups),
    Arithmetic.difference_exact(bound,bound_ok,segment_stop(position,end,out_width),position,stop,p,
      stop_exact(position,end,out_width,bound,bound_ok,width_room,width_positive,end_room,more),{==},
      Bounds.strict_le(p,stop,stop_ahead(position,end,out_width,width_positive,more)),
      Order.transitive(stop,U32.to_nat(end),U32.to_nat(bound),stop_end(position,end,out_width),end_bound)),
    {==},span_room)

# Cells first to low, then low to high, make first to high.
def span(+first: Nat,+low: Nat,+high: Nat,+first_below: {Nat.is_le(first,low) == True{} : Bool},+ordered: {Nat.is_le(low,high) == True{} : Bool}) ->
  {Nat.add(Nat.sub(low,first),Nat.sub(high,low)) == Nat.sub(high,first) : Nat}:
  +rest = Nat.sub(high,low)
  Equal.sym(Nat,Nat.sub(high,first),Nat.add(Nat.sub(low,first),rest),
    Equal.trans(Nat,Nat.sub(high,first),Nat.sub(Nat.add(rest,low),first),Nat.add(Nat.sub(low,first),rest),
      Equal.cong(Nat,Nat,whole => Nat.sub(whole,first),high,Nat.add(rest,low),
        Equal.trans(Nat,high,Nat.add(low,rest),Nat.add(rest,low),Equal.sym(Nat,Nat.add(low,rest),high,Order.restore_shift(low,high,ordered)),Order.commutative(low,rest))),
      Equal.trans(Nat,Nat.sub(Nat.add(rest,low),first),Nat.add(rest,Nat.sub(low,first)),Nat.add(Nat.sub(low,first),rest),
        Order.subtract_from_sum(rest,low,first,first_below),Order.commutative(rest,Nat.sub(low,first)))))

# A segment covers the cells of the piece up to the cells of its stop.
def segment_end(+position: U32,+end: U32,+first: U32,+groups: U32,+out_width: U32,+bound: U32,+bound_ok: {U32.is_le(bound,2147483648) == True{} : Bool},
  +width_room: {Nat.is_le(Nat.double(U32.to_nat(out_width)),U32.to_nat(bound)) == True{} : Bool},+width_positive: {Nat.is_lt(0n,U32.to_nat(out_width)) == True{} : Bool},
  +first_below: {Nat.is_le(U32.to_nat(first),Nat.mul(U32.to_nat(position),U32.to_nat(groups))) == True{} : Bool},
