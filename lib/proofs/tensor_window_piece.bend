# ---- The bias of a piece ----

# The bias tile of a cell of a piece whose first cell begins a group.
def bias_tap(weights: Rows.Weights,unit: Unit,cell: U32) -> Tile.Tile8:
  Rows.Weights{tree,+kernel,+groups} = weights
  Tree.read(Tile.Tile8,tree,(groups * kernel * kernel + cell % U32.max(groups,1) : U32))

# The parameters and an output after a loop over the output.
type PairModel<-pair: Storage.Buffer<Tile.Tile8> & Storage.Buffer<Tile.Tile8>,-parameters: Buffer.Model<Tile.Tile8>,-tree: Tree.Tree<Tile.Tile8>,-length: Nat> is Data:
  PairModel{output: Buffer.Model<Tile.Tile8>,packed: {pair == (Buffer.pack(~Tile.Tile8,parameters),Buffer.pack(~Tile.Tile8,output)) : Storage.Buffer<Tile.Tile8> & Storage.Buffer<Tile.Tile8>},
    tree: {Buffer.tree(~Tile.Tile8,output) == tree : Tree.Tree<Tile.Tile8>},length: {Buffer.length(~Tile.Tile8,output) == length : Nat}}

def pair_moved(-left: Storage.Buffer<Tile.Tile8> & Storage.Buffer<Tile.Tile8>,-right: Storage.Buffer<Tile.Tile8> & Storage.Buffer<Tile.Tile8>,+parameters: Buffer.Model<Tile.Tile8>,-left_tree: Tree.Tree<Tile.Tile8>,-right_tree: Tree.Tree<Tile.Tile8>,-left_length: Nat,
  -right_length: Nat,model: PairModel<right,parameters,right_tree,right_length>,+same: {left == right : Storage.Buffer<Tile.Tile8> & Storage.Buffer<Tile.Tile8>},
  +tree_same: {right_tree == left_tree : Tree.Tree<Tile.Tile8>},+length_same: {right_length == left_length : Nat}) -> PairModel<left,parameters,left_tree,left_length>:
  PairModel{+output,+packed,+tree,+length} = model
  PairModel{output,Equal.trans(Storage.Buffer<Tile.Tile8> & Storage.Buffer<Tile.Tile8>,left,right,(Buffer.pack(~Tile.Tile8,parameters),Buffer.pack(~Tile.Tile8,output)),same,packed),
    Equal.trans(Tree.Tree<Tile.Tile8>,Buffer.tree(~Tile.Tile8,output),right_tree,left_tree,tree,tree_same),
    Equal.trans(Nat,Buffer.length(~Tile.Tile8,output),right_length,left_length,length,length_same)}

# Weighting adds to every cell from cell on the bias tile of its group.
def biased_model(fuel: Nat,+cell: U32,+groups: U32,+kernel: U32,+parameters: Buffer.Model<Tile.Tile8>,+output: Buffer.Model<Tile.Tile8>) ->
  PairModel<Window.biased(fuel,cell,groups,(groups * kernel * kernel : U32),(Buffer.pack(~Tile.Tile8,parameters),Buffer.pack(~Tile.Tile8,output))),parameters,Updates.updated(~Tile.Tile8,~Rows.Weights,~Tile.Tile8,~bias_tap,~Tile.plus,fuel,cell,Rows.Weights{Buffer.tree(~Tile.Tile8,parameters),kernel,groups},Buffer.tree(~Tile.Tile8,output)),Buffer.length(~Tile.Tile8,output)>:
  match fuel:
    case 0n: PairModel{output,{==},{==},{==}}
    case 1n+ +rest:
      +bias = (groups * kernel * kernel : U32)
      +index = (bias + cell % U32.max(groups,1) : U32)
      +value = Tree.read(Tile.Tile8,Buffer.tree(~Tile.Tile8,parameters),index)
      +old = Tree.read(Tile.Tile8,Buffer.tree(~Tile.Tile8,output),cell)
      +fresh = Tile.plus(old,value)
      +next = Rows.written_buffer(~Tile.Tile8,cell,fresh,output)
      +reader = {Rows.Weights{Buffer.tree(~Tile.Tile8,parameters),kernel,groups} : Rows.Weights}
      pair_moved(Window.biased(1n+rest,cell,groups,(groups * kernel * kernel : U32),(Buffer.pack(~Tile.Tile8,parameters),Buffer.pack(~Tile.Tile8,output))),Window.biased(rest,(cell + 1 : U32),groups,(groups * kernel * kernel : U32),(Buffer.pack(~Tile.Tile8,parameters),Buffer.pack(~Tile.Tile8,next))),parameters,Updates.updated(~Tile.Tile8,~Rows.Weights,~Tile.Tile8,~bias_tap,~Tile.plus,1n+rest,cell,Rows.Weights{Buffer.tree(~Tile.Tile8,parameters),kernel,groups},Buffer.tree(~Tile.Tile8,output)),Updates.updated(~Tile.Tile8,~Rows.Weights,~Tile.Tile8,~bias_tap,~Tile.plus,rest,(cell + 1 : U32),Rows.Weights{Buffer.tree(~Tile.Tile8,parameters),kernel,groups},Buffer.tree(~Tile.Tile8,next)),Buffer.length(~Tile.Tile8,output),Buffer.length(~Tile.Tile8,next),
        biased_model(rest,(cell + 1 : U32),groups,kernel,parameters,next),
        Equal.trans(Storage.Buffer<Tile.Tile8> & Storage.Buffer<Tile.Tile8>,Window.biased(1n+rest,cell,groups,(groups * kernel * kernel : U32),(Buffer.pack(~Tile.Tile8,parameters),Buffer.pack(~Tile.Tile8,output))),Window.biased(rest,(cell + 1 : U32),groups,(groups * kernel * kernel : U32),(Buffer.pack(~Tile.Tile8,parameters),Storage.write(~Tile.Tile8,cell,fresh,Buffer.pack(~Tile.Tile8,output)))),Window.biased(rest,(cell + 1 : U32),groups,(groups * kernel * kernel : U32),(Buffer.pack(~Tile.Tile8,parameters),Buffer.pack(~Tile.Tile8,next))),
          Equal.trans(Storage.Buffer<Tile.Tile8> & Storage.Buffer<Tile.Tile8>,Window.biased(1n+rest,cell,groups,(groups * kernel * kernel : U32),(Buffer.pack(~Tile.Tile8,parameters),Buffer.pack(~Tile.Tile8,output))),Window.biased(rest,(cell + 1 : U32),groups,(groups * kernel * kernel : U32),(Buffer.pack(~Tile.Tile8,parameters),Window.sum_biased(cell,value,Storage.read(~Tile.Tile8,Buffer.pack(~Tile.Tile8,output),cell)))),Window.biased(rest,(cell + 1 : U32),groups,(groups * kernel * kernel : U32),(Buffer.pack(~Tile.Tile8,parameters),Storage.write(~Tile.Tile8,cell,fresh,Buffer.pack(~Tile.Tile8,output)))),
            Equal.cong(Storage.Buffer<Tile.Tile8> & Tile.Tile8,Storage.Buffer<Tile.Tile8> & Storage.Buffer<Tile.Tile8>,read => Window.biased(rest,(cell + 1 : U32),groups,(groups * kernel * kernel : U32),Window.bias_read(cell,read,Buffer.pack(~Tile.Tile8,output))),
              Storage.read(~Tile.Tile8,Buffer.pack(~Tile.Tile8,parameters),index),(Buffer.pack(~Tile.Tile8,parameters),value),Buffer.read(~Tile.Tile8,parameters,index)),
            Equal.cong(Storage.Buffer<Tile.Tile8> & Tile.Tile8,Storage.Buffer<Tile.Tile8> & Storage.Buffer<Tile.Tile8>,read => Window.biased(rest,(cell + 1 : U32),groups,(groups * kernel * kernel : U32),(Buffer.pack(~Tile.Tile8,parameters),Window.sum_biased(cell,value,read))),
              Storage.read(~Tile.Tile8,Buffer.pack(~Tile.Tile8,output),cell),(Buffer.pack(~Tile.Tile8,output),old),Buffer.read(~Tile.Tile8,output,cell))),
