# The output piece of a window task: the segments of its output rows, one
# kernel row at a time, then the bias of weighting. Every cell of the piece
# takes the value of its window over the input the task holds.
import Base
import ../kernel_tile.bend as Tile
import ../kernel_gemm.bend as KernelGemm
import ../storage_buffer.bend as Storage
import ../tensor_window.bend as Window
import ./tensor_window_values.bend as Values
import ./tensor_window_rows.bend as Rows
import ./storage_tree_model.bend as Tree
import ./storage_buffer_model.bend as Buffer
import ./tensor_move_readback.bend as Held
import ./boolean_logic.bend as Boolean
import ./bounded_u32_arithmetic.bend as Arithmetic
import ../tensor_grid.bend as Grid
import ./tensor_allocation_depth.bend as AllocationDepth
import ./u32_division.bend as U32Division
import ./storage_shape.bend as Shape
import ./nat_division_order.bend as DivisionOrder
import ./nat_division.bend as Division
import ./natural_addition.bend as Addition
import ./nat_order.bend as Order
import ./nat_to_u32_bounds.bend as Bounds
import ./nat_extrema.bend as Extrema
import ./u32_extrema.bend as U32Extrema
import ./row_major_index.bend as RowMajor
import ./u32_comparison.bend as Comparison
import ./nat_interval.bend as Interval
import ../tensor_tiled_map.bend as TiledMap
import ../traversal_partition.bend as Partition
import ./tensor_pieces_combine_leaf.bend as Updates
import ../tensor.bend as Tensors
import ./tensor_grid_ranges.bend as GridRanges

# ---- The segments of a piece ----

# The output row of a position and the position its segment stops at.
def segment_row(+position: U32,+out_width: U32) -> U32:
  (position / U32.max(out_width,1) : U32)

def segment_stop(+position: U32,+end: U32,+out_width: U32) -> U32:
  U32.min(end,((segment_row(position,out_width) + 1) * out_width : U32))

# The input rows the segments from position on read lie in the holding.
def SegmentsRoom(fuel: Nat,more: Bool,+position: U32,+end: U32,+first: U32,+low: Nat,+high: Nat,+capacity: U32,+kernel: U32,+stride: U32,+padding: U32,+height: U32,
  +width: U32,+groups: U32,+out_height: U32,+out_width: U32) -> Data:
  match fuel more:
    case 0n more: Unit
    case 1n+rest False{}: Unit
    case 1n+rest True{}:
      KernelGemm.Both<Rows.RowsRoom(U32.to_nat(kernel),0,low,high,capacity,(segment_row(position,out_width) / U32.max(out_height,1) : U32),height,((segment_row(position,out_width) % U32.max(out_height,1)) * stride : U32),padding,width,groups),
        SegmentsRoom(rest,U32.is_lt(segment_stop(position,end,out_width),end),segment_stop(position,end,out_width),end,first,low,high,capacity,kernel,stride,padding,height,width,groups,out_height,out_width)>

# The tree of the output after the segments from position on.
def segments_tree(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,~operation: Tile.Tile8 -> Tile.Tile8 -> Tile.Tile8,fuel: Nat,more: Bool,+position: U32,+end: U32,+first: U32,+holder: Holder,+kind: Window.Sampling,
  +kernel: U32,+stride: U32,+padding: U32,+height: U32,+width: U32,+groups: U32,+out_height: U32,+out_width: U32,+weights: Tree.Tree<Tile.Tile8>,tree: Tree.Tree<Tile.Tile8>) ->
  Tree.Tree<Tile.Tile8>:
  match fuel more:
    case 0n more: tree
    case 1n+rest False{}: tree
    case 1n+rest True{}:
      segments_tree(~Holder,~value,~operation,rest,U32.is_lt(segment_stop(position,end,out_width),end),segment_stop(position,end,out_width),end,first,holder,kind,kernel,stride,padding,height,width,groups,out_height,out_width,weights,
        Rows.rows_tree(~Holder,~value,~operation,U32.to_nat(kernel),0,holder,kind,kernel,stride,padding,height,width,groups,(position * groups - first : U32),((segment_stop(position,end,out_width) - position) * groups : U32),(segment_row(position,out_width) / U32.max(out_height,1) : U32),((segment_row(position,out_width) % U32.max(out_height,1)) * stride : U32),((position % U32.max(out_width,1)) * stride : U32),weights,tree))

# The segments from position on, in order.
def segments_model(~Holder: Data,~value: Holder -> U32 -> Tile.Tile8,~operation: Tile.Tile8 -> Tile.Tile8 -> Tile.Tile8,fuel: Nat,more: Bool,+position: U32,+end: U32,+first: U32,+holder: Holder,
  +holding: Held.Holding<Tile.Tile8>,+low: Nat,+high: Nat,+capacity: U32,+capacity_ok: {U32.is_le(capacity,2147483648) == True{} : Bool},
  +bounded: {Nat.is_le(high,U32.to_nat(capacity)) == True{} : Bool},+tiled: Held.Tiled(~Tile.Tile8,holding,low,high),
  +values: Held.HoldingValues(~Tile.Tile8,~Holder,~value,holder,holding),+layout: Held.Spans,+ordered: {Held.spans(~Tile.Tile8,Held.order(~Tile.Tile8,holding)) == layout : Held.Spans},
  +kind: Window.Sampling,+kernel: U32,+stride: U32,+padding: U32,+height: U32,+width: U32,+groups: U32,+lanes: U32,+out_height: U32,+out_width: U32,+grid: Grid.Grid,
  +parameters: Buffer.Model<Tile.Tile8>,+output: Buffer.Model<Tile.Tile8>,
  +groups_room: {Nat.is_le(Nat.double(U32.to_nat(groups)),U32.to_nat(capacity)) == True{} : Bool},+groups_positive: {Nat.is_lt(0n,U32.to_nat(groups)) == True{} : Bool},
  rooms: SegmentsRoom(fuel,more,position,end,first,low,high,capacity,kernel,stride,padding,height,width,groups,out_height,out_width)) ->
  Rows.RowedModel<Holder,value,holder,Window.segments(~operation,fuel,more,position,end,first,Window.Windowing{kind,Window.Taps{kernel,stride,padding,height,width,groups},lanes,out_height,out_width,grid},Window.Rowed{Held.pack(~Tile.Tile8,holding),Buffer.pack(~Tile.Tile8,parameters),Buffer.pack(~Tile.Tile8,output)}),low,high,layout,parameters,segments_tree(~Holder,~value,~operation,fuel,more,position,end,first,holder,kind,kernel,stride,padding,height,width,groups,out_height,out_width,Buffer.tree(~Tile.Tile8,parameters),Buffer.tree(~Tile.Tile8,output)),Buffer.length(~Tile.Tile8,output)>:
  match fuel more:
    case 0n more: Rows.RowedModel{holding,output,{==},tiled,values,ordered,{==},{==}}
    case 1n+rest False{}: Rows.RowedModel{holding,output,{==},tiled,values,ordered,{==},{==}}
    case 1n+ +rest True{}:
      KernelGemm.Both{+rows_room,+later} = rooms
      +first_rows = Rows.rows_model(~Holder,~value,~operation,U32.to_nat(kernel),0,holder,holding,low,high,capacity,capacity_ok,bounded,tiled,values,layout,ordered,kind,kernel,
        stride,padding,height,width,groups,(position * groups - first : U32),((segment_stop(position,end,out_width) - position) * groups : U32),(segment_row(position,out_width) / U32.max(out_height,1) : U32),((segment_row(position,out_width) % U32.max(out_height,1)) * stride : U32),((position % U32.max(out_width,1)) * stride : U32),parameters,output,groups_room,groups_positive,rows_room)
      +next = segments_model(~Holder,~value,~operation,rest,U32.is_lt(segment_stop(position,end,out_width),end),segment_stop(position,end,out_width),end,first,holder,Rows.rowed_holding(~Holder,~value,holder,Window.kernel_rows(~operation,U32.to_nat(kernel),0,kind,Window.Taps{kernel,stride,padding,height,width,groups},Window.Segment{(position * groups - first : U32),((segment_stop(position,end,out_width) - position) * groups : U32),(segment_row(position,out_width) / U32.max(out_height,1) : U32),((segment_row(position,out_width) % U32.max(out_height,1)) * stride : U32),((position % U32.max(out_width,1)) * stride : U32)},Window.Rowed{Held.pack(~Tile.Tile8,holding),Buffer.pack(~Tile.Tile8,parameters),Buffer.pack(~Tile.Tile8,output)}),low,high,layout,parameters,Rows.rows_tree(~Holder,~value,~operation,U32.to_nat(kernel),0,holder,kind,kernel,stride,padding,height,width,groups,(position * groups - first : U32),((segment_stop(position,end,out_width) - position) * groups : U32),(segment_row(position,out_width) / U32.max(out_height,1) : U32),((segment_row(position,out_width) % U32.max(out_height,1)) * stride : U32),((position % U32.max(out_width,1)) * stride : U32),Buffer.tree(~Tile.Tile8,parameters),Buffer.tree(~Tile.Tile8,output)),Buffer.length(~Tile.Tile8,output),first_rows),low,high,capacity,capacity_ok,bounded,Rows.rowed_tiled(~Holder,~value,holder,Window.kernel_rows(~operation,U32.to_nat(kernel),0,kind,Window.Taps{kernel,stride,padding,height,width,groups},Window.Segment{(position * groups - first : U32),((segment_stop(position,end,out_width) - position) * groups : U32),(segment_row(position,out_width) / U32.max(out_height,1) : U32),((segment_row(position,out_width) % U32.max(out_height,1)) * stride : U32),((position % U32.max(out_width,1)) * stride : U32)},Window.Rowed{Held.pack(~Tile.Tile8,holding),Buffer.pack(~Tile.Tile8,parameters),Buffer.pack(~Tile.Tile8,output)}),low,high,layout,parameters,Rows.rows_tree(~Holder,~value,~operation,U32.to_nat(kernel),0,holder,kind,ke