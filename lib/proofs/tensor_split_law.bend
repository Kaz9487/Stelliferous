# ---- A target piece cell by cell or run by run ----

def facts_shape(~Context: Data,~value: Context -> U32 -> Tile.Tile8,+context: Context,+stack: Held.Stack<Tile.Tile8>,+depth: Nat,+count: U32,+query: U32,
  +holding: Held.Holding<Tile.Tile8>,+output: Buffer.Model<Tile.Tile8>,+expected: Tile.Tile8,
  +facts: Gather.CellsFacts<Context,value,context,stack,depth,count,query,holding,output,expected>) -> Merge.OutputShape<depth,count,output>:
  Gather.CellsFacts{+kept,+shape,+read} = facts
  shape

def facts_read(~Context: Data,~value: Context -> U32 -> Tile.Tile8,+context: Context,+stack: Held.Stack<Tile.Tile8>,+depth: Nat,+count: U32,+query: U32,
  +holding: Held.Holding<Tile.Tile8>,+output: Buffer.Model<Tile.Tile8>,+expected: Tile.Tile8,
  +facts: Gather.CellsFacts<Context,value,context,stack,depth,count,query,holding,output,expected>) ->
  {Tree.read(Tile.Tile8,Buffer.tree(~Tile.Tile8,output),query) == expected : Tile.Tile8}:
  Gather.CellsFacts{+kept,+shape,+read} = facts
  read

def kept_ordered(~Context: Data,~value: Context -> U32 -> Tile.Tile8,+context: Context,+stack: Held.Stack<Tile.Tile8>,+holding: Held.Holding<Tile.Tile8>,
  +kept: Merge.PartKept<Context,value,context,stack,holding>) -> {Held.order(~Tile.Tile8,holding) == stack : Held.Stack<Tile.Tile8>}:
  Merge.PartKept{+ordered,+values} = kept
  ordered

# The cells of a piece of the target cells fit the machine.
def count_capacity(+limits: Machine.Limits,+width: U32,+target_outer: U32,+first: U32,+count: U32,+cells_room: {Nat.is_le(Nat.mul(U32.to_nat(Tiled.groups(width)),U32.to_nat(target_outer)),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},+piece_room: {Nat.is_le(Nat.add(U32.to_nat(first),U32.to_nat(count)),Nat.mul(U32.to_nat(Tiled.groups(width)),U32.to_nat(target_outer))) == True{} : Bool}) ->
  {Nat.is_le(U32.to_nat(count),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}:
  +cells = Nat.mul(U32.to_nat(Tiled.groups(width)),U32.to_nat(target_outer))
  Order.transitive(U32.to_nat(count),cells,U32.to_nat(Machine.capacity(limits)),
    Order.transitive(U32.to_nat(count),Nat.add(U32.to_nat(first),U32.to_nat(count)),cells,Order.right_le(U32.to_nat(first),U32.to_nat(count)),piece_room),cells_room)

