# ---- The shapes of the values ----

def counted_cells(+shape: List<&2,U32>,+counted: Global.Counted<shape>) -> {U32.to_nat(Tensors.count_or_zero(shape)) == ShapeLaws.elements(shape) : Nat}:
  Global.Counted{+count,+accepted} = counted
  ViewMoved.counted_cells(shape,count,accepted)

# The target cells, with the lanes on the axis, fit the machine.
def target_shape(+limits: Machine.Limits,+values: List<&2,U32>,+axis: Nat,+position: Grid.Position,+within: {Nat.is_lt(axis,List.length(&2,U32,values)) == True{} : Bool},
  +room: {Nat.is_le(ShapeLaws.elements(Tiled.cell_shape(values,axis,position)),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},+positive: {Nat.is_lt(0n,ShapeLaws.elements(Tiled.cell_shape(values,axis,position))) == True{} : Bool},+rank_room: {Nat.is_le(List.length(&2,U32,Tiled.cell_shape(values,axis,position)),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}) ->
  Components.ShapeOk(limits,Grid.placed(True{},position,Grid.removed(values,axis),Grid.groups(Grid.lanes_at(values,axis)))):
  %within : Components.ShapeOk(limits,Grid.placed(_,position,Grid.removed(values,axis),Grid.groups(Grid.lanes_at(values,axis))))
  {Held.Both{room,Held.Both{positive,rank_room}} : Components.ShapeOk(limits,Tiled.cell_shape(values,axis,position))}

# The part cells, with the lanes on the axis and the other extents of the
# target, fit the machine.
def part_shape(+limits: Machine.Limits,+values: List<&2,U32>,+part_values: List<&2,U32>,+axis: Nat,+position: Grid.Position,
  +part_within: {Nat.is_lt(axis,List.length(&2,U32,part_values)) == True{} : Bool},+removed_same: {Grid.removed(part_values,axis) == Grid.removed(values,axis) : List<&2,U32>},
  +room: {Nat.is_le(ShapeLaws.elements(Tiled.cell_shape(part_values,axis,position)),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},+positive: {Nat.is_lt(0n,ShapeLaws.elements(Tiled.cell_shape(part_values,axis,position))) == True{} : Bool},+rank_room: {Nat.is_le(List.length(&2,U32,Tiled.cell_shape(part_values,axis,position)),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}) ->
  Components.ShapeOk(limits,Grid.placed(True{},position,Grid.removed(values,axis),Grid.groups(Grid.lanes_at(part_values,axis)))):
  %removed_same : Components.ShapeOk(limits,Grid.placed(True{},position,_,Grid.groups(Grid.lanes_at(part_values,axis))))
  %part_within : Components.ShapeOk(limits,Grid.placed(_,position,Grid.removed(part_values,axis),Grid.groups(Grid.lanes_at(part_values,axis))))
  {Held.Both{room,Held.Both{positive,rank_room}} : Components.ShapeOk(limits,Tiled.cell_shape(part_values,axis,position))}

# The other cells a target group holds: the target cells over its groups.
def count_exact(+limits: Machine.Limits,+values: List<&2,U32>,+axis: Nat,+position: Grid.Position,+within: {Nat.is_lt(axis,List.length(&2,U32,values)) == True{} : Bool},
  +counted: Global.Counted<Tiled.cell_shape(values,axis,position)>,+groups_positive: {Nat.is_lt(0n,U32.to_nat(Grid.groups(Grid.lanes_at(values,axis)))) == True{} : Bool},+groups_room: {Nat.is_le(U32.to_nat(Grid.groups(Grid.lanes_at(values,axis))),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}) ->
  {U32.to_nat((Tensors.count_or_zero(Tiled.cell_shape(values,axis,position)) / U32.max(Grid.groups(Grid.lanes_at(values,axis)),1) : U32)) == ShapeLaws.elements(Grid.removed(values,axis)) : Nat}:
  +groups = U32.to_nat(Grid.groups(Grid.lanes_at(values,axis)))
  +others = ShapeLaws.elements(Grid.removed(values,axis))
  +cells = {%Equal.sym(Bool,Nat.is_lt(axis,List.length(&2,U32,values)),True{},within) :
      {ShapeLaws.elements(Grid.placed(_,position,Grid.removed(values,axis),Grid.groups(Grid.lanes_at(values,axis)))) == Nat.mul(groups,others) : Nat}
    Public.placed_cells(position,Grid.removed(values,axis),Grid.groups(Grid.lanes_at(values,axis))) : {ShapeLaws.elements(Tiled.cell_shape(values,axis,position)) == Nat.mul(groups,others) : Nat}}
  +count = Equal.trans(Nat,U32.to_nat(Tensors.count_or_zero(Tiled.cell_shape(values,axis,position))),ShapeLaws.elements(Tiled.cell_shape(values,axis,position)),Nat.mul(groups,others),counted_cells(Tiled.cell_shape(values,axis,position),counted),cells)
  +kept = Equal.cong(U32,Nat,U32.to_nat,U32.max(Grid.groups(Grid.lanes_at(values,axis)),1),Grid.groups(Grid.lanes_at(values,axis)),GridLaws.maximum_kept(Grid.groups(Grid.lanes_at(values,axis)),1,Order.positive_one(groups,groups_positive)))
  Equal.trans(Nat,U32.to_nat((Tensors.count_or_zero(Tiled.cell_shape(values,axis,position)) / U32.max(Grid.groups(Grid.lanes_at(values,axis)),1) : U32)),Nat.div(Nat.mul(groups,others),groups),others,
    U32Division.quotient_exact(Machine.half_word(limits),Limits.half_word_fits(limits),Tensors.count_or_zero(Tiled.cell_shape(values,axis,position)),U32.max(Grid.groups(Grid.lanes_at(values,axis)),1),Nat.mul(groups,others),groups,count,kept,
      Limits.double_bound(limits,groups,groups_room),groups_positive),
    %RowMajor.multiply_commutative(others,groups) : {Nat.div(_,groups) == others : Nat}
    Division.exact_quotient(others,groups,groups_positive))

# The part groups are the lanes of the part over eight, rounded up.
def bound_exact(+limits: Machine.Limits,+lanes: U32,+room: {Nat.is_le(U32.to_nat(lanes),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}) ->
  {U32.to_nat(Grid.groups(lanes)) == Nat.div(Nat.add(U32.to_nat(lanes),7n),8n) : Nat}:
  Equal.trans(Nat,U32.to_nat(Grid.groups(lanes)),Ceiling.ceiling(U32.to_nat(lanes),8n),Nat.div(Nat.add(U32.to_nat(lanes),7n),8n),
    Encoded.eight_blocks_exact(limits,lanes,room),Equal.sym(Nat,Nat.div(Nat.add(U32.to_nat(lanes),7n),8n),Ceiling.ceiling(U32.to_nat(lanes),8n),
      Ceiling.shifted_formula(U32.to_nat(lanes),8n,{==})))

# The lanes of a target fit its groups of eight.
def lanes_cover(+limits: Machine.Limits,+lanes: U32,+room: {Nat.is_le(U32.to_nat(lanes),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}) -> {Nat.is_le(U32.to_nat(lanes),Nat.mul(8n,U32.to_nat(Grid.groups(lanes)))) == True{} : Bool}:
  %Equal.sym(Nat,Nat.mul(8n,U32.to_nat(Grid.groups(lanes))),Nat.mul(U32.to_nat(Grid.groups(lanes)),8n),RowMajor.multiply_commutative(8n,U32.to_nat(Grid.groups(lanes)))) :
    {Nat.is_le(U32.to_nat(lanes),_) == True{} : Bool}
  %Equal.sym(Nat,U32.to_nat(Grid.groups(lanes)),Ceiling.ceiling(U32.to_nat(lanes),8n),Encoded.eight_blocks_exact(limits,lanes,room)) :
    {Nat.is_le(U32.to_nat(lanes),Nat.mul(_,8n)) == True{} : Bool}
  Ceiling.covers(U32.to_nat(lanes),8n,{==})

# ---- The result a lane write agrees with ----

# A lane of a written cell holds the result lane where the result reads the
# part value at the channel of the lane if it lies in the part and the target
# value otherwise.
def lane_agrees(~Logical: Data,~original: Logical -> U32 -> F32,~Part: Data,~part_value: Part -> U32 -> F32,~Result: Data,~result_value: Result -> U32 -> F32,+logical: Logical,+part: Part,+result: Result,+limits: Machine.Limits,+values: List<&2,U32>,+part_values: List<&2,U32>,+axis: Nat,+position: Grid.Position,+start: U32,+count: U32,+shape: WriteShape<limits,values,part_values,axis,position,start,count>,+spot: List<&2,Nat>,+group: Nat,+word: U32,+spot_below: Coordinates.DigitsBelow(Grid.removed(values,axis),spot),+group_inside: {Nat.is_lt(group,U32.to_nat(Grid.groups(Grid.lanes_at(values,axis)))) == True{} : Bool},+exact: {U32.to_nat(word) == ShapeLaws.digits_value(Tiled.cell_shape(values,axis,position),Coordinates.cell_digits(position,spot,group)) : Nat},+lane: Nat,+small: {Nat.is_le(lane,7n) == True{} : Bool},
  spec: @+hit: {Nat.is_lt(Nat.add(lane,Nat.mul(group,8n)),U32.to_nat(Grid.lanes_at(values,axis))) == True{} : Bool} ->
    {result_value(result,U32.from_nat(ShapeLaws.digits_value(values,Coordinates.inserted_digit(axis,spot,Nat.add(lane,Nat.mul(group,8n)))))) == Bool.pick(F32,LanesCell.in_part(start,Grid.lanes_at(part_values,axis),Nat.add(lane,Nat.mul(group,8n))),part_value(part,U32.from_nat(ShapeLaws.digits_value(part_values,Coordinates.inserted_digit(axis,spot,Nat.sub(Nat.add(lane,Nat.mul(group,8n)),U32.to_nat(start)))))),original(logical,U32.from_nat(ShapeLaws.digits_value(values,Coordinates.inserted_digit(axis,spot,Nat.add(lane,Nat.mul(group,8n))))))) : F32}) ->
