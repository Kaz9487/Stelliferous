# ---- The written value of a cell ----

# A part along the lane axis of a target of the same other extents, inside
# its lanes, and the cells and groups of both within the bounds.
type WriteShape<-limits: Machine.Limits,-values: List<&2,U32>,-part_values: List<&2,U32>,-axis: Nat,-position: Grid.Position,-start: U32,-count: U32> is Data:
  WriteShape{within: {Nat.is_lt(axis,List.length(&2,U32,values)) == True{} : Bool},
    part_within: {Nat.is_lt(axis,List.length(&2,U32,part_values)) == True{} : Bool},
    removed_same: {Grid.removed(part_values,axis) == Grid.removed(values,axis) : List<&2,U32>},
    ends: {Nat.is_le(Nat.add(U32.to_nat(start),U32.to_nat(Grid.lanes_at(part_values,axis))),U32.to_nat(Grid.lanes_at(values,axis))) == True{} : Bool},
    room: {Nat.is_le(ShapeLaws.elements(Grid.removed(values,axis)),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},
    count_exact: {U32.to_nat(count) == ShapeLaws.elements(Grid.removed(values,axis)) : Nat},
    part_room: {Nat.is_le(ShapeLaws.elements(Grid.placed(True{},position,Grid.removed(values,axis),Grid.groups(Grid.lanes_at(part_values,axis)))),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},
    groups_room: {Nat.is_le(Nat.mul(8n,U32.to_nat(Grid.groups(Grid.lanes_at(values,axis)))),U32.to_nat(Machine.half_word(limits))) == True{} : Bool},
    lanes_room: {Nat.is_le(Nat.add(U32.to_nat(start),U32.to_nat(Grid.lanes_at(part_values,axis))),Nat.mul(8n,U32.to_nat(Grid.groups(Grid.lanes_at(values,axis))))) == True{} : Bool},
    bound_exact: {U32.to_nat(Grid.groups(Grid.lanes_at(part_values,axis))) == Nat.div(Nat.add(U32.to_nat(Grid.lanes_at(part_values,axis)),7n),8n) : Nat}}

def shape_within(+limits: Machine.Limits,+values: List<&2,U32>,+part_values: List<&2,U32>,+axis: Nat,+position: Grid.Position,+start: U32,+count: U32,+shape: WriteShape<limits,values,part_values,axis,position,start,count>) -> {Nat.is_lt(axis,List.length(&2,U32,values)) == True{} : Bool}:
  WriteShape{+within,+part_within,+removed_same,+ends,+room,+count_exact,+part_room,+groups_room,+lanes_room,+bound_exact} = shape
  within

def shape_ends(+limits: Machine.Limits,+values: List<&2,U32>,+part_values: List<&2,U32>,+axis: Nat,+position: Grid.Position,+start: U32,+count: U32,+shape: WriteShape<limits,values,part_values,axis,position,start,count>) -> {Nat.is_le(Nat.add(U32.to_nat(start),U32.to_nat(Grid.lanes_at(part_values,axis))),U32.to_nat(Grid.lanes_at(values,axis))) == True{} : Bool}:
  WriteShape{+within,+part_within,+removed_same,+ends,+room,+count_exact,+part_room,+groups_room,+lanes_room,+bound_exact} = shape
  ends

def shape_room(+limits: Machine.Limits,+values: List<&2,U32>,+part_values: List<&2,U32>,+axis: Nat,+position: Grid.Position,+start: U32,+count: U32,+shape: WriteShape<limits,values,part_values,axis,position,start,count>) -> {Nat.is_le(ShapeLaws.elements(Grid.removed(values,axis)),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}:
  WriteShape{+within,+part_within,+removed_same,+ends,+room,+count_exact,+part_room,+groups_room,+lanes_room,+bound_exact} = shape
  room

def shape_count_exact(+limits: Machine.Limits,+values: List<&2,U32>,+part_values: List<&2,U32>,+axis: Nat,+position: Grid.Position,+start: U32,+count: U32,+shape: WriteShape<limits,values,part_values,axis,position,start,count>) -> {U32.to_nat(count) == ShapeLaws.elements(Grid.removed(values,axis)) : Nat}:
  WriteShape{+within,+part_within,+removed_same,+ends,+room,+count_exact,+part_room,+groups_room,+lanes_room,+bound_exact} = shape
  count_exact

def shape_groups_room(+limits: Machine.Limits,+values: List<&2,U32>,+part_values: List<&2,U32>,+axis: Nat,+position: Grid.Position,+start: U32,+count: U32,+shape: WriteShape<limits,values,part_values,axis,position,start,count>) -> {Nat.is_le(Nat.mul(8n,U32.to_nat(Grid.groups(Grid.lanes_at(values,axis)))),U32.to_nat(Machine.half_word(limits))) == True{} : Bool}:
  WriteShape{+within,+part_within,+removed_same,+ends,+room,+count_exact,+part_room,+groups_room,+lanes_room,+bound_exact} = shape
  groups_room

def shape_lanes_room(+limits: Machine.Limits,+values: List<&2,U32>,+part_values: List<&2,U32>,+axis: Nat,+position: Grid.Position,+start: U32,+count: U32,+shape: WriteShape<limits,values,part_values,axis,position,start,count>) -> {Nat.is_le(Nat.add(U32.to_nat(start),U32.to_nat(Grid.lanes_at(part_values,axis))),Nat.mul(8n,U32.to_nat(Grid.groups(Grid.lanes_at(values,axis))))) == True{} : Bool}:
  WriteShape{+within,+part_within,+removed_same,+ends,+room,+count_exact,+part_room,+groups_room,+lanes_room,+bound_exact} = shape
  lanes_room

def shape_bound_exact(+limits: Machine.Limits,+values: List<&2,U32>,+part_values: List<&2,U32>,+axis: Nat,+position: Grid.Position,+start: U32,+count: U32,+shape: WriteShape<limits,values,part_values,axis,position,start,count>) -> {U32.to_nat(Grid.groups(Grid.lanes_at(part_values,axis))) == Nat.div(Nat.add(U32.to_nat(Grid.lanes_at(part_values,axis)),7n),8n) : Nat}:
  WriteShape{+within,+part_within,+removed_same,+ends,+room,+count_exact,+part_room,+groups_room,+lanes_room,+bound_exact} = shape
  bound_exact

# ---- Channels of the part ----

# A channel in the part lies the start less below the width.
def part_channel(+start: U32,+width: U32,+channel: Nat,+hit: {LanesCell.in_part(start,width,channel) == True{} : Bool}) ->
  {Nat.is_lt(Nat.sub(channel,U32.to_nat(start)),U32.to_nat(width)) == True{} : Bool}:
  +s = U32.to_nat(start)
  +w = U32.to_nat(width)
  +lower = Logic.left(Nat.is_le(s,channel),Nat.is_lt(channel,Nat.add(s,w)),hit)
  +upper = Logic.right(Nat.is_le(s,channel),Nat.is_lt(channel,Nat.add(s,w)),hit)
