# A part of its contract, with values of the target extents but along the
# lane axis, written into target cells of their contract along their lane
# axis from start on, holds the result every written cell agrees with.
def lanes_written(~Logical: Data,~original: Logical -> U32 -> F32,~Part: Data,~part_value: Part -> U32 -> F32,~Result: Data,~result_value: Result -> U32 -> F32,+logical: Logical,+part: Part,+result: Result,+values: List<&2,U32>,+part_values: List<&2,U32>,+axis: Nat,+start: U32,
  cells: Tensors.Tensor<Tile.Tile8>,+lanes: U32,+position: Grid.Position,part_tiled: Tiled.Tiled,
  +limits: Machine.Limits,+default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},
  +target_contract: Public.Contract(~Logical,~original,logical,values,Tiled.Tiled{cells,axis,lanes,position}),
  +part_contract: Public.Contract(~Part,~part_value,part,part_values,part_tiled),+within: {Nat.is_lt(axis,List.length(&2,U32,values)) == True{} : Bool},+part_within: {Nat.is_lt(axis,List.length(&2,U32,part_values)) == True{} : Bool},+removed_same: {Grid.removed(part_values,axis) == Grid.removed(values,axis) : List<&2,U32>},+ends: {Nat.is_le(Nat.add(U32.to_nat(start),U32.to_nat(Grid.lanes_at(part_values,axis))),U32.to_nat(Grid.lanes_at(values,axis))) == True{} : Bool},+rank_room: {Nat.is_le(List.length(&2,U32,values),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},+part_rank_room: {Nat.is_le(List.length(&2,U32,part_values),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},+part_nonempty: {Nat.is_lt(0n,ShapeLaws.elements(part_values)) == True{} : Bool},cell_spec: @+spot: List<&2,Nat> -> @+group: Nat -> @+word: U32 -> @+spot_below: Coordinates.DigitsBelow(Grid.removed(values,axis),spot) -> @+group_inside: {Nat.is_lt(group,U32.to_nat(Grid.groups(Grid.lanes_at(values,axis)))) == True{} : Bool} -> @+exact: {U32.to_nat(word) == ShapeLaws.digits_value(Tiled.cell_shape(values,axis,position),Coordinates.cell_digits(position,spot,group)) : Nat} -> @+shape: WriteShape<limits,values,part_values,axis,position,start,(Tensors.count_or_zero(Tiled.cell_shape(values,axis,position)) / U32.max(Grid.groups(Grid.lanes_at(values,axis)),1) : U32)> -> {Law.written_value(~Logical,~original,~Representation.Lifted<Part>,~Representation.lifted(~Part,~part_value),Law.Written{Representation.Lifted{logical,Public.geometry_of(values,axis,position)},Representation.Lifted{part,Public.geometry_of(part_values,axis,position)},Tiled.Write{start,Grid.lanes_at(part_values,axis),Grid.groups(Grid.lanes_at(values,axis)),Grid.groups(Grid.lanes_at(part_values,axis)),(Tensors.count_or_zero(Tiled.cell_shape(values,axis,position)) / U32.max(Grid.groups(Grid.lanes_at(values,axis)),1) : U32),position}},word) == Representation.lifted(~Result,~result_value,Representation.Lifted{result,Public.geometry_of(values,axis,position)},word) : Tile.Tile8}) ->
  Public.Contract(~Result,~result_value,result,values,Tiled.lanes_written(Tiled.Tiled{cells,axis,lanes,position},start,part_tiled)):
  match part_tiled:
    case Tiled.Tiled{part_cells,+part_axis,+part_lanes,+part_position}:
      match part_cells:
        case Tensors.Tensor{part_pieces,+part_shape,+part_fill,Tensors.Usable{},+part_workers}:
          lanes_observed(~Logical,~original,~Part,~part_value,~Result,~result_value,logical,part,result,values,part_values,axis,start,cells,lanes,position,part_pieces,part_shape,part_fill,part_workers,part_axis,part_lanes,
            part_position,PiecesModel.observe(~Tile.Tile8,part_pieces),limits,default_capacity,target_contract,part_contract,within,part_within,removed_same,ends,rank_room,part_rank_room,part_nonempty,cell_spec)
        case Tensors.Tensor{part_pieces,+part_shape,+part_fill,Tensors.Failed{+problem},+part_workers}:
          Empty.absurd(Public.Contract(~Result,~result_value,result,values,Tiled.lanes_written(Tiled.Tiled{cells,axis,lanes,position},start,
            Tiled.Tiled{Tensors.Tensor{part_pieces,part_shape,part_fill,Tensors.Failed{problem},part_workers},part_axis,part_lanes,part_position})),part_contract)
