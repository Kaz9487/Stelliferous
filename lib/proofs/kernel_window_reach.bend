    Order.right_le(Nat.mul(U32.to_nat((last / U32.max((oh * ow : U32),1) : U32)),U32.to_nat(h)),Nat.add(U32.to_nat(f2),U32.to_nat(r2))),
    Order.transitive(Nat.add(Nat.mul(U32.to_nat((last / U32.max((oh * ow : U32),1) : U32)),U32.to_nat(h)),Nat.add(U32.to_nat(f2),U32.to_nat(r2))),Nat.mul(Nat.add(Nat.mul(U32.to_nat((last / U32.max((oh * ow : U32),1) : U32)),U32.to_nat(h)),Nat.add(U32.to_nat(f2),U32.to_nat(r2))),Nat.mul(U32.to_nat(w),U32.to_nat(gi))),U32.to_nat(Machine.capacity(limits)),
      RowMajor.product_covers(Nat.add(Nat.mul(U32.to_nat((last / U32.max((oh * ow : U32),1) : U32)),U32.to_nat(h)),Nat.add(U32.to_nat(f2),U32.to_nat(r2))),Nat.mul(U32.to_nat(w),U32.to_nat(gi)),row_positive),word_bound))
  +sum_exact = Arithmetic.add(f2,r2,Machine.capacity(limits),LimitBounds.capacity_fits(limits),sum_room)
  +sum_nat = Equal.cong(Nat,Nat,value => Nat.mul(Nat.add(Nat.mul(U32.to_nat((last / U32.max((oh * ow : U32),1) : U32)),U32.to_nat(h)),value),Nat.mul(U32.to_nat(w),U32.to_nat(gi))),U32.to_nat((f2 + r2 : U32)),Nat.add(U32.to_nat(f2),U32.to_nat(r2)),sum_exact)
  +word_bound = Held.nat_le_moved(Nat.mul(Nat.add(Nat.mul(U32.to_nat((last / U32.max((oh * ow : U32),1) : U32)),U32.to_nat(h)),U32.to_nat((f2 + r2 : U32))),Nat.mul(U32.to_nat(w),U32.to_nat(gi))),Nat.mul(Nat.add(Nat.mul(U32.to_nat((last / U32.max((oh * ow : U32),1) : U32)),U32.to_nat(h)),Nat.add(U32.to_nat(f2),U32.to_nat(r2))),Nat.mul(U32.to_nat(w),U32.to_nat(gi))),U32.to_nat(Machine.capacity(limits)),sum_nat,word_bound)
  +row_exact = row_cells(limits,h,w,gi,positive,groups_positive,height_room,image_room)
  +row_word_positive = {%Equal.sym(Nat,U32.to_nat(((h * w * gi : U32) / U32.max(h,1) : U32)),Nat.mul(U32.to_nat(w),U32.to_nat(gi)),row_exact) : {Nat.is_lt(0n,_) == True{} : Bool} row_positive : {Nat.is_lt(0n,U32.to_nat(((h * w * gi : U32) / U32.max(h,1) : U32))) == True{} : Bool}}
  %Equal.sym(U32,(low + (high - low : U32) : U32),high,span) : {U32.to_nat(_) == Nat.mul(Nat.add(Nat.mul(U32.to_nat((last / U32.max((oh * ow : U32),1) : U32)),U32.to_nat(h)),Nat.add(U32.to_nat(f2),U32.to_nat(r2))),Nat.mul(U32.to_nat(w),U32.to_nat(gi))) : Nat}
  %Equal.sym(U32,high,joined,grouped) : {U32.to_nat(_) == Nat.mul(Nat.add(Nat.mul(U32.to_nat((last / U32.max((oh * ow : U32),1) : U32)),U32.to_nat(h)),Nat.add(U32.to_nat(f2),U32.to_nat(r2))),Nat.mul(U32.to_nat(w),U32.to_nat(gi))) : Nat}
  Equal.trans(Nat,U32.to_nat(joined),Nat.mul(Nat.add(Nat.mul(U32.to_nat((last / U32.max((oh * ow : U32),1) : U32)),U32.to_nat(h)),U32.to_nat((f2 + r2 : U32))),Nat.mul(U32.to_nat(w),U32.to_nat(gi))),Nat.mul(Nat.add(Nat.mul(U32.to_nat((last / U32.max((oh * ow : U32),1) : U32)),U32.to_nat(h)),Nat.add(U32.to_nat(f2),U32.to_nat(r2))),Nat.mul(U32.to_nat(w),U32.to_nat(gi))),
    {%row_exact :
    {U32.to_nat(joined) == Nat.mul(Nat.add(Nat.mul(U32.to_nat((last / U32.max((oh * ow : U32),1) : U32)),U32.to_nat(h)),U32.to_nat((f2 + r2 : U32))),_) : Nat}
  affine_word(limits,(last / U32.max((oh * ow : U32),1) : U32),h,(f2 + r2 : U32),((h * w * gi : U32) / U32.max(h,1) : U32),row_word_positive,
    {%Equal.sym(Nat,U32.to_nat(((h * w * gi : U32) / U32.max(h,1) : U32)),Nat.mul(U32.to_nat(w),U32.to_nat(gi)),row_exact) : {Nat.is_le(Nat.mul(Nat.add(Nat.mul(U32.to_nat((last / U32.max((oh * ow : U32),1) : U32)),U32.to_nat(h)),U32.to_nat((f2 + r2 : U32))),_),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}
      word_bound : {Nat.is_le(Nat.mul(Nat.add(Nat.mul(U32.to_nat((last / U32.max((oh * ow : U32),1) : U32)),U32.to_nat(h)),U32.to_nat((f2 + r2 : U32))),U32.to_nat(((h * w * gi : U32) / U32.max(h,1) : U32))),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}})
  : {U32.to_nat(joined) == Nat.mul(Nat.add(Nat.mul(U32.to_nat((last / U32.max((oh * ow : U32),1) : U32)),U32.to_nat(h)),U32.to_nat((f2 + r2 : U32))),Nat.mul(U32.to_nat(w),U32.to_nat(gi))) : Nat}},sum_nat)

# A word ((a * b + c) * d) * e within the capacity, d * e positive, is its
# number.
def affine_word2(+limits: Machine.Limits,+a: U32,+b: U32,+c: U32,+d: U32,+e: U32,+positive: {Nat.is_lt(0n,Nat.mul(U32.to_nat(d),U32.to_nat(e))) == True{} : Bool},
  +scale_room: {Nat.is_le(Nat.mul(U32.to_nat(d),U32.to_nat(e)),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},
  +bound: {Nat.is_le(Nat.mul(Nat.add(Nat.mul(U32.to_nat(a),U32.to_nat(b)),U32.to_nat(c)),Nat.mul(U32.to_nat(d),U32.to_nat(e))),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}) ->
  {U32.to_nat((((a * b + c) * d) * e : U32)) == Nat.mul(Nat.add(Nat.mul(U32.to_nat(a),U32.to_nat(b)),U32.to_nat(c)),Nat.mul(U32.to_nat(d),U32.to_nat(e))) : Nat}:
  +scale = (d * e : U32)
  +scale_exact = Multiplication.bounded_multiply(d,e,Machine.capacity(limits),LimitBounds.capacity_fits(limits),scale_room)
  +target = Nat.mul(Nat.add(Nat.mul(U32.to_nat(a),U32.to_nat(b)),U32.to_nat(c)),Nat.mul(U32.to_nat(d),U32.to_nat(e)))
  %Equal.sym(U32,(((a * b : U32) + c : U32) * d * e : U32),(((a * b : U32) + c : U32) * (d * e : U32) : U32),Arithmetic.multiply_associative(((a * b : U32) + c : U32),d,e)) : {U32.to_nat(_) == target : Nat}
  %scale_exact :
    {U32.to_nat((((a * b : U32) + c : U32) * scale : U32)) == Nat.mul(Nat.add(Nat.mul(U32.to_nat(a),U32.to_nat(b)),U32.to_nat(c)),_) : Nat}
  affine_word(limits,a,b,c,scale,{%Equal.sym(Nat,U32.to_nat(scale),Nat.mul(U32.to_nat(d),U32.to_nat(e)),scale_exact) : {Nat.is_lt(0n,_) == True{} : Bool} positive : {Nat.is_lt(0n,U32.to_nat(scale)) == True{} : Bool}},
    {%Equal.sym(Nat,U32.to_nat(scale),Nat.mul(U32.to_nat(d),U32.to_nat(e)),scale_exact) :
      {Nat.is_le(Nat.mul(Nat.add(Nat.mul(U32.to_nat(a),U32.to_nat(b)),U32.to_nat(c)),_),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}
      bound : {Nat.is_le(Nat.mul(Nat.add(Nat.mul(U32.to_nat(a),U32.to_nat(b)),U32.to_nat(c)),U32.to_nat(scale)),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}})
