    Equal.cong(Nat,Nat,value => Nat.add(value,U32.to_nat(c)),U32.to_nat((a * b : U32)),ab,ab_exact))
  Equal.trans(Nat,U32.to_nat(((a * b + c) * d : U32)),Nat.mul(U32.to_nat(((a * b : U32) + c : U32)),U32.to_nat(d)),Nat.mul(sum,U32.to_nat(d)),
