      +rest_room = Order.transitive(ShapeLaws.elements(rest),Nat.mul(U32.to_nat(extent),ShapeLaws.elements(rest)),U32.to_nat(cap),
        DivisionOrder.le_multiple(U32.to_nat(extent),ShapeLaws.elements(rest),extent_positive),room)
      +product = Grid.product(rest)
      +exact = Public.product_exact(cap,cap_ok,rest,rest_room)
