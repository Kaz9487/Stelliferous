# All but the last of a list, and its last.
def init_of(items: List<&2,U32>) -> List<&2,U32>:
  match items:
    case Nil{}: []
    case Con{head,tail}:
      match tail:
        case Nil{}: []
        case Con{next,rest}: head <> init_of(tail)

def last_of(items: List<&2,U32>) -> U32:
  match items:
    case Nil{}: 0
    case Con{head,tail}:
      match tail:
        case Nil{}: head
        case Con{next,rest}: last_of(tail)

def init_appended(items: List<&2,U32>,+last: U32) -> {init_of(List.append(&2,U32,items,[last])) == items : List<&2,U32>}:
  match items:
    case Nil{}: {==}
    case Con{+head,Nil{}}: {==}
    case Con{+head,Con{+next,+rest}}:
      Equal.cong(List<&2,U32>,List<&2,U32>,more => head <> more,init_of(List.append(&2,U32,next <> rest,[last])),next <> rest,init_appended(next <> rest,last))

def last_appended(items: List<&2,U32>,+last: U32) -> {last_of(List.append(&2,U32,items,[last])) == last : U32}:
  match items:
    case Nil{}: {==}
    case Con{+head,Nil{}}: {==}
    case Con{+head,Con{+next,+rest}}: last_appended(next <> rest,last)

# Lists with one more extent each agree when they do.
def appended_same(+left: List<&2,U32>,+right: List<&2,U32>,+last: U32,+other: U32,+same: {List.append(&2,U32,left,[last]) == List.append(&2,U32,right,[other]) : List<&2,U32>}) ->
  KernelGemm.Both<{left == right : List<&2,U32>},{last == other : U32}>:
  KernelGemm.Both{
