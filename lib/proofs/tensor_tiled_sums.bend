# ---- The rooms of the rows of a box ----

def removed_nonzero(extents: List<&2,U32>,axis: Nat,+nonzero: {Shapes.has_zero(extents) == False{} : Bool}) -> {Shapes.has_zero(Grid.removed(extents,axis)) == False{} : Bool}:
  match extents axis:
    case Nil{} axis: {==}
    case Con{+extent,+rest} 0n: Boolean.or_false_right(U32.is_zero(extent),Shapes.has_zero(rest),nonzero)
    case Con{+extent,+rest} 1n+ +next:
      +head = Boolean.or_false_left(U32.is_zero(extent),Shapes.has_zero(rest),nonzero)
      +tail = removed_nonzero(rest,next,Boolean.or_false_right(U32.is_zero(extent),Shapes.has_zero(rest),nonzero))
      %Equal.sym(Bool,U32.is_zero(extent),False{},head) : {_ || Shapes.has_zero(Grid.removed(rest,next)) == False{} : Bool}
      %Equal.sym(Bool,Shapes.has_zero(Grid.removed(rest,next)),False{},tail) : {False{} || _ == False{} : Bool}
      {==}

def removed_fewer(extents: List<&2,U32>,axis: Nat,+nonzero: {Shapes.has_zero(extents) == False{} : Bool}) ->
  {Nat.is_le(ShapeLaws.elements(Grid.removed(extents,axis)),ShapeLaws.elements(extents)) == True{} : Bool}:
  match extents axis:
    case Nil{} axis: Order.reflexive(1n)
    case Con{+extent,+rest} 0n:
      DivisionOrder.le_multiple(U32.to_nat(extent),ShapeLaws.elements(rest),Arithmetic.word_nonzero_positive(extent,Boolean.or_false_left(U32.is_zero(extent),Shapes.has_zero(rest),nonzero)))
    case Con{+extent,+rest} 1n+ +next:
      +fewer = removed_fewer(rest,next,Boolean.or_false_right(U32.is_zero(extent),Shapes.has_zero(rest),nonzero))
      %RowMajor.multiply_commutative(ShapeLaws.elements(Grid.removed(rest,next)),U32.to_nat(extent)) :
        {Nat.is_le(_,Nat.mul(U32.to_nat(extent),ShapeLaws.elements(rest))) == True{} : Bool}
      %RowMajor.multiply_commutative(ShapeLaws.elements(rest),U32.to_nat(extent)) :
        {Nat.is_le(Nat.mul(ShapeLaws.elements(Grid.removed(rest,next)),U32.to_nat(extent)),_) == True{} : Bool}
      RowMajor.mul_le(ShapeLaws.elements(Grid.removed(rest,next)),ShapeLaws.elements(rest),U32.to_nat(extent),fewer)

def rows_nonzero(reduced: Bool,+extents: List<&2,U32>,+axis: Nat,+nonzero: {Shapes.has_zero(extents) == False{} : Bool}) ->
  {Shapes.has_zero(Partials.row_extents(reduced,extents,axis,1n)) == False{} : Bool}:
  match reduced:
    case True{}: removed_nonzero(extents,axis,nonzero)
    case False{}: nonzero

def rows_fewer(reduced: Bool,+extents: List<&2,U32>,+axis: Nat,+nonzero: {Shapes.has_zero(extents) == False{} : Bool}) ->
  {Nat.is_le(ShapeLaws.elements(Partials.row_extents(reduced,extents,axis,1n)),ShapeLaws.elements(extents)) == True{} : Bool}:
  match reduced:
    case True{}: removed_fewer(extents,axis,nonzero)
    case False{}: Order.reflexive(ShapeLaws.elements(extents))

# ---- The lanes of kept cells ----

# The digits of a value of a line of a row lie below the reduced extents.
def line_below(reduced: Bool,+values: List<&2,U32>,+flags: List<&2,Bool>,+rows: List<&2,Nat>,+offset: Nat,
  +flagged: {Partials.flag_at(flags,Nat.sub(List.length(&2,U32,values),1n)) == reduced : Bool},+same: {List.length(&2,U32,values) == List.length(&2,Bool,flags) : Nat},+positive: {Nat.is_lt(0n,List.length(&2,U32,values)) == True{} : Bool},
