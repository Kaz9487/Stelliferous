        Extrema.max_one_exact(product,ShapeLaws.elements(rest),exact,CountCompletion.positive_elements(rest,rest_nonzero)),Equal.sym(Nat,U32.to_nat(product),ShapeLaws.elements(rest),exact)))
      %Equal.sym(List<&2,U32>,Grid.strides(Con{extent,rest}),Con{Grid.product(rest),Grid.strides(rest)},GridLaws.strides_con(extent,rest)) :
        {U32.max(product,1) <> max_strides(rest) == _ : List<&2,U32>}
      Equal.trans(List<&2,U32>,U32.max(product,1) <> max_strides(rest),product <> max_strides(rest),product <> Tasks.strides_of(rest),
        Equal.cong(U32,List<&2,U32>,word => word <> max_strides(rest),U32.max(product,1),product,head),
        Equal.cong(List<&2,U32>,List<&2,U32>,later => product <> later,max_strides(rest),Tasks.strides_of(rest),max_strides_same(rest,cap,cap_ok,rest_nonzero,rest_room)))

