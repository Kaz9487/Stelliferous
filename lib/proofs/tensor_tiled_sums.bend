# ---- The specification ----

# The box of the sums of the listed axes of the values of a reader.
def sum_box(~Logical: Data,~original: Logical -> U32 -> F32,+logical: Logical,+values: List<&2,U32>,+axes: List<&2,U32>) -> PartialsValues.Box<Sum.Parts>:
  PartialsValues.reduced_box(~F32,~Sum.Lanes,~Sum.Parts,~Sum.step,~Sum.parts,~Logical,~original,logical,Sum.zero(),TiledReduce.parts_zero(),values,Layout.naturals(axes))

# The tiled values of the sums of the listed axes: at the row-major index of
# the kept axes, the rounded merge of the partials of the rows there.
def Summed(~Logical: Data,~original: Logical -> U32 -> F32,+logical: Logical,+values: List<&2,U32>,+axes: List<&2,U32>,tiled: Tiled.Tiled) -> Data:
  Public.Contract(~PartialsValues.Box<Sum.Parts>,~PartialsValues.box_value(~F32,~Sum.Parts,~Sum.merge,~Sum.rounded),sum_box(~Logical,~original,logical,values,axes),Layout.extents_at(values,Reduce.kept_axes(values,axes)),tiled)

# The kept extents of Partials are those of the kept axes.
def kept_head(flag: Bool,+extent: U32,+left: List<&2,U32>,+right: List<&2,U32>,+same: {left == right : List<&2,U32>}) ->
  {Partials.kept_extent(flag,extent,left) == ReduceLaws.kept_extent(flag,False{},extent,right) : List<&2,U32>}:
  match flag:
    case True{}: same
    case False{}: Equal.cong(List<&2,U32>,List<&2,U32>,rest => extent <> rest,left,right,same)

def kept_picked(extents: List<&2,U32>,flags: List<&2,Bool>) -> {Partials.kept_extents(extents,flags) == ReduceLaws.picked_extents(extents,flags,False{}) : List<&2,U32>}:
  match extents flags:
    case Nil{} Nil{}: {==}
    case Nil{} Con{+flag,+others}: {==}
    case Con{+extent,+rest} Nil{}: {==}
    case Con{+extent,+rest} Con{+flag,+others}:
      kept_head(flag,extent,Partials.kept_extents(rest,others),ReduceLaws.picked_extents(rest,others,False{}),kept_picked(rest,others))

def kept_extents(+values: List<&2,U32>,+axes: List<&2,Nat>) ->
  {Partials.kept_extents(values,Layout.reduced_flags(List.length(&2,U32,values),0n,axes)) == Layout.extents_at(values,Layout.axes_where(List.length(&2,U32,values),0n,axes,False{})) : List<&2,U32>}:
  Equal.trans(List<&2,U32>,Partials.kept_extents(values,Layout.reduced_flags(List.length(&2,U32,values),0n,axes)),ReduceLaws.picked_extents(values,Layout.reduced_flags(List.length(&2,U32,values),0n,axes),False{}),
    Layout.extents_at(values,Layout.axes_where(List.length(&2,U32,values),0n,axes,False{})),kept_picked(values,Layout.reduced_flags(List.length(&2,U32,values),0n,axes)),
    Equal.sym(List<&2,U32>,Layout.extents_at(values,Layout.axes_where(List.length(&2,U32,values),0n,axes,False{})),ReduceLaws.picked_extents(values,Layout.reduced_flags(List.length(&2,U32,values),0n,axes),False{}),
      ReduceLaws.extents_listed(values,axes,False{})))

# ---- Values on the unit axis ----

def sum_begins(+context: Unit) -> {TiledReduce.sum_begun(context) == LineChain.unchanged(~Sum.Lanes,TiledReduce.sum_begun(context)) : Sum.Lanes}:
  {==}

def line_begins(+lanes: U32) -> {TiledReduce.line_begun(lanes) == LineChain.unchanged(~TiledReduce.SumLine,TiledReduce.line_begun(lanes)) : TiledReduce.SumLine}:
  {==}

# Unit cells fold their first lanes as the values fold.
def unit_line_fold(~Accumulator: Data,~step: Accumulator -> F32 -> Accumulator,~Logical: Data,~original: Logical -> U32 -> F32,+logical: Logical,count: Nat,+position: Nat,+state: Accumulator) ->
  {Reduce.line_fold(~Tile.Tile8,~Accumulator,~TiledReduce.lane_operation(~Accumulator,~step),~Logical,~ReduceLaws.unit_of(~Logical,~original),logical,count,position,state) == Reduce.line_fold(~F32,~Accumulator,~step,~Logical,~original,logical,count,position,state) : Accumulator}:
  match count:
    case 0n: {==}
    case 1n+ +rest: unit_line_fold(~Accumulator,~step,~Logical,~original,logical,rest,1n+position,step(state,original(logical,U32.from_nat(position))))

def unit_line_folds(~Accumulator: Data,~step: Accumulator -> F32 -> Accumulator,~Logical: Data,~original: Logical -> U32 -> F32,+logical: Logical,lines: Nat,+size: Nat,+position: Nat,+state: Accumulator) ->
  {Reduce.line_folds(~Tile.Tile8,~Accumulator,~TiledReduce.lane_operation(~Accumulator,~step),~Logical,~ReduceLaws.unit_of(~Logical,~original),logical,lines,size,position,state) == Reduce.line_folds(~F32,~Accumulator,~step,~Logical,~original,logical,lines,size,position,state) : List<&2,Accumulator>}:
  match lines:
    case 0n: {==}
    case 1n+ +rest:
      %unit_line_fold(~Accumulator,~step,~Logical,~original,logical,size,position,state) :
        {Reduce.line_fold(~Tile.Tile8,~Accumulator,~TiledReduce.lane_operation(~Accumulator,~step),~Logical,~ReduceLaws.unit_of(~Logical,~original),logical,size,position,state) <> Reduce.line_folds(~Tile.Tile8,~Accumulator,~TiledReduce.lane_operation(~Accumulator,~step),~Logical,~ReduceLaws.unit_of(~Logical,~original),logical,rest,size,Nat.add(position,size),state) ==
          _ <> Reduce.line_folds(~F32,~Accumulator,~step,~Logical,~original,logical,rest,size,Nat.add(position,size),state) : List<&2,Accumulator>}
      Equal.cong(List<&2,Accumulator>,List<&2,Accumulator>,tail => Reduce.line_fold(~Tile.Tile8,~Accumulator,~TiledReduce.lane_operation(~Accumulator,~step),~Logical,~ReduceLaws.unit_of(~Logical,~original),logical,size,position,state) <> tail,
        Reduce.line_folds(~Tile.Tile8,~Accumulator,~TiledReduce.lane_operation(~Accumulator,~step),~Logical,~ReduceLaws.unit_of(~Logical,~original),logical,rest,size,Nat.add(position,size),state),Reduce.line_folds(~F32,~Accumulator,~step,~Logical,~original,logical,rest,size,Nat.add(position,size),state),
        unit_line_folds(~Accumulator,~step,~Logical,~original,logical,rest,size,Nat.add(position,size),state))

# The box of the sums of unit cells is that of their values.
