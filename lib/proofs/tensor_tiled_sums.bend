# ---- Sums along the last axis, the lanes there ----

# Three numbers added, one moved to the front.
def shift_front(+a: Nat,+b: Nat,+c: Nat) -> {Nat.add(a,Nat.add(c,b)) == Nat.add(c,Nat.add(a,b)) : Nat}:
  Equal.trans(Nat,Nat.add(a,Nat.add(c,b)),Nat.add(Nat.add(c,a),b),Nat.add(c,Nat.add(a,b)),
    Equal.trans(Nat,Nat.add(a,Nat.add(c,b)),Nat.add(Nat.add(a,c),b),Nat.add(Nat.add(c,a),b),
      Equal.sym(Nat,Nat.add(Nat.add(a,c),b),Nat.add(a,Nat.add(c,b)),Addition.associative(a,c,b)),
      Equal.cong(Nat,Nat,x => Nat.add(x,b),Nat.add(a,c),Nat.add(c,a),Order.commutative(a,c))),
    Addition.associative(c,a,b))

# A positive count is one more than the count before it.
def count_split(count: Nat,+positive: {Nat.is_lt(0n,count) == True{} : Bool}) -> {count == 1n+Nat.sub(count,1n) : Nat}:
  match count:
    case 0n: Empty.absurd({0n == 1n+Nat.sub(0n,1n) : Nat},WordEncoding.false_true(positive))
    case 1n+ +rest: Equal.cong(Nat,Nat,n => 1n+n,rest,Nat.sub(rest,0n),Equal.sym(Nat,Nat.sub(rest,0n),rest,Order.subtract_zero(rest)))

# One more than a count is its full groups of eight, then a last group of one
