# ---- The rows of kept cells ----

def below_of(a: Nat,b: Nat,+le: {Nat.is_le(a,b) == True{} : Bool},+ne: {Nat.is_eq(a,b) == False{} : Bool}) -> {Nat.is_lt(a,b) == True{} : Bool}:
  match a b:
    case 0n 0n: Empty.absurd({Nat.is_lt(0n,0n) == True{} : Bool},WordEncoding.false_true(Equal.sym(Bool,True{},False{},ne)))
    case 0n 1n+y: {==}
    case 1n+x 0n: Empty.absurd({Nat.is_lt(1n+x,0n) == True{} : Bool},WordEncoding.false_true(le))
    case 1n+ +x 1n+ +y: below_of(x,y,le,ne)

def flag_end(flags: List<&2,Bool>,+flag: Bool) -> {Partials.flag_at(List.append(&2,Bool,flags,[flag]),List.length(&2,Bool,flags)) == flag : Bool}:
  match flags:
    case Nil{}: {==}
    case Con{+first,+rest}: flag_end(rest,flag)

# A flag after the axis taken out moves down by one.
def flag_after_removed(flags: List<&2,Bool>,axis: Nat,index: Nat,+before: {Nat.is_le(axis,index) == True{} : Bool}) ->
  {Partials.flag_at(Partials.flag_removed(flags,axis),index) == Partials.flag_at(flags,1n+index) : Bool}:
  match flags axis index:
    case Nil{} axis index: {==}
    case Con{+flag,+rest} 0n index: {==}
    case Con{+flag,+rest} 1n+next 0n: Empty.absurd({Partials.flag_at(Partials.flag_removed(Con{flag,rest},1n+next),0n) == Partials.flag_at(Con{flag,rest},1n) : Bool},WordEncoding.false_true(before))
    case Con{+flag,+rest} 1n+ +next 1n+ +more: flag_after_removed(rest,next,more,before)

# The last of the flags with the groups at their kept position is the last
# flag.
def last_placed(choice: Bool,+flags: List<&2,Bool>,+lane: Nat,+rank: Nat,+count: {List.length(&2,Bool,Partials.flag_removed(flags,lane)) == Nat.sub(rank,1n) : Nat},
  +unflagged: {Partials.flag_at(flags,lane) == False{} : Bool},+inside: {Nat.is_le(lane,Nat.sub(rank,1n)) == True{} : Bool},+test: {Nat.is_eq(lane,Nat.sub(rank,1n)) == choice : Bool}) ->
  {Partials.flag_at(TiledReduce.flags_placed(Bool.pick(Grid.Position,choice,Grid.Innermost{},Grid.Outermost{}),Partials.flag_removed(flags,lane),False{}),Nat.sub(rank,1n)) == Partials.flag_at(flags,Nat.sub(rank,1n)) : Bool}:
  match choice:
    case True{}:
      +others = Partials.flag_removed(flags,lane)
      +equal = Order.equal_of_is_eq(lane,Nat.sub(rank,1n),test)
      %count : {Partials.flag_at(List.append(&2,Bool,others,[False{}]),_) == Partials.flag_at(flags,Nat.sub(rank,1n)) : Bool}
      %equal : {Partials.flag_at(List.append(&2,Bool,others,[False{}]),List.length(&2,Bool,others)) == Partials.flag_at(flags,_) : Bool}
      Equal.trans(Bool,Partials.flag_at(List.append(&2,Bool,others,[False{}]),List.length(&2,Bool,others)),False{},Partials.flag_at(flags,lane),flag_end(others,False{}),
        Equal.sym(Bool,Partials.flag_at(flags,lane),False{},unflagged))
    case False{}:
      +others = Partials.flag_removed(flags,lane)
      +below = below_of(lane,Nat.sub(rank,1n),inside,test)
      +split = Order.positive_has_last(Nat.sub(rank,1n),Order.positive_bound(lane,Nat.sub(rank,1n),below))
      +index = Nat.sub(Nat.sub(rank,1n),1n)
      +before = {%Equal.sym(Nat,1n+index,Nat.sub(rank,1n),split) : {Nat.is_le(1n+lane,_) == True{} : Bool} Order.strict_follow(lane,Nat.sub(rank,1n),below) :
        {Nat.is_le(lane,index) == True{} : Bool}}
      %split : {Partials.flag_at(False{} <> others,_) == Partials.flag_at(flags,Nat.sub(rank,1n)) : Bool}
      %split : {Partials.flag_at(False{} <> others,1n+index) == Partials.flag_at(flags,_) : Bool}
      flag_after_removed(flags,lane,index,before)

