# ---- Rows of Partials in digits ----

def axis_strides(axes: List<&2,Views.Axis>) -> List<&2,U32>:
  match axes:
    case Nil{}: []
    case Con{Views.Axis{extent,stride},rest}: stride <> axis_strides(rest)

# The kept axes of Partials step an output by its coordinates.
def address_coordinates(axes: List<&2,Views.Axis>,+index: U32,+offset: U32) ->
  {PartialsValues.address(axes,index,offset) == (offset + Digits.stepped_digits(Digits.words_nat(Grid.coordinates(Views.axis_extents(axes),index)),axis_strides(axes)) : U32) : U32}:
  match axes:
    case Nil{}: Equal.sym(U32,(offset + 0 : U32),offset,Arithmetic.add_zero(offset))
    case Con{Views.Axis{+extent,+stride},+rest}:
      +inner = U32.max(Grid.product(Views.axis_extents(rest)),1)
      +coordinate = (index / inner % U32.max(extent,1) : U32)
      +later = Digits.stepped_digits(Digits.words_nat(Grid.coordinates(Views.axis_extents(rest),(index % inner : U32))),axis_strides(rest))
      %Equal.sym(List<&2,U32>,Grid.strides(Con{extent,Views.axis_extents(rest)}),Con{Grid.product(Views.axis_extents(rest)),Grid.strides(Views.axis_extents(rest))},
          GridLaws.strides_con(extent,Views.axis_extents(rest))) :
        {PartialsValues.address(Con{Views.Axis{extent,stride},rest},index,offset) ==
          (offset + Digits.stepped_digits(Digits.words_nat(Grid.coordinates_by(Con{extent,Views.axis_extents(rest)},_,index)),axis_strides(Con{Views.Axis{extent,stride},rest})) : U32) : U32}
      Equal.trans(U32,PartialsValues.address(rest,(index % inner : U32),(offset + coordinate * stride : U32)),((offset + coordinate * stride : U32) + later : U32),
        (offset + (U32.from_nat(U32.to_nat(coordinate)) * stride + later : U32) : U32),
        address_coordinates(rest,(index % inner : U32),(offset + coordinate * stride : U32)),
        Equal.trans(U32,((offset + coordinate * stride : U32) + later : U32),(offset + (coordinate * stride + later : U32) : U32),
          (offset + (U32.from_nat(U32.to_nat(coordinate)) * stride + later : U32) : U32),
          Arithmetic.add_associative(offset,(coordinate * stride : U32),later),
          Equal.cong(U32,U32,word => (offset + (word * stride + later : U32) : U32),coordinate,U32.from_nat(U32.to_nat(coordinate)),
            Equal.sym(U32,U32.from_nat(U32.to_nat(coordinate)),coordinate,Arithmetic.native_roundtrip(coordinate)))))

# The rows of a tree step from its base by their digits.
def address_stepped(axes: List<&2,Views.Axis>,+base: U32,digits: List<&2,Nat>) ->
  {PartialsValues.digits_address(axes,base,digits) == (base + Digits.stepped_digits(digits,axis_strides(axes)) : U32) : U32}:
  match axes digits:
    case Con{Views.Axis{+extent,+stride},+rest} Con{+digit,+more}:
      +step = (U32.from_nat(digit) * stride : U32)
      +later = Digits.stepped_digits(more,axis_strides(rest))
      Equal.trans(U32,PartialsValues.digits_address(rest,(base + step : U32),more),((base + step : U32) + later : U32),(base + (step + later : U32) : U32),
        address_stepped(rest,(base + step : U32),more),Arithmetic.add_associative(base,step,later))
    case Nil{} Nil{}: Equal.sym(U32,(base + 0 : U32),base,Arithmetic.add_zero(base))
    case Nil{} Con{+digit,+more}: Equal.sym(U32,(base + 0 : U32),base,Arithmetic.add_zero(base))
    case Con{Views.Axis{+extent,+stride},+rest} Nil{}: Equal.sym(U32,(base + 0 : U32),base,Arithmetic.add_zero(base))

# The strides of the rows of extents, at least one each.
def max_strides(extents: List<&2,U32>) -> List<&2,U32>:
  match extents:
    case Nil{}: []
    case Con{extent,+rest}: U32.max(Grid.product(rest),1) <> max_strides(rest)

def merged_none(flags: List<&2,Bool>) -> {(0 + 0 : U32) == Digits.stepped_digits(ReduceLaws.merged(flags,[],[]),max_strides([])) : U32}:
  match flags:
    case Nil{}: {==}
    case Con{True{},+others}: {==}
    case Con{False{},+others}: {==}

# Steps over the kept digits and over the reduced digits are the steps over
# the digits merged back in axis order.
def merged_stepped(extents: List<&2,U32>,flags: List<&2,Bool>,kept: List<&2,Nat>,reduced: List<&2,Nat>,
  +kept_below: Coordinates.DigitsBelow(Views.axis_extents(PartialsValues.axes_with(extents,flags,False{})),kept),+reduced_below: Coordinates.DigitsBelow(Views.axis_extents(PartialsValues.axes_with(extents,flags,True{})),reduced)) ->
  {(Digits.stepped_digits(kept,axis_strides(PartialsValues.axes_with(extents,flags,False{}))) + Digits.stepped_digits(reduced,axis_strides(PartialsValues.axes_with(extents,flags,True{}))) : U32) == Digits.stepped_digits(ReduceLaws.merged(flags,kept,reduced),max_strides(extents)) : U32}:
  match extents flags kept reduced:
    case Con{+extent,+rest} Con{True{},+others} +kept Nil{}:
      Empty.absurd({(Digits.stepped_digits(kept,axis_strides(PartialsValues.axes_with(extent <> rest,True{} <> others,False{}))) + Digits.stepped_digits([],axis_strides(PartialsValues.axes_with(extent <> rest,True{} <> others,True{}))) : U32) ==
        Digits.stepped_digits(ReduceLaws.merged(True{} <> others,kept,[]),max_strides(extent <> rest)) : U32},reduced_below)
    case Con{+extent,+rest} Con{True{},+others} +kept Con{+digit,+more}:
      KernelGemm.Both{+here,+later} = reduced_below
      +step = (U32.from_nat(digit) * U32.max(Grid.product(rest),1) : U32)
      +before = Digits.stepped_digits(kept,axis_strides(PartialsValues.axes_with(rest,others,False{})))
      +after = Digits.stepped_digits(more,axis_strides(PartialsValues.axes_with(rest,others,True{})))
      +inner = Digits.stepped_digits(ReduceLaws.merged(others,kept,more),max_strides(rest))
      Equal.trans(U32,(before + (step + after : U32) : U32),((before + step : U32) + after : U32),(step + inner : U32),
        Equal.sym(U32,((before + step : U32) + after : U32),(before + (step + after : U32) : U32),Arithmetic.add_associative(before,step,after)),
        Equal.trans(U32,((before + step : U32) + after : U32),((step + before : U32) + after : U32),(step + inner : U32),
          Equal.cong(U32,U32,word => (word + after : U32),(before + step : U32),(step + before : U32),Arithmetic.add_commutative(before,step)),
          Equal.trans(U32,((step + before : U32) + after : U32),(step + (before + after : U32) : U32),(step + inner : U32),
            Arithmetic.add_associative(step,before,after),
            Equal.cong(U32,U32,word => (step + word : U32),(before + after : U32),inner,merged_stepped(rest,others,kept,more,kept_below,later)))))
    case Con{+extent,+rest} Con{False{},+others} Nil{} +reduced:
      Empty.absurd({(Digits.stepped_digits([],axis_strides(PartialsValues.axes_with(extent <> rest,False{} <> others,False{}))) + Digits.stepped_digits(reduced,axis_strides(PartialsValues.axes_with(extent <> rest,False{} <> others,True{}))) : U32) ==
        Digits.stepped_digits(ReduceLaws.merged(False{} <> others,[],reduced),max_strides(extent <> rest)) : U32},kept_below)
    case Con{+extent,+rest} Con{False{},+others} Con{+digit,+more} +reduced:
      KernelGemm.Both{+here,+later} = kept_below
      +step = (U32.from_nat(digit) * U32.max(Grid.product(rest),1) : U32)
      +before = Digits.stepped_digits(more,axis_strides(PartialsValues.axes_with(rest,others,False{})))
      +after = Digits.stepped_digits(reduced,axis_strides(PartialsValues.axes_with(rest,others,True{})))
      +inner = Digits.stepped_digits(ReduceLaws.merged(others,more,reduced),max_strides(rest))
      Equal.trans(U32,((step + before : U32) + after : U32),(step + (before + after : U32) : U32),(step + inner : U32),
        Arithmetic.add_associative(step,before,after),
        Equal.cong(U32,U32,word => (step + word : U32),(before + after : U32),inner,merged_stepped(rest,others,more,reduced,later,reduced_below)))
    case Nil{} +flags Nil{} Nil{}: merged_none(flags)
    case Con{+extent,+rest} Nil{} Nil{} Nil{}: {==}
    case Nil{} +flags Con{+digit,+more} +reduced:
      Empty.absurd({(Digits.stepped_digits(digit <> more,axis_strides(PartialsValues.axes_with([],flags,False{}))) + Digits.stepped_digits(reduced,axis_strides(PartialsValues.axes_with([],flags,True{}))) : U32) ==
        Digits.stepped_digits(ReduceLaws.merged(flags,digit <> more,reduced),max_strides([])) : U32},kept_below)
    case Nil{} +flags Nil{} Con{+digit,+more}:
      Empty.absurd({(Digits.stepped_digits([],axis_strides(PartialsValues.axes_with([],flags,False{}))) + Digits.stepped_digits(digit <> more,axis_strides(PartialsValues.axes_with([],flags,True{}))) : U32) ==
        Digits.stepped_digits(ReduceLaws.merged(flags,[],digit <> more),max_strides([])) : U32},reduced_below)
    case Con{+extent,+rest} Nil{} Con{+digit,+more} +reduced:
      Empty.absurd({(Digits.stepped_digits(digit <> more,axis_strides(PartialsValues.axes_with(extent <> rest,[],False{}))) + Digits.stepped_digits(reduced,axis_strides(PartialsValues.axes_with(extent <> rest,[],True{}))) : U32) ==
        Digits.stepped_digits(ReduceLaws.merged([],digit <> more,reduced),max_strides(extent <> rest)) : U32},kept_below)
    case Con{+extent,+rest} Nil{} Nil{} Con{+digit,+more}:
      Empty.absurd({(Digits.stepped_digits([],axis_strides(PartialsValues.axes_with(extent <> rest,[],False{}))) + Digits.stepped_digits(digit <> more,axis_strides(PartialsValues.axes_with(extent <> rest,[],True{}))) : U32) ==
        Digits.stepped_digits(ReduceLaws.merged([],[],digit <> more),max_strides(extent <> rest)) : U32},reduced_below)

# Without a zero extent and within a capacity, every stride is at least one.
def max_strides_same(extents: List<&2,U32>,+cap: U32,+cap_ok: {U32.is_le(cap,2147483648) == True{} : Bool},+nonzero: {Shapes.has_zero(extents) == False{} : Bool},
  +room: {Nat.is_le(ShapeLaws.elements(extents),U32.to_nat(cap)) == True{} : Bool}) -> {max_strides(extents) == Tasks.strides_of(extents) : List<&2,U32>}:
  match extents:
    case Nil{}: {==}
    case Con{+extent,+rest}:
      +extent_nonzero = Boolean.or_false_left(U32.is_zero(extent),Shapes.has_zero(rest),nonzero)
      +rest_nonzero = Boolean.or_false_right(U32.is_zero(extent),Shapes.has_zero(rest),nonzero)
