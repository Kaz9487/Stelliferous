  Equal.cong(List<&2,Sum.Lanes>,PartialsValues.Box<Sum.Parts>,rows => PartialsValues.Box{PartialsValues.written(~Sum.Parts,LineChainValues.turned_values(~Sum.Lanes,~Sum.Parts,~Sum.parts,rows),TiledReduce.parts_zero()),
