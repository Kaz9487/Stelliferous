    Reduce.line_folds(~Tile.Tile8,~Sum.Lanes,~TiledReduce.lane_operation(~Sum.Lanes,~Sum.step),~Logical,~ReduceLaws.unit_of(~Logical,~original),logical,ShapeLaws.elements(List.take(&2,U32,values,Bool.pick(Nat,Partials.flag_at(Layout.reduced_flags(List.length(&2,U32,values),0n,axes),Nat.sub(List.length(&2,U32,values),1n)),Nat.sub(List.length(&2,U32,values),1n),List.length(&2,U32,values)))),ShapeLaws.elements(List.drop(&2,U32,values,Bool.pick(Nat,Partials.flag_at(Layout.reduced_flags(List.length(&2,U32,values),0n,axes),Nat.sub(List.length(&2,U32,values),1n)),Nat.sub(List.length(&2,U32,values),1n),List.length(&2,U32,values)))),0n,Sum.zero()),
    Reduce.line_folds(~F32,~Sum.Lanes,~Sum.step,~Logical,~original,logical,ShapeLaws.elements(List.take(&2,U32,values,Bool.pick(Nat,Partials.flag_at(Layout.reduced_flags(List.length(&2,U32,values),0n,axes),Nat.sub(List.length(&2,U32,values),1n)),Nat.sub(List.length(&2,U32,values),1n),List.length(&2,U32,values)))),ShapeLaws.elements(List.drop(&2,U32,values,Bool.pick(Nat,Partials.flag_at(Layout.reduced_flags(List.length(&2,U32,values),0n,axes),Nat.sub(List.length(&2,U32,values),1n)),Nat.sub(List.length(&2,U32,values),1n),List.length(&2,U32,values)))),0n,Sum.zero()),
    unit_line_folds(~Sum.Lanes,~Sum.step,~Logical,~original,logical,ShapeLaws.elements(List.take(&2,U32,values,Bool.pick(Nat,Partials.flag_at(Layout.reduced_flags(List.length(&2,U32,values),0n,axes),Nat.sub(List.length(&2,U32,values),1n)),Nat.sub(List.length(&2,U32,values),1n),List.length(&2,U32,values)))),ShapeLaws.elements(List.drop(&2,U32,values,Bool.pick(Nat,Partials.flag_at(Layout.reduced_flags(List.length(&2,U32,values),0n,axes),Nat.sub(List.length(&2,U32,values),1n)),Nat.sub(List.length(&2,U32,values),1n),List.length(&2,U32,values)))),0n,Sum.zero()))

# ---- One value a cell ----

