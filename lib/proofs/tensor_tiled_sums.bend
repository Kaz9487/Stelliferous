# ---- Sums along the last axis ----

# The lanes of a tile from lane on, count of them, hold the values of a line
# from its place of lane on.
def HeldLanes(~Context: Data,~value: Context -> U32 -> F32,count: Nat,+lane: Nat,+tile: Tile.Tile8,+context: Context,+position: Nat) -> Data:
  match count:
    case 0n: Unit
    case 1n+rest:
      KernelGemm.Both<{TileLaws.select_lane(lane,tile) == value(context,U32.from_nat(Nat.add(lane,position))) : F32},
        HeldLanes(~Context,~value,rest,1n+lane,tile,context,position)>

# Lane lane of a tile of a line: below count the value of the line there,
# otherwise the lane of the tile.
def held_lane(~Context: Data,~value: Context -> U32 -> F32,+context: Context,+position: Nat,+count: Nat,+tile: Tile.Tile8,+lane: Nat) -> F32:
  Bool.pick(F32,Nat.is_lt(lane,count),value(context,U32.from_nat(Nat.add(lane,position))),TileLaws.select_lane(lane,tile))

def held(~Context: Data,~value: Context -> U32 -> F32,+context: Context,+position: Nat,+count: Nat,+tile: Tile.Tile8) -> Tile.Tile8:
  Tile.Tile{held_lane(~Context,~value,context,position,count,tile,0n),held_lane(~Context,~value,context,position,count,tile,1n),held_lane(~Context,~value,context,position,count,tile,2n),held_lane(~Context,~value,context,position,count,tile,3n),held_lane(~Context,~value,context,position,count,tile,4n),held_lane(~Context,~value,context,position,count,tile,5n),held_lane(~Context,~value,context,position,count,tile,6n),held_lane(~Context,~value,context,position,count,tile,7n)}

# A tile whose lanes below count hold the values of a line is the tile of
# those values and its other lanes.
def tile_held(~Context: Data,~value: Context -> U32 -> F32,count: Nat,+tile: Tile.Tile8,+context: Context,+position: Nat,+facts: HeldLanes(~Context,~value,count,0n,tile,context,position)) ->
  {tile == held(~Context,~value,context,position,count,tile) : Tile.Tile8}:
  match count:
    case 0n:
      %Equal.sym(Tile.Tile8,tile,Tile.Tile{Tile.lane0(tile),Tile.lane1(tile),Tile.lane2(tile),Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)},TileLaws.tile_eta(tile)) : {_ == held(~Context,~value,context,position,0n,tile) : Tile.Tile8}
      {==}
    case 1n+ +c1:
      match c1:
        case 0n:
          KernelGemm.Both{+fact0,+more} = facts
          %Equal.sym(Tile.Tile8,tile,Tile.Tile{Tile.lane0(tile),Tile.lane1(tile),Tile.lane2(tile),Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)},TileLaws.tile_eta(tile)) : {_ == held(~Context,~value,context,position,1n,tile) : Tile.Tile8}
          %Equal.sym(F32,TileLaws.select_lane(0n,tile),value(context,U32.from_nat(Nat.add(0n,position))),fact0) : {Tile.Tile{_,Tile.lane1(tile),Tile.lane2(tile),Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,1n,tile) : Tile.Tile8}
          {==}
        case 1n+ +c2:
          match c2:
            case 0n:
              KernelGemm.Both{+fact0,KernelGemm.Both{+fact1,+more}} = facts
              %Equal.sym(Tile.Tile8,tile,Tile.Tile{Tile.lane0(tile),Tile.lane1(tile),Tile.lane2(tile),Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)},TileLaws.tile_eta(tile)) : {_ == held(~Context,~value,context,position,2n,tile) : Tile.Tile8}
              %Equal.sym(F32,TileLaws.select_lane(0n,tile),value(context,U32.from_nat(Nat.add(0n,position))),fact0) : {Tile.Tile{_,Tile.lane1(tile),Tile.lane2(tile),Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,2n,tile) : Tile.Tile8}
              %Equal.sym(F32,TileLaws.select_lane(1n,tile),value(context,U32.from_nat(Nat.add(1n,position))),fact1) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),_,Tile.lane2(tile),Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,2n,tile) : Tile.Tile8}
              {==}
            case 1n+ +c3:
              match c3:
                case 0n:
                  KernelGemm.Both{+fact0,KernelGemm.Both{+fact1,KernelGemm.Both{+fact2,+more}}} = facts
                  %Equal.sym(Tile.Tile8,tile,Tile.Tile{Tile.lane0(tile),Tile.lane1(tile),Tile.lane2(tile),Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)},TileLaws.tile_eta(tile)) : {_ == held(~Context,~value,context,position,3n,tile) : Tile.Tile8}
                  %Equal.sym(F32,TileLaws.select_lane(0n,tile),value(context,U32.from_nat(Nat.add(0n,position))),fact0) : {Tile.Tile{_,Tile.lane1(tile),Tile.lane2(tile),Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,3n,tile) : Tile.Tile8}
                  %Equal.sym(F32,TileLaws.select_lane(1n,tile),value(context,U32.from_nat(Nat.add(1n,position))),fact1) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),_,Tile.lane2(tile),Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,3n,tile) : Tile.Tile8}
                  %Equal.sym(F32,TileLaws.select_lane(2n,tile),value(context,U32.from_nat(Nat.add(2n,position))),fact2) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),value(context,U32.from_nat(Nat.add(1n,position))),_,Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,3n,tile) : Tile.Tile8}
                  {==}
                case 1n+ +c4:
                  match c4:
                    case 0n:
                      KernelGemm.Both{+fact0,KernelGemm.Both{+fact1,KernelGemm.Both{+fact2,KernelGemm.Both{+fact3,+more}}}} = facts
                      %Equal.sym(Tile.Tile8,tile,Tile.Tile{Tile.lane0(tile),Tile.lane1(tile),Tile.lane2(tile),Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)},TileLaws.tile_eta(tile)) : {_ == held(~Context,~value,context,position,4n,tile) : Tile.Tile8}
                      %Equal.sym(F32,TileLaws.select_lane(0n,tile),value(context,U32.from_nat(Nat.add(0n,position))),fact0) : {Tile.Tile{_,Tile.lane1(tile),Tile.lane2(tile),Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,4n,tile) : Tile.Tile8}
                      %Equal.sym(F32,TileLaws.select_lane(1n,tile),value(context,U32.from_nat(Nat.add(1n,position))),fact1) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),_,Tile.lane2(tile),Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,4n,tile) : Tile.Tile8}
                      %Equal.sym(F32,TileLaws.select_lane(2n,tile),value(context,U32.from_nat(Nat.add(2n,position))),fact2) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),value(context,U32.from_nat(Nat.add(1n,position))),_,Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,4n,tile) : Tile.Tile8}
                      %Equal.sym(F32,TileLaws.select_lane(3n,tile),value(context,U32.from_nat(Nat.add(3n,position))),fact3) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),value(context,U32.from_nat(Nat.add(1n,position))),value(context,U32.from_nat(Nat.add(2n,position))),_,Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,4n,tile) : Tile.Tile8}
                      {==}
                    case 1n+ +c5:
                      match c5:
                        case 0n:
                          KernelGemm.Both{+fact0,KernelGemm.Both{+fact1,KernelGemm.Both{+fact2,KernelGemm.Both{+fact3,KernelGemm.Both{+fact4,+more}}}}} = facts
                          %Equal.sym(Tile.Tile8,tile,Tile.Tile{Tile.lane0(tile),Tile.lane1(tile),Tile.lane2(tile),Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)},TileLaws.tile_eta(tile)) : {_ == held(~Context,~value,context,position,5n,tile) : Tile.Tile8}
                          %Equal.sym(F32,TileLaws.select_lane(0n,tile),value(context,U32.from_nat(Nat.add(0n,position))),fact0) : {Tile.Tile{_,Tile.lane1(tile),Tile.lane2(tile),Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,5n,tile) : Tile.Tile8}
                          %Equal.sym(F32,TileLaws.select_lane(1n,tile),value(context,U32.from_nat(Nat.add(1n,position))),fact1) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),_,Tile.lane2(tile),Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,5n,tile) : Tile.Tile8}
                          %Equal.sym(F32,TileLaws.select_lane(2n,tile),value(context,U32.from_nat(Nat.add(2n,position))),fact2) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),value(context,U32.from_nat(Nat.add(1n,position))),_,Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,5n,tile) : Tile.Tile8}
                          %Equal.sym(F32,TileLaws.select_lane(3n,tile),value(context,U32.from_nat(Nat.add(3n,position))),fact3) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),value(context,U32.from_nat(Nat.add(1n,position))),value(context,U32.from_nat(Nat.add(2n,position))),_,Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,5n,tile) : Tile.Tile8}
                          %Equal.sym(F32,TileLaws.select_lane(4n,tile),value(context,U32.from_nat(Nat.add(4n,position))),fact4) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),value(context,U32.from_nat(Nat.add(1n,position))),value(context,U32.from_nat(Nat.add(2n,position))),value(context,U32.from_nat(Nat.add(3n,position))),_,Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,5n,tile) : Tile.Tile8}
                          {==}
                        case 1n+ +c6:
                          match c6:
                            case 0n:
                              KernelGemm.Both{+fact0,KernelGemm.Both{+fact1,KernelGemm.Both{+fact2,KernelGemm.Both{+fact3,KernelGemm.Both{+fact4,KernelGemm.Both{+fact5,+more}}}}}} = facts
                              %Equal.sym(Tile.Tile8,tile,Tile.Tile{Tile.lane0(tile),Tile.lane1(tile),Tile.lane2(tile),Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)},TileLaws.tile_eta(tile)) : {_ == held(~Context,~value,context,position,6n,tile) : Tile.Tile8}
                              %Equal.sym(F32,TileLaws.select_lane(0n,tile),value(context,U32.from_nat(Nat.add(0n,position))),fact0) : {Tile.Tile{_,Tile.lane1(tile),Tile.lane2(tile),Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,6n,tile) : Tile.Tile8}
                              %Equal.sym(F32,TileLaws.select_lane(1n,tile),value(context,U32.from_nat(Nat.add(1n,position))),fact1) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),_,Tile.lane2(tile),Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,6n,tile) : Tile.Tile8}
                              %Equal.sym(F32,TileLaws.select_lane(2n,tile),value(context,U32.from_nat(Nat.add(2n,position))),fact2) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),value(context,U32.from_nat(Nat.add(1n,position))),_,Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,6n,tile) : Tile.Tile8}
                              %Equal.sym(F32,TileLaws.select_lane(3n,tile),value(context,U32.from_nat(Nat.add(3n,position))),fact3) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),value(context,U32.from_nat(Nat.add(1n,position))),value(context,U32.from_nat(Nat.add(2n,position))),_,Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,6n,tile) : Tile.Tile8}
                              %Equal.sym(F32,TileLaws.select_lane(4n,tile),value(context,U32.from_nat(Nat.add(4n,position))),fact4) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),value(context,U32.from_nat(Nat.add(1n,position))),value(context,U32.from_nat(Nat.add(2n,position))),value(context,U32.from_nat(Nat.add(3n,position))),_,Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,6n,tile) : Tile.Tile8}
                              %Equal.sym(F32,TileLaws.select_lane(5n,tile),value(context,U32.from_nat(Nat.add(5n,position))),fact5) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),value(context,U32.from_nat(Nat.add(1n,position))),value(context,U32.from_nat(Nat.add(2n,position))),value(context,U32.from_nat(Nat.add(3n,position))),value(context,U32.from_nat(Nat.add(4n,position))),_,Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,6n,tile) : Tile.Tile8}
                              {==}
                            case 1n+ +c7:
                              match c7:
                                case 0n:
                                  KernelGemm.Both{+fact0,KernelGemm.Both{+fact1,KernelGemm.Both{+fact2,KernelGemm.Both{+fact3,KernelGemm.Both{+fact4,KernelGemm.Both{+fact5,KernelGemm.Both{+fact6,+more}}}}}}} = facts
                                  %Equal.sym(Tile.Tile8,tile,Tile.Tile{Tile.lane0(tile),Tile.lane1(tile),Tile.lane2(tile),Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)},TileLaws.tile_eta(tile)) : {_ == held(~Context,~value,context,position,7n,tile) : Tile.Tile8}
                                  %Equal.sym(F32,TileLaws.select_lane(0n,tile),value(context,U32.from_nat(Nat.add(0n,position))),fact0) : {Tile.Tile{_,Tile.lane1(tile),Tile.lane2(tile),Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,7n,tile) : Tile.Tile8}
                                  %Equal.sym(F32,TileLaws.select_lane(1n,tile),value(context,U32.from_nat(Nat.add(1n,position))),fact1) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),_,Tile.lane2(tile),Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,7n,tile) : Tile.Tile8}
                                  %Equal.sym(F32,TileLaws.select_lane(2n,tile),value(context,U32.from_nat(Nat.add(2n,position))),fact2) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),value(context,U32.from_nat(Nat.add(1n,position))),_,Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,7n,tile) : Tile.Tile8}
                                  %Equal.sym(F32,TileLaws.select_lane(3n,tile),value(context,U32.from_nat(Nat.add(3n,position))),fact3) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),value(context,U32.from_nat(Nat.add(1n,position))),value(context,U32.from_nat(Nat.add(2n,position))),_,Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,7n,tile) : Tile.Tile8}
                                  %Equal.sym(F32,TileLaws.select_lane(4n,tile),value(context,U32.from_nat(Nat.add(4n,position))),fact4) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),value(context,U32.from_nat(Nat.add(1n,position))),value(context,U32.from_nat(Nat.add(2n,position))),value(context,U32.from_nat(Nat.add(3n,position))),_,Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,7n,tile) : Tile.Tile8}
                                  %Equal.sym(F32,TileLaws.select_lane(5n,tile),value(context,U32.from_nat(Nat.add(5n,position))),fact5) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),value(context,U32.from_nat(Nat.add(1n,position))),value(context,U32.from_nat(Nat.add(2n,position))),value(context,U32.from_nat(Nat.add(3n,position))),value(context,U32.from_nat(Nat.add(4n,position))),_,Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,7n,tile) : Tile.Tile8}
                                  %Equal.sym(F32,TileLaws.select_lane(6n,tile),value(context,U32.from_nat(Nat.add(6n,position))),fact6) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),value(context,U32.from_nat(Nat.add(1n,position))),value(context,U32.from_nat(Nat.add(2n,position))),value(context,U32.from_nat(Nat.add(3n,position))),value(context,U32.from_nat(Nat.add(4n,position))),value(context,U32.from_nat(Nat.add(5n,position))),_,Tile.lane7(tile)} == held(~Context,~value,context,position,7n,tile) : Tile.Tile8}
                                  {==}
                                case 1n+ +c8:
                                  KernelGemm.Both{+fact0,KernelGemm.Both{+fact1,KernelGemm.Both{+fact2,KernelGemm.Both{+fact3,KernelGemm.Both{+fact4,KernelGemm.Both{+fact5,KernelGemm.Both{+fact6,KernelGemm.Both{+fact7,+more}}}}}}}} = facts
                                  %Equal.sym(Tile.Tile8,tile,Tile.Tile{Tile.lane0(tile),Tile.lane1(tile),Tile.lane2(tile),Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)},TileLaws.tile_eta(tile)) : {_ == held(~Context,~value,context,position,1n+1n+1n+1n+1n+1n+1n+1n+c8,tile) : Tile.Tile8}
                                  %Equal.sym(F32,TileLaws.select_lane(0n,tile),value(context,U32.from_nat(Nat.add(0n,position))),fact0) : {Tile.Tile{_,Tile.lane1(tile),Tile.lane2(tile),Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,1n+1n+1n+1n+1n+1n+1n+1n+c8,tile) : Tile.Tile8}
                                  %Equal.sym(F32,TileLaws.select_lane(1n,tile),value(context,U32.from_nat(Nat.add(1n,position))),fact1) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),_,Tile.lane2(tile),Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,1n+1n+1n+1n+1n+1n+1n+1n+c8,tile) : Tile.Tile8}
                                  %Equal.sym(F32,TileLaws.select_lane(2n,tile),value(context,U32.from_nat(Nat.add(2n,position))),fact2) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),value(context,U32.from_nat(Nat.add(1n,position))),_,Tile.lane3(tile),Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,1n+1n+1n+1n+1n+1n+1n+1n+c8,tile) : Tile.Tile8}
                                  %Equal.sym(F32,TileLaws.select_lane(3n,tile),value(context,U32.from_nat(Nat.add(3n,position))),fact3) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),value(context,U32.from_nat(Nat.add(1n,position))),value(context,U32.from_nat(Nat.add(2n,position))),_,Tile.lane4(tile),Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,1n+1n+1n+1n+1n+1n+1n+1n+c8,tile) : Tile.Tile8}
                                  %Equal.sym(F32,TileLaws.select_lane(4n,tile),value(context,U32.from_nat(Nat.add(4n,position))),fact4) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),value(context,U32.from_nat(Nat.add(1n,position))),value(context,U32.from_nat(Nat.add(2n,position))),value(context,U32.from_nat(Nat.add(3n,position))),_,Tile.lane5(tile),Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,1n+1n+1n+1n+1n+1n+1n+1n+c8,tile) : Tile.Tile8}
                                  %Equal.sym(F32,TileLaws.select_lane(5n,tile),value(context,U32.from_nat(Nat.add(5n,position))),fact5) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),value(context,U32.from_nat(Nat.add(1n,position))),value(context,U32.from_nat(Nat.add(2n,position))),value(context,U32.from_nat(Nat.add(3n,position))),value(context,U32.from_nat(Nat.add(4n,position))),_,Tile.lane6(tile),Tile.lane7(tile)} == held(~Context,~value,context,position,1n+1n+1n+1n+1n+1n+1n+1n+c8,tile) : Tile.Tile8}
                                  %Equal.sym(F32,TileLaws.select_lane(6n,tile),value(context,U32.from_nat(Nat.add(6n,position))),fact6) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),value(context,U32.from_nat(Nat.add(1n,position))),value(context,U32.from_nat(Nat.add(2n,position))),value(context,U32.from_nat(Nat.add(3n,position))),value(context,U32.from_nat(Nat.add(4n,position))),value(context,U32.from_nat(Nat.add(5n,position))),_,Tile.lane7(tile)} == held(~Context,~value,context,position,1n+1n+1n+1n+1n+1n+1n+1n+c8,tile) : Tile.Tile8}
                                  %Equal.sym(F32,TileLaws.select_lane(7n,tile),value(context,U32.from_nat(Nat.add(7n,position))),fact7) : {Tile.Tile{value(context,U32.from_nat(Nat.add(0n,position))),value(context,U32.from_nat(Nat.add(1n,position))),value(context,U32.from_nat(Nat.add(2n,position))),value(context,U32.from_nat(Nat.add(3n,position))),value(context,U32.from_nat(Nat.add(4n,position))),value(context,U32.from_nat(Nat.add(5n,position))),value(context,U32.from_nat(Nat.add(6n,position))),_} == held(~Context,~value,context,position,1n+1n+1n+1n+1n+1n+1n+1n+c8,tile) : Tile.Tile8}
                                  {==}

# A tile turned by turns lanes: lane k holds lane k + turns.
def rotated(turns: Nat,tile: Tile.Tile8) -> Tile.Tile8:
  match turns tile:
    case 1n Tile.Tile{a,b,c,d,e,f,g,h}: Tile.Tile{b,c,d,e,f,g,h,a}
    case 2n Tile.Tile{a,b,c,d,e,f,g,h}: Tile.Tile{c,d,e,f,g,h,a,b}
    case 3n Tile.Tile{a,b,c,d,e,f,g,h}: Tile.Tile{d,e,f,g,h,a,b,c}
    case 4n Tile.Tile{a,b,c,d,e,f,g,h}: Tile.Tile{e,f,g,h,a,b,c,d}
    case 5n Tile.Tile{a,b,c,d,e,f,g,h}: Tile.Tile{f,g,h,a,b,c,d,e}
    case 6n Tile.Tile{a,b,c,d,e,f,g,h}: Tile.Tile{g,h,a,b,c,d,e,f}
    case 7n Tile.Tile{a,b,c,d,e,f,g,h}: Tile.Tile{h,a,b,c,d,e,f,g}
    case turns tile: tile

# The lanes of a sum turned by turns, its phase turns past a group, merge as
# the lanes in place.
def turned_parts(turns: Nat,+hi: Tile.Tile8,+lo: Tile.Tile8,+phase: U32,+now: {U32.and(phase,7) == Slots.word(turns) : U32}) ->
  {Sum.parts(Sum.Lanes{rotated(turns,hi),rotated(turns,lo),phase}) == Sum.parts(Sum.Lanes{hi,lo,0}) : Sum.Parts}:
  match turns:
    case 0n:
      match hi lo:
        case Tile.Tile{+h0,+h1,+h2,+h3,+h4,+h5,+h6,+h7} Tile.Tile{+l0,+l1,+l2,+l3,+l4,+l5,+l6,+l7}:
          %Equal.sym(U32,U32.and(phase,7),Slots.word(0n),now) :
            {Sum.in_order(U32.to_nat(_),Sum.Parts{h0,l0},Sum.Parts{h1,l1},Sum.Parts{h2,l2},Sum.Parts{h3,l3},Sum.Parts{h4,l4},Sum.Parts{h5,l5},Sum.Parts{h6,l6},Sum.Parts{h7,l7}) == Sum.parts(Sum.Lanes{Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7},0}) : Sum.Parts}
          {==}
    case 1n+ +t1:
      match t1:
        case 0n:
          match hi lo:
            case Tile.Tile{+h0,+h1,+h2,+h3,+h4,+h5,+h6,+h7} Tile.Tile{+l0,+l1,+l2,+l3,+l4,+l5,+l6,+l7}:
              %Equal.sym(U32,U32.and(phase,7),Slots.word(1n),now) :
                {Sum.in_order(U32.to_nat(_),Sum.Parts{h1,l1},Sum.Parts{h2,l2},Sum.Parts{h3,l3},Sum.Parts{h4,l4},Sum.Parts{h5,l5},Sum.Parts{h6,l6},Sum.Parts{h7,l7},Sum.Parts{h0,l0}) == Sum.parts(Sum.Lanes{Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7},0}) : Sum.Parts}
              {==}
        case 1n+ +t2:
          match t2:
            case 0n:
              match hi lo:
                case Tile.Tile{+h0,+h1,+h2,+h3,+h4,+h5,+h6,+h7} Tile.Tile{+l0,+l1,+l2,+l3,+l4,+l5,+l6,+l7}:
                  %Equal.sym(U32,U32.and(phase,7),Slots.word(2n),now) :
                    {Sum.in_order(U32.to_nat(_),Sum.Parts{h2,l2},Sum.Parts{h3,l3},Sum.Parts{h4,l4},Sum.Parts{h5,l5},Sum.Parts{h6,l6},Sum.Parts{h7,l7},Sum.Parts{h0,l0},Sum.Parts{h1,l1}) == Sum.parts(Sum.Lanes{Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7},0}) : Sum.Parts}
                  {==}
            case 1n+ +t3:
              match t3:
                case 0n:
                  match hi lo:
                    case Tile.Tile{+h0,+h1,+h2,+h3,+h4,+h5,+h6,+h7} Tile.Tile{+l0,+l1,+l2,+l3,+l4,+l5,+l6,+l7}:
                      %Equal.sym(U32,U32.and(phase,7),Slots.word(3n),now) :
                        {Sum.in_order(U32.to_nat(_),Sum.Parts{h3,l3},Sum.Parts{h4,l4},Sum.Parts{h5,l5},Sum.Parts{h6,l6},Sum.Parts{h7,l7},Sum.Parts{h0,l0},Sum.Parts{h1,l1},Sum.Parts{h2,l2}) == Sum.parts(Sum.Lanes{Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7},0}) : Sum.Parts}
                      {==}
                case 1n+ +t4:
                  match t4:
                    case 0n:
                      match hi lo:
                        case Tile.Tile{+h0,+h1,+h2,+h3,+h4,+h5,+h6,+h7} Tile.Tile{+l0,+l1,+l2,+l3,+l4,+l5,+l6,+l7}:
                          %Equal.sym(U32,U32.and(phase,7),Slots.word(4n),now) :
                            {Sum.in_order(U32.to_nat(_),Sum.Parts{h4,l4},Sum.Parts{h5,l5},Sum.Parts{h6,l6},Sum.Parts{h7,l7},Sum.Parts{h0,l0},Sum.Parts{h1,l1},Sum.Parts{h2,l2},Sum.Parts{h3,l3}) == Sum.parts(Sum.Lanes{Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7},0}) : Sum.Parts}
                          {==}
                    case 1n+ +t5:
                      match t5:
                        case 0n:
                          match hi lo:
                            case Tile.Tile{+h0,+h1,+h2,+h3,+h4,+h5,+h6,+h7} Tile.Tile{+l0,+l1,+l2,+l3,+l4,+l5,+l6,+l7}:
                              %Equal.sym(U32,U32.and(phase,7),Slots.word(5n),now) :
                                {Sum.in_order(U32.to_nat(_),Sum.Parts{h5,l5},Sum.Parts{h6,l6},Sum.Parts{h7,l7},Sum.Parts{h0,l0},Sum.Parts{h1,l1},Sum.Parts{h2,l2},Sum.Parts{h3,l3},Sum.Parts{h4,l4}) == Sum.parts(Sum.Lanes{Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7},0}) : Sum.Parts}
                              {==}
                        case 1n+ +t6:
                          match t6:
                            case 0n:
                              match hi lo:
                                case Tile.Tile{+h0,+h1,+h2,+h3,+h4,+h5,+h6,+h7} Tile.Tile{+l0,+l1,+l2,+l3,+l4,+l5,+l6,+l7}:
                                  %Equal.sym(U32,U32.and(phase,7),Slots.word(6n),now) :
                                    {Sum.in_order(U32.to_nat(_),Sum.Parts{h6,l6},Sum.Parts{h7,l7},Sum.Parts{h0,l0},Sum.Parts{h1,l1},Sum.Parts{h2,l2},Sum.Parts{h3,l3},Sum.Parts{h4,l4},Sum.Parts{h5,l5}) == Sum.parts(Sum.Lanes{Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7},0}) : Sum.Parts}
                                  {==}
                            case 1n+ +t7:
                              match t7:
                                case 0n:
                                  match hi lo:
                                    case Tile.Tile{+h0,+h1,+h2,+h3,+h4,+h5,+h6,+h7} Tile.Tile{+l0,+l1,+l2,+l3,+l4,+l5,+l6,+l7}:
                                      %Equal.sym(U32,U32.and(phase,7),Slots.word(7n),now) :
                                        {Sum.in_order(U32.to_nat(_),Sum.Parts{h7,l7},Sum.Parts{h0,l0},Sum.Parts{h1,l1},Sum.Parts{h2,l2},Sum.Parts{h3,l3},Sum.Parts{h4,l4},Sum.Parts{h5,l5},Sum.Parts{h6,l6}) == Sum.parts(Sum.Lanes{Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7},0}) : Sum.Parts}
                                      {==}
                                case 1n+ +t8:
                                  match hi lo:
                                    case Tile.Tile{+h0,+h1,+h2,+h3,+h4,+h5,+h6,+h7} Tile.Tile{+l0,+l1,+l2,+l3,+l4,+l5,+l6,+l7}:
                                      %Equal.sym(U32,U32.and(phase,7),Slots.word(1n+1n+1n+1n+1n+1n+1n+1n+t8),now) :
                                        {Sum.in_order(U32.to_nat(_),Sum.Parts{h0,l0},Sum.Parts{h1,l1},Sum.Parts{h2,l2},Sum.Parts{h3,l3},Sum.Parts{h4,l4},Sum.Parts{h5,l5},Sum.Parts{h6,l6},Sum.Parts{h7,l7}) == Sum.parts(Sum.Lanes{Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7},0}) : Sum.Parts}
                                      {==}

def low_turn(+phase: U32,low: Slots.Low<phase>) -> Nat:
  Slots.Low{turn,now,next} = low
  turn

# The low bits of a phase name its turn.
def low_now(+phase: U32,+low: Slots.Low<phase>) -> {U32.and(phase,7) == Slots.word(low_turn(phase,low)) : U32}:
  Slots.Low{+turn,+now,+next} = low
  now

# The tiles of a line, a group a tile, hold its values: every lane of a whole
# group, the first tail lanes of the last group.
def GroupsHeld(~CellContext: Data,~cell: CellContext -> U32 -> Tile.Tile8,~Context: Data,~value: Context -> U32 -> F32,groups: Nat,+cells: CellContext,+context: Context,+tail: Nat,+cell_at: Nat,+value_at: Nat) -> Data:
  match groups:
    case 0n: HeldLanes(~Context,~value,tail,0n,cell(cells,U32.from_nat(cell_at)),context,value_at)
    case 1n+rest:
      KernelGemm.Both<HeldLanes(~Context,~value,8n,0n,cell(cells,U32.from_nat(cell_at)),context,value_at),
        GroupsHeld(~CellContext,~cell,~Context,~value,rest,cells,context,tail,1n+cell_at,Nat.add(8n,value_at))>

# The last group of a line, tail lanes of values, closes as the sum of the
# values.
def last_summed(~CellContext: Data,~cell: CellContext -> U32 -> Tile.Tile8,~Context: Data,~value: Context -> U32 -> F32,tail: Nat,+cells: CellContext,+context: Context,+cell_at: Nat,+value_at: Nat,+lanes: U32,+first: U32,+rest: Word(29n),
  +hi: Tile.Tile8,+lo: Tile.Tile8,+count_eq: {(lanes - first : U32) == U32.from_nat(tail) : U32},
  +tail_positive: {Nat.is_lt(0n,tail) == True{} : Bool},+tail_small: {Nat.is_le(tail,8n) == True{} : Bool},
  +lanes_held: HeldLanes(~Context,~value,tail,0n,cell(cells,U32.from_nat(cell_at)),context,value_at)) ->
  {TiledReduce.line_closed(Reduce.line_fold(~Tile.Tile8,~TiledReduce.SumLine,~TiledReduce.line_added,~CellContext,~cell,cells,1n,cell_at,TiledReduce.SumLine{Sum.TileParts{hi,lo},first,lanes})) ==
    Sum.parts(Reduce.line_fold(~F32,~Sum.Lanes,~Sum.step,~Context,~value,context,tail,value_at,Sum.Lanes{hi,lo,U32{WCon{False{},WCon{False{},WCon{False{},rest}}}}})) : Sum.Parts}:
  match tail:
    case 0n: Empty.absurd({TiledReduce.line_closed(Reduce.line_fold(~Tile.Tile8,~TiledReduce.SumLine,~TiledReduce.line_added,~CellContext,~cell,cells,1n,cell_at,TiledReduce.SumLine{Sum.TileParts{hi,lo},first,lanes})) ==
    Sum.parts(Reduce.line_fold(~F32,~Sum.Lanes,~Sum.step,~Context,~value,context,0n,value_at,Sum.Lanes{hi,lo,U32{WCon{False{},WCon{False{},WCon{False{},rest}}}}})) : Sum.Parts},WordEncoding.false_true(tail_positive))
    case 1n+ +s1:
      match s1:
        case 0n:
          match hi lo:
            case Tile.Tile{+h0,+h1,+h2,+h3,+h4,+h5,+h6,+h7} Tile.Tile{+l0,+l1,+l2,+l3,+l4,+l5,+l6,+l7}:
              +tile = cell(cells,U32.from_nat(cell_at))
              +values = held(~Context,~value,context,value_at,1n,tile)
              +word = U32.from_nat(1n)
              +parts = TiledReduce.cell_added(U32.is_le(8,word),word,Sum.TileParts{Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7}},values)
              +phase = Slots.ahead(1n,U32{WCon{False{},WCon{False{},WCon{False{},rest}}}})
              Equal.trans(Sum.Parts,TiledReduce.row_closed(TiledReduce.cell_added(U32.is_le(8,(lanes - first : U32)),(lanes - first : U32),Sum.TileParts{Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7}},tile)),
                TiledReduce.row_closed(TiledReduce.cell_added(U32.is_le(8,word),word,Sum.TileParts{Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7}},tile)),Sum.parts(Sum.Lanes{rotated(1n,Slots.hi_of(parts)),rotated(1n,Slots.lo_of(parts)),phase}),
                Equal.cong(U32,Sum.Parts,count => TiledReduce.row_closed(TiledReduce.cell_added(U32.is_le(8,count),count,Sum.TileParts{Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7}},tile)),(lanes - first : U32),word,count_eq),
                Equal.trans(Sum.Parts,TiledReduce.row_closed(TiledReduce.cell_added(U32.is_le(8,word),word,Sum.TileParts{Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7}},tile)),Sum.parts(Sum.Lanes{Slots.hi_of(parts),Slots.lo_of(parts),0}),
                  Sum.parts(Sum.Lanes{rotated(1n,Slots.hi_of(parts)),rotated(1n,Slots.lo_of(parts)),phase}),
                  Equal.cong(Tile.Tile8,Sum.Parts,cell_tile => TiledReduce.row_closed(TiledReduce.cell_added(U32.is_le(8,word),word,Sum.TileParts{Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7}},cell_tile)),tile,values,
                    tile_held(~Context,~value,1n,tile,context,value_at,lanes_held)),
                  Equal.sym(Sum.Parts,Sum.parts(Sum.Lanes{rotated(1n,Slots.hi_of(parts)),rotated(1n,Slots.lo_of(parts)),phase}),Sum.parts(Sum.Lanes{Slots.hi_of(parts),Slots.lo_of(parts),0}),
                    turned_parts(1n,Slots.hi_of(parts),Slots.lo_of(parts),phase,low_now(phase,Slots.low(phase))))))
        case 1n+ +s2:
          match s2:
            case 0n:
              match hi lo:
                case Tile.Tile{+h0,+h1,+h2,+h3,+h4,+h5,+h6,+h7} Tile.Tile{+l0,+l1,+l2,+l3,+l4,+l5,+l6,+l7}:
                  +tile = cell(cells,U32.from_nat(cell_at))
                  +values = held(~Context,~value,context,value_at,2n,tile)
                  +word = U32.from_nat(2n)
                  +parts = TiledReduce.cell_added(U32.is_le(8,word),word,Sum.TileParts{Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7}},values)
                  +phase = Slots.ahead(2n,U32{WCon{False{},WCon{False{},WCon{False{},rest}}}})
                  Equal.trans(Sum.Parts,TiledReduce.row_closed(TiledReduce.cell_added(U32.is_le(8,(lanes - first : U32)),(lanes - first : U32),Sum.TileParts{Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7}},tile)),
                    TiledReduce.row_closed(TiledReduce.cell_added(U32.is_le(8,word),word,Sum.TileParts{Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7}},tile)),Sum.parts(Sum.Lanes{rotated(2n,Slots.hi_of(parts)),rotated(2n,Slots.lo_of(parts)),phase}),
                    Equal.cong(U32,Sum.Parts,count => TiledReduce.row_closed(TiledReduce.cell_added(U32.is_le(8,count),count,Sum.TileParts{Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7}},tile)),(lanes - first : U32),word,count_eq),
                    Equal.trans(Sum.Parts,TiledReduce.row_closed(TiledReduce.cell_added(U32.is_le(8,word),word,Sum.TileParts{Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7}},tile)),Sum.parts(Sum.Lanes{Slots.hi_of(parts),Slots.lo_of(parts),0}),
                      Sum.parts(Sum.Lanes{rotated(2n,Slots.hi_of(parts)),rotated(2n,Slots.lo_of(parts)),phase}),
                      Equal.cong(Tile.Tile8,Sum.Parts,cell_tile => TiledReduce.row_closed(TiledReduce.cell_added(U32.is_le(8,word),word,Sum.TileParts{Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7}},cell_tile)),tile,values,
                        tile_held(~Context,~value,2n,tile,context,value_at,lanes_held)),
                      Equal.sym(Sum.Parts,Sum.parts(Sum.Lanes{rotated(2n,Slots.hi_of(parts)),rotated(2n,Slots.lo_of(parts)),phase}),Sum.parts(Sum.Lanes{Slots.hi_of(parts),Slots.lo_of(parts),0}),
                        turned_parts(2n,Slots.hi_of(parts),Slots.lo_of(parts),phase,low_now(phase,Slots.low(phase))))))
            case 1n+ +s3:
              match s3:
                case 0n:
                  match hi lo:
                    case Tile.Tile{+h0,+h1,+h2,+h3,+h4,+h5,+h6,+h7} Tile.Tile{+l0,+l1,+l2,+l3,+l4,+l5,+l6,+l7}:
                      +tile = cell(cells,U32.from_nat(cell_at))
                      +values = held(~Context,~value,context,value_at,3n,tile)
                      +word = U32.from_nat(3n)
                      +parts = TiledReduce.cell_added(U32.is_le(8,word),word,Sum.TileParts{Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7}},values)
                      +phase = Slots.ahead(3n,U32{WCon{False{},WCon{False{},WCon{False{},rest}}}})
                      Equal.trans(Sum.Parts,TiledReduce.row_closed(TiledReduce.cell_added(U32.is_le(8,(lanes - first : U32)),(lanes - first : U32),Sum.TileParts{Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7}},tile)),
                        TiledReduce.row_closed(TiledReduce.cell_added(U32.is_le(8,word),word,Sum.TileParts{Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7}},tile)),Sum.parts(Sum.Lanes{rotated(3n,Slots.hi_of(parts)),rotated(3n,Slots.lo_of(parts)),phase}),
                        Equal.cong(U32,Sum.Parts,count => TiledReduce.row_closed(TiledReduce.cell_added(U32.is_le(8,count),count,Sum.TileParts{Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7}},tile)),(lanes - first : U32),word,count_eq),
                        Equal.trans(Sum.Parts,TiledReduce.row_closed(TiledReduce.cell_added(U32.is_le(8,word),word,Sum.TileParts{Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7}},tile)),Sum.parts(Sum.Lanes{Slots.hi_of(parts),Slots.lo_of(parts),0}),
