# ---- The values of a line of a row ----

def with_kept(flag: Bool,+wanted: Bool,+extent: U32,+stride: U32,+axes: List<&2,Views.Axis>,+picked: List<&2,U32>,+same: {Views.axis_extents(axes) == picked : List<&2,U32>}) ->
  {Views.axis_extents(PartialsValues.kept_axis(PartialsValues.same_flag(flag,wanted),Views.Axis{extent,stride},axes)) == ReduceLaws.kept_extent(flag,wanted,extent,picked) : List<&2,U32>}:
  match flag wanted:
    case True{} True{}: Equal.cong(List<&2,U32>,List<&2,U32>,rest => extent <> rest,Views.axis_extents(axes),picked,same)
    case False{} False{}: Equal.cong(List<&2,U32>,List<&2,U32>,rest => extent <> rest,Views.axis_extents(axes),picked,same)
    case True{} False{}: same
    case False{} True{}: same

# The extents of the axes of Partials of a flag are those it picks.
def with_picked(extents: List<&2,U32>,flags: List<&2,Bool>,+wanted: Bool) ->
  {Views.axis_extents(PartialsValues.axes_with(extents,flags,wanted)) == ReduceLaws.picked_extents(extents,flags,wanted) : List<&2,U32>}:
  match extents flags:
    case Nil{} Nil{}: {==}
    case Nil{} Con{+flag,+others}: {==}
    case Con{+extent,+rest} Nil{}: {==}
    case Con{+extent,+rest} Con{+flag,+others}:
      with_kept(flag,wanted,extent,U32.max(Grid.product(rest),1),PartialsValues.axes_with(rest,others,wanted),ReduceLaws.picked_extents(rest,others,wanted),with_picked(rest,others,wanted))

def none_after_end(flags: List<&2,Bool>,+flag: Bool) -> {TiledReduce.none_after(flag <> flags,List.length(&2,Bool,flags)) == True{} : Bool}:
  match flags:
    case Nil{}: {==}
    case Con{+next,+rest}: none_after_end(rest,next)

def none_after_count(flags: List<&2,Bool>,+positive: {Nat.is_lt(0n,List.length(&2,Bool,flags)) == True{} : Bool}) ->
  {TiledReduce.none_after(flags,Nat.sub(List.length(&2,Bool,flags),1n)) == True{} : Bool}:
  match flags:
    case Nil{}: Empty.absurd({TiledReduce.none_after([],Nat.sub(0n,1n)) == True{} : Bool},Order.below_zero(0n,positive))
    case Con{+flag,+rest}:
      %Equal.sym(Nat,Nat.sub(List.length(&2,Bool,rest),0n),List.length(&2,Bool,rest),Order.subtract_zero(List.length(&2,Bool,rest))) :
        {TiledReduce.none_after(flag <> rest,_) == True{} : Bool}
      none_after_end(rest,flag)

# No flag follows the last axis.
def none_after_last(+flags: List<&2,Bool>,+rank: Nat,+same: {rank == List.length(&2,Bool,flags) : Nat},+positive: {Nat.is_lt(0n,rank) == True{} : Bool}) ->
  {TiledReduce.none_after(flags,Nat.sub(rank,1n)) == True{} : Bool}:
  %Equal.sym(Nat,rank,List.length(&2,Bool,flags),same) : {TiledReduce.none_after(flags,Nat.sub(_,1n)) == True{} : Bool}
  none_after_count(flags,{%same : {Nat.is_lt(0n,_) == True{} : Bool} positive : {Nat.is_lt(0n,List.length(&2,Bool,flags)) == True{} : Bool}})

# A digit put back past the digits follows them.
def inserted_end(digits: List<&2,Nat>,+value: Nat) -> {Coordinates.inserted_digit(List.length(&2,Nat,digits),digits,value) == List.append(&2,Nat,digits,[value]) : List<&2,Nat>}:
  match digits:
    case Nil{}: {==}
    case Con{+digit,+rest}:
      Equal.cong(List<&2,Nat>,List<&2,Nat>,tail => digit <> tail,Coordinates.inserted_digit(List.length(&2,Nat,rest),rest,value),List.append(&2,Nat,rest,[value]),inserted_end(rest,value))

# The extents but the last, then the last.
def removed_appended(shape: List<&2,U32>,index: Nat,+exact: {Nat.add(index,1n) == List.length(&2,U32,shape) : Nat}) ->
