# The groups of a line, then tail lanes of values in its last group, close as
# the sum of the values, the lanes of the sum in place at the start.
def groups_summed(~CellContext: Data,~cell: CellContext -> U32 -> Tile.Tile8,~Context: Data,~value: Context -> U32 -> F32,groups: Nat,+cells: CellContext,+context: Context,+tail: Nat,+cell_at: Nat,+value_at: Nat,+limits: Machine.Limits,
  +lanes: U32,+first: U32,+first_value: Nat,+first_exact: {U32.to_nat(first) == first_value : Nat},
  +lanes_exact: {U32.to_nat(lanes) == Nat.add(first_value,Nat.add(Nat.mul(groups,8n),tail)) : Nat},+lanes_room: {Nat.is_le(U32.to_nat(lanes),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},
  +tail_positive: {Nat.is_lt(0n,tail) == True{} : Bool},+tail_small: {Nat.is_le(tail,8n) == True{} : Bool},+rest: Word(29n),+hi: Tile.Tile8,+lo: Tile.Tile8,
  +groups_held: GroupsHeld(~CellContext,~cell,~Context,~value,groups,cells,context,tail,cell_at,value_at)) ->
  {TiledReduce.line_closed(Reduce.line_fold(~Tile.Tile8,~TiledReduce.SumLine,~TiledReduce.line_added,~CellContext,~cell,cells,1n+groups,cell_at,TiledReduce.SumLine{Sum.TileParts{hi,lo},first,lanes})) ==
    Sum.parts(Reduce.line_fold(~F32,~Sum.Lanes,~Sum.step,~Context,~value,context,Nat.add(Nat.mul(groups,8n),tail),value_at,Sum.Lanes{hi,lo,U32{WCon{False{},WCon{False{},WCon{False{},rest}}}}})) : Sum.Parts}:
  match groups:
    case 0n:
      +room = {%lanes_exact : {Nat.is_le(_,U32.to_nat(Machine.capacity(limits))) == True{} : Bool} lanes_room : {Nat.is_le(Nat.add(first_value,tail),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}}
      +count_value = Equal.trans(Nat,U32.to_nat((lanes - first : U32)),Nat.sub(Nat.add(first_value,tail),first_value),tail,
        Arithmetic.difference_exact(Machine.capacity(limits),Limits.capacity_fits(limits),lanes,first,Nat.add(first_value,tail),first_value,lanes_exact,first_exact,Order.le_add(first_value,tail),room),
        Order.subtract_shift(first_value,tail))
      +tail_within = {%Order.commutative(tail,first_value) : {Nat.is_le(tail,_) == True{} : Bool} Order.le_add(tail,first_value) : {Nat.is_le(tail,Nat.add(first_value,tail)) == True{} : Bool}}
      +tail_room = Order.transitive(tail,Nat.add(first_value,tail),U32.to_nat(Machine.capacity(limits)),tail_within,room)
      +count_eq = Arithmetic.to_nat_injective((lanes - first : U32),U32.from_nat(tail),Equal.trans(Nat,U32.to_nat((lanes - first : U32)),tail,U32.to_nat(U32.from_nat(tail)),count_value,
        Equal.sym(Nat,U32.to_nat(U32.from_nat(tail)),tail,FullRange.roundtrip(tail,Machine.capacity(limits),tail_room))))
      last_summed(~CellContext,~cell,~Context,~value,tail,cells,context,cell_at,value_at,lanes,first,rest,hi,lo,count_eq,tail_positive,tail_small,groups_held)
    case 1n+ +others:
      match hi lo:
        case Tile.Tile{+h0,+h1,+h2,+h3,+h4,+h5,+h6,+h7} Tile.Tile{+l0,+l1,+l2,+l3,+l4,+l5,+l6,+l7}:
          KernelGemm.Both{+now,+later} = groups_held
          +tile = cell(cells,U32.from_nat(cell_at))
          +values = held(~Context,~value,context,value_at,8n,tile)
          +sum_hi = Tile.plus(Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},values)
          +sum_lo = Tile.plus(Tile.Tile{l0,l1,l2,l3,l4,l5,l6,l7},Sum.tile_error(Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7},values,sum_hi,Tile.minus(sum_hi,Tile.Tile{h0,h1,h2,h3,h4,h5,h6,h7})))
          +more = Nat.add(Nat.mul(others,8n),tail)
          +count = Nat.add(8n,more)
          +room = {%lanes_exact : {Nat.is_le(_,U32.to_nat(Machine.capacity(limits))) == True{} : Bool} lanes_room : {Nat.is_le(Nat.add(first_value,count),U32.to_nat(Machine.capacity(limits))) == True{} : Bool}}
          +difference = Equal.trans(Nat,U32.to_nat((lanes - first : U32)),Nat.sub(Nat.add(first_value,count),first_value),count,
            Arithmetic.difference_exact(Machine.capacity(limits),Limits.capacity_fits(limits),lanes,first,Nat.add(first_value,count),first_value,lanes_exact,first_exact,Order.le_add(first_value,count),room),
            Order.subtract_shift(first_value,count))
          +whole = Equal.trans(Bool,U32.is_le(8,(lanes - first : U32)),Nat.is_le(8n,U32.to_nat((lanes - first : U32))),True{},Comparison.le(8,(lanes - first : U32)),
            {%Equal.sym(Nat,U32.to_nat((lanes - first : U32)),count,difference) : {Nat.is_le(8n,_) == True{} : Bool} Order.zero_le(more) : {Nat.is_le(8n,U32.to_nat((lanes - first : U32))) == True{} : Bool}})
          +eight_room = Order.transitive(Nat.add(first_value,8n),Nat.add(first_value,count),U32.to_nat(Machine.capacity(limits)),
