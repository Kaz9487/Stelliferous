# Tiled values of the contract sum a valid list of axes as the specification
# sums the values: at every output, the rounded merge of the partials of its
# rows.
def tiled_sums(~Logical: Data,~original: Logical -> U32 -> F32,+logical: Logical,+limits: Machine.Limits,+name: String,+listed: List<&2,U32>,+values: List<&2,U32>,tiled: Tiled.Tiled,+contract: Public.Contract(~Logical,~original,logical,values,tiled),+unique: {Views.unique_axes(Layout.naturals(listed)) == True{} : Bool},+below: {Layout.all_below(listed,List.length(&2,U32,values)) == True{} : Bool},+default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},+rank_room: {Nat.is_le(List.length(&2,U32,values),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},+nonempty: {Nat.is_lt(0n,ShapeLaws.elements(values)) == True{} : Bool},+cap: U32,+cap_ok: {U32.is_le(cap,2147483648) == True{} : Bool},+count_room: {Nat.is_le(Nat.add(Nat.double(ShapeLaws.elements(values)),4n),U32.to_nat(cap)) == True{} : Bool}) -> Summed(~Logical,~original,logical,values,listed,TiledReduce.sum_axes(name,tiled,listed)):
  match tiled:
    case Tiled.Tiled{cells,+lane,+lanes,+position}:
      match cells:
        case Tensors.Tensor{pieces,+shape,+fill,Tensors.Usable{},+workers}:
          sum_usable(~Logical,~original,logical,limits,name,listed,values,pieces,shape,fill,workers,lane,lanes,position,contract,unique,below,default_capacity,rank_room,nonempty,cap,cap_ok,count_room)
        case Tensors.Tensor{pieces,+shape,+fill,Tensors.Failed{+problem},+workers}:
          Empty.absurd(Summed(~Logical,~original,logical,values,listed,TiledReduce.sum_axes(name,Tiled.Tiled{Tensors.Tensor{pieces,shape,fill,Tensors.Failed{problem},workers},lane,lanes,position},listed)),contract)

# ---- Sums of every axis and means ----

# Usable cells of the contract sum every axis.
def sum_all_usable(~Logical: Data,~original: Logical -> U32 -> F32,+logical: Logical,+limits: Machine.Limits,+name: String,+values: List<&2,U32>,pieces: Pieces.Pieces(~Tile.Tile8),+shape: List<&2,U32>,+fill: Tile.Tile8,+workers: U32,+lane: Nat,+lanes: U32,+position: Grid.Position,
  +contract: Public.Contract(~Logical,~original,logical,values,Tiled.Tiled{Tensors.Tensor{pieces,shape,fill,Tensors.Usable{},workers},lane,lanes,position}),+default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},+rank_room: {Nat.is_le(List.length(&2,U32,values),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},+nonempty: {Nat.is_lt(0n,ShapeLaws.elements(values)) == True{} : Bool},+cap: U32,+cap_ok: {U32.is_le(cap,2147483648) == True{} : Bool},+count_room: {Nat.is_le(Nat.add(Nat.double(ShapeLaws.elements(values)),4n),U32.to_nat(cap)) == True{} : Bool}) -> Summed(~Logical,~original,logical,values,TiledReduce.every_axis(List.length(&2,U32,values),0),TiledReduce.sum_all(name,Tiled.Tiled{Tensors.Tensor{pieces,shape,fill,Tensors.Usable{},workers},lane,lanes,position})):
  KernelGemm.Both{+global,Public.Laid{+inside,+shaped,+restored,+counted,+pinned}} = contract
  +same = Equal.cong(List<&2,U32>,Tiled.Tiled,extents => TiledReduce.sum_axes(name,Tiled.Tiled{Tensors.Tensor{pieces,shape,fill,Tensors.Usable{},workers},lane,lanes,position},TiledReduce.every_axis(List.length(&2,U32,extents),0)),Tiled.logical_shape(shape,lane,lanes,position),values,restored)
  %Equal.sym(Tiled.Tiled,TiledReduce.sum_all(name,Tiled.Tiled{Tensors.Tensor{pieces,shape,fill,Tensors.Usable{},workers},lane,lanes,position}),TiledReduce.sum_axes(name,Tiled.Tiled{Tensors.Tensor{pieces,shape,fill,Tensors.Usable{},workers},lane,lanes,position},TiledReduce.every_axis(List.length(&2,U32,values),0)),same) : Summed(~Logical,~original,logical,values,TiledReduce.every_axis(List.length(&2,U32,values),0),_)
  tiled_sums(~Logical,~original,logical,limits,name,TiledReduce.every_axis(List.length(&2,U32,values),0),values,Tiled.Tiled{Tensors.Tensor{pieces,shape,fill,Tensors.Usable{},workers},lane,lanes,position},contract,
    ReduceLaws.every_unique_words(List.length(&2,U32,values),Machine.capacity(limits),Limits.capacity_fits(limits),rank_room),ReduceLaws.every_below_words(List.length(&2,U32,values),Machine.capacity(limits),Limits.capacity_fits(limits),rank_room),default_capacity,rank_room,nonempty,cap,cap_ok,count_room)

# Tiled values of the contract sum every axis as the specification sums every
# axis of the values.
def tiled_sum_all(~Logical: Data,~original: Logical -> U32 -> F32,+logical: Logical,+limits: Machine.Limits,+name: String,+values: List<&2,U32>,tiled: Tiled.Tiled,
  +contract: Public.Contract(~Logical,~original,logical,values,tiled),+default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},+rank_room: {Nat.is_le(List.length(&2,U32,values),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},+nonempty: {Nat.is_lt(0n,ShapeLaws.elements(values)) == True{} : Bool},+cap: U32,+cap_ok: {U32.is_le(cap,2147483648) == True{} : Bool},+count_room: {Nat.is_le(Nat.add(Nat.double(ShapeLaws.elements(values)),4n),U32.to_nat(cap)) == True{} : Bool}) -> Summed(~Logical,~original,logical,values,TiledReduce.every_axis(List.length(&2,U32,values),0),TiledReduce.sum_all(name,tiled)):
  match tiled:
    case Tiled.Tiled{cells,+lane,+lanes,+position}:
      match cells:
        case Tensors.Tensor{pieces,+shape,+fill,Tensors.Usable{},+workers}:
          sum_all_usable(~Logical,~original,logical,limits,name,values,pieces,shape,fill,workers,lane,lanes,position,contract,default_capacity,rank_room,nonempty,cap,cap_ok,count_room)
        case Tensors.Tensor{pieces,+shape,+fill,Tensors.Failed{+problem},+workers}:
          Empty.absurd(Summed(~Logical,~original,logical,values,TiledReduce.every_axis(List.length(&2,U32,values),0),TiledReduce.sum_all(name,Tiled.Tiled{Tensors.Tensor{pieces,shape,fill,Tensors.Failed{problem},workers},lane,lanes,position})),contract)

# The tiled values of the means of the listed axes: at the row-major index of
# the kept axes, the sum of the specification there divided by count.
def Meaned(~Logical: Data,~original: Logical -> U32 -> F32,+logical: Logical,+values: List<&2,U32>,+listed: List<&2,U32>,+count: F32,tiled: Tiled.Tiled) -> Data:
  Public.Contract(~PiecesMap.Context<F32,PartialsValues.Box<Sum.Parts>>,~PiecesMap.value(~F32,~F32,~PartialsValues.Box<Sum.Parts>,~F32Tensor.scalar_value(~F32.div),~PartialsValues.box_value(~F32,~Sum.Parts,~Sum.merge,~Sum.rounded)),PiecesMap.Context{count,sum_box(~Logical,~original,logical,values,listed)},
    Layout.extents_at(values,Reduce.kept_axes(values,listed)),tiled)

def mean_axes_model(~Logical: Data,~original: Logical -> U32 -> F32,+logical: Logical,+limits: Machine.Limits,+listed: List<&2,U32>,+values: List<&2,U32>,+model: PiecesModel.Model<Tile.Tile8>,+fill: Tile.Tile8,+workers: U32,
  +lane: Nat,+position: Grid.Position,+contract: Public.Contract(~Logical,~original,logical,values,Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),Tiled.cell_shape(values,lane,position),fill,Tensors.Usable{},workers},lane,Grid.lanes_at(values,lane),position}),+unique: {Views.unique_axes(Layout.naturals(listed)) == True{} : Bool},+below: {Layout.all_below(listed,List.length(&2,U32,values)) == True{} : Bool},+default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},+rank_room: {Nat.is_le(List.length(&2,U32,values),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},+nonempty: {Nat.is_lt(0n,ShapeLaws.elements(values)) == True{} : Bool},+cap: U32,+cap_ok: {U32.is_le(cap,2147483648) == True{} : Bool},+count_room: {Nat.is_le(Nat.add(Nat.double(ShapeLaws.elements(values)),4n),U32.to_nat(cap)) == True{} : Bool}) ->
  Meaned(~Logical,~original,logical,values,listed,U32.to_f32(Tensors.count_or_zero(Layout.extents_at(values,Layout.axes_where(List.length(&2,U32,values),0n,Layout.naturals(listed),True{})))),F32Tensor.mean_axes(Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),Tiled.cell_shape(values,lane,position),fill,Tensors.Usable{},workers},lane,Grid.lanes_at(values,lane),position},listed)):
  KernelGemm.Both{+global,Public.Laid{+inside,+shaped,+restored,+counted,+pinned}} = contract
  +same = Equal.cong(List<&2,U32>,Tiled.Tiled,extents => F32Tensor.div_scalar(TiledReduce.sum_axes("mean_axes",Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),Tiled.cell_shape(values,lane,position),fill,Tensors.Usable{},workers},lane,Grid.lanes_at(values,lane),position},listed),U32.to_f32(Tensors.count_or_zero(Layout.extents_at(extents,Layout.axes_where(List.length(&2,U32,extents),0n,Layout.naturals(listed),True{}))))),Tiled.logical_shape(Tiled.cell_shape(values,lane,position),lane,Grid.lanes_at(values,lane),position),values,restored)
  %Equal.sym(Tiled.Tiled,F32Tensor.mean_axes(Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),Tiled.cell_shape(values,lane,position),fill,Tensors.Usable{},workers},lane,Grid.lanes_at(values,lane),position},listed),F32Tensor.div_scalar(TiledReduce.sum_axes("mean_axes",Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),Tiled.cell_shape(values,lane,position),fill,Tensors.Usable{},workers},lane,Grid.lanes_at(values,lane),position},listed),U32.to_f32(Tensors.count_or_zero(Layout.extents_at(values,Layout.axes_where(List.length(&2,U32,values),0n,Layout.naturals(listed),True{}))))),same) : Meaned(~Logical,~original,logical,values,listed,U32.to_f32(Tensors.count_or_zero(Layout.extents_at(values,Layout.axes_where(List.length(&2,U32,values),0n,Layout.naturals(listed),True{})))),_)
  TiledMaps.map(~F32,~PartialsValues.Box<Sum.Parts>,~F32Tensor.scalar_value(~F32.div),~TiledMap.lanes(~F32,~F32Tensor.scalar_value(~F32.div)),~TiledMaps.lanes_law(~F32,~F32Tensor.scalar_value(~F32.div)),~PartialsValues.box_value(~F32,~Sum.Parts,~Sum.merge,~Sum.rounded),U32.to_f32(Tensors.count_or_zero(Layout.extents_at(values,Layout.axes_where(List.length(&2,U32,values),0n,Layout.naturals(listed),True{})))),1.0,
    sum_box(~Logical,~original,logical,values,listed),Layout.extents_at(values,Reduce.kept_axes(values,listed)),TiledReduce.sum_axes("mean_axes",Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),Tiled.cell_shape(values,lane,position),fill,Tensors.Usable{},workers},lane,Grid.lanes_at(values,lane),position},listed),
    tiled_sums(~Logical,~original,logical,limits,"mean_axes",listed,values,Tiled.Tiled{Tensors.Tensor{PiecesModel.pack(~Tile.Tile8,model),Tiled.cell_shape(values,lane,position),fill,Tensors.Usable{},workers},lane,Grid.lanes_at(values,lane),position},contract,unique,below,default_capacity,rank_room,nonempty,cap,cap_ok,count_room))

# Tiled values of the contract hold, at every output of their means over a
# valid list of axes, the sum of the specification divided by the number of
# values it adds.
def mean_axes(~Logical: Data,~original: Logical -> U32 -> F32,+logical: Logical,+limits: Machine.Limits,+listed: List<&2,U32>,+values: List<&2,U32>,tiled: Tiled.Tiled,
  +contract: Public.Contract(~Logical,~original,logical,values,tiled),+unique: {Views.unique_axes(Layout.naturals(listed)) == True{} : Bool},+below: {Layout.all_below(listed,List.length(&2,U32,values)) == True{} : Bool},+default_capacity: {Machine.capacity(limits) == Machine.capacity(Default.limits()) : U32},+rank_room: {Nat.is_le(List.length(&2,U32,values),U32.to_nat(Machine.capacity(limits))) == True{} : Bool},+nonempty: {Nat.is_lt(0n,ShapeLaws.elements(values)) == True{} : Bool},+cap: U32,+cap_ok: {U32.is_le(cap,2147483648) == True{} : Bool},+count_room: {Nat.is_le(Nat.add(Nat.double(ShapeLaws.elements(values)),4n),U32.to_nat(cap)) == True{} : Bool}) ->
  Meaned(~Logical,~original,logical,values,listed,U32.to_f32(Tensors.count_or_zero(Layout.extents_at(values,Layout.axes_where(List.length(&2,U32,values),0n,Layout.naturals(listed),True{})))),F32Tensor.mean_axes(tiled,listed)):
  match tiled:
    case Tiled.Tiled{cells,+lane,+lanes,+position}:
      ReduceLaws.modeled_cells(~Logical,~original,~(tiled => Meaned(~Logical,~original,logical,values,listed,U32.to_f32(Tensors.count_or_zero(Layout.extents_at(values,Layout.axes_where(List.length(&2,U32,values),0n,Layout.naturals(listed),True{})))),F32Tensor.mean_axes(tiled,listed))),
        logical,values,cells,lane,lanes,position,contract,
        axes_model => axes_fill => axes_workers => axes_contract =>
          mean_axes_model(~Logical,~original,logical,limits,listed,values,axes_model,axes_fill,axes_workers,lane,position,axes_contract,unique,below,default_capacity,rank_room,nonempty,cap,cap_ok,count_room))
